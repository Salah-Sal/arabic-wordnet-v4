{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01XuXGJPcSsprHnULcRub2Nb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NEfjTzx1aiUjyKrutU17Cc","name":"Write","input":{"file_path":"/output/awn4-13590429-n.review.yaml","content":"# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية: awn4-13590429-n\n# protein folding — طَيُّ البُرُوتِين\n# AWN4 Review Pipeline v2 — 5 Stages\n# ═══════════════════════════════════════════════════════════════\n\nstage1_review:\n  assessment:\n    concerns:\n      - \"اللمّة الوحيدة «طي البروتين» تفتقر إلى التشكيل الكامل\"\n      - \"لا تتضمن المجموعة سوى لمّة واحدة وهي فقيرة معجمياً مقارنةً بأهمية المصطلح البيولوجي\"\n      - \"التعريف الحالي يبدو ترجمةً حرفيةً من الإنجليزية بأسلوب لا يرقى إلى مستوى المعجم العلمي\"\n      - \"مصطلح «البروتين» دخيل معرَّب، وإن كان ذلك مقبولاً للمواد الكيميائية ذات التسمية الدولية\"\n    observations: >\n      المفهوم يصف عمليةً بيولوجيةً جزيئيةً دقيقة تندرج في علمَي الكيمياء الحيوية والأحياء\n      الجزيئي. الجذر العربي الأصيل لهذا المفهوم هو «طوي» (الإدراج والثني)، وهو ما\n      يوثّقه ابن فارس بقوله: «أصل صحيح يدلّ على إدراج شيء حتى يُدرج بعضه في بعض».\n      تنتمي اللمّة إلى نوع التركيب الإضافي (MWE idafi). المفهوم يمثّل فجوةً معجميةً\n      نسبيةً في العربية؛ إذ لا توجد مفردة واحدة متداولة لعملية الطيّ البروتيني، وإنما\n      يُعبَّر عنها بالتركيب الإضافي.\n  blind_candidates:\n    - lemma: \"انْطِوَاءُ البُرُوتِين\"\n      generation_method: tarkib\n      justification: >\n        تركيب إضافي من المصدر «انطواء» (وزن انفعال من جذر طوي) مضافاً إلى «البروتين».\n        «انطوى» يدلّ على ثني الشيء على بعضه، وهو ما يُشبه العملية الفيزيائية لطيّ\n        البروتين. آثرت هذا الوزن على المصدر المجرد «طيّ» لإبراز الطابع التلقائي\n        (الانعكاسي) للعملية.\n    - lemma: \"تَثَنِّي البُرُوتِين\"\n      generation_method: tarkib\n      justification: >\n        تركيب إضافي من مصدر «تَثَنَّى» (وزن تفعّل من جذر ثني)، يدلّ على انعطاف الشيء\n        وارتداد بعضه على بعض، وهو وصف دقيق لكيفية تشكّل البروتين بنيوياً عبر انعطاف\n        سلاسله الببتيدية.\n    - lemma: \"التَّطَوِّي الجُزَيْئِيّ\"\n      generation_method: tarkib\n      justification: >\n        تركيب وصفي من «التطوّي» (مصدر تطوّى = انطوى، وزن تفعّل من جذر طوي) موصوفاً\n        بـ«الجزيئيّ»، مما يُضيّق الدلالة إلى مجال الكيمياء الحيوية ويُميّزه عن\n        التطوّي الجيولوجي أو الفيزيائي العام.\n    - lemma: \"الطَّيُّ البُرُوتِينِيّ\"\n      generation_method: tarkib\n      justification: >\n        تركيب وصفي بديل للتركيب الإضافي الموجود «طي البروتين»؛ المصدر «الطيّ» (جذر طوي)\n        موصوفاً بالنسبة «البروتيني»، يُعطي صياغةً أكثر انسجاماً مع أنماط المصطلحات\n        العلمية العربية المركّبة وصفياً.\n\n\nstage2_evidence:\n  per_lemma:\n    - lemma: \"طَيُّ البُرُوتِين\"\n      confirm:\n        - text: >\n            «طيّ — translation_en: folding — domain: Geology»\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (ARABTERM)\"\n        - text: >\n            «طيّ — translation_en: folding — domain: Seismology»\n          source: \"المعجم الموحد لمصطلحات علوم الزلازل (ARABTERM)\"\n        - text: >\n            «طيّ — translation_en: folding — domain: Printing - Electricity»\n          source: \"المعجم الموحد للمصطلحات المهنية والتقنية ج.1 (ARABTERM)\"\n        - text: >\n            «الطَّيُّ: ضمنُ الشيء أو داخله... في (الجيولوجيا): تقبُّض في القشرة الأرضية\n            نتيجة للحركات الأرضية ينشأ عنه أن تنطوي الصخور»\n          source: \"المعجم الوسيط\"\n        - text: >\n            «الطَّيُّ: الثَّنْيُ، نقيضُ النَّشْرِ؛ داخلُ الشَّيْءِ ومحتواه»\n          source: \"المعجم الكبير\"\n        - text: >\n            «بروتين — translation_en: protein — مادة عضوية أساسها التركيبي الأحماض الأمينية»\n          source: \"المعجم الموحد لمصطلحات علم الأحياء (ARABTERM)\"\n        - text: >\n            «بروتين — جزيء طويل ومطوي، يتكون من سلسلة من الأحماض الأمينية. كل بروتين له\n            وظيفة خاصة»\n          source: \"مسرد المناخ والبيئة وإدارة النفايات الصلبة (ARABTERM)\"\n        - text: >\n            «بروتين — جزيء عملاق يتكون من عديد ببتيدات واحد أو من تحت وحدتي عديدات\n            ببتيدات أو أكثر مترابطة تُبنى باستخدام آلية كائنية»\n          source: \"المعجم الموحد لمصطلحات علم الوراثة (ARABTERM)\"\n      expands:\n        - text: >\n            «الطَّاءُ وَالْوَاوُ وَالْيَاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى إِدْرَاجِ شَيْءٍ\n            حَتَّى يُدْرَجَ بَعْضُهُ فِي بَعْضٍ، ثُمَّ يُحْمَلَ عَلَيْهِ تَشْبِيهًا.\n            يُقَالُ: طَوَيْتُ الثَّوْبَ وَالْكِتَابَ طَيًّا أَطْوِيهِ»\n          source: \"مقاييس اللغة لابن فارس\"\n          addition: >\n            يكشف ابن فارس أن الجذر طوي يدل على الإدراج والانطواء الكلي، وهو ما يصف\n            بدقة التغيير البنيوي لجزيء البروتين حين ينطوي مكوّناً شكله الثلاثي.\n        - text: >\n            «تكتونية الطي — translation_en: tectonics (folding...)»\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (ARABTERM)\"\n          addition: \"يؤكد أن «طيّ» مصطلح علمي راسخ في السياق التقني العربي.\"\n\n    - lemma: \"انْطِوَاءُ البُرُوتِين\"\n      contradicts:\n        - text: >\n            «الإنطواء (في الفلسفة): اتجاه الفرد نحو شعوره الذاتي اتجاهاً مستغرقاً\n            يؤدى إلى السهو وفرط الحساسية»\n          source: \"المعجم الوسيط\"\n          conflict: >\n            «انطواء» راسخ في المعاجم الحديثة بمعنى الانطواء النفسي (introversion)،\n            وليس الطيّ الجزيئي الفيزيائي. استخدامه لـprotein folding سيُوقع في\n            الاشتراك اللفظي الضار مع المصطلح النفسي.\n        - text: >\n            «انطواء — translation_en: introversion — domain: Education»\n          source: \"مسرد التربية (ARABTERM)\"\n          conflict: \"مُثبَّت في معاجم التربية وعلم النفس والفلسفة بمعنى introversion.\"\n        - text: >\n            «انطواء — translation_en: introversion — domain: Philosophy and Psychology»\n          source: \"مسرد الفلسفة وعلم النفس (ARABTERM)\"\n          conflict: \"تثبيت آخر لمعنى الانطواء النفسي في المعجم الطبي الموحد.\"\n\n    - lemma: \"تَثَنِّي البُرُوتِين\"\n      confirm:\n        - text: >\n            «تَثَنَّى الشيء: انعطف وارتدَّ بعضه على بعض. يقال: تثنّى الغصن»\n          source: \"المعجم الكبير\"\n        - text: >\n            «تَثَنَّى: انثنى في صدره كذا: تردَّدَ»\n          source: \"المعجم الوسيط\"\n      contradicts:\n        - text: >\n            «تُثْني — الجذر: ث ن ي — مثال: لا تُثْنِ ركبتك — الرأي: مرفوضة عند بعضهم\n            للخطأ في ضبط حرف المضارعة بالضمّ»\n          source: \"معجم الصواب اللغوي لأحمد مختار عمر\"\n          conflict: >\n            يشير إلى حساسية صرفية حول ضبط الفعل؛ وإن كانت لا تمسّ صحة المصدر\n            «تَثَنٍّ»، فإن غياب المصطلح التقني المركّب «تثني البروتين» في المعاجم\n            يضعف توظيفه.\n\n    - lemma: \"التَّطَوِّي الجُزَيْئِيّ\"\n      confirm:\n        - text: >\n            «تَطَوَّى فلانٌ وغيرُه: انْطَوَى؛ التفَّ بعضُه حولَ بعضٍ. الثَّوبُ: انطَوَى،\n            أي تَثَنَّى وانضمَّ بعضُه إلى بعضٍ»\n          source: \"المعجم الكبير\"\n        - text: >\n            «تطوَّى: انْطَوَى»\n          source: \"المعجم الوسيط\"\n      expands:\n        - text: >\n            «تطوى: انطوى»\n          source: \"المعجم الوسيط لمجموعة من المؤلفين (hawramani)\"\n          addition: >\n            تطوّى مرادف مباشر لانطوى، مما يؤكد دلالة الطيّ والالتفاف وإن كان\n            المصطلح المركّب «التطوي الجزيئي» غير مسجّل.\n\n    - lemma: \"الطَّيُّ البُرُوتِينِيّ\"\n      confirm:\n        - text: >\n            «الطَّيُّ: الثَّنْيُ، نقيضُ النَّشْرِ»\n          source: \"المعجم الكبير\"\n        - text: >\n            «طيّ — translation_en: folding — domain: Geology»\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (ARABTERM)\"\n      expands:\n        - text: >\n            «(1) ثلاثيّ الأبعاد (2) مُجَسَّم — translation_en: three-dimensional»\n          source: \"المورد الحديث (ARABTERM)\"\n          addition: >\n            «ثلاثي الأبعاد» هو المصطلح الثابت في العربية المعاصرة، ويؤكد أن\n            وصف «البروتيني» في التركيب الوصفي البديل ملائم ومعهود.\n\n\nstage3_analysis:\n  per_lemma:\n    - lemma: \"طَيُّ البُرُوتِين\"\n      decision: confirmed\n      decision_reason: >\n        اللمّة تركيب إضافي صحيح من مصدر عربي أصيل (طيّ من جذر طوي) مضاف إلى الاسم\n        الدولي المعرَّب (بروتين). «طيّ» مصطلح تقني راسخ في علم الجيولوجيا والعروض\n        والطباعة العربية بمعنى folding، وهو ما يدعم توظيفه في السياق البيولوجي.\n        التركيب مسكوك ومُتداوَل في الكتابات البيولوجية والطبية العربية المعاصرة.\n        يحتاج إلى تحديث التشكيل.\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: true\n        mwe_type: idafi\n      nuance_differentiation: >\n        اللمّة الوحيدة في المجموعة؛ تختص بالعملية البيولوجية لاكتساب البروتين بنيته\n        الفراغية، وتتميز عن «الطيّ» المجرّد بتحديد المجال (الكيمياء الحيوية) وعن\n        «الانطواء» بانعدام الدلالة النفسية.\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"طَيُّ البُرُوتِين\"\n\n    - lemma: \"انْطِوَاءُ البُرُوتِين\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        «انطواء» راسخ في المعاجم التقنية العربية (التربية، الفلسفة، علم النفس،\n        المعجم الطبي الموحد) بمعنى introversion النفسي حصراً. استخدامه لـprotein\n        folding سيُفضي إلى اشتراك لفظي حادّ مع مصطلح قائم ومرسَّخ. رُفض.\n\n    - lemma: \"تَثَنِّي البُرُوتِين\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        «تَثَنَّى» فعل لا اسم مصدر تقني؛ التعريف المعجمي يذكر «انعطف وارتدَّ بعضه\n        على بعض» وهو صحيح وصفياً لكن المركّب «تثني البروتين» غير مسجّل في أي معجم\n        تقني عربي. المصدر «تَثَنٍّ» ثقيل صرفياً ويصعب تداوله مقارنةً بـ«طيّ».\n        لا تتوفر أدلة على تثبيته معجمياً كمصطلح علمي. رُفض.\n\n    - lemma: \"التَّطَوِّي الجُزَيْئِيّ\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        «تطوّى» مرادف «انطوى» في المعاجم، غير أن المركّب الوصفي «التطوي الجزيئي»\n        غير مسجّل في أي مصدر معجمي. الوصف «الجزيئي» يُشير إلى مستوى التحليل لا إلى\n        عملية محددة. الصيغة أشبه بالعبارة الوصفية الحرة منها بالمصطلح المسكوك.\n        اختبار السكّ: «التطوي الجزيئي» ← «التطوي الببتيدي» = وصف لا مصطلح. رُفض.\n\n    - lemma: \"الطَّيُّ البُرُوتِينِيّ\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        الصيغة الوصفية «الطيّ البروتيني» موازية للمصطلح الإضافي «طيّ البروتين» دون\n        أن تُضيف دلالةً جديدة. الأصل في التركيب الإضافي العلمي العربي أقوى (مثل\n        «طيّ الحمض النووي»، «تكتونية الطيّ»). لا وجود لها في المعاجم التقنية. رُفض.\n\n\nstage4_content:\n  definition:\n    current: \"العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد\"\n    assessment:\n      decision: revise\n      reason: >\n        التعريف الحالي ترجمة حرفية من الإنجليزية («يتخذ ... شكله»). يفتقر إلى\n        الجنس القريب الدقيق («عملية بيولوجية تلقائية» بدلاً من «العملية»)، وإلى\n        الفصل النوعي الكافي (لا يُشير إلى آلية الانطواء ولا إلى البنية الفراغية\n        الوظيفية). كلمة «المعقد» ترجمة غير دقيقة لـintricate وأصحّها «المحدد»\n        أو «الوظيفي».\n    authored:\n      - type: terminological\n        text: >\n          عمليةٌ بيولوجيةٌ تلقائيةٌ تنطوي فيها السلسلةُ الببتيديةُ للبروتين\n          مكتسِبةً بنيتَها الفضائيةَ ثلاثيةَ الأبعاد الوظيفية المحددة\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: >\n          عملية فيزيائية كيميائية تتكشّف فيها سلاسل الأحماض الأمينية لجزيء\n          البروتين وتنعقد عفوياً مكوِّنةً الشكل الفضائي ثلاثي الأبعاد الضروري\n          لأداء وظيفته البيولوجية؛ وتشمل البنى الثانوية والثلاثية والرباعية\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n    actions:\n      - command: update_definition\n        params:\n          synset_id: \"awn4-13590429-n\"\n          definition_index: 0\n          text: >\n            عمليةٌ بيولوجيةٌ تلقائيةٌ تنطوي فيها السلسلةُ الببتيديةُ للبروتين\n            مكتسِبةً بنيتَها الفضائيةَ ثلاثيةَ الأبعاد الوظيفية المحددة\n      - command: add_definition\n        params:\n          synset_id: \"awn4-13590429-n\"\n          text: >\n            عملية فيزيائية كيميائية تتكشّف فيها سلاسل الأحماض الأمينية لجزيء\n            البروتين وتنعقد عفوياً مكوِّنةً الشكل الفضائي ثلاثي الأبعاد الضروري\n            لأداء وظيفته البيولوجية؛ وتشمل البنى الثانوية والثلاثية والرباعية\n\n  examples:\n    per_lemma:\n      - lemma: \"طَيُّ البُرُوتِين\"\n        examples:\n          - text: >\n              يُعدُّ طَيُّ البُرُوتِين من أعقد العمليات الجزيئية في الخلية الحية،\n              وأيُّ خلل في مساره قد يُفضي إلى أمراض كالزهايمر والباركنسون\n            type: usage\n          - text: >\n              درس الباحثون طَيَّ البُرُوتِين بالحاسوب لتصميم أدوية تستهدف مواضع\n              التعرج في البنية الفضائية للإنزيم\n            type: usage\n    actions:\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: >\n            يُعدُّ طَيُّ البُرُوتِين من أعقد العمليات الجزيئية في الخلية الحية،\n            وأيُّ خلل في مساره قد يُفضي إلى أمراض كالزهايمر والباركنسون\n      - command: add_synset_example\n        params:\n          synset_id: \"awn4-13590429-n\"\n          text: >\n            درس الباحثون طَيَّ البُرُوتِين بالحاسوب لتصميم أدوية تستهدف مواضع\n            التعرج في البنية الفضائية للإنزيم\n\n\nstage5_enrichment:\n  per_entry:\n    - lemma: \"طَيُّ البُرُوتِين\"\n      entry_id: \"{auto}\"\n      roots:\n        - word: \"طَيُّ\"\n          root: \"طوي\"\n          maqayis_quote: >\n            «الطَّاءُ وَالْوَاوُ وَالْيَاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى إِدْرَاجِ\n            شَيْءٍ حَتَّى يُدْرَجَ بَعْضُهُ فِي بَعْضٍ، ثُمَّ يُحْمَلَ عَلَيْهِ\n            تَشْبِيهًا. يُقَالُ: طَوَيْتُ الثَّوْبَ وَالْكِتَابَ طَيًّا أَطْوِيهِ»\n        - word: \"البُرُوتِين\"\n          root: null\n          maqayis_quote: null\n\n  per_sense:\n    - lemma: \"طَيُّ البُرُوتِين\"\n      sense_id: \"{auto}\"\n      nuance: >\n        اللمّة تُقيّد الطيّ (الفيزيائي العام) بمحلّه الجزيئي البيولوجي، مميِّزةً\n        العملية عن الطيّ الجيولوجي (تكتونية الطيّ) والطيّ الميكانيكي والطيّ\n        العروضي. الإضافة إلى «البروتين» هي الفصل النوعي الوحيد المتاح\n        لمصطلح ذي جنس عام.\n      mwe: true\n\n  synset:\n    cultural_fit: lexical_gap\n\n  actions:\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: >\n          {\"roots\":[{\"word\":\"طي\",\"root\":\"طوي\",\"maqayis\":\"«الطَّاءُ وَالْوَاوُ وَالْيَاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى إِدْرَاجِ شَيْءٍ حَتَّى يُدْرَجَ بَعْضُهُ فِي بَعْضٍ»\"},{\"word\":\"البروتين\",\"root\":null,\"maqayis\":null}]}\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n        key: note\n        value: >\n          {\"nuance\":\"يُقيّد الطيّ الفيزيائي بمحلّه الجزيئي البيولوجي؛ يتميّز عن الطيّ الجيولوجي والعروضي والميكانيكي\",\"mwe\":true}\n    - command: set_metadata\n      params:\n        entity_type: synset\n        entity_id: \"awn4-13590429-n\"\n        key: note\n        value: '{\"cultural_fit\":\"lexical_gap\"}'\n    - command: set_confidence\n      params:\n        entity_type: synset\n        entity_id: \"awn4-13590429-n\"\n        score: 0.78\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":8990,"cache_read_input_tokens":49741,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8990},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"f528e1a3-c453-49fa-b06a-8e4f90733ac8","uuid":"92d9e4cd-d532-4d5a-8344-8041f92fc9b3"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NEfjTzx1aiUjyKrutU17Cc","type":"tool_result","content":"File created successfully at: /output/awn4-13590429-n.review.yaml"}]},"parent_tool_use_id":null,"session_id":"f528e1a3-c453-49fa-b06a-8e4f90733ac8","uuid":"a0cb9cc4-3733-4617-958c-19052c2f051a","tool_use_result":{"type":"create","filePath":"/output/awn4-13590429-n.review.yaml","content":"# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية: awn4-13590429-n\n# protein folding — طَيُّ البُرُوتِين\n# AWN4 Review Pipeline v2 — 5 Stages\n# ═══════════════════════════════════════════════════════════════\n\nstage1_review:\n  assessment:\n    concerns:\n      - \"اللمّة الوحيدة «طي البروتين» تفتقر إلى التشكيل الكامل\"\n      - \"لا تتضمن المجموعة سوى لمّة واحدة وهي فقيرة معجمياً مقارنةً بأهمية المصطلح البيولوجي\"\n      - \"التعريف الحالي يبدو ترجمةً حرفيةً من الإنجليزية بأسلوب لا يرقى إلى مستوى المعجم العلمي\"\n      - \"مصطلح «البروتين» دخيل معرَّب، وإن كان ذلك مقبولاً للمواد الكيميائية ذات التسمية الدولية\"\n    observations: >\n      المفهوم يصف عمليةً بيولوجيةً جزيئيةً دقيقة تندرج في علمَي الكيمياء الحيوية والأحياء\n      الجزيئي. الجذر العربي الأصيل لهذا المفهوم هو «طوي» (الإدراج والثني)، وهو ما\n      يوثّقه ابن فارس بقوله: «أصل صحيح يدلّ على إدراج شيء حتى يُدرج بعضه في بعض».\n      تنتمي اللمّة إلى نوع التركيب الإضافي (MWE idafi). المفهوم يمثّل فجوةً معجميةً\n      نسبيةً في العربية؛ إذ لا توجد مفردة واحدة متداولة لعملية الطيّ البروتيني، وإنما\n      يُعبَّر عنها بالتركيب الإضافي.\n  blind_candidates:\n    - lemma: \"انْطِوَاءُ البُرُوتِين\"\n      generation_method: tarkib\n      justification: >\n        تركيب إضافي من المصدر «انطواء» (وزن انفعال من جذر طوي) مضافاً إلى «البروتين».\n        «انطوى» يدلّ على ثني الشيء على بعضه، وهو ما يُشبه العملية الفيزيائية لطيّ\n        البروتين. آثرت هذا الوزن على المصدر المجرد «طيّ» لإبراز الطابع التلقائي\n        (الانعكاسي) للعملية.\n    - lemma: \"تَثَنِّي البُرُوتِين\"\n      generation_method: tarkib\n      justification: >\n        تركيب إضافي من مصدر «تَثَنَّى» (وزن تفعّل من جذر ثني)، يدلّ على انعطاف الشيء\n        وارتداد بعضه على بعض، وهو وصف دقيق لكيفية تشكّل البروتين بنيوياً عبر انعطاف\n        سلاسله الببتيدية.\n    - lemma: \"التَّطَوِّي الجُزَيْئِيّ\"\n      generation_method: tarkib\n      justification: >\n        تركيب وصفي من «التطوّي» (مصدر تطوّى = انطوى، وزن تفعّل من جذر طوي) موصوفاً\n        بـ«الجزيئيّ»، مما يُضيّق الدلالة إلى مجال الكيمياء الحيوية ويُميّزه عن\n        التطوّي الجيولوجي أو الفيزيائي العام.\n    - lemma: \"الطَّيُّ البُرُوتِينِيّ\"\n      generation_method: tarkib\n      justification: >\n        تركيب وصفي بديل للتركيب الإضافي الموجود «طي البروتين»؛ المصدر «الطيّ» (جذر طوي)\n        موصوفاً بالنسبة «البروتيني»، يُعطي صياغةً أكثر انسجاماً مع أنماط المصطلحات\n        العلمية العربية المركّبة وصفياً.\n\n\nstage2_evidence:\n  per_lemma:\n    - lemma: \"طَيُّ البُرُوتِين\"\n      confirm:\n        - text: >\n            «طيّ — translation_en: folding — domain: Geology»\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (ARABTERM)\"\n        - text: >\n            «طيّ — translation_en: folding — domain: Seismology»\n          source: \"المعجم الموحد لمصطلحات علوم الزلازل (ARABTERM)\"\n        - text: >\n            «طيّ — translation_en: folding — domain: Printing - Electricity»\n          source: \"المعجم الموحد للمصطلحات المهنية والتقنية ج.1 (ARABTERM)\"\n        - text: >\n            «الطَّيُّ: ضمنُ الشيء أو داخله... في (الجيولوجيا): تقبُّض في القشرة الأرضية\n            نتيجة للحركات الأرضية ينشأ عنه أن تنطوي الصخور»\n          source: \"المعجم الوسيط\"\n        - text: >\n            «الطَّيُّ: الثَّنْيُ، نقيضُ النَّشْرِ؛ داخلُ الشَّيْءِ ومحتواه»\n          source: \"المعجم الكبير\"\n        - text: >\n            «بروتين — translation_en: protein — مادة عضوية أساسها التركيبي الأحماض الأمينية»\n          source: \"المعجم الموحد لمصطلحات علم الأحياء (ARABTERM)\"\n        - text: >\n            «بروتين — جزيء طويل ومطوي، يتكون من سلسلة من الأحماض الأمينية. كل بروتين له\n            وظيفة خاصة»\n          source: \"مسرد المناخ والبيئة وإدارة النفايات الصلبة (ARABTERM)\"\n        - text: >\n            «بروتين — جزيء عملاق يتكون من عديد ببتيدات واحد أو من تحت وحدتي عديدات\n            ببتيدات أو أكثر مترابطة تُبنى باستخدام آلية كائنية»\n          source: \"المعجم الموحد لمصطلحات علم الوراثة (ARABTERM)\"\n      expands:\n        - text: >\n            «الطَّاءُ وَالْوَاوُ وَالْيَاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى إِدْرَاجِ شَيْءٍ\n            حَتَّى يُدْرَجَ بَعْضُهُ فِي بَعْضٍ، ثُمَّ يُحْمَلَ عَلَيْهِ تَشْبِيهًا.\n            يُقَالُ: طَوَيْتُ الثَّوْبَ وَالْكِتَابَ طَيًّا أَطْوِيهِ»\n          source: \"مقاييس اللغة لابن فارس\"\n          addition: >\n            يكشف ابن فارس أن الجذر طوي يدل على الإدراج والانطواء الكلي، وهو ما يصف\n            بدقة التغيير البنيوي لجزيء البروتين حين ينطوي مكوّناً شكله الثلاثي.\n        - text: >\n            «تكتونية الطي — translation_en: tectonics (folding...)»\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (ARABTERM)\"\n          addition: \"يؤكد أن «طيّ» مصطلح علمي راسخ في السياق التقني العربي.\"\n\n    - lemma: \"انْطِوَاءُ البُرُوتِين\"\n      contradicts:\n        - text: >\n            «الإنطواء (في الفلسفة): اتجاه الفرد نحو شعوره الذاتي اتجاهاً مستغرقاً\n            يؤدى إلى السهو وفرط الحساسية»\n          source: \"المعجم الوسيط\"\n          conflict: >\n            «انطواء» راسخ في المعاجم الحديثة بمعنى الانطواء النفسي (introversion)،\n            وليس الطيّ الجزيئي الفيزيائي. استخدامه لـprotein folding سيُوقع في\n            الاشتراك اللفظي الضار مع المصطلح النفسي.\n        - text: >\n            «انطواء — translation_en: introversion — domain: Education»\n          source: \"مسرد التربية (ARABTERM)\"\n          conflict: \"مُثبَّت في معاجم التربية وعلم النفس والفلسفة بمعنى introversion.\"\n        - text: >\n            «انطواء — translation_en: introversion — domain: Philosophy and Psychology»\n          source: \"مسرد الفلسفة وعلم النفس (ARABTERM)\"\n          conflict: \"تثبيت آخر لمعنى الانطواء النفسي في المعجم الطبي الموحد.\"\n\n    - lemma: \"تَثَنِّي البُرُوتِين\"\n      confirm:\n        - text: >\n            «تَثَنَّى الشيء: انعطف وارتدَّ بعضه على بعض. يقال: تثنّى الغصن»\n          source: \"المعجم الكبير\"\n        - text: >\n            «تَثَنَّى: انثنى في صدره كذا: تردَّدَ»\n          source: \"المعجم الوسيط\"\n      contradicts:\n        - text: >\n            «تُثْني — الجذر: ث ن ي — مثال: لا تُثْنِ ركبتك — الرأي: مرفوضة عند بعضهم\n            للخطأ في ضبط حرف المضارعة بالضمّ»\n          source: \"معجم الصواب اللغوي لأحمد مختار عمر\"\n          conflict: >\n            يشير إلى حساسية صرفية حول ضبط الفعل؛ وإن كانت لا تمسّ صحة المصدر\n            «تَثَنٍّ»، فإن غياب المصطلح التقني المركّب «تثني البروتين» في المعاجم\n            يضعف توظيفه.\n\n    - lemma: \"التَّطَوِّي الجُزَيْئِيّ\"\n      confirm:\n        - text: >\n            «تَطَوَّى فلانٌ وغيرُه: انْطَوَى؛ التفَّ بعضُه حولَ بعضٍ. الثَّوبُ: انطَوَى،\n            أي تَثَنَّى وانضمَّ بعضُه إلى بعضٍ»\n          source: \"المعجم الكبير\"\n        - text: >\n            «تطوَّى: انْطَوَى»\n          source: \"المعجم الوسيط\"\n      expands:\n        - text: >\n            «تطوى: انطوى»\n          source: \"المعجم الوسيط لمجموعة من المؤلفين (hawramani)\"\n          addition: >\n            تطوّى مرادف مباشر لانطوى، مما يؤكد دلالة الطيّ والالتفاف وإن كان\n            المصطلح المركّب «التطوي الجزيئي» غير مسجّل.\n\n    - lemma: \"الطَّيُّ البُرُوتِينِيّ\"\n      confirm:\n        - text: >\n            «الطَّيُّ: الثَّنْيُ، نقيضُ النَّشْرِ»\n          source: \"المعجم الكبير\"\n        - text: >\n            «طيّ — translation_en: folding — domain: Geology»\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (ARABTERM)\"\n      expands:\n        - text: >\n            «(1) ثلاثيّ الأبعاد (2) مُجَسَّم — translation_en: three-dimensional»\n          source: \"المورد الحديث (ARABTERM)\"\n          addition: >\n            «ثلاثي الأبعاد» هو المصطلح الثابت في العربية المعاصرة، ويؤكد أن\n            وصف «البروتيني» في التركيب الوصفي البديل ملائم ومعهود.\n\n\nstage3_analysis:\n  per_lemma:\n    - lemma: \"طَيُّ البُرُوتِين\"\n      decision: confirmed\n      decision_reason: >\n        اللمّة تركيب إضافي صحيح من مصدر عربي أصيل (طيّ من جذر طوي) مضاف إلى الاسم\n        الدولي المعرَّب (بروتين). «طيّ» مصطلح تقني راسخ في علم الجيولوجيا والعروض\n        والطباعة العربية بمعنى folding، وهو ما يدعم توظيفه في السياق البيولوجي.\n        التركيب مسكوك ومُتداوَل في الكتابات البيولوجية والطبية العربية المعاصرة.\n        يحتاج إلى تحديث التشكيل.\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: true\n        mwe_type: idafi\n      nuance_differentiation: >\n        اللمّة الوحيدة في المجموعة؛ تختص بالعملية البيولوجية لاكتساب البروتين بنيته\n        الفراغية، وتتميز عن «الطيّ» المجرّد بتحديد المجال (الكيمياء الحيوية) وعن\n        «الانطواء» بانعدام الدلالة النفسية.\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"طَيُّ البُرُوتِين\"\n\n    - lemma: \"انْطِوَاءُ البُرُوتِين\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        «انطواء» راسخ في المعاجم التقنية العربية (التربية، الفلسفة، علم النفس،\n        المعجم الطبي الموحد) بمعنى introversion النفسي حصراً. استخدامه لـprotein\n        folding سيُفضي إلى اشتراك لفظي حادّ مع مصطلح قائم ومرسَّخ. رُفض.\n\n    - lemma: \"تَثَنِّي البُرُوتِين\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        «تَثَنَّى» فعل لا اسم مصدر تقني؛ التعريف المعجمي يذكر «انعطف وارتدَّ بعضه\n        على بعض» وهو صحيح وصفياً لكن المركّب «تثني البروتين» غير مسجّل في أي معجم\n        تقني عربي. المصدر «تَثَنٍّ» ثقيل صرفياً ويصعب تداوله مقارنةً بـ«طيّ».\n        لا تتوفر أدلة على تثبيته معجمياً كمصطلح علمي. رُفض.\n\n    - lemma: \"التَّطَوِّي الجُزَيْئِيّ\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        «تطوّى» مرادف «انطوى» في المعاجم، غير أن المركّب الوصفي «التطوي الجزيئي»\n        غير مسجّل في أي مصدر معجمي. الوصف «الجزيئي» يُشير إلى مستوى التحليل لا إلى\n        عملية محددة. الصيغة أشبه بالعبارة الوصفية الحرة منها بالمصطلح المسكوك.\n        اختبار السكّ: «التطوي الجزيئي» ← «التطوي الببتيدي» = وصف لا مصطلح. رُفض.\n\n    - lemma: \"الطَّيُّ البُرُوتِينِيّ\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        الصيغة الوصفية «الطيّ البروتيني» موازية للمصطلح الإضافي «طيّ البروتين» دون\n        أن تُضيف دلالةً جديدة. الأصل في التركيب الإضافي العلمي العربي أقوى (مثل\n        «طيّ الحمض النووي»، «تكتونية الطيّ»). لا وجود لها في المعاجم التقنية. رُفض.\n\n\nstage4_content:\n  definition:\n    current: \"العملية التي يتخذ فيها جزيء البروتين شكله المعقد ثلاثي الأبعاد\"\n    assessment:\n      decision: revise\n      reason: >\n        التعريف الحالي ترجمة حرفية من الإنجليزية («يتخذ ... شكله»). يفتقر إلى\n        الجنس القريب الدقيق («عملية بيولوجية تلقائية» بدلاً من «العملية»)، وإلى\n        الفصل النوعي الكافي (لا يُشير إلى آلية الانطواء ولا إلى البنية الفراغية\n        الوظيفية). كلمة «المعقد» ترجمة غير دقيقة لـintricate وأصحّها «المحدد»\n        أو «الوظيفي».\n    authored:\n      - type: terminological\n        text: >\n          عمليةٌ بيولوجيةٌ تلقائيةٌ تنطوي فيها السلسلةُ الببتيديةُ للبروتين\n          مكتسِبةً بنيتَها الفضائيةَ ثلاثيةَ الأبعاد الوظيفية المحددة\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: >\n          عملية فيزيائية كيميائية تتكشّف فيها سلاسل الأحماض الأمينية لجزيء\n          البروتين وتنعقد عفوياً مكوِّنةً الشكل الفضائي ثلاثي الأبعاد الضروري\n          لأداء وظيفته البيولوجية؛ وتشمل البنى الثانوية والثلاثية والرباعية\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: fals