ool_use","id":"toolu_01Kyw7kFt7zCKW5ZtZ1KzuU6","name":"Bash","input":{"command":"sqlite3 -json /data/arabic_dict.db \"SELECT e.id AS entry_id, e.headword, e.headword_norm, e.root, e.definitions_text, d.name_ar, d.source_type FROM entries e JOIN dictionaries d ON e.dictionary_id=d.id WHERE e.id IN (SELECT rowid FROM entries_fts WHERE entries_fts MATCH '\\\"انتعاش\\\" OR \\\"ازدهار\\\" OR \\\"رخاء\\\" OR \\\"حظ سعيد\\\" OR \\\"كسب مفاجئ\\\"' ORDER BY bm25(entries_fts, 10.0, 5.0, 5.0, 3.0, 1.0) LIMIT 30) AND e.id NOT IN (40071,61041,17418,877328,29663,886058,22284,20965,400799) ORDER BY d.source_type, d.name_en;\"","description":"Arabic FTS keyword search for related terms"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":14116,"cache_read_input_tokens":39553,"cache_creation":{"ephemeral_5m_input_tokens":14116,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"9c7b4829-82d4-43b4-91f1-33a3cf0c3ad4","uuid":"f38eb0ce-a6f5-4e08-bba7-fc31f3330f76"}
