":"run_shell_command_1773666420264_0","parameters":{"command":"sqlite3 -json \"/data/arabic_dict.db\" \"\nSELECT e.id AS entry_id, e.headword, e.translation_en, d.name_ar\nFROM entries e\nJOIN dictionaries d ON e.dictionary_id = d.id\nWHERE e.id IN (\n    SELECT rowid FROM entries_translations_fts \n    WHERE entries_translations_fts MATCH 'translation_en:\\\"clubhead\\\"'\n)\nORDER BY d.source_type;\n\"","description":"Check for 'clubhead' translations."}}
