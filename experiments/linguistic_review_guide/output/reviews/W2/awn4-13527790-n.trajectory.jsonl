{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_0195BczEiq9JmYANNAtnrQ7d","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KjVtY46WvPJ8SRb5xW3QUv","name":"Write","input":{"file_path":"/output/awn4-13527790-n.review.yaml","content":"# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية — AWN4 Review Pipeline v2\n# Synset: awn4-13527790-n  |  ILI: i107705\n# POS: n  |  Concept: leaching (natural soil washing process)\n# ═══════════════════════════════════════════════════════════════\n\n# ── المرحلة ١: المراجعة والتوليد ────────────────────────────\nstage1_review:\n  assessment:\n    concerns:\n      - \"اللمّة «ترشيح» تُرجمت في جميع المعاجم التقنية المحكمة إلى «filtration» لا «leaching»؛\n         وهما عمليتان مختلفتان: الترشيح = فصل مادة صلبة عالقة بمرشّح مسامي،\n         والغسل (leaching) = إذابة مواد ذائبة بالماء ونقلها عبر التربة؛\n         إبقاء «ترشيح» في المجموعة يُرسّخ خلطاً مصطلحياً بين العمليتين.\"\n      - \"التعريف الحالي يتضمّن «الترشيح» و«الغسل» كأنهما مرادفان في هذا السياق،\n         وهو خطأ علمي ومصطلحي لأن الترشيح لا يُزيل مواد ذائبة بل عالقة.\"\n      - \"التعريف لا يُصرّح بالسياق الطبيعي (التربة، المياه الجوفية) الذي يُميّز leaching عن\n         عمليات الغسل الصناعي.\"\n    observations: >\n      المجموعة تصف عملية Leaching — وهي العملية الجيولوجية/البيئية الطبيعية التي يتخلّل فيها\n      الماءُ التربةَ أو الصخرَ، فيُذيب المواد القابلة للانحلال (كالأملاح والمعادن والمغذيات)\n      وينقلها قسراً إلى طبقات أعمق أو إلى المياه الجوفية. من أهم الشواهد المعجمية الخارجية:\n      المعجم الموحد لمصطلحات المياه (2000) يُعرّف «غسل التربة» تعريفاً دقيقاً يطابق leaching،\n      بينما يُعرّف «غسل» في مسرد المناخ والبيئة بأنه «عملية غسل المواد القابلة للذوبان في التربة\n      ونقلها إلى طبقة سفلى أو إلى المياه الجوفية». والجدير بالذكر أن المعجم الموحد للهندسة المدنية\n      (2012) يُصرّح أن «نَضّ» هو المرادف العربي لـleaching، وهو مصطلح من الجذر (ن-ض-ض) يدل على\n      تسرّب الماء قطرةً قطرةً. تستحق «اللمّة ترشيح» الإزالة من المجموعة والاستعاضة بمصطلحات أدق.\n\n  blind_candidates:\n    - lemma: \"النَّضْح\"\n      generation_method: ishtiqaq\n      justification: >\n        من الجذر (ن-ض-ح): النَّضْح في اللغة هو رشُّ الماء وتسرّبه، وفي المعجم الوسيط «نضحت\n        القِرْبة: رشحت»؛ يُوحي بالسائل المتسرّب عبر مادة مسامية حاملاً ما ذاب فيها، وهو قريب\n        من آلية leaching.\n    - lemma: \"الإِرْشَاح\"\n      generation_method: ishtiqaq\n      justification: >\n        من الجذر (ر-ش-ح) على وزن إِفْعَال (متعدٍّ قسري)؛ الرَّشْح في الأصل هو النَّدى يبدو\n        من الشيء (مقاييس اللغة)؛ صيغة الإفعال توحي بتسريب مقصود أو تسبيب للرَّشح؛ يصلح\n        للعملية المُدارة (leaching الصناعي).\n    - lemma: \"التَّرَشُّح\"\n      generation_method: ishtiqaq\n      justification: >\n        من الجذر (ر-ش-ح) على وزن تَفَعُّل (للتسرّب التلقائي الطبيعي)؛ «تَرَشَّحَ الماءُ»\n        أي تسرّب من تلقاء نفسه؛ الصيغة مناسبة لوصف العملية الطبيعية المنسجمة مع التضمين\n        في مجموعة «عملية طبيعية».\n    - lemma: \"الاسْتِنْضَاح\"\n      generation_method: ishtiqaq\n      justification: >\n        من الجذر (ن-ض-ح) على وزن استفعال؛ يدل على استخراج المذابات أو طلب الرَّشح؛\n        يُحاكي الفعل المُوجَّه (استخلاص المعادن بالغسل) في التطبيقات التقنية.\n\n\n# ── المرحلة ٢: جمع الأدلة ────────────────────────────────────\nstage2_evidence:\n  per_lemma:\n\n    - lemma: \"تَرْشِيح\"\n      contradicts:\n        - text: \"«التَّرْشِيحُ: عند البيانيين: ذكر ما يلائم المُشَبَّهَ به تقوية لها.\n                 تنقيةُ الماء ونحوه من المواد العالقة به. عند الكيمياويين: فصل الأجسام الصُّلْبة\n                 العالقة في سائل باستخدام مادة مسامية تسمح للسائل بالنفاذ خلاله مُحْتَجِزَةً\n                 الأجسام العالقة.»\"\n          source: \"المعجم الوسيط (OCR)\"\n          conflict: >\n            التعريف يُحدّد أن الترشيح يعمل على إزالة المواد العالقة (الصلبة) لا المواد الذائبة؛\n            leaching يُزيل مواد ذائبة لا عالقة — الآلية والمواد المُزالة مختلفتان جوهرياً.\n        - text: \"«الترشيح: (أ) إنفاذ سائل ما من خلال مرشح.\n                 (ب) (في علم الأشعة) استعمال سائل معدني لمنع مرور جسيمات بيتا والفوتونات\n                 الطويلة الموجة.»\"\n          source: \"معجم المصطلحات الطبية (2003) — ARABTERM\"\n          conflict: \"تعريف صريح في أن الترشيح = filtration، لا علاقة بإزالة مواد ذائبة من تربة.\"\n        - text: \"«ترشيح: فصل المواد العالقة (وبعض المواد الذائبة) وتختلف دقته من ترشيح عادي إلى\n                 ترشيح ميكرون إلى ترشيح دقيق إلى ترشيح متناهي الدقة. عملية تصفية الماء من المواد\n                 العالقة كالرمل والطمي وغيرها.»\"\n          source: \"المعجم الموحد لمصطلحات المياه (2000) — ARABTERM — translation_en: filtration\"\n          conflict: >\n            الترشيح في معجم المياه = filtration (تصفية من عالقات)، وليس leaching (إذابة ذوائب).\n            التداخل الوحيد المذكور — «وبعض المواد الذائبة» — يخصّ الترشيح الدقيق جداً\n            (nanofiltration) لا عملية الغسل الجيولوجية.\n        - text: \"«ترشيح: تسرب الماء إلى التربة. — translation_en: percolation»\"\n          source: \"المعجم الموحد لمصطلحات الهندسة المدنية (2012) — ARABTERM\"\n          conflict: >\n            حتى في الدلالة الهيدرولوجية «ترشيح = percolation» (تسرّب الماء بلا إذابة)، وليس\n            leaching. Percolation وLeaching عمليتان مترافقتان لكن ليستا متطابقتين.\n\n    - lemma: \"غَسْل التُّرْبَة\"\n      confirm:\n        - text: \"«غسل التربة: 1- نزع الأملاح في الطبقة العليا للتربة باستخدام مياه قليلة الملوحة\n                 نسبياً. 2- نزع الملوثات الموجودة في مياه مستعملة مخزنة. — translation_en: leaching»\"\n          source: \"المعجم الموحد لمصطلحات المياه (2000) — ARABTERM\"\n        - text: \"«غسل التربة — translation_en: leaching»\"\n          source: \"مسرد الجغرافيا والتاريخ — ARABTERM\"\n        - text: \"«غَسْل: عملية غسل المواد القابلة للانحلال من التربة أو من المعادن الخام أو من\n                 الفضلات المردومة ووصولها إلى مصدر مائي. نضٌّ (المرادف العربي) — translation_en: leaching»\"\n          source: \"المعجم الموحد لمصطلحات الهندسة المدنية (2012) — ARABTERM\"\n        - text: \"«الغسل هو العملية التي من خلالها يتم غسل المواد القابلة للذوبان في التربة، مثل\n                 الأملاح والمواد الغذائية، والمبيدات الكيميائية أو الملوثات، ونقلها إلى طبقة سفلى\n                 من التربة أو حملها إلى المياه الجوفية التي قد تنقلها بعيداً. — translation_en: leaching»\"\n          source: \"مسرد المناخ والبيئة وإدارة النفايات الصلبة — ARABTERM\"\n      expands:\n        - text: \"«ارتشاح، غَسْل (شطف): إزالة المواد الذائبة من طبقة صلبة بواسطة ارتشاح المذيب\n                 من خلالها. — translation_en: leaching»\"\n          source: \"المعجم الموحد لمصطلحات تقانات الأغذية (2004) — ARABTERM\"\n          addition: >\n            يُظهر أن «الارتشاح» يُعدّ مرادفاً جزئياً في سياق تقانات الأغذية، مما يثبت أن\n            «غسل» هو المكوّن الجوهري في مصطلح leaching العربي.\n\n    - lemma: \"النَّضْح\"\n      contradicts:\n        - text: \"«نضح: يدل النضح (أو التناضح) في العلوم الطبيعية، على تدفق في اتجاه محدد لجسيمات\n                 جزيئية من خلال طبقة فصل انتقائية أو شبه منفذة. في كثير من الأحيان يوصف النضح\n                 بأنه مرور عفوي للماء أو مذيب آخر عبر غشاء شبه منفذ، الذي هو منفذ للمذيب،\n                 ولكن ليس منفذاً للمواد الذائبة. — translation_en: osmosis»\"\n          source: \"المعجم الموحد لمصطلحات الطاقة المتجددة (1996) — ARABTERM\"\n          conflict: >\n            «نضح» رُسّخ في المصطلح العلمي العربي للدلالة على osmosis (التناضح الأسموزي)،\n            وهو عملية مختلفة تماماً عن leaching؛ استخدامه هنا سيحدث خلطاً مع مصطلح\n            ثابت راسخ.\n        - text: \"«نَضْح — translation_en: exudation»\"\n          source: \"المعجم الطبي الموحد (2009) — ARABTERM\"\n          conflict: \"النضح = exudation (إفراز) في الطب، بعيد عن leaching.\"\n      expands:\n        - text: \"«النَّضْح: الرَّشُّ. نَضَحَ البيتَ يَنْضِحُهُ وَنَضَحَ جِلدُهُ بالعَرَقِ.\n                 وَالسَّانِيَةُ نَاضِحٌ.»\"\n          source: \"مقاييس اللغة لابن فارس\"\n          addition: >\n            الجذر (ن-ض-ح) يدل على الرَّشّ وبلّ الشيء بالماء؛ يمتلك صلة دلالية بمفهوم الغسل\n            لكنه مرتبط في التراث بالرَّشّ الخفيف لا بالإذابة والنقل كما في leaching.\n\n    - lemma: \"الإِرْشَاح\"\n      evidence_status: \"no_material_found\"\n\n    - lemma: \"التَّرَشُّح\"\n      expands:\n        - text: \"«رشح غسلي — translation_en: leaching»\"\n          source: \"المعجم الموحد لمصطلحات الطاقة المتجددة (1996) — ARABTERM\"\n          addition: >\n            يُظهر أن المصطلح المعجمي الراسخ هو «رشح غسلي» (مركب وصفي) لا «الترشّح»\n            المجرّد؛ و«الترشّح» وحده لا يحمل دلالة leaching دون القيد الوصفي «غسلي».\n        - text: \"«(1) ترشيح؛ تخليل؛ تسريب / (2) ارتشاح؛ تخلُّل؛ تسرُّب / (3) الراشح؛ الرَّشيح\n                 — translation_en: infiltration»\"\n          source: \"المورد الحديث (2008) — ARABTERM\"\n          addition: >\n            الارتشاح والترشّح يُرادفان «infiltration» (التسرب) لا leaching تحديداً؛\n            الدلالة مجاورة لكن غير مطابقة.\n\n    - lemma: \"الاسْتِنْضَاح\"\n      evidence_status: \"no_material_found\"\n\n\n# ── المرحلة ٣: التحليل اللغوي للّمات ─────────────────────────\nstage3_analysis:\n  per_lemma:\n\n    - lemma: \"تَرْشِيح\"\n      decision: removed\n      decision_reason: >\n        «ترشيح» مصطلح محكم في المصطلحية العربية بمعنى filtration (فصل المعلّقات الصلبة بمرشّح)،\n        وهو مختلف جوهرياً عن leaching (إذابة المواد الذائبة ونقلها). جميع المعاجم الموثوقة\n        (المعجم الوسيط، المعجم الكبير، معجم المياه، معجم الكيمياء، معجم الطاقة المتجددة...)\n        تُرجمه بـ filtration أو percolation لا بـ leaching. إبقاؤه في هذه المجموعة خلط\n        مصطلحي بين عمليتين مختلفتين في الآلية والمواد المُعالَجة.\n      evidence_assessment:\n        case: contradicts_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: remove_sense\n          params:\n            sense_id: \"{auto}\"\n\n    - lemma: \"غَسْل التُّرْبَة\"\n      decision: confirmed\n      decision_reason: >\n        المصطلح المُثبَت في المصطلحية التقنية العربية لـleaching؛ موثَّق في معجم المياه (2000)\n        ومسرد الجغرافيا ومسرد المناخ والبيئة ومعجم الهندسة المدنية. التعريفات تُطابق المفهوم\n        العلمي بدقة. الجذران (غسل) و(ترب) عربيان أصيلان. المركب الإضافي ثابت ومسكوك\n        في عدة مصادر.\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: true\n        mwe_type: idafi\n      nuance_differentiation: >\n        الوحيدة المؤكَّدة في المجموعة بعد حذف «ترشيح»؛ تختص بالسياق الجيولوجي/البيئي\n        (التربة كوسط)، بينما «غَسْل» المجرّد أعمّ وأوسع استخداماً (يشمل الصناعة والطب).\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"غَسْل التُّرْبَة\"\n\n  synset_actions:\n    - command: update_definition\n      params:\n        synset_id: \"awn4-13527790-n\"\n        definition_index: 0\n        text: >\n          عَمَلِيَّة طَبِيعِيَّة يَتَخَلَّلُ فِيهَا الماءُ التُّرْبَةَ أو الصَّخْرَ مُذِيبًا\n          المَوَادَّ القَابِلَةَ لِلذَّوَبانِ — كَالأَمْلاحِ والمُغَذِّيَاتِ والمُلوِّثَاتِ —\n          وحَامِلًا إِيَّاهَا إِلَى طَبَقَاتٍ أَعْمَق أو إِلَى المِيَاهِ الجَوْفِيَّة\n\n\n# ── المرحلة ٤: التعريف والأمثلة ───────────────────────────────\nstage4_content:\n  definition:\n    current: \"عملية الترشيح أو الغسل لإزالة المواد القابلة للذوبان\"\n    assessment:\n      decision: revise\n      reason: >\n        التعريف الحالي يستخدم «الترشيح» بمعنى leaching مما يكرّس الخلط مع filtration؛\n        كذلك لا يُحدّد السياق (التربة/الصخر)، ولا الآلية (تسرّب الماء وإذابة المواد ونقلها)،\n        ولا الوجهة (الطبقات الأعمق والمياه الجوفية).\n    authored:\n      - type: terminological\n        text: >\n          عَمَلِيَّة طَبِيعِيَّة يَتَخَلَّلُ فِيهَا الماءُ التُّرْبَةَ أو الصَّخْرَ مُذِيبًا\n          المَوَادَّ القَابِلَةَ لِلذَّوَبانِ — كَالأَمْلاحِ والمُغَذِّيَاتِ والمُلوِّثَاتِ —\n          وحَامِلًا إِيَّاهَا إِلَى طَبَقَاتٍ أَعْمَق أو إِلَى المِيَاهِ الجَوْفِيَّة\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: >\n          غَسِيلُ التُّرْبَة: ظَاهِرَة بِيئِيَّة تحدث حِين تَتَسَرَّب مِياهُ الأمطار أو\n          الرَّي عَبْرَ الطَّبَقَاتِ السَّطْحِيَّة للتُّرْبَة، فَتَحمِلُ مَعَهَا المَوَادَّ\n          الذَّائِبَةَ كَالأَمْلَاح والنِّتْرَاتِ والمُبِيدَاتِ إِلَى الطَّبَقَاتِ الأَعْمَق؛\n          مِمَّا يُفقِر التُّرْبَة الزِّرَاعِيَّةَ وقد يُلوِّث المِيَاهَ الجَوْفِيَّة\n    actions:\n      - command: update_definition\n        params:\n          synset_id: \"awn4-13527790-n\"\n          definition_index: 0\n          text: >\n            عَمَلِيَّة طَبِيعِيَّة يَتَخَلَّلُ فِيهَا الماءُ التُّرْبَةَ أو الصَّخْرَ مُذِيبًا\n            المَوَادَّ القَابِلَةَ لِلذَّوَبانِ — كَالأَمْلاحِ والمُغَذِّيَاتِ والمُلوِّثَاتِ —\n            وحَامِلًا إِيَّاهَا إِلَى طَبَقَاتٍ أَعْمَق أو إِلَى المِيَاهِ الجَوْفِيَّة\n      - command: add_definition\n        params:\n          synset_id: \"awn4-13527790-n\"\n          text: >\n            غَسِيلُ التُّرْبَة: ظَاهِرَة بِيئِيَّة تحدث حِين تَتَسَرَّب مِياهُ الأمطار أو\n            الرَّي عَبْرَ الطَّبَقَاتِ السَّطْحِيَّة للتُّرْبَة، فَتَحمِلُ مَعَهَا المَوَادَّ\n            الذَّائِبَةَ كَالأَمْلَاح والنِّتْرَاتِ والمُبِيدَاتِ إِلَى الطَّبَقَاتِ الأَعْمَق؛\n            مِمَّا يُفقِر التُّرْبَة الزِّرَاعِيَّةَ وقد يُلوِّث المِيَاهَ الجَوْفِيَّة\n\n  examples:\n    per_lemma:\n      - lemma: \"غَسْل التُّرْبَة\"\n        examples:\n          - text: >\n              أدَّى غَسْلُ التُّرْبَة المتواصل إلى فُقدانِ جزءٍ كبيرٍ من النِّتْرَاتِ\n              والبُوتَاسْيُوم في الحُقُولِ المروِيَّة، مما أوجَبَ الإضافةَ المتكرِّرةَ للأسمدة.\n            type: usage\n    actions:\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: >\n            أدَّى غَسْلُ التُّرْبَة المتواصل إلى فُقدانِ جزءٍ كبيرٍ من النِّتْرَاتِ\n            والبُوتَاسْيُوم في الحُقُولِ المروِيَّة، مما أوجَبَ الإضافةَ المتكرِّرةَ للأسمدة.\n\n\n# ── المرحلة ٥: الإثراء (البيانات الوصفية) ──────────────────────\nstage5_enrichment:\n  per_entry:\n    - lemma: \"غَسْل التُّرْبَة\"\n      entry_id: \"{auto}\"\n      roots:\n        - word: \"غَسْل\"\n          root: \"غسل\"\n          maqayis_quote: >\n            «الْغَيْنُ وَالسِّينُ وَاللَّامُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى تَطْهِيرِ الشَّيْءِ\n            وَتَنْقِيَتِهِ. يُقَالُ: غَسَلْتُ الشَّيْءَ غَسْلًا. وَالْغُسْلُ الِاسْمُ.»\n        - word: \"التُّرْبَة\"\n          root: \"ترب\"\n          maqayis_quote: >\n            «التَّاءُ وَالرَّاءُ وَالْبَاءُ أَصْلَانِ: أَحَدُهُمَا التُّرَابُ وَمَا يُشْتَقُّ\n            مِنْهُ، وَالْآخَرُ تَسَاوِي الشَّيْئَيْنِ. فَالْأَوَّلُ التُّرَابُ، وَهُوَ\n            التَّيْرَبُ وَالتَّوْرَابُ.»\n\n  per_sense:\n    - lemma: \"غَسْل التُّرْبَة\"\n      sense_id: \"{auto}\"\n      nuance: >\n        المصطلح المركّب يُقيّد «الغسل» بالوسط الجيولوجي (التربة)، مميِّزاً العملية الطبيعية\n        من الغسل الاصطناعي أو الكيميائي. يختص بالسياقين الزراعي والبيئي حيث تفقد التربة\n        مكوّناتها الذائبة بفعل مياه الأمطار أو الرَّي، خلافاً لـ«الارتشاح» الذي يعني تسرّب\n        الماء دون التركيز على الإذابة والنقل.\n      mwe: true\n\n  synset:\n    cultural_fit: native\n\n  actions:\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: >-\n          {\"roots\":[{\"word\":\"غسل\",\"root\":\"غسل\",\"maqayis\":\"«الغين والسين واللام أصل صحيح يدل على تطهير الشيء وتنقيته»\"},{\"word\":\"التربة\",\"root\":\"ترب\",\"maqayis\":\"«التاء والراء والباء أصلان: أحدهما التراب وما يشتق منه»\"}]}\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n        key: note\n        value: >-\n          {\"nuance\":\"يختص بالسياق الجيولوجي والزراعي: غسل التربة من مكوناتها الذائبة بفعل مياه التسرب، بخلاف الارتشاح الذي يعني تسرب الماء دون التركيز على الإذابة