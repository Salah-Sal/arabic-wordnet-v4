,\"source_type\":\"ocr\",\"period\":\"modern\",\"author\":\"مجمع اللغة العربية\",\"death_year\":null},\n{\"entry_id\":67768,\"dictionary_id\":2,\"headword\":\"التَّرْبَةُ\",\"headword_bare\":\"التربة\",\"headword_norm\":\"التربة\",\"root\":\"ترب\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"definitions_text\":\"نبت سُهلي مفرّض الورق: أي محززه, وهي الترباء\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\",\"period\":\"modern\",\"author\":\"مجمع اللغة العربية\",\"death_year\":null},\n{\"entry_id\":67767,\"dictionary_id\":2,\"headword\":\"التُّرْبَةُ\",\"headword_bare\":\"التربة\",\"headword_norm\":\"التربة\",\"root\":\"ترب\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"definitions_text\":\"التراب الأرض طبيعة الأرض, يقال: أرض طيبة التربة تُربة الأرض: ظاهر ترابها, وهو الجزء السطحي الذي يتناوله المحراث تُربة الإنسان: رمسه, وهي المقبرة\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\",\"period\":\"modern\",\"author\":\"مجمع اللغة العربية\",\"death_year\":null},\n{\"entry_id\":67765,\"dictionary_id\":2,\"headword\":\"التِّرْبَةُ\",\"headword_bare\":\"التربة\",\"headword_norm\":\"التربة\",\"root\":\"ترب\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"definitions_text\":\"ضعف الفؤاد وقلة الفطنة\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\",\"period\":\"modern\",\"author\":\"مجمع اللغة العربية\",\"death_year\":null},\n{\"entry_id\":813252,\"dictionary_id\":117,\"headword\":\"الترشيح\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الترشيح: أن يذكر شيئا ملائما لمشبه به.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_22\",\"dict_name_ar\":\"التوقيف على مهمات التعاريف للمناوي\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":1622},\n{\"entry_id\":957773,\"dictionary_id\":147,\"headword\":\"الترشيح\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الترشيح\\nفي النحو.\\nلسليمان بن محمد بن الطراوة المالقي.\\nالمتوفى: سنة 528، ثمان وعشرين وخمسمائة.\\nوهو مختصر من: (المقدمات على كتاب سيبويه).\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_50\",\"dict_name_ar\":\"كشف الظنون عن أسامي الكتب والفنون لحاجي خليفة\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":1657},\n{\"entry_id\":957774,\"dictionary_id\":147,\"headword\":\"الترشيح\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الترشيح\\nللإمام، تاج الدين: عبد الوهاب بن علي السبكي، الشافعي.\\nالمتوفى: سنة 771، إحدى وسبعين وسبعمائة.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_50\",\"dict_name_ar\":\"كشف الظنون عن أسامي الكتب والفنون لحاجي خليفة\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":1657},\n{\"entry_id\":819164,\"dictionary_id\":119,\"headword\":\"التّرشيح\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"التّرشيح:[في الانكليزية] Metaphor ،metonymy ،simile [ في الفرنسية] Metophore ،metonymie ،comparaison عند أهل البيان من أهل الفرس يطلق على قسم من الاستعارة كما مرّ. ومن أهل العرب يطلق على معان منها ترشيح التشبيه وهو ذكر ما يلائم المشبّه به كذكر الإنشاب في قولهم أظفار المنية الشبيهة بالسبع أنشبت فلانا. والتخييل وهو إثبات ما يلازم المشبّه به للمشبه كإثبات الأظفار اللازمة للسبع للمنية المشبّه. ومنها ترشيح المجاز اللغوي وهو ذكر ما يلائم المعنى الحقيقي نحو أطولكنّ في قوله عليه السلام (أسرعكن لحوقا بي أطولكن يدا) فإنّه ترشيح للمجاز أعني اليد المستعملة في النعمة. ومنها ترشيح المجاز العقلي وهو ذكر ما يلائم ما هو له نحو:وإذا المنية أنشبت أظفارها لأصبت كلّ تميمة لا تنفع فإنّ ذكر الإنشاب ترشيح لإثبات الأظفار للمنية على مذهب صاحب التلخيص. ومنها ترشيح الاستعارة المصرّحة وهو ذكر ما يلائم المستعار منه ويجب اقترانه بلفظ المشبّه به، وذكر بيانه في ذكر الاستعارة المرشّحة، وكذا ترشيح الاستعارة بالكناية إذ هو أيضا ذكر ما يلائم المستعار منه. فالإنشاب في قولهم إذا المنية أنشبت أظفارها ترشيح للاستعارة بالكناية.فإن قلت كما أنّ الأظفار من لوازم المشبّه به وهو السبع فكذا الإنشاب، فما وجه جعل إثبات الأول تخييلا وإثبات الثاني ترشيحا؟ قلت إذا اجتمع لازمان للمشبّه به في الكلام فأيهما أقوى اختصاصا وتعلّقا به فإثباته تخييل، وأيهما دونه فإثباته ترشيح. ولا شك أنّ الأظفار أقوى اختصاصا وتعلّقا بالسبع من الإنشاب فيكون إثباته تخييلا وإثبات الإنشاب ترشيحا، هكذا يستفاد مما ذكر أبو القاسم في حاشية المطول في فصل تحقيق الاستعارة بالكناية.والحقّ في الجواب أنّ الإنشاب ليس لازما للسبع لأنّ لازم الشيء ما يمتنع انفكاكه عنه، والإنشاب يجوز انفكاكه عن السبع لأن الإنشاب فعل من أفعال السبع يمكن أن يفارق عن بعض أفراده وإن كان لازما عادة بالنظر إلى جنس السبع، بخلاف الأظفار كما لا يخفى.ويؤيد هذا ما ذكر الچلپي في حاشية المطول في خطبة التلخيص في قوله وبه يكشف عن وجوه الإعجاز في نظم القرآن أستارها وهو أنّ الترشيح أن يذكر شيء يلائم المشبّه به إن كان في الكلام تشبيه أو المستعار منه إن كان فيه استعارة أو المعنى الحقيقي إن كان مجازا مرسلا كما في قوله عليه السلام أسرعكن لحوقا بي أطولكن يدا، فإنّ أطولكن ترشيح لليد وهي مجاز عن النعمة. والظاهر من شرح الشريف للمفتاح أنّ الترشيح إنما يكون للمجاز اللغوي لا العقلي انتهى. وفي بعض الرسائل المستعار منه عند السّكّاكي في الاستعارة بالكناية هو المشبّه الذي يعبّر عنه غير السكّاكي بالمستعار له انتهى. وأمّا عند غيره فالمستعار منه في الاستعارة بالكناية هو المشبّه به. والمفهوم من الأطول أنّ الترشيح في الاستعارة بالكناية هو ذكر ما يلائم المستعار له حيث قال ما يقارن بما يلائم المستعار له في الاستعارة بالكناية ترشيح أيضا. ومنها ترشيح الإيهام.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_24\",\"dict_name_ar\":\"كشّاف اصطلاحات الفنون والعلوم للتهانوي\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":1777},\n{\"entry_id\":869422,\"dictionary_id\":131,\"headword\":\"الترشيح\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"(الترشيح) للاستعارة (عِنْد البيانيين) ذكر مَا يلائم الْمُشبه بِهِ تَقْوِيَة لَهَا وتنقية المَاء وَنَحْوه من الْموَاد العالقة بِهِ (مج) و (عِنْد الكيماويين) فصل الْأَجْسَام الصلبة العالقة فِي سَائل باستخدام مَادَّة مسامية تسمح للسَّائِل بالنفاذ خلاله محتجزة الْأَجْسَام العالقة وورقة الترشيح ورقة مسامية غير مصقولة تستخدم للترشيح (مج)\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_35\",\"dict_name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\",\"period\":\"modern\",\"author\":null,\"death_year\":1998},\n{\"entry_id\":816173,\"dictionary_id\":118,\"headword\":\"الترشيح\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الترشيح: فِي الِاسْتِعَارَة المرشحة.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_23\",\"dict_name_ar\":\"دستور العلماء للأحمدنكري\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":null},\n{\"entry_id\":10697,\"dictionary_id\":1,\"headword\":\"التَّرْشِيحُ\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"definitions_text\":\"عند البيانيين: ذكر ما يلائم المُشَبَّهَ به تقوية لها تنقيةُ الماء ونحوه من المواد العالقة به عند الكيمياويين: فصل الأجسام الصُّلْبة العالقة فى سائل باستخدام مادة مساميّة تسمح للسائل بالنفاذ خلاله مُحْتَجِزَةً الأجسام العالقة\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\",\"period\":\"modern\",\"author\":\"مجمع اللغة العربية\",\"death_year\":null},\n{\"entry_id\":93663,\"dictionary_id\":2,\"headword\":\"التَّرْشِيحُ\",\"headword_bare\":\"الترشيح\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"definitions_text\":\"(عند البلاغيين): يطلق باصطلاحين: الأول: أن تقترن الاستعارة بما يلائم المستعار منه (المشبه به) والثاني: أن يريد المتكلِّمُ ضَربًا من ضروب البديع, فلا يتأتَّى له الإتيانُ به مُجَرَّدًا حتى يأتيَ بشيءٍ في الكلام (في الكيمياء) filtration: فَصْلُ الأجسام الصُّلْبَةِ العالِقَةِ في سائلٍ باستخدام مادَّةٍ مَسَامِيَّةٍ تسمحُ للسائل بالنَّفَاذ خلالها مُحْتَجِزَةً الأجسام العالِقَةَ وورقة التَّرْشِيح: ورقةٌ مسامِّيَّة غير مَصْقُولَة تُسْتَخْدَمُ للتَّرْشيح\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\",\"period\":\"modern\",\"author\":\"مجمع اللغة العربية\",\"death_year\":null},\n{\"entry_id\":814544,\"dictionary_id\":117,\"headword\":\"الغسل\",\"headword_bare\":\"الغسل\",\"headword_norm\":\"الغسل\",\"root\":\"غسل\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الغسل: لغة: إفاضة الماء على الشيء. وشرعا: تعميم البدن بالماء بنية معتبرة.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_22\",\"dict_name_ar\":\"التوقيف على مهمات التعاريف للمناوي\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":1622},\n{\"entry_id\":820297,\"dictionary_id\":119,\"headword\":\"الغسل\",\"headword_bare\":\"الغسل\",\"headword_norm\":\"الغسل\",\"root\":\"غسل\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الغسل:[في الانكليزية] Washing ،ablutions [ في الفرنسية] Lavage ،ablutions بالضم وسكون السين لغة سيلان الماء مطلقا ثم نقل شرعا لسيلان الماء على جميع البدن كذا في شرح المنهاج.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_24\",\"dict_name_ar\":\"كشّاف اصطلاحات الفنون والعلوم للتهانوي\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":1777},\n{\"entry_id\":835313,\"dictionary_id\":122,\"headword\":\"الغُسل\",\"headword_bare\":\"الغسل\",\"headword_norm\":\"الغسل\",\"root\":\"غسل\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الغُسل: بالضم اسم من الاغتسال هو غَسلُ تمام الجسد، وبالفتح: مصدر وهو إسالة الماء مع التقاطر قال في \\\"المُغرب\\\": غَسلُ الشيء إزالةُ الوسخ ونحوه بإجراء الماء عليه أي بالدلك، والتغسيلُ يومَ الجمعة هو حمل امرأته على الغسل: بأن وطئها حتى أجنبت ثم اغتسلت، والغِسل بالكسر ما يغسل به الرأس من خِطْمي ونحوه.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_27\",\"dict_name_ar\":\"التعريفات الفقهيّة للبركتي\",\"source_type\":\"hawramani\",\"period\":\"modern\",\"author\":null,\"death_year\":1975},\n{\"entry_id\":878703,\"dictionary_id\":131,\"headword\":\"الْغسْل\",\"headword_bare\":\"الغسل\",\"headword_norm\":\"الغسل\",\"root\":\"غسل\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"(الْغسْل) تَمام غسل الْجَسَد كُله والغسول (ج) أغسال\\n(الْغسْل) الغسول\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_35\",\"dict_name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\",\"period\":\"modern\",\"author\":null,\"death_year\":1998},\n{\"entry_id\":817182,\"dictionary_id\":118,\"headword\":\"الْغسْل\",\"headword_bare\":\"الغسل\",\"headword_norm\":\"الغسل\",\"root\":\"غسل\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"الْغسْل: هُوَ الإسالة مَعَ التقاطر.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_23\",\"dict_name_ar\":\"دستور العلماء للأحمدنكري\",\"source_type\":\"hawramani\",\"period\":\"classical\",\"author\":null,\"death_year\":null},\n{\"entry_id\":20561,\"dictionary_id\":1,\"headword\"