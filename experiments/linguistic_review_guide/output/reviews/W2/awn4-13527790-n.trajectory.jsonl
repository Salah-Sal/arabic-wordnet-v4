54155,\"dictionary_id\":75,\"headword\":\"تربة\",\"headword_bare\":\"تربة\",\"headword_norm\":\"تربة\",\"root\":\"ترب\",\"root_source\":\"lane\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"glebe\",\"translation_fr\":\"glèbe; terre\",\"domain\":\"Biology\",\"dict_key\":\"arabterm_arabterm_biology\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\",\"source_type\":\"arabterm\",\"period\":\"modern\",\"author\":null,\"death_year\":null},\n{\"entry_id\":459355,\"dictionary_id\":76,\"headword\":\"تربة\",\"headword_bare\":\"تربة\",\"headword_norm\":\"تربة\",\"root\":\"ترب\",\"root_source\":\"lane\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"soil\",\"translation_fr\":\"sol\",\"domain\":\"Hygienics and Human Body\",\"dict_key\":\"arabterm_arabterm_hygienics_human_body\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علم الصحة وجسم الانسان (1992)\",\"source_type\":\"arabterm\",\"period\":\"modern\",\"author\":null,\"death_year\":null},\n{\"entry_id\":480136,\"dictionary_id\":83,\"headword\":\"تربة\",\"headword_bare\":\"تربة\",\"headword_norm\":\"تربة\",\"root\":\"ترب\",\"root_source\":\"lane\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"soil\",\"translation_fr\":\"sol\",\"domain\":\"Masonry - Carpentry\",\"dict_key\":\"arabterm_arabterm_masonry_carpentry\",\"dict_name_ar\":\"المعجم الموحد للمصطلحات المهنية والتقنية ج. 2: بناء - تجارة (1999)\",\"source_type\":\"arabterm\",\"period\":\"modern\",\"author\":null,\"death_year\":null},\n{\"entry_id\":501289,\"dictionary_id\":90,\"headword\":\"تربة\",\"headword_bare\":\"تربة\",\"headword_norm\":\"تربة\",\"root\":\"ترب\",\"root_source\":\"lane\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"soil\",\"translation_fr\":\"sol\",\"domain\":\"Geography and History\",\"dict_key\":\"arabterm_arabterm_geography_history\",\"dict_name_ar\":\"مسرد الجغرافيا والتاريخ، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\",\"period\":\"modern\",\"author\":null,\"death_year\":null},\n{\"entry_id\":762806,\"dictionary_id\":101,\"headword\":\"تربة\",\"headword_bare\":\"تربة\",\"headword_norm\":\"تربة\",\"root\":\"ترب\",\"root_source\":\"lane\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"soil\",\"translation_fr\":\"sol\",\"domain\":\"AGROVOC\",\"dict_key\":\"arabterm_agrovoc\",\"dict_name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"source_type\":\"arabterm\",\"period\":\"modern\",\"author\":null,\"death_year\":null},\n{\"entry_id\":971196,\"dictionary_id\":149,\"headword\":\"تُرَبَة\",\"headword_bare\":\"تربة\",\"headword_norm\":\"تربة\",\"root\":\"ترب\",\"root_source\":\"camel\",\"pos\":null,\"definitions_text\":\"تُرَبَة:\\nبالضم ثم الفتح قال عرّام: تربة واد بالقرب من مكة على مسافة يومين منها، يصبّ في ببستان ابن عامر، يسكنه بنو هلال، وحواليه من الجبال السراة ويسوم وفرقد، ومعدن البرم له ذكر في خبر عمر، رضي الله عنه، أنفذه رسول الله، صلى الله عليه وسلم، غازيا حتى بلغ تربة وقال الأصمعي: تربة واد للضباب طوله ثلاث ليال، فيه النخل والزرع والفواكه، ويشاركهم فيه هلال وعامر ابن ربيعة قال أحمد بن محمد الهمذاني: تربة وزبية وبيشة هذه الثلاثة أودية ضخام، مسيرة كل واحد منها عشرون يوما، أسافلها في نجد وأعاليها في السراة وقال هشام: تربة واد يأخذ من السراة ويفرغ في نجران، قال: ونزلت خثعم ما بين بيشة وتربة وما صاقب تلك البلاد إلى أن ظهر الإسلام، وفي المثل: عرف بطني بطن تربة قاله عامر بن مالك بن جعفر بن كلاب أبو براء ملاعب الأسنّة في قصة فيها طول، غاب عن قومه فلما عاد إلى تربة وهي أرضه التي ولد بها ألصق بطنه بأرضها فوجد راحة فقال ذلك. وخبّرني رجل من ساكني الجبلين أن تربة ماء في غربي سلمى.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_52\",\"dict_nam","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/home/node/.claude/projects/-workspace/8fdbe189-a1b9-41d7-94bd-6d9906d33399/tool-results/b9494y9fn.txt","persistedOutputSize":60000}}
