{"type":"tool_use","timestamp":"2026-03-17T15:55:37.080Z","tool_name":"write_file","tool_id":"write_file_1773762937080_0","parameters":{"file_path":"/output/awn4-13527790-n.review.yaml","content":"stage1_review:\n  assessment:\n    concerns:\n      - \"التعريف الحالي دقيق ولكنه يجمع بين الترشيح والغسل في الصياغة، والأفضل صياغته بأسلوب علمي شامل لا يعتمد على اللمات ذاتها.\"\n      - \"لمة 'غسل التربة' مخصصة جداً لمجال الزراعة أو البيئة (soil washing)، بينما المفهوم العام للاستخلاص (leaching) أوسع من ذلك بكثير.\"\n    observations: \"المفهوم يشير إلى عملية استخلاص المواد القابلة للذوبان من الأجسام الصلبة بواسطة سائل مذيب، وهو ما يُعرف في الكيمياء بالاستخلاص أو الغسل، وفي الجيولوجيا والبيئة بالارتشاح أو الغسل.\"\n  blind_candidates:\n    - lemma: \"نَضْح\"\n      generation_method: ishtiqaq\n      justification: \"من الجذر (ن ض ح) الدال على الرش وتخلل السوائل.\"\n    - lemma: \"اِسْتِخْلَاص\"\n      generation_method: ishtiqaq\n      justification: \"يستخدم في الكيمياء للدلالة على استخلاص المواد من الشوائب بالسوائل.\"\n    - lemma: \"غَسْل\"\n      generation_method: ishtiqaq\n      justification: \"من (غ س ل) الدال على التنقية، ويستعمل علمياً بمعنى إزالة المواد الذائبة.\"\n    - lemma: \"رَشْح\"\n      generation_method: ishtiqaq\n      justification: \"يدل على تخلل السوائل عبر الأوساط المسامية.\"\n\nstage2_evidence:\n  per_lemma:\n    - lemma: \"ترشيح\"\n      confirm:\n        - text: \"عند الكيمياويين: فصل الأجسام الصُّلْبة العالقة فى سائل باستخدام مادة مساميّة تسمح للسائل بالنفاذ خلاله مُحْتَجِزَةً الأجسام العالقة\"\n          source: \"المعجم الوسيط\"\n        - text: \"تحليل الإشارة إلى مركباتها التوافقية أو عزل التشويش عن مركّبة زمنية\"\n          source: \"المعجم الموحد لمصطلحات الاستشعار عن بعد\"\n    - lemma: \"غسل التربة\"\n      confirm:\n        - text: \"الغسل هو العملية التي من خلالها يتم غسل المواد القابلة للذوبان في التربة، مثل الأملاح والمواد الغذائية... ونقلها إلى طبقة سفلى\"\n          source: \"مسرد المناخ والبيئة ArabTerm\"\n    - lemma: \"نضح\"\n      expands:\n        - text: \"يدل النضح (أو التناضح) في العلوم الطبيعية، على تدفق في اتجاه محدد لجسيمات جزيئية من خلال طبقة فصل انتقائية أو شبه منفذة.\"\n          source: \"المعجم الموحد لمصطلحات الطاقة المتجددة\"\n          addition: \"يدل على التناضح الأسموزي والإفراز أكثر من عملية الغسل أو الاستخلاص.\"\n    - lemma: \"استخلاص\"\n      confirm:\n        - text: \"مُعالجةُ الشىءِ بِمذيبٍ لِفَصْلِ ما به من موادّ قابلةٍ للذوبان فيه\"\n          source: \"المعجم الكبير\"\n    - lemma: \"غسل\"\n      confirm:\n        - text: \"عملية غسل المواد القابلة للانحلال من التربة أو من المعادن الخام أو من الفضلات المردومة ووصولها إلى مصدر مائي\"\n          source: \"المعجم الموحد لمصطلحات الهندسة المدنية\"\n        - text: \"عملية فصل مادة قابلة للذوبان من مادة غير قابلة للذوبان بواسطة مُذيب مثل الماء\"\n          source: \"المعجم الموحد لمصطلحات المياه\"\n    - lemma: \"رشح\"\n      confirm:\n        - text: \"جريان الماء خلال سطح التربة إلى ما تحت السطح أو جوف الأرض\"\n          source: \"المعجم الموحد لمصطلحات الهندسة المدنية\"\n\nstage3_analysis:\n  per_lemma:\n    - lemma: \"ترشيح\"\n      decision: confirmed\n      decision_reason: \"مصطلح علمي مستقر للدلالة على فصل المواد باستخدام وسط مسامي.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"تَرْشِيح\"\n    - lemma: \"غسل التربة\"\n      decision: confirmed\n      decision_reason: \"مصطلح مركب ثابت في المجالات الزراعية والبيئية.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: true\n        mwe_type: idafi\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"غَسْلُ التُّرْبَةِ\"\n    - lemma: \"نَضْح\"\n      source: stage1\n      decision: removed\n      decision_reason: \"المعنى يميل أكثر إلى التناضح (osmosis) أو الإفراز ال