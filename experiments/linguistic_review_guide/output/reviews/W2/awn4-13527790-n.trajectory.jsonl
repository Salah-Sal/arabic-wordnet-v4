main\":\"Data and AI Glossary\",\"dict_name_ar\":\"معجم البيانات والذكاء الاصطناعي (2024)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":10697,\"headword\":\"التَّرْشِيحُ\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"pos\":\"noun\",\"def_short\":\"عند البيانيين: ذكر ما يلائم المُشَبَّهَ به تقوية لها تنقيةُ الماء ونحوه من المواد العالقة به عند الكيمياويين: فصل الأجسام الصُّلْبة العالقة فى سائل باستخدام مادة مساميّة تسمح للسائل بالنفاذ خلاله مُحْتَجِزَةً الأجسام العالقة\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\",\"period\":\"modern\"},\n{\"entry_id\":93663,\"headword\":\"التَّرْشِيحُ\",\"headword_norm\":\"الترشيح\",\"root\":\"رشح\",\"pos\":\"noun\",\"def_short\":\"(عند البلاغيين): يطلق باصطلاحين: الأول: أن تقترن الاستعارة بما يلائم المستعار منه (المشبه به) والثاني: أن يريد المتكلِّمُ ضَربًا من ضروب البديع, فلا يتأتَّى له الإتيانُ به مُجَرَّدًا حتى يأتيَ بشيءٍ في الكلام (في الكيمياء) filtration: فَصْلُ الأجسام الصُّلْبَةِ العالِقَةِ في سائلٍ باستخدام مادَّةٍ م\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\",\"period\":\"modern\"}]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_015nb7xK6Q8c3kDph3tPrjJZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y6CV6t8bupGyCEN2rUPvnF","name":"Bash","input":{"command":"sqlite3 -json \"/data/arabic_dict.db\" \"\nSELECT e.id AS entry_id, e.headword, e.headword_norm, e.root, e.pos,\n       substr(e.definitions_text,1,400) AS def_short, e.translation_en, e.domain,\n       d.name_ar AS dict_name_ar, d.source_type, d.period\nFROM entries e\nJOIN dictionaries d ON e.dictionary_id = d.id\nWHERE e.headword_norm IN ('نضح','النضح','نض','النض')\nORDER BY d.source_type, d.period, d.death_year ASC NULLS LAST\nLIMIT 30;\n\" 2>/dev/null","description":"نضح/نض entries lookup"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":922,"cache_read_input_tokens":44588,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":922},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"8fdbe189-a1b9-41d7-94bd-6d9906d33399","uuid":"ed303b5f-b499-4c50-a066-876b9db5fd4f"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y6CV6t8bupGyCEN2rUPvnF","type":"tool_result","content":"[{\"entry_id\":757523,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نض\",\"pos\":null,\"def_short\":\"\",\"translation_en\":\"leaching\",\"domain\":\"AGROVOC\",\"dict_name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":384593,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"يدل النضح (أو التناضح) في العلوم الطبيعية، على تدفق  في اتجاه محدد لجسيمات جزيئية من خلال طبقة فصل انتقائية أو شبه منفذة. في كثير من الأحيان يوصف النضح بأنه مرور عفوي للماء أو مذيب آخر عبر غشاء شبه منفذ، الذي هو منفذ للمذيب، ولكن ليس منفذا للمواد الذائبة.\",\"translation_en\":\"osmosis\",\"domain\":\"Renewable Energy\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":356818,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"إفراز سائل من الأوعية الدموية (أو قنوات السوائل بالنباتات) في مناطق الالتهاب أو التي أصابها ضرر، يتجمد ويغطي (ويحمي) الموقع المصاب. يختلف تكوين السائل حسب الجسم المصاب ونوع وموقع الإصابة.\",\"translation_en\":\"exudation\",\"domain\":\"Climate, Environment and Solid Waste management\",\"dict_name_ar\":\"مسرد المناخ والبيئة وإدارة النفايات الصلبة، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":453626,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"ويطلق على خروج السوائل من الثغور المائية\",\"translation_en\":\"exudation\",\"domain\":\"Biology\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":473272,\"headword\":\"نَضْح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"\",\"translation_en\":\"exudate\",\"domain\":\"Gross Anatomy\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علم التشريح العياني (2015)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":576871,\"headword\":\"نَضْح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"\",\"translation_en\":\"exudation\",\"domain\":\"The Unified Medical Dictionary\",\"dict_name_ar\":\"المعجم الطبي الموحد (2009)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":912155,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح [قَالَ أَبُو عبيد و -] يُقَال: ولد تَمام وَتَمام وقمر تَمام وَتَمام وَفِي ليل تَمام لَا يُقَال إِلَّا بِالْكَسْرِ: ليل التَّمام.\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"غريب الحديث لأبي عبيد القاسم بن سلام\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":984254,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"[نضح] النَضْح: الرشُّ. نضحْت البيت أَنْضِحُهُ بالكسر. والنَضْحُ أيضاً: الشُرْبُ دون الرِيِّ. تقول: نَضَحَ عطشَهُ يَنْضِحُهُ. والنَضيحُ: الحوض، والجمع نُضُح. وكذلك النَضَحُ بالتحريك، والجمع أَنْضاحٌ. قال ابن الاعرابي: إنما سمى بذلك لانه ينضح عطش الابل أي يبله. والنضيح: العرق. قال الراجز :\\nتنضح ذفراه بماء صب * والناضِح: البعير يسْتقى عليه، والأنثى ناضِحَةٌ وسانِيَةٌ. والنَضَّاحُ: الذي يَنْضَحُ على ا\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تاج اللغة وصِحاح العربية للجوهري\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":989153,\"headword\":\"نَضَّ \",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"(نَضَّ) النُّونُ وَالضَّادُ أَصْلَانِ صَحِيحَانِ أَحَدُهُمَا يَدُلُّ عَلَى تَيْسِيرِ الشَّيْءِ وَظُهُورِهِ، وَالثَّانِي عَلَى جِنْسٍ مِنَ الْحَرَكَةِ.\\nالْأَوَّلُ: قَوْلُ الْعَرَبِ: خُذْ مَا نَضَّ لَكَ مِنْ دَيْنٍ، أَيْ تَيَسَّرَ. وَفُلَانٌ يَسْتَنِضُّ مَالَ فُلَانٍ، أَيْ يَأْخُذُهُ كَمَا تَيَسَّرَ. وَالنَّضِيضُ مِنَ الْمَاءِ: الْقَلِيلُ. فَأَمَّا النَّاضُّ مِنَ الْمَالِ فَيُقَالُ: هُوَ مَا لَهُ مَ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مقاييس اللغة لابن فارس\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":989157,\"headword\":\"نَضَحَ \",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(نَضَحَ) النُّونُ وَالضَّادُ وَالْحَاءُ أَصْلٌ يَدُلُّ عَلَى شَيْءٍ يُنَدَّى، وَمَاءٌ يُرَشُّ. فَالنَّضْحُ: رَشُّ الْمَاءِ. وَنَضَحْتُهُ. قَالَ أَهْلُ اللُّغَةِ: يُقَالُ لِكُلِّ مَا رَقَّ: نَضْحٌ وَهَذَا هُوَ الْقِيَاسُ الَّذِي ذَكَرْنَاهُ، لِأَنَّ الرَّشَّ رَقِيقٌ. يُقَالُ: نَضَحْتُ الْبَيْتَ بِالْمَاءِ. وَنَضَحَ جِلْدُهُ بِالْعَرَقِ. وَالسَّانِيَةُ نَاضِحٌ.\\nوَنَضَحُوهُمْ بِالنَّبْلِ، وَهَذَا عَل\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مقاييس اللغة لابن فارس\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":995616,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(ن ض ح)\\nنَضَحَ عَلَيْهِ المَاء ينضِحه نَضْحا، إِذا ضربه بِشَيْء فَأَصَابَهُ مِنْهُ رشاش، ونَضَحَ عَلَيْهِ المَاء، ارتش. وَقَالَ الْأَصْمَعِي: نَضحْتُ عَلَيْهِ المَاء نَضْحا، وأصابه نَضْحٌ من كَذَا.\\nوَقَالَ ابْن الْأَعرَابِي: النَّضْحُ، مَا كَانَ على اعْتِمَاد، والنضْحُ مَا كَانَ على غير اعْتِمَاد. وَقيل: هما لُغَتَانِ بِمَعْنى. وَكله رش. قَالَ أَبُو عَليّ: النَّضْحُ مَا كَانَ من علو إِلَى سفل، بِد\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المحكم والمحيط الأعظم لابن سيده الأندلسي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":999752,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"ن ض ح\\nنضح عليه الماء، ونضح البيت بالماء نضحاً وهو الرّشّ. ونضح جلده بالعرق.\\nومن المجاز: قد نضح الشجر: تفطّر. ورأيت نضح الرمّان وغيره. قال أبو طالب:\\nبورك الميّت الغريب كما بو ... رك نضح الرمّان والزّيتون\\nونضح غلّته بالماء: بلّها، ومنه: النضيح والنّضّح: للحوض لبلّه عطش الإبل وكذلك البعير الناضح، ونواضح يثرب، ونضح أديم الودّ بينهم. قال الكميت:\\nنضحت أديم الودّ بيني وبينهم ... بآصرة الأرحام لو يتبلّل\\nو\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"أساس البلاغة للزمخشري\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":778297,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(نضح) - في الحديث: \\\"قال للرُّمَاة  انْضَحُوا عنّا الخَيلَ لا نُؤْتَى مِن خَلْفِنَا\\\": أي ارمُوهُم بالنُّشَّاب  وارضَخُوهُم بالحجر.- وفي حديثٍ آخر : \\\"كأنما تَرْمُون به نَضْح النَّبْلِ\\\"يعنى هِجَاءَ المشرِكِينَ.والنَّضْحُ والنَضْخُ يَتقارَبان في المعنى، وقيل: إنّ النَّضخَ - بالخَاءِ المُعَجَمةِ -: مَا بَقِىَ له أثَرٌ، وقيلَ: مَا كان على اعتمادٍ، وبالحَاء المُهْمَلة - بخلافهما، وقيل: بالحَاء المُهْمَلة\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المجموع المغيث في غريبي القرآن والحديث لأبو موسى المديني\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":782423,\"headword\":\"نَضَحَ\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(نَضَحَ)(هـ) فِيهِ «مَا يُسْقىَ مِنَ الزَّرْع نَضْحاً ففيهِ نِصفُ العُشْر» أَيْ مَا سُقِيَ بالدَّوالِي والاسْتقاء. والنَّوَاضِحُ: الْإِبِلُ الَّتِي يُسْتَقَى عَلَيْهَا، واحدُها: نَاضِحٌ .وَمِنْهُ الْحَدِيثُ «أَتَاهُ رَجُلٌ فَقَالَ: إِنَّ نَاضِحَ بَني فُلان قَدْ أبَدَ عَلَيْهِمْ» ويُجْمَع أَيْضًا عَلَى نَضَّاحٍ.وَمِنْهُ الْحَدِيثُ «اعْلفْه نُضَّاحَكَ» هَكَذَا جَاءَ فِي رِوَايَةٍ. وَفَسَّرَهُ بَعْضُ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"النهاية في غريب الحديث والأثر لأبي السعادات ابن الأثير الجزري\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":784995,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(ن ض ح) : (النَّضْحُ) الرَّشُّ وَالْبَلُّ يُقَالُ (نَضَحَ) الْمَاءَ وَنَضَحَ الْبَيْتَ بِالْمَاءِ وَمِنْهُ (يُنْضَحُ) ضَرْعُ النَّاقَةِ أَيْ يُرَشُّ بِالْمَاءِ الْبَارِدِ حَتَّى يَتَقَلَّصَ قَالَ الْخَطَّابِيُّ وَالْمُرَادُ بِنَضْحِ الْبَوْلِ إمْرَارُ الْمَاءِ عَلَيْهِ بِرِفْقٍ مِنْ غَيْرِ دَلْكٍ وَانْتَضَحَ الْبَوْلُ عَلَى الثَّوْبِ تَرَشَّشَ عَلَيْهِ (وَالنَّضُوحُ) مِنْ الطِّيبِ مَا يُنْضَحُ بِه\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المغرب في ترتيب المعرب للمُطَرِّزي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":789580,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"ن ض ح: (النَّضْحُ) الرَّشُّ وَبَابُهُ ضَرَبَ. وَنَضَحَ الْبَيْتَ رَشَّهُ. وَ (النَّاضِحُ) الْبَعِيرُ يُسْتَقَى عَلَيْهِ وَالْأُنْثَى (نَاضِحَةٌ) وَسَانِيَةٌ. وَ (انْتَضَحَ) عَلَيْهِ الْمَاءُ تَرَشَّشَ. وَ (نَضَحَتِ) الْقِرْبَةُ وَالْخَابِيَةُ رَشَحَتْ وَبَابُهُ قَطَعَ وَ (تَنْضَاحًا) أَيْضًا بِالْفَتْحِ.\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مختار الصحاح للرازي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":775016,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح: النَّضْحُ: الرَّشُّ.\\nنَضَح عليه الماءَ يَنْضَحُه \\n(* قوله «نضح عليه الماء ينضحه إلخ» بابه\\nضرب ومنع وكذلك نضخ بالخاء المعجمة كما في المصباح.) نَضْحاً إِذا ضربه\\nبشيء فأَصابه منه رَشاشٌ. ونَضَح عليه الماءُ: ارْتَشَّ. وفي حديث قتادة:\\nالنَّضْحُ من النَّضْحِ؛ يريد من أَصابه نَضْحٌ من البول وهو الشيء اليسير\\nمنه فعليه أَن يَنْضَحَه بالماء وليس عليه غسله؛ قال الزمخشري: هو أَن\\nيصيبه من البول رَشاشٌ كرؤ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"لسان العرب لابن منظور\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":793950,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"ن ض ح : نَضَحْتُ الثَّوْبَ نَضْحًا مِنْ بَابِ ضَرَبَ وَنَفَعَ وَهُوَ الْبَلُّ بِالْمَاءِ وَالرَّشُّ وَيُنْضَحُ مِنْ بَوْلِ الْغُلَامِ أَيْ يُرَشُّ وَنَضَحَ الْفَرَسُ عَرِقَ وَنَضَحَ الْعَرَقُ خَرَجَ وَانْتَضَحَ الْبَوْلُ عَلَى الثَّوْبِ تَرَشَّشَ وَنَضَحَ الْبَعِيرُ الْمَاءَ حَمَلَهُ مِنْ نَهْرٍ أَوْ بِئْرٍ لِسَقْيِ الزَّرْعِ فَهُوَ نَاضِحٌ وَالْأُنْثَى نَاضِحَةٌ بِالْهَاءِ سُمِّيَ نَاضِحًا لِأَنّ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المصباح المنير للفيّومي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":805823,\"headword\":\"نَضَّ\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نَضَّ الماءُ يَنِضُّ نَضّاً ونَضيضاً: سالَ قليلاً قليلاً، أو خَرَجَ رَشْحاً، وبئرٌ نَضوضٌ،وـ العُودُ: غلى أقْصاهُ بعدَ أن أوقِدَ أدْناهُ،وـ القِرْبَةُ من شِدَّةِ المَلْءِ: انْشَقَّتْ.والنَّضيضُ: الماءُ القليلُج: نَضائضُ، وبهاءٍ: المَطَرُ القليلُج: أنِضَّةٌ ونَضائضُ، والريحُ التي تَنِضُّ بالماءِ، فَيَسيلُ، أو هي الضعيفةُ.وجاؤُوا بأَقْصَى نَضيضِهم ونَضيضَتِهم: جماعتِهم.وإبِلٌ ذاتُ نَضيضَةٍ ونَضائضَ:\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"القاموس المحيط للفيروزآبادي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":805827,\"headword\":\"نَضَحَ\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نَضَحَ البيتَ يَنْضِحُهُ: رَشَّهُ،وـ عَطَشَهُ: سَكَّنَهُ، ورَوِيَ، أو شَرِبَ دونَ الرِّيِّ، ضِدٌّ،وـ النَّخْلَ: سَقاها بالسَّانية،وـ فلاناً بالنَّبْلِ: رَماهُ،وـ الشَّجَرُ: تَفَطَّرَ لِيَخْرُجَ ورَقُهُ،وـ الزَّرْعُ: ابتدأ الدَّقيقُ في حَبِّهِ وهو رَطْبٌ،كأَنْضَحَ،وـ بالبَوْلِ على فَخِذَيْهِ: أصابَهُما به،وـ الجُلَّةَ: نَثَرَ ما فيها،وـ عنه: ذَبَّ، ودَفَعَ،كناضَحَ،وـ القِرْبَةُ تَنْضَحُ، كتَمْنَعُ،\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"القاموس المحيط للفيروزآبادي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":812116,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"[نضح] ك: وفيه: كادت أن \\\"تنضح\\\"- بفتح ضاد، أي تطيب، قوله: طعيم- بتشديد ياء مصغر طعام. نه: فيه ما يسقى من الزرع \\\"نضحًا\\\" ففيه نصف العشر، أي ما سقى بالدوالي والاستقاء، والنواضح: إبل يستقي عليها، جمع ناضح. ك: ومنه: وما سقي \\\"بالنضح\\\"، أي الاستقاء. ومنه: أقبل رجل \\\"بناضحين\\\"- بضاد معجمة وحاء مهملة. نه: ومنه ح: إن \\\"ناضح\\\" بني فلان قد أبد عليهم، ويجمع أيضًا على نضاح. ومنه: أعلفه \\\"نضاحك\\\"- كذا في رواية، وفسره بعض\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مجمع بحار الأنوار للفَتِّنيّ\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":815269,\"headword\":\"النضح\",\"headword_norm\":\"النضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"النضح: الرش بالماء. ومنه قالوا للحوض النضح والنضيح، لنضحه عطش الإبل. النضرة والنضارة: الرونق والسرور.\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"التوقيف على مهمات التعاريف للمناوي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":832254,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح: (نَضَحَ البَيْتَ يَنْضِحُهُ) ، بِالْكَسْرِ نَضْحاً: (رَشَّه) ، وَقيل رَشَّه رَشًّا خَفيفاً. قَالَ الأَصمعيّ: نَضَحْتُ عَلَيْهِ الماءَ نَضْحاً، وأَصابَهُ نَضْحٌ من كَذَا. وَقَالَ ابْن الأَعرابيّ: النَّضْح مَا كَانَ على اعْتِمَاد، وَهُوَ مَا نَضْحتَه بيَدِكَ معْتمِداً. والنَّاقَةُ تَنضَح ببَوْلها، والنَّضْخُ مَا كانَ على غَير اعتمادٍ، وَقيل: هما لُغتان بِمَعْنى واحدٍ وكلّه رَشٌّ. وحكَى الأَزهري\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تاج العروس لمرتضى الزبيدي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":955283,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نض\\n1 نَضَّ, aor. ـِ inf. n. نَضِيضٌ (S, A, Mgh, Msb, K) and نَضٌّ, (K,) It (water) welled from a source, or spring: (TA:) or flowed: (TA:) or flowed, (S, Mgh, K,) or came forth, (Mgh, Msb,) by little and little, (S, A, Mgh, Msb,) from stone or the like; (Mgh;) like بَضَّ: (A:) or exuded; or oozed forth, (A, K,) [like بَضَّ;] like as it does from stone. (TA.) You say also, سَحَابَةٌ تَنِضُّ بِالْمَ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المعجم العربي الإنجليزي لإدوارد وليام لين\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":955286,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح\\n1 نَضَحَ, aor. ـِ (S, K,) and نَضَحَ, (Msb, MF,) inf. n. نَضْحٌ, (S,) He sprinkled a house, or chamber, [with water]: (S, K:) or he sprinkled it lightly: (TA:) نَضْحٌ is like نَضْخٌ; and sometimes these two words agree, and sometimes they differ: (Lth:) some say that they both signify any sprinkling: (TA:) or the former signifies what is intentional; and the latter, what is unintentional. (IAa\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المعجم العربي الإنجليزي لإدوارد وليام لين\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":849170,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نض: نض: خفق، رجف (ألف ليلة برسل 4: 177): فاغتاظ الخليفة ونض العرق الهاشمي من بين عينيه (ترجمها لين: throb to أي نبض، خنق).\\nنض: في (محيط المحيط): ما نض بيدي منه شيء أي ما حصل؛ أعطى (فوك) لهذا الفعل مرادفا هو Presto esse أي حان أو حل؛ ولعله المرادف نفسه الذي ذكره (الكالا) في مواضع عدة ( acaecer mal, acaecer bien, acontecer, acaecer) نض، ينض، نضا وقد ترجمه بأنه الفعل: وصل، وقع، حدث، حان أجله. لقد ذكر\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تكملة المعاجم العربية لرينهارت دوزي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":849173,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح: نضح: وسخ (باين سميث 1529): salir.\\nنضح: خفف الضغط، استرخى، استراح، تسلى deteindre se deteindre ( القماش)، وفي (محيط المحيط) في مادة فطم: والعامة تقول فطم الصباغ الثوب أي غمسه في ما يمسك صباغه فلا ينضح على غيره (انظر نضخ في المعاجم).\\nنضح: ينضح (سال) (سانح9 (المقدمة 3: 430).\\nنضح: وسخ (باين سميث 1529).\\nنضوح: (مؤنث ومذكر) مسامي، ذو مسام تنفذ إليه السوائل (للزق) (معجم البلاذري).\\nنضاح: الذي يعرق كثي\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تكملة المعاجم العربية لرينهارت دوزي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":965528,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح\\n نَضَحَ(n. ac.\\n نَضْح) \\na.  [acc. & Bi], Sprinkled, besprinkled. \\nb. Allayed, quenched.\\n c.  [acc. & Bi], Shot at. \\nd. Budded, sprouted.\\n e.  [acc. & 'An], Averted from. \\nf.  ['An], Defended. \\ng.(n. ac. نَضْح\\n تَنْضَاْح), Oozed; perspired. \\nh. Shed tears; overflowed.\\n i. Was watered.\\n j.  ['Ala], Carried water on. \\n نَاْضَحَa.  see I (f)\\n أَنْضَحَa.  see I (d) (e). \\nc. Aspersed.\\n تَنَضَّحَa.  \",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"حبيب سالمون، قاموس عربي انجليزي متقدم للمتعلمين\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":908342,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نض: النَّضُّ: نَضِيْضٌ من الماء قَليلٌ، نَضَّ الماءُ يَنِضُّ. وفلاننٌ يَسْتَنِضُّ مَعْرُوْفَ فلانٍ. ونَضَّ إلَيَّ من مَعْرُوْفِه نُضَاضَةٌ. وأصابَهُ نّضٌّ من الأمْرِ: أي مَكْرُوْهٌ. والنّاضُّ من المالِ: مالَهُ مادَّةٌ وبَقَاءٌ. والنَّضِيْضَةُ: القَلِيلَةُ من المَطَرِ. وما في يدي إلاّ نَضِيْضَةٌ: أي شَيْءٌ يَسِيْرٌ. وعليهم نَضَائضُ من أمْوالِهِم ونَضِيْضَاتٌ: أي بَقَايا، وكذلك النُّضَاضَةُ. وأنّضَّ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المحيط في اللغة للصاحب بن عباد\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":908345,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح\\nالنَّضْحُ: كالنَّضْحْ، إلاَ أنَّ النَّضْخَ له أثَرٌ. والعَيْنُ تَنْضَحُ بالماءِ نَضْحاً وتَنْتَضِحُ، وكذلك الجَبَلُ والجَرَّةُ. واسْتَنْضَحَ الرَّجُلُ في الوُضُوء: رَشَّ على نَفْسِه الماءَ. والنَّضِيْحُ: العَرَقُ. والرَّجُلُ يَنْضَحُ عن نَفْسِه ما قُرِفَ به: إذا أظْهَرَ البَراءَةَ منه. وانْتَضَحَ: اعْتَذَرَ. والنَّضِيْحُ من الحِيَاضِ: ما قَرُبَ من البِئْر، وهو النَّضَحُ - أيضاً - بِفَتْحَتَيْن\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المحيط في اللغة للصاحب بن عباد\",\"source_type\":\"hawramani\",\"period\":\"classical\"}]","is_error":false}]},"parent_tool_use_id":null,"session_id":"8fdbe189-a1b9-41d7-94bd-6d9906d33399","uuid":"93149baf-9c1e-4361-bbfa-5d061dfd110d","tool_use_result":{"stdout":"[{\"entry_id\":757523,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نض\",\"pos\":null,\"def_short\":\"\",\"translation_en\":\"leaching\",\"domain\":\"AGROVOC\",\"dict_name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":384593,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"يدل النضح (أو التناضح) في العلوم الطبيعية، على تدفق  في اتجاه محدد لجسيمات جزيئية من خلال طبقة فصل انتقائية أو شبه منفذة. في كثير من الأحيان يوصف النضح بأنه مرور عفوي للماء أو مذيب آخر عبر غشاء شبه منفذ، الذي هو منفذ للمذيب، ولكن ليس منفذا للمواد الذائبة.\",\"translation_en\":\"osmosis\",\"domain\":\"Renewable Energy\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":356818,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"إفراز سائل من الأوعية الدموية (أو قنوات السوائل بالنباتات) في مناطق الالتهاب أو التي أصابها ضرر، يتجمد ويغطي (ويحمي) الموقع المصاب. يختلف تكوين السائل حسب الجسم المصاب ونوع وموقع الإصابة.\",\"translation_en\":\"exudation\",\"domain\":\"Climate, Environment and Solid Waste management\",\"dict_name_ar\":\"مسرد المناخ والبيئة وإدارة النفايات الصلبة، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":453626,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"ويطلق على خروج السوائل من الثغور المائية\",\"translation_en\":\"exudation\",\"domain\":\"Biology\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":473272,\"headword\":\"نَضْح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"\",\"translation_en\":\"exudate\",\"domain\":\"Gross Anatomy\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علم التشريح العياني (2015)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":576871,\"headword\":\"نَضْح\",\"headword_norm\":\"نضح\",\"root\":\"نضح\",\"pos\":null,\"def_short\":\"\",\"translation_en\":\"exudation\",\"domain\":\"The Unified Medical Dictionary\",\"dict_name_ar\":\"المعجم الطبي الموحد (2009)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":912155,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح [قَالَ أَبُو عبيد و -] يُقَال: ولد تَمام وَتَمام وقمر تَمام وَتَمام وَفِي ليل تَمام لَا يُقَال إِلَّا بِالْكَسْرِ: ليل التَّمام.\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"غريب الحديث لأبي عبيد القاسم بن سلام\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":984254,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"[نضح] النَضْح: الرشُّ. نضحْت البيت أَنْضِحُهُ بالكسر. والنَضْحُ أيضاً: الشُرْبُ دون الرِيِّ. تقول: نَضَحَ عطشَهُ يَنْضِحُهُ. والنَضيحُ: الحوض، والجمع نُضُح. وكذلك النَضَحُ بالتحريك، والجمع أَنْضاحٌ. قال ابن الاعرابي: إنما سمى بذلك لانه ينضح عطش الابل أي يبله. والنضيح: العرق. قال الراجز :\\nتنضح ذفراه بماء صب * والناضِح: البعير يسْتقى عليه، والأنثى ناضِحَةٌ وسانِيَةٌ. والنَضَّاحُ: الذي يَنْضَحُ على ا\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تاج اللغة وصِحاح العربية للجوهري\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":989153,\"headword\":\"نَضَّ \",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"(نَضَّ) النُّونُ وَالضَّادُ أَصْلَانِ صَحِيحَانِ أَحَدُهُمَا يَدُلُّ عَلَى تَيْسِيرِ الشَّيْءِ وَظُهُورِهِ، وَالثَّانِي عَلَى جِنْسٍ مِنَ الْحَرَكَةِ.\\nالْأَوَّلُ: قَوْلُ الْعَرَبِ: خُذْ مَا نَضَّ لَكَ مِنْ دَيْنٍ، أَيْ تَيَسَّرَ. وَفُلَانٌ يَسْتَنِضُّ مَالَ فُلَانٍ، أَيْ يَأْخُذُهُ كَمَا تَيَسَّرَ. وَالنَّضِيضُ مِنَ الْمَاءِ: الْقَلِيلُ. فَأَمَّا النَّاضُّ مِنَ الْمَالِ فَيُقَالُ: هُوَ مَا لَهُ مَ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مقاييس اللغة لابن فارس\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":989157,\"headword\":\"نَضَحَ \",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(نَضَحَ) النُّونُ وَالضَّادُ وَالْحَاءُ أَصْلٌ يَدُلُّ عَلَى شَيْءٍ يُنَدَّى، وَمَاءٌ يُرَشُّ. فَالنَّضْحُ: رَشُّ الْمَاءِ. وَنَضَحْتُهُ. قَالَ أَهْلُ اللُّغَةِ: يُقَالُ لِكُلِّ مَا رَقَّ: نَضْحٌ وَهَذَا هُوَ الْقِيَاسُ الَّذِي ذَكَرْنَاهُ، لِأَنَّ الرَّشَّ رَقِيقٌ. يُقَالُ: نَضَحْتُ الْبَيْتَ بِالْمَاءِ. وَنَضَحَ جِلْدُهُ بِالْعَرَقِ. وَالسَّانِيَةُ نَاضِحٌ.\\nوَنَضَحُوهُمْ بِالنَّبْلِ، وَهَذَا عَل\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مقاييس اللغة لابن فارس\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":995616,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(ن ض ح)\\nنَضَحَ عَلَيْهِ المَاء ينضِحه نَضْحا، إِذا ضربه بِشَيْء فَأَصَابَهُ مِنْهُ رشاش، ونَضَحَ عَلَيْهِ المَاء، ارتش. وَقَالَ الْأَصْمَعِي: نَضحْتُ عَلَيْهِ المَاء نَضْحا، وأصابه نَضْحٌ من كَذَا.\\nوَقَالَ ابْن الْأَعرَابِي: النَّضْحُ، مَا كَانَ على اعْتِمَاد، والنضْحُ مَا كَانَ على غير اعْتِمَاد. وَقيل: هما لُغَتَانِ بِمَعْنى. وَكله رش. قَالَ أَبُو عَليّ: النَّضْحُ مَا كَانَ من علو إِلَى سفل، بِد\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المحكم والمحيط الأعظم لابن سيده الأندلسي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":999752,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"ن ض ح\\nنضح عليه الماء، ونضح البيت بالماء نضحاً وهو الرّشّ. ونضح جلده بالعرق.\\nومن المجاز: قد نضح الشجر: تفطّر. ورأيت نضح الرمّان وغيره. قال أبو طالب:\\nبورك الميّت الغريب كما بو ... رك نضح الرمّان والزّيتون\\nونضح غلّته بالماء: بلّها، ومنه: النضيح والنّضّح: للحوض لبلّه عطش الإبل وكذلك البعير الناضح، ونواضح يثرب، ونضح أديم الودّ بينهم. قال الكميت:\\nنضحت أديم الودّ بيني وبينهم ... بآصرة الأرحام لو يتبلّل\\nو\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"أساس البلاغة للزمخشري\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":778297,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(نضح) - في الحديث: \\\"قال للرُّمَاة  انْضَحُوا عنّا الخَيلَ لا نُؤْتَى مِن خَلْفِنَا\\\": أي ارمُوهُم بالنُّشَّاب  وارضَخُوهُم بالحجر.- وفي حديثٍ آخر : \\\"كأنما تَرْمُون به نَضْح النَّبْلِ\\\"يعنى هِجَاءَ المشرِكِينَ.والنَّضْحُ والنَضْخُ يَتقارَبان في المعنى، وقيل: إنّ النَّضخَ - بالخَاءِ المُعَجَمةِ -: مَا بَقِىَ له أثَرٌ، وقيلَ: مَا كان على اعتمادٍ، وبالحَاء المُهْمَلة - بخلافهما، وقيل: بالحَاء المُهْمَلة\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المجموع المغيث في غريبي القرآن والحديث لأبو موسى المديني\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":782423,\"headword\":\"نَضَحَ\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(نَضَحَ)(هـ) فِيهِ «مَا يُسْقىَ مِنَ الزَّرْع نَضْحاً ففيهِ نِصفُ العُشْر» أَيْ مَا سُقِيَ بالدَّوالِي والاسْتقاء. والنَّوَاضِحُ: الْإِبِلُ الَّتِي يُسْتَقَى عَلَيْهَا، واحدُها: نَاضِحٌ .وَمِنْهُ الْحَدِيثُ «أَتَاهُ رَجُلٌ فَقَالَ: إِنَّ نَاضِحَ بَني فُلان قَدْ أبَدَ عَلَيْهِمْ» ويُجْمَع أَيْضًا عَلَى نَضَّاحٍ.وَمِنْهُ الْحَدِيثُ «اعْلفْه نُضَّاحَكَ» هَكَذَا جَاءَ فِي رِوَايَةٍ. وَفَسَّرَهُ بَعْضُ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"النهاية في غريب الحديث والأثر لأبي السعادات ابن الأثير الجزري\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":784995,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"(ن ض ح) : (النَّضْحُ) الرَّشُّ وَالْبَلُّ يُقَالُ (نَضَحَ) الْمَاءَ وَنَضَحَ الْبَيْتَ بِالْمَاءِ وَمِنْهُ (يُنْضَحُ) ضَرْعُ النَّاقَةِ أَيْ يُرَشُّ بِالْمَاءِ الْبَارِدِ حَتَّى يَتَقَلَّصَ قَالَ الْخَطَّابِيُّ وَالْمُرَادُ بِنَضْحِ الْبَوْلِ إمْرَارُ الْمَاءِ عَلَيْهِ بِرِفْقٍ مِنْ غَيْرِ دَلْكٍ وَانْتَضَحَ الْبَوْلُ عَلَى الثَّوْبِ تَرَشَّشَ عَلَيْهِ (وَالنَّضُوحُ) مِنْ الطِّيبِ مَا يُنْضَحُ بِه\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المغرب في ترتيب المعرب للمُطَرِّزي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":789580,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"ن ض ح: (النَّضْحُ) الرَّشُّ وَبَابُهُ ضَرَبَ. وَنَضَحَ الْبَيْتَ رَشَّهُ. وَ (النَّاضِحُ) الْبَعِيرُ يُسْتَقَى عَلَيْهِ وَالْأُنْثَى (نَاضِحَةٌ) وَسَانِيَةٌ. وَ (انْتَضَحَ) عَلَيْهِ الْمَاءُ تَرَشَّشَ. وَ (نَضَحَتِ) الْقِرْبَةُ وَالْخَابِيَةُ رَشَحَتْ وَبَابُهُ قَطَعَ وَ (تَنْضَاحًا) أَيْضًا بِالْفَتْحِ.\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مختار الصحاح للرازي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":775016,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح: النَّضْحُ: الرَّشُّ.\\nنَضَح عليه الماءَ يَنْضَحُه \\n(* قوله «نضح عليه الماء ينضحه إلخ» بابه\\nضرب ومنع وكذلك نضخ بالخاء المعجمة كما في المصباح.) نَضْحاً إِذا ضربه\\nبشيء فأَصابه منه رَشاشٌ. ونَضَح عليه الماءُ: ارْتَشَّ. وفي حديث قتادة:\\nالنَّضْحُ من النَّضْحِ؛ يريد من أَصابه نَضْحٌ من البول وهو الشيء اليسير\\nمنه فعليه أَن يَنْضَحَه بالماء وليس عليه غسله؛ قال الزمخشري: هو أَن\\nيصيبه من البول رَشاشٌ كرؤ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"لسان العرب لابن منظور\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":793950,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"ن ض ح : نَضَحْتُ الثَّوْبَ نَضْحًا مِنْ بَابِ ضَرَبَ وَنَفَعَ وَهُوَ الْبَلُّ بِالْمَاءِ وَالرَّشُّ وَيُنْضَحُ مِنْ بَوْلِ الْغُلَامِ أَيْ يُرَشُّ وَنَضَحَ الْفَرَسُ عَرِقَ وَنَضَحَ الْعَرَقُ خَرَجَ وَانْتَضَحَ الْبَوْلُ عَلَى الثَّوْبِ تَرَشَّشَ وَنَضَحَ الْبَعِيرُ الْمَاءَ حَمَلَهُ مِنْ نَهْرٍ أَوْ بِئْرٍ لِسَقْيِ الزَّرْعِ فَهُوَ نَاضِحٌ وَالْأُنْثَى نَاضِحَةٌ بِالْهَاءِ سُمِّيَ نَاضِحًا لِأَنّ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المصباح المنير للفيّومي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":805823,\"headword\":\"نَضَّ\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نَضَّ الماءُ يَنِضُّ نَضّاً ونَضيضاً: سالَ قليلاً قليلاً، أو خَرَجَ رَشْحاً، وبئرٌ نَضوضٌ،وـ العُودُ: غلى أقْصاهُ بعدَ أن أوقِدَ أدْناهُ،وـ القِرْبَةُ من شِدَّةِ المَلْءِ: انْشَقَّتْ.والنَّضيضُ: الماءُ القليلُج: نَضائضُ، وبهاءٍ: المَطَرُ القليلُج: أنِضَّةٌ ونَضائضُ، والريحُ التي تَنِضُّ بالماءِ، فَيَسيلُ، أو هي الضعيفةُ.وجاؤُوا بأَقْصَى نَضيضِهم ونَضيضَتِهم: جماعتِهم.وإبِلٌ ذاتُ نَضيضَةٍ ونَضائضَ:\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"القاموس المحيط للفيروزآبادي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":805827,\"headword\":\"نَضَحَ\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نَضَحَ البيتَ يَنْضِحُهُ: رَشَّهُ،وـ عَطَشَهُ: سَكَّنَهُ، ورَوِيَ، أو شَرِبَ دونَ الرِّيِّ، ضِدٌّ،وـ النَّخْلَ: سَقاها بالسَّانية،وـ فلاناً بالنَّبْلِ: رَماهُ،وـ الشَّجَرُ: تَفَطَّرَ لِيَخْرُجَ ورَقُهُ،وـ الزَّرْعُ: ابتدأ الدَّقيقُ في حَبِّهِ وهو رَطْبٌ،كأَنْضَحَ،وـ بالبَوْلِ على فَخِذَيْهِ: أصابَهُما به،وـ الجُلَّةَ: نَثَرَ ما فيها،وـ عنه: ذَبَّ، ودَفَعَ،كناضَحَ،وـ القِرْبَةُ تَنْضَحُ، كتَمْنَعُ،\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"القاموس المحيط للفيروزآبادي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":812116,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"[نضح] ك: وفيه: كادت أن \\\"تنضح\\\"- بفتح ضاد، أي تطيب، قوله: طعيم- بتشديد ياء مصغر طعام. نه: فيه ما يسقى من الزرع \\\"نضحًا\\\" ففيه نصف العشر، أي ما سقى بالدوالي والاستقاء، والنواضح: إبل يستقي عليها، جمع ناضح. ك: ومنه: وما سقي \\\"بالنضح\\\"، أي الاستقاء. ومنه: أقبل رجل \\\"بناضحين\\\"- بضاد معجمة وحاء مهملة. نه: ومنه ح: إن \\\"ناضح\\\" بني فلان قد أبد عليهم، ويجمع أيضًا على نضاح. ومنه: أعلفه \\\"نضاحك\\\"- كذا في رواية، وفسره بعض\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"مجمع بحار الأنوار للفَتِّنيّ\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":815269,\"headword\":\"النضح\",\"headword_norm\":\"النضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"النضح: الرش بالماء. ومنه قالوا للحوض النضح والنضيح، لنضحه عطش الإبل. النضرة والنضارة: الرونق والسرور.\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"التوقيف على مهمات التعاريف للمناوي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":832254,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح: (نَضَحَ البَيْتَ يَنْضِحُهُ) ، بِالْكَسْرِ نَضْحاً: (رَشَّه) ، وَقيل رَشَّه رَشًّا خَفيفاً. قَالَ الأَصمعيّ: نَضَحْتُ عَلَيْهِ الماءَ نَضْحاً، وأَصابَهُ نَضْحٌ من كَذَا. وَقَالَ ابْن الأَعرابيّ: النَّضْح مَا كَانَ على اعْتِمَاد، وَهُوَ مَا نَضْحتَه بيَدِكَ معْتمِداً. والنَّاقَةُ تَنضَح ببَوْلها، والنَّضْخُ مَا كانَ على غَير اعتمادٍ، وَقيل: هما لُغتان بِمَعْنى واحدٍ وكلّه رَشٌّ. وحكَى الأَزهري\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تاج العروس لمرتضى الزبيدي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":955283,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نض\\n1 نَضَّ, aor. ـِ inf. n. نَضِيضٌ (S, A, Mgh, Msb, K) and نَضٌّ, (K,) It (water) welled from a source, or spring: (TA:) or flowed: (TA:) or flowed, (S, Mgh, K,) or came forth, (Mgh, Msb,) by little and little, (S, A, Mgh, Msb,) from stone or the like; (Mgh;) like بَضَّ: (A:) or exuded; or oozed forth, (A, K,) [like بَضَّ;] like as it does from stone. (TA.) You say also, سَحَابَةٌ تَنِضُّ بِالْمَ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المعجم العربي الإنجليزي لإدوارد وليام لين\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":955286,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح\\n1 نَضَحَ, aor. ـِ (S, K,) and نَضَحَ, (Msb, MF,) inf. n. نَضْحٌ, (S,) He sprinkled a house, or chamber, [with water]: (S, K:) or he sprinkled it lightly: (TA:) نَضْحٌ is like نَضْخٌ; and sometimes these two words agree, and sometimes they differ: (Lth:) some say that they both signify any sprinkling: (TA:) or the former signifies what is intentional; and the latter, what is unintentional. (IAa\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المعجم العربي الإنجليزي لإدوارد وليام لين\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":849170,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نض: نض: خفق، رجف (ألف ليلة برسل 4: 177): فاغتاظ الخليفة ونض العرق الهاشمي من بين عينيه (ترجمها لين: throb to أي نبض، خنق).\\nنض: في (محيط المحيط): ما نض بيدي منه شيء أي ما حصل؛ أعطى (فوك) لهذا الفعل مرادفا هو Presto esse أي حان أو حل؛ ولعله المرادف نفسه الذي ذكره (الكالا) في مواضع عدة ( acaecer mal, acaecer bien, acontecer, acaecer) نض، ينض، نضا وقد ترجمه بأنه الفعل: وصل، وقع، حدث، حان أجله. لقد ذكر\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تكملة المعاجم العربية لرينهارت دوزي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":849173,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح: نضح: وسخ (باين سميث 1529): salir.\\nنضح: خفف الضغط، استرخى، استراح، تسلى deteindre se deteindre ( القماش)، وفي (محيط المحيط) في مادة فطم: والعامة تقول فطم الصباغ الثوب أي غمسه في ما يمسك صباغه فلا ينضح على غيره (انظر نضخ في المعاجم).\\nنضح: ينضح (سال) (سانح9 (المقدمة 3: 430).\\nنضح: وسخ (باين سميث 1529).\\nنضوح: (مؤنث ومذكر) مسامي، ذو مسام تنفذ إليه السوائل (للزق) (معجم البلاذري).\\nنضاح: الذي يعرق كثي\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"تكملة المعاجم العربية لرينهارت دوزي\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":965528,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح\\n نَضَحَ(n. ac.\\n نَضْح) \\na.  [acc. & Bi], Sprinkled, besprinkled. \\nb. Allayed, quenched.\\n c.  [acc. & Bi], Shot at. \\nd. Budded, sprouted.\\n e.  [acc. & 'An], Averted from. \\nf.  ['An], Defended. \\ng.(n. ac. نَضْح\\n تَنْضَاْح), Oozed; perspired. \\nh. Shed tears; overflowed.\\n i. Was watered.\\n j.  ['Ala], Carried water on. \\n نَاْضَحَa.  see I (f)\\n أَنْضَحَa.  see I (d) (e). \\nc. Aspersed.\\n تَنَضَّحَa.  \",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"حبيب سالمون، قاموس عربي انجليزي متقدم للمتعلمين\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":908342,\"headword\":\"نض\",\"headword_norm\":\"نض\",\"root\":\"نضض\",\"pos\":null,\"def_short\":\"نض: النَّضُّ: نَضِيْضٌ من الماء قَليلٌ، نَضَّ الماءُ يَنِضُّ. وفلاننٌ يَسْتَنِضُّ مَعْرُوْفَ فلانٍ. ونَضَّ إلَيَّ من مَعْرُوْفِه نُضَاضَةٌ. وأصابَهُ نّضٌّ من الأمْرِ: أي مَكْرُوْهٌ. والنّاضُّ من المالِ: مالَهُ مادَّةٌ وبَقَاءٌ. والنَّضِيْضَةُ: القَلِيلَةُ من المَطَرِ. وما في يدي إلاّ نَضِيْضَةٌ: أي شَيْءٌ يَسِيْرٌ. وعليهم نَضَائضُ من أمْوالِهِم ونَضِيْضَاتٌ: أي بَقَايا، وكذلك النُّضَاضَةُ. وأنّضَّ\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المحيط في اللغة للصاحب بن عباد\",\"source_type\":\"hawramani\",\"period\":\"classical\"},\n{\"entry_id\":908345,\"headword\":\"نضح\",\"headword_norm\":\"نضح\",\"root\":\"ضح\",\"pos\":null,\"def_short\":\"نضح\\nالنَّضْحُ: كالنَّضْحْ، إلاَ أنَّ النَّضْخَ له أثَرٌ. والعَيْنُ تَنْضَحُ بالماءِ نَضْحاً وتَنْتَضِحُ، وكذلك الجَبَلُ والجَرَّةُ. واسْتَنْضَحَ الرَّجُلُ في الوُضُوء: رَشَّ على نَفْسِه الماءَ. والنَّضِيْحُ: العَرَقُ. والرَّجُلُ يَنْضَحُ عن نَفْسِه ما قُرِفَ به: إذا أظْهَرَ البَراءَةَ منه. وانْتَضَحَ: اعْتَذَرَ. والنَّضِيْحُ من الحِيَاضِ: ما قَرُبَ من البِئْر، وهو النَّضَحُ - أيضاً - بِفَتْحَتَيْن\",\"translation_en\":null,\"domain\":null,\"dict_name_ar\":\"المحيط في اللغة للصاحب بن عباد\",\"source_type\":\"hawramani\",\"period\":\"classical\"}]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
