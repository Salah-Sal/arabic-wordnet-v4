e","timestamp":"2026-03-17T15:52:40.486Z","tool_name":"write_file","tool_id":"write_file_1773762760485_0","parameters":{"file_path":"/output/awn4-13527790-n.review.yaml","content":"stage1_review:\n  assessment:\n    concerns:\n      - \"اللمّة 'ترشيح' شائعة لكنها قد تلتبس بعملية التصفية (Filtration) في غير سياق الغسل.\"\n      - \"اللمّة 'غسل التربة' تعبير مركب يحتاج إلى فحص كونه مصطلحاً مستقراً (وهو كذلك في علم التربة والمياه).\"\n    observations: \"المفهوم مركزي في علوم الجيولوجيا والكيمياء والتربة، ويشترك فيه جانبان: ميكانيكي (مرور السائل) وكيميائي (الإذابة والإزالة). المصطلحات التراثية مثل 'نضّ' و'نضيض' تعبر بدقة عن الجانب الميكانيكي، بينما 'غسل' يعبر عن النتيجة الكيميائية.\"\n  blind_candidates:\n    - lemma: \"نَضِيض\"\n      generation_method: ishtiqaq\n      justification: \"من الجذر 'نضّ' الذي يعني سيلان الماء قليلاً قليلاً أو خروجه رشحاً، وهو جوهر عملية الترشيح في التربة.\"\n    - lemma: \"انْتِضَاض\"\n      generation_method: ishtiqaq\n      justification: \"مصدر الفعل 'انتضّ'، يعبر عن المطاوعة والعملية المستمرة لخروج السائل.\"\n    - lemma: \"نَضّ\"\n      generation_method: ishtiqaq\n      justification: \"المصدر الصريح للفعل، وهو المصطلح المعتمد في بعض المعاجم الزراعية (مثل AGROVOC) مرادفاً لـ leaching.\"\n    - lemma: \"اسْتِخْلَاص\"\n      generation_method: ishtiqaq\n      justification: \"يعبر عن غاية العملية وهي إزالة أو فصل المواد الذائبة، ويستخدم بكثرة في سياق التعدين والكيمياء.\"\n\nstage2_evidence:\n  per_lemma:\n    - lemma: \"تَرْشِيح\"\n      confirm:\n        - text: \"«(5) عملية الترشيح» لمصطلح leach.\"\n          source: \"المورد الحديث\"\n      expands:\n        - text: \"«الترشيح: أن يذكر شيئا ملائما لمشبه به» (معنى بلاغي).\"\n          source: \"التوقيف على مهمات التعاريف\"\n    - lemma: \"غَسْل التُّرْبَة\"\n      confirm:\n        - text: \"«نزع الأملاح في الطبقة العليا للتربة باستخدام مياه قليلة الملوحة نسبياً».\"\n          source: \"المعجم الموحد لمصطلحات المياه\"\n        - text: \"«نظام للتفاعل بين التربة الملوثة ومحاليل استخل