" for enrichment\n#   value: str           # JSON string (note-packed)\n#\n# set_confidence:\n#   entity_type: str     # \"synset\" | \"sense\"\n#   entity_id: str\n#   score: float         # 0.0–1.0\n\n# ── Complete Action Type Catalog (19 types) ─────────────────\n#\n# Stage 3 (10 types):\n#   1.  remove_sense         — Lemma rejected\n#   2.  update_lemma         — Diacritics fix, spelling fix\n#   3.  update_entry         — Wrong POS on entry\n#   4.  add_form             — Add variant form\n#   5.  remove_form          — Remove incorrect form\n#   6.  create_entry         — New lemma approved\n#   7.  add_sense            — Link entry to synset\n#   8.  update_synset        — Wrong POS at synset level\n#   9.  add_sense_relation   — Derivation, sense antonymy\n#   10. remove_sense_relation — Wrong sense relation\n#\n# Stage 4 (7 types):\n#   11. update_definition     — Revise existing definition\n#   12. add_definition        — Add encyclopedic/linguistic def\n#   13. remove_definition     — Remove bad/duplicate def\n#   14. add_synset_example    — Add synset-level example\n#   15. remove_synset_example — Remove bad example\n#   16. add_sense_example     — Add sense-level example\n#   17. remove_sense_example  — Remove bad example\n#\n# Stage 5 (2 types):\n#   18. set_metadata          — Note-packed enrichment\n#   19. set_confidence        — Confidence scores"}
