{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01Mv78C11rHPiWZC3qYy1nn1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KMXTzMA4cQN9eHTRRMCDZn","name":"Write","input":{"file_path":"/output/awn4-13526452-n.review.yaml","content":"# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية — Synset Review\n# synset_id : awn4-13526452-n\n# ili       : i107699\n# pos       : n\n# pipeline  : AWN4 Review Pipeline v2 (5-Stage)\n# date      : 2026-03-17\n# ═══════════════════════════════════════════════════════════════\n\n\n# ── المرحلة ١: المراجعة والتوليد (عمياء) ──────────────────\nstage1_review:\n  assessment:\n    concerns:\n      - \"اللمّة الوحيدة 'تقرن' مكتوبة بلا تشكيل، وصيغتها المضبوطة تَقَرُّن (مصدر الباب الخامس) غائبة\"\n      - \"بعض المعاجم تخلط بين تقرُّن (keratinization) وتقرُّن بمعنى keratosis (نمو قرني مرضي)، مما يُوحي بتعدد دلالي في المصطلح\"\n      - \"التعريف العربي الحالي يستخدم صيغة 'يتم فيها' المقتبسة من أسلوب الترجمة الحرفية، بدلاً من الأسلوب المعجمي العربي الأصيل\"\n    observations: >-\n      المجموعة تمثّل مصطلحاً بيولوجياً-طبياً دقيقاً يُعنى بعملية تحوّل الخلايا إلى مادة قرنية\n      بفعل ترسّب الكيراتين، وهي العملية الطبيعية المسؤولة عن بناء الأظافر والشعر والطبقة القرنية\n      من الجلد. الجذر المحوري ق-ر-ن يحمل معنى البروز القوي (القرن) وهو أصل صحيح في مقاييس\n      اللغة. الاشتقاق بصيغة تَفَعُّل (تَقَرُّن) طبيعي للإشارة إلى عملية تحوّل ذاتية تدريجية.\n      المصطلح موثَّق في أكثر من سبعة معاجم طبية عربية حديثة.\n\n  blind_candidates:\n    - lemma: \"تَقَرُّن\"\n      generation_method: ishtiqaq\n      justification: >-\n        مصدر الفعل تَقَرَّنَ (الباب الخامس) من جذر ق-ر-ن، على النمط تَفَعُّل الدال على\n        التحوّل الذاتي التدريجي. يصف بدقة عملية اكتساب الخلايا للطابع القرني — وهو\n        اشتقاق مطّرد ودقيق دلالياً، وتشكيله ملتزم بقياس الصرف العربي.\n\n    - lemma: \"تَقْرِين\"\n      generation_method: ishtiqaq\n      justification: >-\n        مصدر الفعل قَرَّنَ (الباب الثاني) من جذر ق-ر-ن، على النمط تَفْعِيل الدال على\n        التحويل والإحداث. يُركّز على البُعد التحويلي (جعل الشيء قرنياً)، وهو مناسب لوصف\n        عملية ترسيب الكيراتين بوصفها تحويلاً خارجياً للبنية الخلوية.\n\n    - lemma: \"قَرْنَنَة\"\n      generation_method: ishtiqaq\n      justification: >-\n        مصدر رباعي على وزن فَعْلَلَة باعتبار 'قَرَّنَ' جذراً رباعياً مرتجَلاً.\n        النمط فَعْلَلَة منتج في المصطلحية العلمية الحديثة للدلالة على عمليات تحويلية\n        تقنية. غير أن هذا التشكيل أقل طبيعية من تَقَرُّن لأنه يفترض رباعية الجذر.\n\n    - lemma: \"كَيْرَتَنَة\"\n      generation_method: taarib\n      justification: >-\n        تعريب مقترح من الأصل اليوناني-اللاتيني keratinization عبر انتزاع جذع\n        كَيْرَتِن (keratin بعد حذف اللاحقة -in) وإلحاق لاحقة المصدر العربي -نة.\n        يُذكر كملاذ أخير إذ تقبّل لام التعريف والنسبة (كيرتني). غير أن وجود اشتقاق\n        عربي أصيل (تَقَرُّن) يجعل هذا التعريب غير ضروري.\n\n\n# ── المرحلة ٢: جمع الأدلة ──────────────────────────────────\n# استعلامات منفّذة: ٤\n#   ١. مطابقة دفعية (تقرن + المرشحات الأربعة)\n#   ٢. الجسر الإنجليزي (keratinization / keratinisation / cornification / keratinize)\n#   ٣. FTS بالكلمات المفتاحية (كيراتين، قرني، تقرن)\n#   ٤. مقاييس اللغة (dictionary_id=151، جذر قرن)\nstage2_evidence:\n  per_lemma:\n\n    # ─── اللمّة الموجودة ───────────────────────────────────\n    - lemma: \"تقرن\"\n      confirm:\n        - text: \"«تقرن — keratinization — Hygienics and Human Body»\"\n          source: \"المعجم الموحد لمصطلحات علم الصحة وجسم الانسان (1992)\"\n        - text: \"«تقرُّن — keratinisation — Veterinary Medicine»\"\n          source: \"المعجم الموحد لمصطلحات الطب البيطري (2010)\"\n        - text: \"«تَقَرُّن — keratinization — The Unified Medical Dictionary»\"\n          source: \"المعجم الطبي الموحد (2009)\"\n        - text: \"«تَقَرُّن — cornification — The Unified Medical Dictionary»\"\n          source: \"المعجم الطبي الموحد (2009)\"\n        - text: \"«تقرّن — cornification — انسطاح الطباقية وتحولها إلى خلايا قشرية»\"\n          source: \"معجم المصطلحات الطبية (ج.1، 1985)\"\n        - text: \"«تقرن — keratinization — نمو الكيراتين أو التحول إليه»\"\n          source: \"معجم المصطلحات الطبية (ج.3، 1997)\"\n        - text: \"«التَّقَرُّن: التحوُّل إلى مادة قَرْنيّة — cornification»\"\n          source: \"المورد الحديث (2008)\"\n        - text: \"«تقرُّن — hornification = cornification — انظر: cornification»\"\n          source: \"معجم المصطلحات الطبية (ج.3، 1997)\"\n      contradicts:\n        - text: \"«تقرن — keratosis — كل نمو قرني مثل الثؤلول والجسأة»\"\n          source: \"معجم المصطلحات الطبية (ج.3، 1997)\"\n          conflict: >-\n            هذا المدخل يربط 'تقرن' بمصطلح keratosis (نمو قرني مرضي كالثؤلول والجسأة)\n            وهو مفهوم مختلف عن keratinization (العملية الخلوية الطبيعية). يكشف هذا\n            عن تعدد دلالي في استخدامات المصطلح.\n        - text: \"«تَقَرُّن — keratoplasia — The Unified Medical Dictionary»\"\n          source: \"المعجم الطبي الموحد (2009)\"\n          conflict: >-\n            keratoplasia تشير إلى التكوّن القرني بمعنى أوسع (أحياناً مرضي)، وليست\n            مرادفاً دقيقاً لـ keratinization بمعناها الخلوي الدقيق.\n      expands:\n        - text: \"«تَقَرُّنُ الجِلْد — keratoderma»\"\n          source: \"المعجم الطبي الموحد (2009)\"\n          addition: >-\n            يُظهر أن 'تقرن' يُستخدم في مركبات مقيّدة مثل 'تقرّن الجلد'\n            للدلالة على حالات التقرّن في مواضع بعينها.\n        - text: \"«اختِبارُ التَّقَرُّنِ المَهْبِلِيّ (لفعالية الاستروجين) — vaginal cornification test»\"\n          source: \"المعجم الطبي الموحد (2009)\"\n          addition: \"يُستخدم المصطلح في تركيبات طبية مركّبة مضافة.\"\n\n    # ─── المرشحات من المرحلة ١ ────────────────────────────\n    - lemma: \"تَقَرُّن\"\n      confirm:\n        - text: \"«تقرُّن — keratinization / keratinisation / cornification»\"\n          source: \"متعدد (المعجم الطبي الموحد 2009؛ معجم المصطلحات الطبية ج.١، ج.٣؛ المورد الحديث 2008)\"\n      # ملاحظة: هذا المرشح هو ذاته اللمّة الموجودة بتشكيل كامل — الأدلة موحّدة\n\n    - lemma: \"تَقْرِين\"\n      evidence_status: \"no_material_found\"\n\n    - lemma: \"قَرْنَنَة\"\n      evidence_status: \"no_material_found\"\n\n    - lemma: \"كَيْرَتَنَة\"\n      evidence_status: \"no_material_found\"\n\n\n# ── المرحلة ٣: التحليل اللغوي للمّات ──────────────────────\nstage3_analysis:\n  per_lemma:\n\n    # ─── اللمّة الموجودة ───────────────────────────────────\n    - lemma: \"تقرن\"\n      decision: confirmed\n      decision_reason: >-\n        اللمّة موثّقة بصيغة تَقَرُّن (مصدر الباب الخامس) في أكثر من سبعة معاجم طبية\n        عربية حديثة معتمدة، وتُقابل keratinization وkeratinisation وcornification.\n        الاشتقاق صحيح على وزن تَفَعُّل من الجذر ق-ر-ن. غير أن الرسم في السجل الحالي\n        مجرَّد من التشكيل؛ يجب تحديثه إلى تَقَرُّن.\n      evidence_assessment:\n        case: mixed\n      morphological_fit: >-\n        وزن تَفَعُّل مطّرد للدلالة على عملية تحوّل ذاتية تدريجية (تَكلُّس، تَصلُّب،\n        تَقَرُّح). يناسب تماماً مفهوم اكتساب الخلايا للطابع القرني تدريجياً.\n      polysemy_note: >-\n        يرصد المعجم التداخلَ بين keratinization (عملية طبيعية) وkeratosis (حالة\n        مرضية)؛ بعض المعاجم تستخدم تقرّن لكليهما. في سياق هذه المجموعة يُقصد\n        المعنى الأول (العملية الطبيعية).\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: >-\n        اللمّة الوحيدة في المجموعة؛ تختص بالعملية الخلوية الطبيعية (ترسّب الكيراتين\n        وتحوّل الخلايا إلى مادة قرنية)، في مقابل مصطلح 'تقرُّن الجلد' (keratoderma)\n        الذي يستخدمها في سياق مرضي مقيَّد.\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"تَقَرُّن\"\n\n    # ─── مرشحات المرحلة ١ ─────────────────────────────────\n    - lemma: \"تَقَرُّن\"\n      source: stage1\n      decision: removed\n      decision_reason: >-\n        هذا المرشح مطابق للمّة الموجودة (تقرن) بعد إضافة التشكيل؛ تمت معالجته\n        ضمن اللمّة الأصلية عبر إجراء update_lemma. لا إجراء إضافي مطلوب.\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n\n    - lemma: \"تَقْرِين\"\n      source: stage1\n      decision: removed\n      decision_reason: >-\n        لا أدلة معجمية على استخدام تَقْرِين بمعنى keratinization في أي معجم\n        طبي أو علمي. وزن تَفْعِيل يُفيد التعدية ولا يناسب وصف العملية الخلوية\n        الذاتية. تَقَرُّن (الباب الخامس) أدق وأوسع تداولاً.\n      evidence_assessment:\n        case: no_material\n      mwe_check:\n        is_mwe: false\n\n    - lemma: \"قَرْنَنَة\"\n      source: stage1\n      decision: removed\n      decision_reason: >-\n        لا وجود لهذا المصطلح في أي من المعاجم المستعلَمة. الجذر الرباعي المفترَض\n        (قرنن) غير وارد في قوائم الجذور العربية. لا يجتاز اختبار التثبيت المعجمي.\n      evidence_assessment:\n        case: no_material\n      mwe_check:\n        is_mwe: false\n\n    - lemma: \"كَيْرَتَنَة\"\n      source: stage1\n      decision: removed\n      decision_reason: >-\n        تعريب مقترح غير مسجَّل في المعاجم. وجود الاشتقاق العربي الأصيل تَقَرُّن\n        يُغني عن التعريب وفق مبدأ إيثار العربي. لا يجتاز بوابة الضرورة.\n      evidence_assessment:\n        case: no_material\n      mwe_check:\n        is_mwe: false\n\n\n# ── المرحلة ٤: التعريف والأمثلة ────────────────────────────\nstage4_content:\n  definition:\n    current: \"عملية عضوية يتم فيها ترسيب الكيراتين في الخلايا وتصبح الخلايا قرنية (كما في الأظافر والشعر)\"\n    assessment:\n      decision: revise\n      reason: >-\n        التعريف الحالي يعتمد على صياغة ترجمية ('يتم فيها') غير اعتيادية في المعجمية\n        العربية. كما أن 'عملية عضوية' أقل دقة من 'عملية خلوية' في السياق البيولوجي.\n        يستحسن صياغة تعريف مصطلحي واضح الجنس والفصل بأسلوب المعجم الوسيط.\n    authored:\n      - type: terminological\n        text: >-\n          عَمَلِيَّةٌ خَلَوِيَّةٌ تَتَّخِذُ فِيهَا خَلَايَا الأَنسِجَةِ الطَّابَعَ القَرنِيَّ\n          بِتَرَاكُمِ مَادَّةِ الكِيرَاتِينِ فِيهَا، وَيَجرِي ذَلِكَ طَبِيعِيّاً فِي تَكَوُّنِ\n          الأَظَافِرِ وَالشَّعَرِ وَالطَّبَقَةِ القَرنِيَّةِ مِنَ الجِلد.\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: >-\n          يُشكِّل التَّقَرُّنُ العمليةَ التي تتحوّل فيها الخلايا الطلائية إلى خلايا\n          قرنية (كيراتينية) متقشِّرة عديمة النواة. يبدأ الكيراتين بروتيناً ليفياً ضمن\n          الخلايا ثم يتراكم حتى يملأها فتفقد وظائفها الحيوية وتتصلّب. تشمل نماذجه\n          تكوُّن صفيحة الظفر، ونمو قضيب الشعر، وتجديد البشرة.\n    actions:\n      - command: update_definition\n        params:\n          synset_id: \"awn4-13526452-n\"\n          definition_index: 0\n          text: >-\n            عَمَلِيَّةٌ خَلَوِيَّةٌ تَتَّخِذُ فِيهَا خَلَايَا الأَنسِجَةِ الطَّابَعَ القَرنِيَّ\n            بِتَرَاكُمِ مَادَّةِ الكِيرَاتِينِ فِيهَا، وَيَجرِي ذَلِكَ طَبِيعِيّاً فِي تَكَوُّنِ\n            الأَظَافِرِ وَالشَّعَرِ وَالطَّبَقَةِ القَرنِيَّةِ مِنَ الجِلد.\n      - command: add_definition\n        params:\n          synset_id: \"awn4-13526452-n\"\n          text: >-\n            يُشكِّل التَّقَرُّنُ العمليةَ التي تتحوّل فيها الخلايا الطلائية إلى خلايا\n            قرنية (كيراتينية) متقشِّرة عديمة النواة. يبدأ الكيراتين بروتيناً ليفياً ضمن\n            الخلايا ثم يتراكم حتى يملأها فتفقد وظائفها الحيوية وتتصلّب. تشمل نماذجه\n            تكوُّن صفيحة الظفر، ونمو قضيب الشعر، وتجديد البشرة.\n\n  examples:\n    per_lemma:\n      - lemma: \"تَقَرُّن\"\n        examples:\n          - text: >-\n              تُعدُّ ظاهرةُ التَّقَرُّنِ في خلايا البشرةِ مسؤولةً عن تكوينِ\n              الطبقةِ الواقيةِ التي تحمي الجلدَ من العوامل الخارجية.\n            type: usage\n          - text: >-\n              يُسفر اضطرابُ التَّقَرُّنِ الطبيعي لخلايا الجريبِ الشعري عن\n              حالاتٍ جلدية مزمنة كالكيراتوسيس الشعيري.\n            type: usage\n    actions:\n      - command: add_synset_example\n        params:\n          synset_id: \"awn4-13526452-n\"\n          text: >-\n            تُعدُّ ظاهرةُ التَّقَرُّنِ في خلايا البشرةِ مسؤولةً عن تكوينِ\n            الطبقةِ الواقيةِ التي تحمي الجلدَ من العوامل الخارجية.\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: >-\n            يُسفر اضطرابُ التَّقَرُّنِ الطبيعي لخلايا الجريبِ الشعري عن\n            حالاتٍ جلدية مزمنة كالكيراتوسيس الشعيري.\n\n\n# ── المرحلة ٥: الإثراء (البيانات الوصفية) ─────────────────\nstage5_enrichment:\n  per_entry:\n    - lemma: \"تَقَرُّن\"\n      entry_id: \"{auto}\"\n      root: \"قرن\"\n      maqayis_quote: >-\n        «الْقَافُ وَالرَّاءُ وَالنُّونُ أَصْلَانِ صَحِيحَانِ، أَحَدُهُمَا يَدُلُّ عَلَى\n        جَمْعِ شَيْءٍ إِلَى شَيْءٍ، وَالْآخَرُ شَيْءٌ يَنْتَأُ بِقُوَّةٍ وَشِدَّةٍ …\n        وَالْأَصْلُ الْآخَرُ: الْقَرْنُ لِلشَّاةِ وَغَيْرِهَا، وَهُوَ نَاتِئٌ قَوِيٌّ»\n\n  per_sense:\n    - lemma: \"تَقَرُّن\"\n      sense_id: \"{auto}\"\n      nuance: >-\n        اللمّة الوحيدة في المجموعة؛ تُختص بالعملية الخلوية الطبيعية المتمثّلة في\n        تراكم الكيراتين وتحوّل الخلايا إلى مادة قرنية، وتتمايز عن مصطلح 'تقرُّن\n        الجلد' (keratoderma) الخاص بحالة مرضية، وعن 'الكيراتوز' (keratosis)\n        الذي يُعنى بالنموّ القرني الشاذ.\n\n  synset:\n    cultural_fit: lexical_gap\n\n  actions:\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"قرن\",\"maqayis\":\"«الْقَافُ وَالرَّاءُ وَالنُّونُ أَصْلَانِ صَحِيحَانِ، أَحَدُهُمَا يَدُلُّ عَلَى جَمْعِ شَيْءٍ إِلَى شَيْءٍ، وَالْآخَرُ شَيْءٌ يَنْتَأُ بِقُوَّةٍ وَشِدَّةٍ … وَالْأَصْلُ الْآخَرُ: الْقَرْنُ لِلشَّاةِ وَغَيْرِهَا، وَهُوَ نَاتِئٌ قَوِيٌّ»\"}'\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"nuance\":\"اللمّة الوحيدة في المجموعة؛ تُختص بالعملية الخلوية الطبيعية لتراكم الكيرات