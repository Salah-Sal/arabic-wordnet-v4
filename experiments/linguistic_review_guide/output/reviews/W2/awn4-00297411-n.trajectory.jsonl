{"type":"tool_result","timestamp":"2026-03-19T06:40:01.017Z","tool_id":"run_shell_command_1773902400506_0","status":"success","output":"CREATE TABLE dictionaries (\n    id            INTEGER PRIMARY KEY AUTOINCREMENT,\n    key           TEXT NOT NULL UNIQUE,\n    name_ar       TEXT,\n    name_en       TEXT,\n    source_type   TEXT NOT NULL DEFAULT 'ocr',  -- 'ocr' | 'hawramani' | 'arabterm'\n    group_key     TEXT,\n    period        TEXT,                          -- 'modern' | 'classical'\n    author        TEXT,\n    death_year    INTEGER,\n    metadata      TEXT DEFAULT '{}'\n);\nCREATE TABLE sqlite_sequence(name,seq);\nCREATE TABLE entries (\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\n    dictionary_id   INTEGER NOT NULL REFERENCES dictionaries(id),\n    headword        TEXT NOT NULL,\n    headword_bare   TEXT NOT NULL,\n    headword_norm   TEXT NOT NULL,\n    root            TEXT,\n    root_source     TEXT,                        -- 'ocr' | 'camel' | NULL\n    pos             TEXT,\n    form            TEXT,\n    is_partial      INTEGER NOT NULL DEFAULT 0,\n    definitions_text TEXT NOT NULL DEFAULT '',\n    translation_en  TEXT,\n    translation_fr  TEXT,\n    domain          TEXT,\n    external_id     TEXT,\n    UNIQUE(external_id)\n);\nCREATE TABLE definitions (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    entry_id    INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE,\n    sense_index INTEGER NOT NULL DEFAULT 0,\n    text        TEXT NOT NULL,\n    is_raw      INTEGER NOT NULL DEFAULT 0,\n    UNIQUE(entry_id, sense_index)\n);\nCREATE TABLE examples (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    entry_id    INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE,\n    idx         INTEGER NOT NULL DEFAULT 0,\n    type        TEXT,\n    text        TEXT NOT NULL,\n    attribution TEXT,\n    UNIQUE(entry_id, idx)\n);\nCREATE TABLE plurals (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    entry_id    INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE,\n    idx         INTEGER NOT NULL DEFAULT 0,\n    text        TEXT NOT NULL,\n    UNIQUE(entry_id, idx)\n);\nCREATE TABLE derived_forms (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    entry_id    INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE,\n    idx         INTEGER NOT NULL DEFAULT 0,\n    text        TEXT NOT NULL,\n    UNIQUE(entry_id, idx)\n);\nCREATE TABLE cross_refs (\n    id          INTEGER PRIMARY KEY AUTOINCREMENT,\n    entry_id    INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE,\n    idx         INTEGER NOT NULL DEFAULT 0,\n    text        TEXT NOT NULL,\n    UNIQUE(entry_id, idx)\n);\nCREATE TABLE provenance (\n    entry_id          INTEGER PRIMARY KEY REFERENCES entries(id) ON DELETE CASCADE,\n    page_number       TEXT,\n    page_file         TEXT,\n    entry_index       INTEGER,\n    volume            TEXT,\n    hawramani_post_id INTEGER,\n    hawramani_slug    TEXT,\n    source_uri        TEXT\n);\nCREATE INDEX idx_entries_root ON entries(root);\nCREATE INDEX idx_entries_root_dict ON entries(root, dictionary_id);\nCREATE INDEX idx_entries_headword_bare ON entries(headword_bare);\nCREATE INDEX idx_entries_headword_norm ON entries(headword_norm);\nCREATE INDEX idx_entries_headword_dict ON entries(headword_bare, dictionary_id);\nCREATE INDEX idx_entries_dict ON entries(dictionary_id);\nCREATE INDEX idx_entries_pos ON entries(pos);\nCREATE INDEX idx_defs_entry ON definitions(entry_id);\nCREATE INDEX idx_examples_entry ON examples(entry_id);\nCREATE INDEX idx_examples_type ON examples(type);\nCREATE INDEX idx_plurals_entry ON plurals(entry_id);\nCREATE INDEX idx_derived_entry ON derived_forms(entry_id);\nCREATE INDEX idx_crossrefs_entry ON cross_refs(entry_id);\nCREATE INDEX idx_prov_pagefile ON provenance(page_file);\nCREATE VIRTUAL TABLE entries_fts USING fts5(\n    headword, headword_bare, headword_norm, root,\n    definitions_text,\n    content=entries, content_rowid=id,\n    tokenize='unicode61 remove_diacritics 2'\n)\n/* entries_fts(headword,headword_bare,headword_norm,root,definitions_text) */;\nCREATE TABLE IF NOT EXISTS 'entries_fts_data'(id INTEGER PRIMARY KEY, block BLOB);\nCREATE TABLE IF NOT EXISTS 'entries_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;\nCREATE TABLE IF NOT EXISTS 'entries_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);\nCREATE TABLE IF NOT EXISTS 'entries_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;\nCREATE TRIGGER entries_ai AFTER INSERT ON entries BEGIN\n    INSERT INTO entries_fts(rowid, headword, headword_bare, headword_norm, root,\n                            definitions_text)\n    VALUES (new.id, new.headword, new.headword_bare, new.headword_norm, new.root,\n            new.definitions_text);\nEND;\nCREATE TRIGGER entries_ad AFTER DELETE ON entries BEGIN\n    INSERT INTO entries_fts(entries_fts, rowid, headword, headword_bare, headword_norm,\n                            root, definitions_text)\n    VALUES ('delete', old.id, old.headword, old.headword_bare, old.headword_norm,\n            old.root, old.definitions_text);\nEND;\nCREATE TRIGGER entries_au AFTER UPDATE ON entries BEGIN\n    INSERT INTO entries_fts(entries_fts, rowid, headword, headword_bare, headword_norm,\n                            root, definitions_text)\n    VALUES ('delete', old.id, old.headword, old.headword_bare, old.headword_norm,\n            old.root, old.definitions_text);\n    INSERT INTO entries_fts(rowid, headword, headword_bare, headword_norm, root,\n                            definitions_text)\n    VALUES (new.id, new.headword, new.headword_bare, new.headword_norm, new.root,\n            new.definitions_text);\nEND;\nCREATE VIRTUAL TABLE entries_translations_fts USING fts5(\n    translation_en, translation_fr, domain,\n    content=entries, content_rowid=id,\n    tokenize='unicode61 remove_diacritics 2'\n)\n/* entries_translations_fts(translation_en,translation_fr,domain) */;\nCREATE TABLE IF NOT EXISTS 'entries_translations_fts_data'(id INTEGER PRIMARY KEY, block BLOB);\nCREATE TABLE IF NOT EXISTS 'entries_translations_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID;\nCREATE TABLE IF NOT EXISTS 'entries_translations_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB);\nCREATE TABLE IF NOT EXISTS 'entries_translations_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID;\nCREATE TRIGGER entries_trans_ai AFTER INSERT ON entries BEGIN\n    INSERT INTO entries_translations_fts(rowid, translation_en, translation_fr, domain)\n    VALUES (new.id, new.translation_en, new.translation_fr, new.domain);\nEND;\nCREATE TRIGGER entries_trans_ad AFTER DELETE ON entries BEGIN\n    INSERT INTO entries_translations_fts(entries_translations_fts, rowid,\n                                         translation_en, translation_fr, domain)\n    VALUES ('delete', old.id, old.translation_en, old.translation_fr, old.domain);\nEND;\nCREATE TRIGGER entries_trans_au AFTER UPDATE ON entries BEGIN\n    INSERT INTO entries_translations_fts(entries_translations_fts, rowid,\n                                         translation_en, translation_fr, domain)\n    VALUES ('delete', old.id, old.translation_en, old.translation_fr, old.domain);\n    INSERT INTO entries_translations_fts(rowid, translation_en, translation_fr, domain)\n    VALUES (new.id, new.translation_en, new.translation_fr, new.domain);\nEND;\nCREATE INDEX idx_entries_root_notnull\n           ON entries(root) WHERE root IS NOT NULL;\nCREATE INDEX idx_entries_headword_norm_cover\n           ON entries(headword_norm, dictionary_id, headword, headword_bare,\n                     root, root_source, pos, form);\nCREATE TABLE sqlite_stat1(tbl,idx,stat);\nCREATE TABLE sqlite_stat4(tbl,idx,neq,nlt,ndlt,sample);"}
