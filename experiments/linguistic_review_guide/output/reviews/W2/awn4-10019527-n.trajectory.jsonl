death_year\":null},\n{\"entry_id\":75454,\"dictionary_id\":2,\"headword\":\"المُحْدَثُ\",\"headword_bare\":\"المحدث\",\"headword_norm\":\"المحدث\",\"root\":\"حدث\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"الأمْرُ المُبْتَدَعُ الذى لم يَكُنْ مَعْرُوفًا (في علم أصول الفِقْه): مالمْ يَرِدْ في كِتابٍ ولا سُنَّةٍ ولا إجْماعٍ مَوْضِعٌ في طريقِ مَكَّةَ, على مَسافَةِ سِتَّةِ أَمْيالٍ من التَّنْعِيمِ؛ كان فيه قَصْرٌ وقِبابٌ مُتفرِّقةٌ وبِئْرانِ ماؤُهما عَذْبٌ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":75455,\"dictionary_id\":2,\"headword\":\"المُحْدِثُ\",\"headword_bare\":\"المحدث\",\"headword_norm\":\"المحدث\",\"root\":\"حدث\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"(من النياق): الحديثةُ النَّتاجِ (عند الفقهاء): الذى يَبْتَدِعُ ما لم يَكُنْ مَعْرُوفًا في كِتابٍ ولا سُنَّةٍ ولا إجْماعٍ (في الأدبِ والعِلْمِ والفَنِّ): المُجدِّدُ فيه\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":5192,\"dictionary_id\":1,\"headword\":\"المُحدَّث\",\"headword_bare\":\"المحدث\",\"headword_norm\":\"المحدث\",\"root\":\"حدث\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"ما لم يكن معروفًا في كتاب ولا سُنّة ولا إجماع الصَّادق الظَّنّ كأنما حُدِّث بما ظنَّ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"dict_name_en\":\"Al-Mu'jam Al-Wasit\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":5193,\"dictionary_id\":1,\"headword\":\"المُحدِّث\",\"headword_bare\":\"المحدث\",\"headword_norm\":\"المحدث\",\"root\":\"حدث\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"المجدد في العلم والفن راوى حديث رسول الله صلَّى الله عليه وسلَّم\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"dict_name_en\":\"Al-Mu'jam Al-Wasit\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":972359,\"dictionary_id\":149,\"headword\":\"خَار\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خر\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"خَار:\\nآخره راء: موضع بالري، منه أبو إسماعيل إبراهيم ابن المختار الخاري الرازي، سمع محمد بن إسحاق ابن بشّار وشعبة بن الحجاج، روى عنه محمد بن سعيد الأصبهاني ومحمد بن حميد الرازي، قاله الحاكم أبو أحمد.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_52\",\"dict_name_ar\":\"معجم البلدان لياقوت الحموي\",\"dict_name_en\":\"Yāqūt al-Ḥamawī, Muʿjam al-Buldān (d. 1229)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":1229},\n{\"entry_id\":893570,\"dictionary_id\":131,\"headword\":\"خار\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خر\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"(خار)الثور خورا وخوارا صَاح وَفُلَان خؤورا ضعف وانكسر فَهُوَ خائر وخوار وَيُقَال خار الْحر وخار الْبرد فتر وَسكن وَفُلَانًا خورا أصَاب خورانه\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_35\",\"dict_name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"dict_name_en\":\"Academy of the Arabic Language in Cairo, al-Muʿjam al-Wasīṭ (1998)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":1998},\n{\"entry_id\":893571,\"dictionary_id\":131,\"headword\":\"خار\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خر\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"(خار) خيرا وخيارة صَار ذَا خير وَله فِي الْأَمر جعل لَهُ فِيهِ الْخَيْر وَأَعْطَاهُ مَا هُوَ خير لَهُ وَفُلَانًا غَلبه وفضله فِي المخايرة فَكَانَ خيرا مِنْهُ يُقَال خايره فخاره وَالشَّيْء خيرا وَخيرا وخيرة وخيرة انتقاه واصطفاه وَفِي التَّنْزِيل الْعَزِيز {وَرَبك يخلق مَا يَشَاء ويختار مَا كَانَ لَهُم الْخيرَة} وَالشَّيْء على غَيره فَضله عَلَيْهِ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_35\",\"dict_name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"dict_name_en\":\"Academy of the Arabic Language in Cairo, al-Muʿjam al-Wasīṭ (1998)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":1998},\n{\"entry_id\":922543,\"dictionary_id\":144,\"headword\":\"خار\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خر\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"خار\\nعن الفارسية بمعنى شوك، أو عن خوار بمعنى حقير أو ذليل. يستخدم للذكور.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_48\",\"dict_name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"dict_name_en\":\"Sultan Qaboos Encyclopedia of Arab Names (Sultan Qaboos University, 1985)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":922542,\"dictionary_id\":144,\"headword\":\"خَارّ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خر\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"خَارّ\\nمن (خ ر ر) الساقط من علو إلى أسفل بصوت، والساجد، والمتتعم، ومن يهجم على غيره من مكان لا يعرفه، والماء الذي يشق الأرض.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_48\",\"dict_name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"dict_name_en\":\"Sultan Qaboos Encyclopedia of Arab Names (Sultan Qaboos University, 1985)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":84743,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خور\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"الثَّوْرُ وغَيْرُه: صاح الشَّىءُ: ضَعُفَ وانْكَسَر\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":84745,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خور\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"من تحتنا يخور: أي يضعف أو ينهار (للتراب) عَزِيمَتُه: ضَعُفَت هِمَّتُه الحرُّ أو البَرْدُ: فَتَرَ وسَكَنَ (مجاز) فلانٌ فلانًا: أصاب خَوْرانَه (دبُرَه)\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":84754,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خور\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"خَرَجْنَ من الخُوارِ وعُدْنَ فِيهِ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":85350,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خور\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"خارت عزيمته: ضعفت همته الحر أو البرد: فتر وسكن (مجاز) فلان فلانا: أصاب خورانه (دبره)\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":85004,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خير\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"فلانٌ ــــ خَيْرًا, وخِيارَةً: صارَ ذا خَيْرٍ اللهُ لفلان: اخْتَارَ له خَيْرَ الأَمْرَيْنِ خارَ فلانٌ لِفُلان خِرْتُ لَكَ كما أَخِيرُ لِنَفْسِى\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":85005,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خير\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"لفلان: أعطاه ما هو خير له لفلان في الأمر: جعل له ما فيه الخير فلانٌ فلانًا: غلبه وفضله في المخابرة فكان خيرًا منه الشيءَ: انتقاه واصطفاه الشيءَ على غيره خيرا وخيرة وخيرة وفضله عليه\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":85592,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خير\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"فلانٌ ــــ خَيْرًا, وخْيارَةً: صارَ ذا خَيْرٍ. فهو خائِرٌ اللهُ لفلان : اخْتارَ له خَيْرَ الأَمْرَيْنِ يُقال: خارَ فلانٌ لِفُلان خِرْتُ لَكَ كما أَخِيرُ لِنَفْسِى خُرْتَ يا رَجُلُ, فَأَنْت خائِرٌ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":85593,\"dictionary_id\":2,\"headword\":\"خارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خير\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"لفُلان: أَعْطاهُ ما هو خَيْرٌ له. لِفُلان فى الأَمْرِ: جَعَلَ لـه مـا فِيه الخَيْرُ. فلانٌ فلانًا: غَلَبَه وفَضَلَه فى الخُايَرَةِ فكان خَيْرًا منه. الشَّيءَ: انْتَقاهُ واصْطَفاهُ. فلانًا لِكَذا: اخْتارَهُ له. الشىءَ على غَيْرِه خَيْرًا, وخِيرَةً, وخِيَرَةً, وخِيَرًا, وخِيَرَةً: فَضَّلَه عليه.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":85348,\"dictionary_id\":2,\"headword\":\"خَارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خور\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"الثَّوْرُ وغَيْرُه: صاح الشّيءُ: ضَعُفَ وانْكَسَر فلانٌ: ضعف وجبن\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":8268,\"dictionary_id\":1,\"headword\":\"خار\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خور\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"الثَّورُ -ُ خَوْراً, وخُوَاراً: صاح فلانٌ خُوُوراً: ضعف وانكسر فلاناً خَوْراً: أصاب خَوَرَانَهُ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"dict_name_en\":\"Al-Mu'jam Al-Wasit\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":8384,\"dictionary_id\":1,\"headword\":\"خَارَ\",\"headword_bare\":\"خار\",\"headword_norm\":\"خار\",\"root\":\"خير\",\"root_source\":\"ocr\",\"pos\":\"verb\",\"form\":\"I\",\"definitions_text\":\"خيراً, وخِيارةً: صار ذا خَيْر له في الأمر: جعل له فيه الخير أعطاه ما هو خير له فلاناً: غلبه وفضله في المخابرة فكان خيراً منه الشيء خيراً, وخيراً, وخِيارةً, وخيرةً: انتقاه واصطفاه الشيء على غيره: فضله عليه\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"dict_name_en\":\"Al-Mu'jam Al-Wasit\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null}]"}
