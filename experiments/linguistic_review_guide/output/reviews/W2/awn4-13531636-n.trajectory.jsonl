{"type":"tool_result","timestamp":"2026-03-17T15:52:54.784Z","tool_id":"run_shell_command_1773762774609_0","status":"success","output":"# ═══════════════════════════════════════════════════════════════\n# مخطط مخرجات المراجعة — Review Pipeline v2.0 Output Template\n# ═══════════════════════════════════════════════════════════════\n#\n# هذا الملف يحدد البنية الكاملة لمخرجات YAML لكل مجموعة ترادفية.\n# This file defines the complete YAML output structure for each synset review.\n#\n# ── اصطلاحات — Conventions ──\n# - Field names: English (snake_case)\n# - Analysis text: Arabic\n# - Decision enums: English lowercase\n# - DRY: omit fields with null/empty/false values\n# - {auto} placeholder IDs: resolved downstream by apply_reviews_v2.py\n# - {synset_id}: replaced by the actual synset ID being reviewed\n# - Command names: exact WordnetEditor method names (English)\n#\n# ═══════════════════════════════════════════════════════════════\n\n# ── المرحلة ١: المراجعة والتوليد (بدون أدلة) ──────────────\n# Stage 1: Review + Generate (no evidence)\n#\n# The reviewer first reads the MASKED synset info (no lemmas visible),\n# then generates 4 fully-diacritized candidate lemmas. Then reads the\n# full synset info and produces an initial linguistic assessment.\nstage1_review:\n  assessment:\n    concerns:                           # list of issues found\n      - \"...\"\n    observations: \"...\"                 # free-form Arabic analysis\n  blind_candidates:                     # 4 candidates, NO evidence yet\n    - lemma: \"لَمَّة\"                   # full tashkeel mandatory\n      generation_method: ishtiqaq       # majaz | ishtiqaq | tarkib | taarib\n      justification: \"...\"\n    - lemma: \"مُرَشَّح٢\"\n      generation_method: tarkib\n      justification: \"...\"\n    - lemma: \"مُرَشَّح٣\"\n      generation_method: majaz\n      justification: \"...\"\n    - lemma: \"مُرَشَّح٤\"\n      generation_method: ishtiqaq\n      justification: \"...\"\n\n\n# ── المرحلة ٢: جمع الأدلة ────────────────────────────────\n# Stage 2: Evidence Gathering (interactive, in-session)\n#\n# The reviewer queries the Arabic dictionary DB via sqlite3 -json\n# to gather evidence for ALL lemmas (existing + Stage 1 candidates).\n# Target query budget: 5-8 queries total.\nstage2_evidence:\n  per_lemma:                            # covers BOTH existing lemmas AND Stage 1 candidates\n    - lemma: \"لَمَّة\"\n      confirm:                          # dictionary text supporting this lemma for the synset\n        - text: \"«نص المعجم»\"\n          source: \"اسم المعجم\"\n      contradicts:                      # dictionary text contradicting this usage\n        - text: \"«نص المعجم»\"\n          source: \"اسم المعجم\"\n          conflict: \"سبب التعارض\"\n      expands:                          # dictionary text expanding on this meaning\n        - text: \"«نص المعجم»\"\n          source: \"اسم المعجم\"\n          addition: \"ما يضيفه الدليل\"\n      # When ALL three categories are empty, use this instead:\n      # evidence_status: \"no_material_found\"\n\n\n# ── المرحلة ٣: التحليل اللغوي للّمات ────────────────────\n# Stage 3: Lemma Linguistic Analysis\n#\n# For each lemma (existing + candidates), produce a linguistic analysis\n# with include/exclude decision and generate actions.\nstage3_analysis:\n  per_lemma:\n    # ── existing lemma example ──\n    - lemma: \"لَمَّة\"                   # exactly as in synset_info\n      decision: confirmed               # confirmed | removed\n      decision_reason: \"...\"            # Arabic explanation\n      evidence_assessment:\n        case: confirm_only              # confirm_only | mixed | contradicts_only | no_material\n      mwe_check:\n        is_mwe: false\n        # mwe_type: idafi              # idafi | wasfi | mazji (only if is_mwe: true)\n      # nuance_differentiation: \"...\"  # mandatory if confirmed — how this lemma differs from siblings\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"لَمَّة\"\n\n    # ── Stage 1 candidate example ──\n    - lemma: \"مُرَشَّح\"\n      source: stage1                    # mark Stage 1 candidates\n      decision: confirmed               # confirmed | removed\n      decision_reason: \"...\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: create_entry\n          params: {lemma: \"مُرَشَّح\", pos: n}\n        - command: add_sense\n          params: {entry_id: \"{auto}\", synset_id: \"{synset_id}\"}\n\n    # ── removed lemma example (minimal) ──\n    - lemma: \"لَمَّة_مَرْفوضة\"\n      decision: removed\n      decision_reason: \"...\"\n      # No actions needed for removed lemmas\n\n  # Synset-level corrections (if needed)\n  # synset_actions:\n  #   - command: update_synset\n  #     params: {synset_id: \"{synset_id}\", pos: n}\n\n\n# ── المرحلة ٤: التعريف والأمثلة ──────────────────────────\n# Stage 4: Definitions & Examples\n#\n# Assess and enrich the synset's Arabic definition and examples.\n# Only covers CONFIRMED lemmas from Stage 3.\nstage4_content:\n  definition:\n    current: \"التعريف الحالي\"            # current Arabic definition (from synset_info)\n    assessment:\n      decision: revise                  # retain | revise\n      reason: \"...\"                     # why revise/retain\n    authored:                           # new/revised definitions (only if revise)\n      - type: terminological            # terminological | linguistic | encyclopedic\n        text: \"...\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: linguistic\n        text: \"...\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: \"...\"\n        # quality_check omitted if not applicable\n    actions:\n      - command: update_definition\n        params: {synset_id: \"{synset_id}\", definition_index: 0, text: \"...\"}\n      - command: add_definition\n        params: {synset_id: \"{synset_id}\", text: \"...\"}\n\n  examples:\n    per_lemma:                          # one example per confirmed lemma\n      - lemma: \"لَمَّة\"\n        examples:\n          - text: \"...\"\n            type: usage                 # usage | quran | hadith | poetry | proverb\n            source: \"مؤلَّف\"            # optional — if from a known source\n    actions:\n      - command: add_synset_example\n        params: {synset_id: \"{synset_id}\", text: \"...\"}\n      - command: add_sense_example\n        params: {sense_id: \"{auto}\", text: \"...\"}\n\n\n# ── المرحلة ٥: الإثراء (البيانات الوصفية) ─────────────────\n# Stage 5: Enrichment (metadata)\n#\n# Populate entries, senses, and synset with structured metadata,\n# packed into the WN-LMF `note` key for XML round-trip safety.\nstage5_enrichment:\n  per_entry:\n    # Single-word entry\n    - lemma: \"كِيَان\"\n      entry_id: \"{auto}\"\n      root: \"كون\"\n      maqayis_quote: \"«الْكَافُ وَالْوَاوُ وَالنُّونُ أَصْلٌ صَحِيحٌ...»\"\n    # MWE entry — per-word roots\n    - lemma: \"ذَكَاء اصْطِنَاعِيّ\"\n      entry_id: \"{auto}\"\n      roots:\n        - word: \"ذكاء\"\n          root: \"ذكو\"\n          maqayis_quote: \"«الذَّالُ وَالْكَافُ...»\"\n        - word: \"اصطناعي\"\n          root: \"صنع\"\n          maqayis_quote: \"«الصَّادُ وَالنُّونُ...»\"\n\n  per_sense:\n    - lemma: \"كِيَان\"\n      sense_id: \"{auto}\"\n      nuance: \"...\"                     # MANDATORY — how this lemma differs from siblings\n      mwe: false                        # true only for MWEs\n\n  synset:\n    cultural_fit: native                # native | lexical_gap | phraset | omission\n\n  actions:\n    # Entry-level note (single-word)\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"كون\",\"maqayis\":\"«...»\"}'\n    # Entry-level note (MWE)\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"roots\":[{\"word\":\"ذكاء\",\"root\":\"ذكو\",\"maqayis\":\"«...»\"},{\"word\":\"اصطناعي\",\"root\":\"صنع\",\"maqayis\":\"«...»\"}]}'\n    # Sense-level note\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"nuance\":\"...\",\"mwe\":false}'\n    # Synset-level note\n    - command: set_metadata\n      params:\n        entity_type: synset\n        entity_id: \"{synset_id}\"\n        key: note\n        value: '{\"cultural_fit\":\"native\"}'\n    # Confidence\n    - command: set_confidence\n      params:\n        entity_type: synset\n        entity_id: \"{synset_id}\"\n        score: 0.85\n\n\n# ═══════════════════════════════════════════════════════════════\n# مرجع الحقول — Field Reference\n# ═══════════════════════════════════════════════════════════════\n\n# ── Stage 1 Fields ──────────────────────────────────────────\n#\n# stage1_review.assessment.concerns:\n#   type: list[str]\n#   description: List of issues found during initial assessment\n#\n# stage1_review.assessment.observations:\n#   type: str\n#   description: Free-form Arabic linguistic analysis\n#\n# stage1_review.blind_candidates[].lemma:\n#   type: str\n#   description: Fully diacritized Arabic lemma\n#   required: true\n#\n# stage1_review.blind_candidates[].generation_method:\n#   type: enum\n#   values: [majaz, ishtiqaq, tarkib, taarib]\n#   description: |\n#     majaz     = semantic extension (metaphor/metonymy from existing Arabic word)\n#     ishtiqaq  = derivation from Arabic root on standard pattern\n#     tarkib    = compounding (idafi, wasfi, or mazji)\n#     taarib    = Arabization of foreign term (last resort)\n#\n# stage1_review.blind_candidates[].justification:\n#   type: str\n#   description: Arabic explanation of why this candidate fits the synset\n\n# ── Stage 2 Fields ──────────────────────────────────────────\n#\n# stage2_evidence.per_lemma[].lemma:\n#   type: str\n#   required: true\n#\n# stage2_evidence.per_lemma[].confirm[]:\n#   type: list[{text: str, source: str}]\n#   description: Dictionary quotations supporting this lemma for the synset meaning\n#\n# stage2_evidence.per_lemma[].contradicts[]:\n#   type: list[{text: str, source: str, conflict: str}]\n#   description: Dictionary quotations contradicting this usage\n#\n# stage2_evidence.per_lemma[].expands[]:\n#   type: list[{text: str, source: str, addition: str}]\n#   description: Dictionary quotations expanding on this meaning\n#\n# stage2_evidence.per_lemma[].evidence_status:\n#   type: enum\n#   values: [no_material_found]\n#   description: Only present when all three categories (confirm/contradicts/expands) are empty\n\n# ── Stage 3 Fields ──────────────────────────────────────────\n#\n# stage3_analysis.per_lemma[].lemma:\n#   type: str\n#   required: true\n#\n# stage3_analysis.per_lemma[].source:\n#   type: enum\n#   values: [stage1]\n#   description: Only present for Stage 1 candidates (absent for existing lemmas)\n#\n# stage3_analysis.per_lemma[].decision:\n#   type: enum\n#   values: [confirmed, removed]\n#   required: true\n#\n# stage3_analysis.per_lemma[].decision_reason:\n#   type: str\n#   required: true\n#   description: Arabic explanation of the decision\n#\n# stage3_analysis.per_lemma[].evidence_assessment.case:\n#   type: enum\n#   values: [confirm_only, mixed, contradicts_only, no_material]\n#\n# stage3_analysis.per_lemma[].mwe_check.is_mwe:\n#   type: bool\n#\n# stage3_analysis.per_lemma[].mwe_check.mwe_type:\n#   type: enum\n#   values: [idafi, wasfi, mazji]\n#   description: Only present if is_mwe is true\n#\n# stage3_analysis.per_lemma[].actions[].command:\n#   type: enum\n#   values: [remove_sense, update_lemma, update_entry, add_form, remove_form,\n#            create_entry, add_sense, update_synset,\n#            add_sense_relation, remove_sense_relation]\n#\n# ── Stage 3 Action Parameters ──\n#\n# remove_sense:\n#   sense_id: str        # \"{auto}\" or explicit sense ID\n#\n# update_lemma:\n#   entry_id: str        # \"{auto}\" or explicit entry ID\n#   new_lemma: str       # fully diacritized\n#\n# update_entry:\n#   entry_id: str\n#   pos: str             # n | v | a | r | s\n#\n# add_form:\n#   entry_id: str\n#   written_form: str\n#\n# remove_form:\n#   entry_id: str\n#   written_form: str\n#\n# create_entry:\n#   lemma: str           # fully diacritized\n#   pos: str             # n | v | a | r | s\n#\n# add_sense:\n#   entry_id: str        # \"{auto}\" — resolved from preceding create_entry\n#   synset_id: str       # \"{synset_id}\"\n#\n# update_synset:\n#   synset_id: str\n#   pos: str\n#\n# add_sense_relation:\n#   source_id: str       # sense ID\n#   relation_type: str   # e.g., \"derivation\", \"also\", \"similar\"\n#   target_id: str       # sense ID\n#\n# remove_sense_relation:\n#   source_id: str\n#   relation_type: str\n#   target_id: str\n\n# ── Stage 4 Fields ──────────────────────────────────────────\n#\n# stage4_content.definition.current:\n#   type: str\n#   description: Current Arabic definition from synset_info\n#\n# stage4_content.definition.assessment.decision:\n#   type: enum\n#   values: [retain, revise]\n#\n# stage4_content.definition.authored[].type:\n#   type: enum\n#   values: [terminological, linguistic, encyclopedic]\n#\n# stage4_content.definition.authored[].text:\n#   type: str\n#   description: The authored definition text in Arabic\n#\n# stage4_content.definition.authored[].quality_check:\n#   type: object\n#   properties:\n#     genus_present: bool\n#     differentia_present: bool\n#     circular: bool\n#\n# stage4_content.examples.per_lemma[].examples[].type:\n#   type: enum\n#   values: [usage, quran, hadith, poetry, proverb]\n#\n# ── Stage 4 Action Parameters ──\n