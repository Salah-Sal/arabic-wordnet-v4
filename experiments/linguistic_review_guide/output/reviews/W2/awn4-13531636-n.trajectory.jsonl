ئية.\n      mwe: false\n\n  synset:\n    cultural_fit: omission\n    # المفهوم فيزيائي حديث لا أصل له في التراث العربي القديم؛ دخل عبر الترجمة والتعريب\n    # العلمي في العصر الحديث، مستنداً إلى اقتراض الكلمة اليونانية منذ العصور الوسطى.\n\n  actions:\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"مغنط\",\"note\":\"جذر رباعي معرَّب من اليونانية μαγνήτης، لا وجود له في مقاييس ابن فارس\"}'\n\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"مغنط\",\"note\":\"جذر رباعي معرَّب من اليونانية μαγνήτης، لا وجود له في مقاييس ابن فارس\"}'\n\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"nuance\":\"مصدر الفعل المتعدي — العملية الفاعلة لإكساب المادة المغنطيسية\",\"mwe\":false}'\n\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"nuance\":\"مصدر الفعل المطاوع — اكتساب المادة ذاتها للخاصية المغنطيسية\",\"mwe\":false}'\n\n    - command: set_metadata\n      params:\n        entity_type: synset\n        entity_id: \"awn4-13531636-n\"\n        key: note\n        value: '{\"cultural_fit\":\"omission\"}'\n\n    - command: set_confidence\n      params:\n        entity_type: synset\n        entity_id: \"awn4-13531636-n\"\n        score: 0.90\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2764,"cache_read_input_tokens":41919,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2764},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"56968204-b17c-48e3-a4d4-868583b0f8c2","uuid":"74a5360c-7e7d-4dd8-9764-0385cb2e