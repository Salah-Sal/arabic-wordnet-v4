{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01AHVPATtbujjyCiCQuaYyX2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SazaQW3s8nafJmKW5XLigu","name":"Write","input":{"file_path":"/output/awn4-13533239-n.review.yaml","content":"# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية — AWN4 Review Pipeline v2 (5-Stage)\n# Synset: awn4-13533239-n  |  ILI: i107735  |  POS: n\n# المفهوم: materialization / materialisation\n# ═══════════════════════════════════════════════════════════════\n\n# ── المرحلة ١: المراجعة والتوليد ──────────────────────────────\nstage1_review:\n\n  # ب. التقييم الأولي (بعد الاطلاع على synset_info الكامل)\n  assessment:\n    concerns:\n      - \"اللمّتان الموجودتان (تجسد، تحقق) خاليتان من التشكيل — إلزامي التحديث.\"\n      - \"تحقُّق في الاستخدام الحديث تعني أساساً التثبّت والإثبات (verification) أكثر من دلالة الخروج إلى الوجود؛ مما يُوجب التأنّي في الاحتفاظ بها.\"\n      - \"التعريف الحالي (عملية الخروج إلى الوجود؛ التحول إلى واقع) مبنيٌّ على قالب ترجمي مباشر، ويفتقر إلى الجنس القريب الصريح المأخوذ من المُفرَدِمة الأعلى (عملية طبيعية).\"\n      - \"المجموعة تفتقر إلى مصطلح يُعبّر بوضوح عن الحدوث من الفراغ أو النشأة الأولى دون تحيّز مادي أو معرفي.\"\n    observations: >\n      المجموعة تمثّل مفهوماً فلسفياً دقيقاً يعبّر عن الانتقال من طور الإمكان أو الكمون إلى طور\n      الوجود الفعلي. تجسُّد يحمل بُعداً جسدياً/مادياً صريحاً يناسب تحوّل الأفكار والمجرّدات إلى\n      وجود محسوس. تحقُّق يحمل بُعداً معرفياً (إحكام الحق وصحّته وفق مقاييس ابن فارس) يُلائم\n      التثبّت من الوقوع لا مجرّد الظهور. أُولى الحلول: إضافة تكوُّن الذي يعبّر عن الحدوث دون أي\n      تحيّز دلالي خاص، ويستمدّ قوّته من الأصل الفلسفي \"كان يكون كوناً إذا وقع وحضر\".\n\n  # أ. اللمّات المرشّحة — توليد أعمى انطلاقاً من التعريف المُقنَّع فقط\n  # التعريف المقنَّع: \"عملية الخروج إلى الوجود؛ التحول إلى واقع\"\n  blind_candidates:\n    - lemma: \"تَكَوُّن\"\n      generation_method: ishtiqaq\n      justification: >\n        مصدر الفعل تكوَّن، من الجذر (ك و ن)، على وزن تَفَعُّل. دلالته الأصيلة هي الحدوث والوقوع\n        من العدم، وهو ما يُطابق تماماً مفهوم \"الخروج إلى الوجود\". وظيفياً: مصدر يعبّر عن عملية\n        لا عن حالة، فيوافق كون المُفرَدِمة الأعلى \"عملية طبيعية\".\n\n    - lemma: \"انْبِثَاق\"\n      generation_method: ishtiqaq\n      justification: >\n        مصدر الفعل انبثق، من الجذر (ب ث ق) الذي يدلّ على التفتّح والانبعاث (مقاييس اللغة). دلالته\n        العامة: بروز الشيء وظهوره من مصدر كامن. يُمكن توظيفه مجازاً في الخروج إلى الوجود،\n        غير أنه يحمل بُعداً مادياً (انبعاث سوائل أو غازات). يُدرج مرشحاً لتقييم ملاءمته.\n\n    - lemma: \"تَجَلٍّ\"\n      generation_method: majaz\n      justification: >\n        من الجذر (ج ل و) الذي يدلّ على \"انكشاف الشيء وبروزه\" (مقاييس اللغة: «الجيم واللام والحرف\n        المعتل أصل واحد وهو انكشاف الشيء وبروزه»). الإزاحة الدلالية: من كشف النقاب إلى ظهور الشيء\n        في الواقع وخروجه إلى الوجود. تعبير مستعمل في الفلسفة العربية للتعبير عن manifestation.\n\n    - lemma: \"تَمَثُّل\"\n      generation_method: ishtiqaq\n      justification: >\n        مصدر الفعل تمثَّل، من الجذر (م ث ل)، وزن تَفَعُّل. الدلالة: أخذ الشيء صورته ومثاله\n        الفعلي (تمثَّل له: ظهر في صورة ملموسة). قد يُعبّر عن تحوّل الشيء من المجرد إلى\n        المحسوس، أي \"التحول إلى واقع\" — لكن يحمل ايضاً معنى التصوّر/المحاكاة، مما قد يُشوّش.\n\n\n# ── المرحلة ٢: جمع الأدلة ────────────────────────────────────\n# الاستعلامات المُنفَّذة: ٥ استعلامات\n#  ١. مطابقة دفعية: تجسد+تحقق+تكون+انبثاق+تجل+تمثل (بصيغتَي ال- وبدونها)\n#  ٢. جسر إنجليزي: materialization/materialisation/actualization/realization/embodiment/manifestation\n#  ٣. بحث FTS عربي: خروج/وجود/تحول/واقع/مادية/تجسيد\n#  ٤. مقاييس ابن فارس: جسد/جل/جلو/كون/مثل/بثق (dictionary_id=151)\n#  ٥. مقاييس ابن فارس: حقق/حق\nstage2_evidence:\n  per_lemma:\n\n    - lemma: \"تجسد\"\n      confirm:\n        - text: \"«الشَّيءُ: صار ذا جسدٍ»\"\n          source: \"المعجم الكبير\"\n        - text: \"«(تجسد) مُطَاوع جسده»\"\n          source: \"المعجم الوسيط (hawramani)\"\n        - text: \"«التجسد: كل روح ظهر في جسم ناري أو نوري»\"\n          source: \"التوقيف على مهمات التعاريف للمناوي\"\n        - text: \"embodiment → «(1) تجسيد؛ تجسُّد / (2) تضمين؛ تضمّن / (3) مثال؛ عنوان [الشجاعة أو الإخلاص]»\"\n          source: \"المورد الحديث (2008)\"\n        - text: \"incarnation → «(1) تجسيد. تجسُّد / (2) تجسيد إلهٍ [في شكل أرضيّ]. التجسُّد؛ تجسُّد المسيح»\"\n          source: \"المورد الحديث (2008)\"\n\n    - lemma: \"تحقق\"\n      confirm:\n        - text: \"«(تحقق) الأمر صحَّ ووقع، والأمر: عرف حقيقته»\"\n          source: \"المعجم الوسيط (hawramani)\"\n        - text: \"«الأمر: صح ووقع»\"\n          source: \"المعجم الوسيط (OCR)\"\n        - text: \"«هو عند الأشاعرة مرادف للثبوت والكون والوجود. وعند المعتزلة مرادف للثبوت وأعم من الكون والوجود»\"\n          source: \"كشّاف اصطلاحات الفنون والعلوم للتهانوي\"\n        - text: \"realization → «(1) تحقيق. تحقُّق. (2) تحويل الأسهم [أو العقارات] إلى نقد. (3) إدراك؛ فهم»\"\n          source: \"المورد الحديث (2008)\"\n      contradicts:\n        - text: \"«verification» — التحقق مُقابَل لـ verification في أغلب مصطلحيات ARABTERM (المناخ، التربية، الطاقة المتجددة، اللسانيات)\"\n          source: \"ARABTERM (مصطلحيات متعددة)\"\n          conflict: \"الترجمة السائدة تعني التثبّت والإثبات، وليس الخروج إلى الوجود؛ مما يُثير اشتراكاً لفظياً مع الدلالة المقصودة.\"\n      expands:\n        - text: \"Actualization — «عملية تنتقل بواسطتها وحدة في اللغة من المستوى التجريدي إلى المستوى الفعلي في الإنجاز»\"\n          source: \"المعجم الموحد لمصطلحات اللسانيات (2002)\"\n          addition: \"يؤكد أن تحقيق (وبالتالي تحقّق) تُستعمل في سياق الانتقال من التجريدي إلى الفعلي، وهو قريب من المعنى المقصود في المجموعة.\"\n\n    - lemma: \"تَكَوُّن\"\n      confirm:\n        - text: \"«(تكون) الشيء حدث»\"\n          source: \"المعجم الوسيط (hawramani)\"\n        - text: \"«الشيء: حدث. يقال: كوَّنه فتكوَّن»\"\n          source: \"المعجم الوسيط (OCR)\"\n        - text: \"تَكَوُّن — genesis (en)\"\n          source: \"المعجم الطبي الموحد (2009)\"\n        - text: \"تَكَوُّن — poiesis (en)\"\n          source: \"المعجم الموحد لمصطلحات علم التشريح العياني (2015)\"\n        - text: \"كَوَنَ — «الكاف والواو والنون أصل يدل على الإخبار عن حدوث شيء، إما في زمان ماضٍ أو زمان راهن. يقولون: كان الشيء يكون كوناً إذا وقع وحضر»\"\n          source: \"مقاييس اللغة لابن فارس\"\n\n    - lemma: \"انْبِثَاق\"\n      confirm:\n        - text: \"emergence — «فعل انبجاس وحالة لما ينبثق للإشارة إلى مكان الفعل كإشعاع يخترق تعبير عصر أو مرحلة أدبية»\"\n          source: \"المعجم الموحد لمصطلحات اللسانيات (2002)\"\n      contradicts:\n        - text: \"«انبعاث غاز أو رائحة أو ضوء من جسم ما، دون تغيير ظاهر لشكل أو حجم الجسم» — emanation\"\n          source: \"مسرد المناخ والبيئة (ArabTerm)\"\n          conflict: \"الدلالة المعجمية السائدة هي انبعاث المواد المادية (غازات، دخان، أبخرة)، وليس الخروج المجرّد إلى الوجود.\"\n        - text: \"«الهواء والدخان من البركان» — exhalation / extrusion\"\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (2000)\"\n          conflict: \"دلالة جيولوجية/فيزيائية محددة تُناقض الاستخدام المجرّد.\"\n        - text: \"بَثَقَ — «الباء والثاء والقاف يدل على التفتّح في الماء وغيره. البثق: بثق الماء»\"\n          source: \"مقاييس اللغة لابن فارس\"\n          conflict: \"الأصل اللغوي لبثق مرتبط بانبعاث الماء وتفتّح المجاري المائية، مما يُقيّد الاستخدام المجازي.\"\n\n    - lemma: \"تَجَلٍّ\"\n      confirm:\n        - text: \"manifestation — «تجلّ / ج:تجليات»\"\n          source: \"مسرد الفلسفة وعلم النفس (ArabTerm)\"\n        - text: \"manifestation → «(1) إظهار؛ إبداء؛ جلاء. (ب) ظهور؛ تجلٍّ»\"\n          source: \"المورد الحديث (2008)\"\n      expands:\n        - text: \"جَلَوَ — «الجيم واللام والحرف المعتل أصل واحد، وقياس مطّرد، وهو انكشاف الشيء وبروزه. ويقال تجلّى الشيء إذا انكشف»\"\n          source: \"مقاييس اللغة لابن فارس\"\n          addition: \"يُثبت أن التجلّي أصله الانكشاف والبروز الحسّي، لا الحدوث والنشأة من العدم؛ وهو ما يُبعده عن دلالة المجموعة.\"\n\n    - lemma: \"تَمَثُّل\"\n      contradicts:\n        - text: \"assimilation — «عملية حيوية يتمكن الكائن الحيّ بموجبها من تحويل المواد الغذائية المتناولة إلى مواد مماثلة»\"\n          source: \"المعجم الموحد لمصطلحات علم الصيدلة (2009)\"\n          conflict: \"الدلالة البيولوجية (الاستيعاب الغذائي) بعيدة تماماً عن المفهوم.\"\n        - text: \"representation — تمثُّل (en: representation)\"\n          source: \"مسرد الفلسفة وعلم النفس (ArabTerm)\"\n          conflict: \"الدلالة الفلسفية (التمثّل المعرفي / Vorstellung) تُناقض معنى الخروج إلى الوجود.\"\n        - text: \"«(تمثل) الشيء تصوّر مثاله»\"\n          source: \"المعجم الوسيط (hawramani)\"\n          conflict: \"التصوّر الذهني نقيض الوجود الفعلي؛ مما يعكس المعنى المطلوب.\"\n        - text: \"مَثَلَ — «الميم والثاء واللام أصل صحيح يدل على مناظرة الشيء للشيء»\"\n          source: \"مقاييس اللغة لابن فارس\"\n          conflict: \"الأصل اللغوي قائم على المماثلة والمطابقة، لا على الحدوث والنشأة.\"\n\n\n# ── المرحلة ٣: التحليل اللغوي للّمات ─────────────────────────\nstage3_analysis:\n  per_lemma:\n\n    # ── لمّة موجودة ١: تجسد ──\n    - lemma: \"تجسد\"\n      decision: confirmed\n      decision_reason: >\n        اللمّة راسخة معجمياً بمعنى التحوّل إلى كيان ذي جسد/صورة فعلية (المعجم الكبير:\n        «صار ذا جسدٍ»). الجذر جسد يدلّ على التجمّع والاشتداد (مقاييس ابن فارس)،\n        وهو ما يُجسّد الانتقال من المجرّد إلى الملموس. علاقتها بـ embodiment وارتباطها\n        بالمجموعة ثابتة. تستوجب إضافة التشكيل الكامل.\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: >\n        يُركّز على البُعد الجسدي/المادي: أخذ الشيء صورةً جسمانيةً ملموسةً. يُلائم\n        تحوّل الأفكار والمجرّدات إلى وجود حسّي (الفكرة تجسَّدت في مشروع، الحلم تجسَّد\n        في إنجاز). يُستعمل كثيراً في السياق الديني والفني والاجتماعي.\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"تَجَسُّد\"\n\n    # ── لمّة موجودة ٢: تحقق ──\n    - lemma: \"تحقق\"\n      decision: confirmed\n      decision_reason: >\n        تحتفظ باللمّة بناءً على شواهد الثبوت الكلاسيكية: المعجم الوسيط («الأمر صح ووقع»)\n        وكشّاف التهانوي («مرادف للثبوت والكون والوجود»). يُثبت كلاهما صلةً وثيقة بمعنى\n        الوقوع والتحقّق الفعلي. أما الاستخدام الحديث كـ verification فهو دلالة متفرّعة\n        لاحقة، لا تُلغي الدلالة الجوهرية الكلاسيكية. تستوجب إضافة التشكيل.\n      evidence_assessment:\n        case: mixed\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: >\n        يُركّز على البُعد المعرفي/الوجودي: إحكام الشيء وصحّته وانتقاله من المشكوك\n        فيه إلى المثبَت والواقع (أصل: إحكام الحق وصحّته). يُلائم السياقات التي تنطوي\n        على مسار من التساؤل والترقّب إلى الثبوت (تحقّق التنبّؤ، تحقّق الأمل). أكثر ملاءمةً\n        للسياق المعرفي والعلمي بخلاف تجسُّد ذي البُعد الجسدي.\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"تَحَقُّق\"\n\n    # ── مرشّح المرحلة ١: تَكَوُّن (مُؤكَّد) ──\n    - lemma: \"تَكَوُّن\"\n      source: stage1\n      decision: confirmed\n      decision_reason: >\n        أدلة المعاجم قاطعة: المعجم الوسيط («الشيء حدث»)، وابن فارس («يدل على الإخبار\n        عن حدوث شيء... كان الشيء يكون كوناً إذا وقع وحضر»). الجذر (ك و ن) هو الأصل\n        الفلسفي للوجود والكون في التراث العربي. تكوُّن مصدر على وزن تَفَعُّل يُعبّر عن\n        عملية لا حالة، وهو أنسب وصف للـ \"process of coming into being\". اجتاز جميع\n        بوابات الجودة المصطلحية: اطّراداً وشيوعاً وملاءمةً واشتقاقيةً. لا يحمل تحيّزاً\n        مادياً (كتجسُّد) ولا معرفياً (كتحقُّق)، مما يُتيح تغطية المفهوم بأعمّ صورة.\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: >\n        يُركّز على الحدوث والنشأة من العدم أو من عناصر سابقة دون أي تحيّز مادي أو\n        معرفي. الأعمّ دلالةً بين أخواته: يصلح للوجود الفيزيائي والمجرّد على حدٍّ سواء\n        (تكوُّن الكون، تكوُّن فكرة، تكوُّن ظاهرة). يُقابل genesis وpoiesis في الترجمة\n        العلمية.\n      actions:\n        - command: create_entry\n          params:\n            lemma: \"تَكَوُّن\"\n            pos: n\n        - command: add_sense\n          params:\n            entry_id: \"{auto}\"\n            synset_id: \"{synset_id}\"\n\n    # ── مرشّح المرحلة ١: انبثاق (مرفوض) ──\n    - lemma: \"انْبِثَاق\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        الأصل اللغوي (بثق الماء: انبعاث الماء وتفتّح مجاريه) والاستخدام المعجمي\n        السائد في ARABTERM (انبعاث غازات، دخان بركاني، exhalation/emanation)\n        يُقيّدانه بالمعنى المادي الفيزيائي. لا يُلائم الانتقال المجرّد من الإمكان\n        إلى الوجود.\n\n    # ── مرشّح المرحلة ١: تَجَلٍّ (مرفوض) ──\n    - lemma: \"تَجَلٍّ\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        الأدلة تُثبت ارتباطه بالانكشاف الحسّي (جلا السيف، تجلّى القمر) وبالظهور\n        الديني/الصوفي (التجلّي الإلهي، تجلّيات ابن عربي)، لا بالنشأة والخروج إلى الوجود.\n        اختبار الاستبدال: لا يُلائم سياقات الـ materialization العلمي أو الطبيعي.\n        حِمْله الصوفي يُضيّق دلالته ويُعيق قبوله مصطلحاً علمياً عاماً.\n\n    # ── مرشّح المرحلة ١: تَمَثُّل (مرفوض) ──\n    - lemma: \"تَمَثُّل\"\n      source: stage1\n      decision: removed\n      decision_reason: >\n        الشواهد المعجمية تُثبت استقراره على معنيَيْن مُغايرَيْن: (١) التمثّل البيولوجي\n        (assimilation: تحويل المواد الغذائية) و(٢) التمثّل الفلسفي المعرفي\n        (representation: Vorstellung). ابن فارس يُؤسّس الجذر على المناظرة والمماثلة،\n        لا على الحدوث والنشأة. يُناقض اتجاه المجموعة (خروج إلى الوجود) لا يُدعمه.\n\n\n# ── المرحلة ٤: التعريف والأمثلة ──────────────────────────────\n# تُعالَج فقط اللمّات المؤكدة: تجسُّد، تحقُّق، تكوُّن\nstage4_content:\n\n  definition:\n    current: \"عملية الخروج إلى الوجود؛ التحول إلى واقع\"\n    assessment:\n      decision: revise\n      reason: >\n        التعريف الحالي مبنيٌّ على قالب ترجمي مباشر من الإنجليزية (coming into being →\n        الخروج إلى الوجود). البنية الثنائية المفصولة بالفاصلة المنقوطة غير اصطلاحية في\n        معاجم الوسيط. يفتقر التعريف إلى الجنس القريب الصريح المأخوذ من المُفرَدِمة الأعلى\n        (عملية طبيعية)، كما يفتقر إلى الفصل النوعي الكافي. يلزم إعادة صياغة بأسلوب\n        المعجم الوسيط.\n    authored:\n      - type: terminological\n        text: \"عَمَلِيَّةٌ طَبِيعِيَّةٌ يَنْتَقِلُ بِهَا الشَّيْءُ مِنَ الطَّوْرِ الاِفْتِرَاضِيِّ أَوِ الْكَامِنِ إِلَى طَوْرِ الْحُضُورِ الْفِعْلِيِّ وَالْوُجُودِ الْمُلَاحَظِ\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: linguistic\n        text: \"صَيْرُورَةُ الشَّيْءِ مِنَ الْعَدَمِ أَوِ الْقُوَّةِ إِلَى الْوُجُودِ وَالْفِعْلِ\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n    actions:\n      - command: update_definition\n        params:\n          synset_id: \"{synset_id}\"\n          definition_index: 0\n          text: \"عَمَلِيَّةٌ طَبِيعِيَّةٌ يَنْتَقِلُ بِهَا الشَّيْءُ مِنَ الطَّوْرِ الاِفْتِرَاضِيِّ أَوِ الْكَامِنِ إِلَى طَوْرِ الْحُضُورِ الْفِعْلِيِّ وَالْوُجُودِ الْمُلَاحَظِ\"\n      - command: add_definition\n        params:\n          synset_id: \"{synset_id}\"\n          text: \"صَيْرُورَةُ الشَّيْءِ مِنَ الْعَدَمِ أَوِ الْقُوَّةِ إِلَى الْوُجُودِ وَالْفِعْلِ\"\n\n  examples:\n    per_lemma:\n      - lemma: \"تَجَسُّد\"\n        examples:\n          - text: \"تَجَسَّدَتِ الرُّؤْيَةُ الطَّمُوحَةُ تَجَسُّداً كَامِلاً حِينَ افْتُتِحَ الْمَشْرُوعُ عَلَى أَرْضِ الْوَاقِعِ.\"\n            type: usage\n\n      - lemma: \"تَحَقُّق\"\n        examples:\n          - text: \"كَانَ الْعُلَمَاءُ يَنْتَظِرُونَ تَحَقُّقَ النَّظَرِيَّةِ الَّتِي أَطْلَقَهَا الْبَاحِثُ قَبْلَ عُقُودٍ عَبْرَ التَّجْرِبَةِ الْفِعْلِيَّةِ.\"\n            type: usage\n\n      - lemma: \"تَكَوُّن\"\n        examples:\n          - text: \"يَدْرُسُ عُلَمَاءُ الأَحْيَاءِ تَكَوُّنَ الْخَلِيَّةِ الْبَشَرِيَّةِ الأُولَى وَمَرَاحِلَ نُشُوئِهَا.\"\n            type: usage\n\n    actions:\n      - command: add_synset_example\n        params:\n          synset_id: \"{synset_id}\"\n          text: \"شَهِدَ الْعَالَمُ تَجَسُّدَ الرُّؤَى الطُّمُوحَةِ وَتَحَقُّقَهَا عَبْرَ عُقُودٍ مِنَ الْعَمَلِ الدَّؤُوبِ وَالتَّكَوُّنِ التَّدْرِيجِيِّ.\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"تَجَسَّدَتِ الرُّؤْيَةُ الطَّمُوحَةُ تَجَسُّداً كَامِلاً حِينَ افْتُتِحَ الْمَشْرُوعُ عَلَى أَرْضِ الْوَاقِعِ.\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"كَانَ الْعُلَمَاءُ يَنْتَظِرُونَ تَحَقُّقَ النَّظَرِيَّةِ الَّتِي أَطْلَقَهَا الْبَاحِثُ قَبْلَ عُقُودٍ عَبْرَ التَّجْرِبَةِ الْفِعْلِيَّةِ.\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"يَدْرُسُ عُلَمَاءُ الأَحْيَاءِ تَكَوُّنَ الْخَلِيَّةِ الْبَشَرِيَّةِ الأُولَى وَمَرَاحِلَ نُشُوئِهَا.\"\n\n\n# ── المرحلة ٥: الإثراء (البيانات الوصفية) ─────────────────────\nstage5_enrichment:\n\n  per_entry:\n    - lemma: \"تَجَسُّد\"\n      entry_id: \"{auto}\"\n      root: \"جسد\"\n      maqayis_quote: \"«الْجِيمُ وَالسِّينُ وَالدَّالُ يَدُلُّ عَلَى تَجَمُّعِ الشَّيْءِ أَيْضًا وَاشْتِدَادِهِ. مِنْ ذَلِكَ جَسَدُ الْإِنْسَانِ»\"\n\n    - lemma: \"تَحَقُّق\"\n      entry_id: \"{auto}\"\n      root: \"حقق\"\n      maqayis_quote: \"«الْحَاءُ وَالْقَافُ أَصْلٌ وَاحِدٌ، وَهُوَ يَدُلُّ عَلَى إِحْكَامِ الشَّيْءِ وَصِحَّتِهِ. فَالْحَقُّ نَقِيضُ الْبَاطِلِ، ثُمَّ يَرْجِعُ كُلُّ فَرْعٍ إِلَيْهِ»\"\n\n    - lemma: \"تَكَوُّن\"\n      entry_id: \"{auto}\"\n      root: \"كون\"\n      maqayis_quote: \"«الْكَافُ وَالْوَاوُ وَالنُّونُ أَصْلٌ يَدُلُّ عَلَى الْإِخْبَارِ عَنْ حُدُوثِ شَيْءٍ، إِمَّا فِي زَمَانٍ مَاضٍ أَوْ زَمَانٍ رَاهِنٍ. يَقُولُونَ: كَانَ الشَّيْءُ يَكُونُ كَوْنًا، إِذَا وَقَعَ وَحَضَرَ»\"\n\n  per_sense:\n    - lemma: \"تَجَسُّد\"\n      sense_id: \"{auto}\"\n      nuance: \"يُركّز على البُعد الجسدي والمادي: تحوّل الشيء إلى صورة جسمانية ملموسة. يُفيد أن الانتقال إلى الوجود يكون بالحضور الحسّي والمادي (الجسد، الشكل، الإحساس).\"\n      mwe: false\n\n    - lemma: \"تَحَقُّق\"\n      sense_id: \"{auto}\"\n      nuance: \"يُركّز على البُعد المعرفي والوجودي: إحكام الشيء وثبوته وصحّة وقوعه بعد أن كان محتمَلاً أو موضع تساؤل. يُلائم السياق العلمي والمنطقي (تحقّق نظرية، تحقّق تنبّؤ).\"\n      mwe: false\n\n    - lemma: \"تَكَوُّن\"\n      sense_id: \"{auto}\"\n      nuance: \"يُركّز على الحدوث والنشأة من العدم أو من مكوّنات سابقة، دون تحيّز مادي أو معرفي. الأعمّ دلالةً: يصلح للوجود الفيزيائي والمجرّد (تكوُّن الكون، تكوُّن ظاهرة، تكوُّن مؤسسة).\"\n      mwe: false\n\n  synset:\n    cultural_fit: native\n\n  actions:\n    # entry: تَجَسُّد\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"جسد\",\"maqayis\":\"«الْجِيمُ وَالسِّينُ وَالدَّالُ يَدُلُّ عَلَى تَجَمُّعِ الشَّيْءِ أَيْضًا وَاشْتِدَادِهِ. مِنْ ذَلِكَ جَسَدُ الْإِنْسَانِ»\"}'\n    # entry: تَحَقُّق\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"حقق\",\"maqayis\":\"«الْحَاءُ وَالْقَافُ أَصْلٌ وَاحِدٌ، وَهُوَ يَدُلُّ عَلَى إِحْكَامِ الشَّيْءِ وَصِحَّتِهِ. فَالْحَقُّ نَقِيضُ الْبَاطِلِ»\"}'\n    # entry: تَكَوُّن\n    - command: set_metadata\n      params:\n        entity_type: entry\n        entity_id: \"{auto}\"\n        key: note\n        value: '{\"root\":\"كون\",\"maqayis\":\"«الْكَافُ وَالْوَاوُ وَالنُّونُ أَصْلٌ يَدُلُّ عَلَى الْإِخْبَارِ عَنْ حُدُوثِ شَيْءٍ... كَانَ الشَّيْءُ يَكُونُ كَوْنًا إِذَا وَقَعَ وَحَضَرَ»\"}'\n    # sense: تَجَسُّد\n    - command: set_metadata\n      params:\n        entity_type: sense\n        entity_id: \"{auto}\"\n