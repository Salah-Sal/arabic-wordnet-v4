{"type":"tool_use","timestamp":"2026-03-17T15:54:22.555Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773762862555_0","parameters":{"command":"sqlite3 -json /data/arabic_dict.db \"SELECT e.id AS entry_id, e.dictionary_id, e.headword, e.headword_bare, e.headword_norm, e.root, e.root_source, e.pos, e.form, e.definitions_text, e.translation_en, d.name_ar, d.source_type, d.period FROM entries e JOIN dictionaries d ON e.dictionary_id = d.id WHERE e.id IN (SELECT rowid FROM entries_fts WHERE entries_fts MATCH '\\\"خروج إلى الوجود\\\" OR \\\"تحول إلى واقع\\\"' ORDER BY bm25(entries_fts, 10.0, 5.0, 5.0, 3.0, 1.0) LIMIT 50) ORDER BY d.source_type, d.name_en;\""}}
