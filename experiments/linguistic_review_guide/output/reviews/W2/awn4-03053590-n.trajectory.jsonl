{"type":"tool_result","timestamp":"2026-03-16T13:11:22.477Z","tool_id":"run_shell_command_1773666682381_0","status":"success","output":"[{\"entry_id\":353762,\"headword\":\"مِثْقَب الحفر الحلزوني\",\"headword_norm\":\"مثقب الحفر الحلزوني\",\"definitions_text\":\"\",\"translation_en\":\"auger\",\"name_ar\":\"المعجم الموحد لمصطلحات الهندسة المدنية (2012)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":353763,\"headword\":\"رأس المِثْقاب\",\"headword_norm\":\"راس المثقاب\",\"definitions_text\":\"رأس الحفر والذي يتم تثبيته على مثقب الحفر\",\"translation_en\":\"auger bit\",\"name_ar\":\"المعجم الموحد لمصطلحات الهندسة المدنية (2012)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":354079,\"headword\":\"مِسبار لولبي\",\"headword_norm\":\"مسبار لولبي\",\"definitions_text\":\"\",\"translation_en\":\"helical auger\",\"name_ar\":\"المعجم الموحد لمصطلحات الهندسة المدنية (2012)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":354331,\"headword\":\"مِسبار لولبي\",\"headword_norm\":\"مسبار لولبي\",\"definitions_text\":\"\",\"translation_en\":\"screw auger\",\"name_ar\":\"المعجم الموحد لمصطلحات الهندسة المدنية (2012)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":381546,\"headword\":\"برّيمة حقن\",\"headword_norm\":\"بريمة حقن\",\"definitions_text\":\"برّيمة الوقود النهائية التي تعمل على نقل الوقود الصلب إلى حيّز الاحتراق. وهي - على وجه الخصوص - البرّيمة التي تدفع الوقود خلال فتحة إلى المُصَبعَّات.\",\"translation_en\":\"Injection auger\",\"name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":384630,\"headword\":\"لولبية أرخميدس\",\"headword_norm\":\"لولبية ارخميدس\",\"definitions_text\":\"انظر مضخة لولبية.\",\"translation_en\":\"rotating auger; spiral distributor\",\"name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":393383,\"headword\":\"مدّ الأنابيب بالضغط والحفر الأفقيّ\",\"headword_norm\":\"مد الانابيب بالضغط والحفر الافقي\",\"definitions_text\":\"عملية يتم فيها تفكيك التُربة بواسطة رأس حفر دوّار، ثم إزالة تلك التُربة المُفككة بواسطة لولب. وفي الوقت نفسه، وبمعزل عن اللولب، يُسحب الأنبوب إلى موضعه في داخل النفق المُتشكل. بعض الآلات تكون لها قدرة تحكّم محدودة. (DIN EN 12889:2000)\",\"translation_en\":\"auger boring\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":393686,\"headword\":\"بِناء الأنفاق الدقيقة بواسطة حفّار لولبيّ\",\"headword_norm\":\"بناء الانفاق الدقيقة بواسطة حفار لولبي\",\"definitions_text\":\"عملية يُجرى فيها نقل التُربة المُفككة من الأنفاق الدقيقة بواسطة حفّار لولبي. (DIN EN 12889:2000)\",\"translation_en\":\"microtunnelling with auger spoil removal\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":445175,\"headword\":\"مثقب حلقي، مثقب يدوي\",\"headword_norm\":\"مثقب حلقي، مثقب يدوي\",\"definitions_text\":\"\",\"translation_en\":\"annular auger\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":445301,\"headword\":\"مثقب (يدوي)، برّيمة\",\"headword_norm\":\"مثقب (يدوي)، بريمة\",\"definitions_text\":\"\",\"translation_en\":\"auger\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":445302,\"headword\":\"راس حافر، نصلة البرّيمة\",\"headword_norm\":\"راس حافر، نصلة البريمة\",\"definitions_text\":\"نصلة المثقب اليدوي\",\"translation_en\":\"auger bit\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":445361,\"headword\":\"مثقب يدوي ذو كيس\",\"headword_norm\":\"مثقب يدوي ذو كيس\",\"definitions_text\":\"\",\"translation_en\":\"bag auger; sackborer\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":445700,\"headword\":\"مثقب يدوي ذو صندوق\",\"headword_norm\":\"مثقب يدوي ذو صندوق\",\"definitions_text\":\"\",\"translation_en\":\"box auger\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\",\"source_type\":\"arabterm\"},\n{\"entry_i