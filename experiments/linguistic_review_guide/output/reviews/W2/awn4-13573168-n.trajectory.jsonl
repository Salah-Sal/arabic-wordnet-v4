word_norm\":\"تعتيق (في حالة الطحين والجبنة مثلا)\",\"name_ar\":\"المعجم الموحد لمصطلحات تقانات الأغذية (2004)\",\"translation_en\":\"aging; ageing\",\"domain\":\"Nutrition Technologies\"},\n{\"entry_id\":480605,\"headword\":\"تنضيج اصطناعي، إنضاج اصطناعيّ\",\"headword_norm\":\"تنضيج اصطناعي، انضاج اصطناعي\",\"name_ar\":\"المعجم الموحد لمصطلحات تقانات الأغذية (2004)\",\"translation_en\":\"artificial ripening\",\"domain\":\"Nutrition Technologies\"},\n{\"entry_id\":506516,\"headword\":\"تعتّق\",\"headword_norm\":\"تعتق\",\"name_ar\":\"المعجم الموحد للمصطلحات المهنية والتقنية ج. 1: طباعة - كهرباء (1996)\",\"translation_en\":\"ageing\",\"domain\":\"Printing - Electricity\"},\n{\"entry_id\":669333,\"headword\":\"pres. part. of age.---\\n(1) تعمير؛ اكتهال؛ تقدّم في السنّ\\n(2) تعتيق\\n(3) آخذٌ في الاكتهال.\\n\",\"headword_norm\":\"pres. part. of age.---\\n(1) تعمير؛ اكتهال؛ تقدم في السن\\n(2) تعتيق\\n(3) اخذ في الاكتهال.\",\"name_ar\":\"المورد الحديث (2008)\",\"translation_en\":\"aging\",\"domain\":\"Al-Mawrid Al-Hadeeth\"},\n{\"entry_id\":749326,\"headword\":\"تعتيق متسارع\",\"headword_norm\":\"تعتيق متسارع\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"accelerated aging\",\"domain\":\"AGROVOC\"},\n{\"entry_id\":749526,\"headword\":\"ما بعد النضج\",\"headword_norm\":\"ما بعد النضج\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"after-ripening\",\"domain\":\"AGROVOC\"},\n{\"entry_id\":749537,\"headword\":\"كبر\",\"headword_norm\":\"كبر\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"ageing\",\"domain\":\"AGROVOC\"},\n{\"entry_id\":751774,\"headword\":\"انضاج الجبن\",\"headword_norm\":\"انضاج الجبن\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"cheese ripening\",\"domain\":\"AGROVOC\"},\n{\"entry_id\":760664,\"headword\":\"نضج ما بعد الحصاد\",\"headword_norm\":\"نضج ما بعد الحصاد\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"postharvest ripening\",\"domain\":\"AGROVOC\"},\n{\"entry_id\":761690,\"headword\":\"إنضاج\",\"headword_norm\":\"انضاج\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"ripening\",\"domain\":\"AGROVOC\"},\n{\"entry_id\":761691,\"headword\":\"مرحلة النضج\",\"headword_norm\":\"مرحلة النضج\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"translation_en\":\"ripening stage\",\"domain\":\"AGROVOC\"}]"}
