{"type":"tool_result","timestamp":"2026-03-17T16:02:34.340Z","tool_id":"run_shell_command_1773763353626_0","status":"success","output":"[{\"entry_id\":387445,\"dictionary_id\":53,\"headword\":\"تحويل الطاقة\",\"headword_norm\":\"تحويل الطاقة\",\"root\":\"حل\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"energy conversion\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":380317,\"dictionary_id\":54,\"headword\":\"تحويل الطاقة\",\"headword_norm\":\"تحويل الطاقة\",\"root\":\"حل\",\"pos\":null,\"definitions_text\":\"العملية التي تُنقل فيها كمية من الطاقة، أو تتحوّل، أو تتبدّد، أو تُمتص. ففي مجال الكيمياء على سبيل المثال، هناك ما يُعرف بالتفاعُلات المانحة للحرارة عند تحرُّر قدر من الطاقة أثناء تحوُّل المادة. أمّا في مجال الفيزياء فتحويل الطاقة يُشير إلى الحصول على الطاقة من عملية التبخّر. وفي عِلم الأحياء يُقصد به الحاجة لتأمين كافة العمليات والأنشطة الحيوية.\",\"translation_en\":\"energy conversion energy alteration\",\"name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":753935,\"dictionary_id\":101,\"headword\":\"تحويل الطاقة\",\"headword_norm\":\"تحويل الطاقة\",\"root\":\"حل\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"energy conversion\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"source_type\":\"arabterm\"}]"}
{"type":"tool_result","timestamp":"2026-03-17T16:02:34.343Z","tool_id":"run_shell_command_1773763353752_1","status":"success","output":"[{\"entry_id\":755523,\"headword\":\"تحول وراثي\",\"headword_norm\":\"تحول وراثي\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"genetic transduction\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"source_type\":\"arabterm\"},\n{\"entry_id\":724467,\"headword\":\"التنبيغ؛ النقلُ بالوِساطة (أح).\",\"headword_norm\":\"التنبيغ؛ النقل بالوساطة (اح).\",\"pos\":null,\"definitions_text\":\"التنبيغ؛ النقلُ بالوِساطة (أح).\",\"translation_en\":\"transduction\",\"name_ar\":\"المورد الحديث (2008)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":459748,\"headword\":\"تنبغ مجهض\",\"headword_norm\":\"تنبغ مجهض\",\"pos\":null,\"definitions_text\":\"فشل إحلال قطع الصبغيات الجديدة ضمن صبغيات المضيف فتبقى كجسيمات غير قابلة للانتساخ.\",\"translation_en\":\"Abortive transduction\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":460639,\"headword\":\"نقْل مُعَمَّم، تنبيغ مُعَمَّم\",\"headword_norm\":\"نقل معمم، تنبيغ معمم\",\"pos\":null,\"definitions_text\":\"نقل غير مقيد ينقل أيّ قطعة من صبغيّ مانح ويتوسط بفيروس ما، استبدل صبغية كلية بدنا مانح.\",\"translation_en\":\"generalized transduction\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":461784,\"headword\":\"نقل محدد\",\"headword_norm\":\"نقل محدد\",\"pos\":null,\"definitions_text\":\"نقل مناطق معينة محدودة من الصبغيّ البكتيريّ مجاورة لموقع دمج إبيسوميّ، وذلك بواسطة إبيسوم مستأصل يكون جينومه مستبدلا جزئيا بالدنا الذي ينقل.\",\"translation_en\":\"restricted transduction\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":461991,\"headword\":\"تنبيغ خاصّ\",\"headword_norm\":\"تنبيغ خاص\",\"pos\":null,\"definitions_text\":\"نقل عدد محدود من المادة الجينية البكتيرية بواسطة العاثية من بكتيرية إلى أخرى.\",\"translation_en\":\"specialized transduction\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":462147,\"headword\":\"نقل محدود للمادة الوراثية، تنبيغ\",\"headword_norm\":\"نقل محدود للمادة الوراثية، تنبيغ\",\"pos\":null,\"definitions_text\":\"نقل مورثات من خلية بكتيرية إلى أخرى بواسطة ناقل مثل الفيروسات. ويمكن أن يتم نقل أيّ مورث بكتيريّ، وفي هذه الحالة يسمى نقلا محدودا عاماً، أو يتم نقل مورثات محدودة بواسطة ناقل محدد وهذا يسمى النقل المحدود.\",\"translation_en\":\"transduction\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":462217,\"headword\":\"نقل غير مقيد\",\"headword_norm\":\"نقل غير مقيد\",\"pos\":null,\"definitions_text\":\"نقل أيّ قطعة من صبغيّ مانح.\",\"translation_en\":\"unrestricted transduction\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":659621,\"headword\":\"تَنْبيغ قَوقَعِيّ\",\"headword_norm\":\"تنبيغ قوقعي\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"cochlear transduction\",\"name_ar\":\"المعجم الطبي الموحد (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":659622,\"headword\":\"تَنْبيغُ التَّرَدُّدِ العالِي\",\"headword_norm\":\"تنبيغ التردد العالي\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"high frequency transduction\",\"name_ar\":\"المعجم الطبي الموحد (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":659623,\"headword\":\"تَنْبيغٌ دِهْليزِيّ\",\"headword_norm\":\"تنبيغ دهليزي\",\"pos\":null,\"definitions_text\":\"\",\"translation_en\":\"vestibular transduction\",\"name_ar\":\"المعجم الطبي الموحد (2009)\",\"source_type\":\"arabterm\"}]"}
