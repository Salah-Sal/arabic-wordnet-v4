{"type":"tool_use","timestamp":"2026-03-17T17:01:22.919Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773766882916_0","parameters":{"command":"sqlite3 -json /data/arabic_dict.db \"\nSELECT e.id AS entry_id, e.headword, e.headword_norm, e.root, e.pos, e.definitions_text, d.name_ar, d.source_type\nFROM entries e\nJOIN dictionaries d ON e.dictionary_id = d.id\nWHERE e.headword_norm IN (\n    'ذخيرة لغوية', 'الذخيرة اللغوية',\n    'مفردات اللغة', 'المفردات اللغة',\n    'مفردات', 'المفردات',\n    'معجم', 'المعجم',\n    'متن اللغة', 'المتن اللغة',\n    'ثروة لغوية', 'الثروة اللغوية',\n    'حصيلة لغوية', 'الحصيلة اللغوية',\n    'ملفظة', 'الملفظة'\n)\nORDER BY e.headword_norm, d.source_type;\n\""}}
{"type":"tool_result","timestamp":"2026-03-17T17:01:23.172Z","tool_id":"run_shell_command_1773766882916_0","status":"success","output":"[{\"entry_id\":820826,\"headword\":\"المعجّم\",\"headword_norm\":\"المعجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"المعجّم:[في الانكليزية] Neologism [ في الفرنسية] Neologisme 2 L هو اسم مفعول من التعجيم. والتعجيم في اللغة هي اعتبار الكلمة أعجمية دون أن تكون أعجمية. والمعجّم في الاصطلاح هو ما أخذه العجم من كلام العرب مع تغيير طفيف في الأصل، أو المعرّب أو المولّد. كذا في شرح نصاب الصبيان.\",\"name_ar\":\"كشّاف اصطلاحات الفنون والعلوم للتهانوي\",\"source_type\":\"hawramani\"},\n{\"entry_id\":883697,\"headword\":\"المعجم\",\"headword_norm\":\"المعجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"(المعجم) ديوَان لمفردات اللُّغَة مُرَتّب على حُرُوف المعجم (ج) معجمات ومعاجم وحروف المعجم حُرُوف الهجاء\",\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\"},\n{\"entry_id\":18326,\"headword\":\"المُعْجَمُ\",\"headword_norm\":\"المعجم\",\"root\":\"عجم\",\"pos\":\"noun\",\"definitions_text\":\"ديوان لمفردات اللغة مرتَّب على حروف المعجم حروف المعجم: حروف الهجاء\",\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\"},\n{\"entry_id\":764901,\"headword\":\"المفردات\",\"headword_norm\":\"المفردات\",\"root\":\"فرد\",\"pos\":null,\"definitions_text\":\"\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\",\"source_type\":\"arabterm\"},\n{\"entry_id\":817813,\"headword\":\"الْمُفْردَات\",\"headword_norm\":\"المفردات\",\"root\":\"فرد\",\"pos\":null,\"definitions_text\":\"الْمُفْردَات: جمع المفردة وَثَلَاث مسَائِل من الْمسَائِل السِّت الجبرية فَإِن المعادلة إِمَّا وَاقعَة بَين جنس وجنس وَهِي ثَلَاث مسَائِل من السِّت تسمى بالمفردات لإفراد الْأَجْنَاس فِيهَا أَو المعادلة وَاقعَة بَين جنس وجنسين وَهِي ثَلَاث مسَائِل أخر من السِّت تسمى بالمقترنات لاقتران الجنسين فِيهَا.\",\"name_ar\":\"دستور العلماء للأحمدنكري\",\"source_type\":\"hawramani\"},\n{\"entry_id\":398114,\"headword\":\"معجم\",\"headword_norm\":\"معجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"\",\"name_ar\":\"مسرد التربية، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":488319,\"headword\":\"مُعْجَم\",\"headword_norm\":\"معجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"مخزون من المفردات مودع في ذهن المتكلمين المنتمين إلى جماعة لغوية واحدة.\",\"name_ar\":\"مسرد الإعلام والتواصل، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":496741,\"headword\":\"معجم\",\"headword_norm\":\"معجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"في علم اللغة العام، مخزون مفرداتي مودع في ذهن المتكلمين داخل عشيرة ما.-و يقابل المعجم في هذا التصور ما يدعى بالمفردات مثلما تقابل اللغة الكلام  أو القدرة على الإنجاز. كما يقرأ أصحاب هذا  المذهب بضرورة تعلم مفردات اللغة من أجل تكوين معجم وبالتالي تعلم اللغ\",\"name_ar\":\"المعجم الموحد لمصطلحات اللسانيات (2002)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":497945,\"headword\":\"مُعجَـم\",\"headword_norm\":\"معجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"عمل فقه لغوي لساني لتقديم شروح بالكلمات والأعلام والأحداث وهو موسوعي يتوخى الإحاطة.\",\"name_ar\":\"المعجم الموحد لمصطلحات اللسانيات (2002)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":945160,\"headword\":\"مُعجِم\",\"headword_norm\":\"معجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"مُعجِم\\nمن (ع ج م) من أبهم الكلام وذهب به إلى العجمة، أو من زال إبهامه بالنقط والشكل.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"source_type\":\"hawramani\"},\n{\"entry_id\":945159,\"headword\":\"مُعْجَم\",\"headword_norm\":\"معجم\",\"root\":\"عجم\",\"pos\":null,\"definitions_text\":\"مُعْجَم\\nمن (ع ج م) الكلام المبهم غير الواضح، والقاموس الخاص بشرح مفرات اللغة.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"source_type\":\"hawramani\"},\n{\"entry_id\":398098,\"headword\":\"مفردات\",\"headword_norm\":\"مفردات\",\"root\":\"فرد\",\"pos\":null,\"definitions_text\":\"\",\"name_ar\":\"مسرد التربية، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":855419,\"headword\":\"مُفْرَدات\",\"headword_norm\":\"مفردات\",\"root\":\"فرد\",\"pos\":null,\"definitions_text\":\"مُفْرَداتالجذر: ف ر د\\nمثال: يحتوي هذا النص على مفردات صعبةالرأي: مرفوضةالسبب: لأنَّ هذه الكلمة مما لا يصحّ جمعه جمع مؤنث سالِمًا.\\nالصواب والرتبة: -يحتوي هذا النصّ على مُفْردات صعبة [فصيحة] التعليق: صرَّح بعض القدماء بجواز جمع ما لا يَعْقِل جمع مؤنث سالِمًا، سواء سُمِع له جمع تكسير، أو لا، كما لاحظ مجمع اللغة المصري أنَّ القدماء قد جمعوا الثلاثي المفرد المذكر غير العاقل جمع مؤنث سالِمًا، مثل: «خان وخانات»، و «ثار وثارات»، وأنَّ المتنبي جمع «بوقًا» على «بوقات»، كما اعتمد المجمع المصري على ما ذكره سيبويه من مثل: «حمامات، وسرادقات، وطرقات، وبيوتات»، وما ذكره غيره من مثل: «سجلات، ومصلّيات، وجوابات، وسؤالات»، فاتجه إلى قياسية هذا الجمع وقبوله فيما شاع، مثل: «طلب وطلبات»، و «سَنَد وسندات»، وبخاصة فيما لم يُسْمع له جمع تكسير؛ ومن ثمَّ يمكن تصويب الاستعمال المرفوض.\",\"name_ar\":\"معجم الصواب اللغوي لأحمد مختار عمر\",\"source_type\":\"hawramani\"},\n{\"entry_id\":489173,\"headword\":\"مَلْفَظة\",\"headword_norm\":\"ملفظة\",\"root\":null,\"pos\":null,\"definitions_text\":\"قائمة من الكلمات المستعملة في النصوص.\",\"name_ar\":\"مسرد الإعلام والتواصل، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":497539,\"headword\":\"مِلْفَظَة\",\"headword_norm\":\"ملفظة\",\"root\":null,\"pos\":null,\"definitions_text\":\"في اللسانيات، يميز بين المعجم كذخيرة مفرداتية على مستوى القدرة والملفظة كقائمة من الكلمات تتحقق على مستوى الإنجاز.\",\"name_ar\":\"المعجم الموحد لمصطلحات اللسانيات (2002)\",\"source_type\":\"arabterm\"}]"}
{"type":"tool_use","timestamp":"2026-03-17T17:01:31.414Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773766891410_0","parameters":{"command":"sqlite3 -json /data/arabic_dict.db \"\nSELECT e.id AS entry_id, e.headword, e.headword_norm, e.definitions_text, d.name_ar\nFROM entries e\nJOIN dictionaries d ON e.dictionary_id = d.id\nWHERE e.id IN (\n    SELECT rowid FROM entries_fts\n    WHERE entries_fts MATCH '\\\"ذخيرة لغوية\\\" OR \\\"ثروة لغوية\\\" OR \\\"حصيلة لغوية\\\" OR \\\"مفردات اللغة\\\" OR \\\"متن اللغة\\\"'\n    LIMIT 20\n)\nORDER BY d.source_type;\n\""}}
{"type":"tool_result","timestamp":"2026-03-17T17:01:31.818Z","tool_id":"run_shell_command_1773766891410_0","status":"success","output":"[{\"entry_id\":398511,\"headword\":\"قاموس\",\"headword_norm\":\"قاموس\",\"definitions_text\":\"كتاب يشتمل على عدد كبير من مفردات اللغة مرتبة ترتيبا معينا، مقرونة بطريقة نطقها وشرحها وتفسير معانيها.\",\"name_ar\":\"مسرد التربية، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\"},\n{\"entry_id\":488868,\"headword\":\"حقل دلالي\",\"headword_norm\":\"حقل دلالي\",\"definitions_text\":\"طبقة من مفردات اللغة تصف فضاء من المعاني، كطبقة المفردات الخاصة بحقل الإبصار.\",\"name_ar\":\"مسرد الإعلام والتواصل، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\"},\n{\"entry_id\":496407,\"headword\":\"تَوَازُن\",\"headword_norm\":\"توازن\",\"definitions_text\":\"يرتبط هذا المصطلح بمفهوم  البنية :  ففي لحظة معينة تحدد  البنية بواسطة مجموع العلاقات التي تنسجها مفردات اللغة فيما بينها. وأي تغيير أو تعديل في واحدة من هذه العلاقات  أو  القواعد يعد قطيعة للتوازن  وتعديلا في مجموع العلاقات.\",\"name_ar\":\"المعجم الموحد لمصطلحات اللسانيات (2002)\"},\n{\"entry_id\":496741,\"headword\":\"معجم\",\"headword_norm\":\"معجم\",\"definitions_text\":\"في علم اللغة العام، مخزون مفرداتي مودع في ذهن المتكلمين داخل عشيرة ما.-و يقابل المعجم في هذا التصور ما يدعى بالمفردات مثلما تقابل اللغة الكلام  أو القدرة على الإنجاز. كما يقرأ أصحاب هذا  المذهب بضرورة تعلم مفردات اللغة من أجل تكوين معجم وبالتالي تعلم اللغ\",\"name_ar\":\"المعجم الموحد لمصطلحات اللسانيات (2002)\"},\n{\"entry_id\":497067,\"headword\":\"محتمل\",\"headword_norm\":\"محتمل\",\"definitions_text\":\"صفة الجملة المكونة انطلاقا من قواعد النحو والتي يمكن تأويلها  بواسطة القواعد الدلالية الخاصة بلغة معينة، لكنها غير موجودة بالفعل أو غير مأخوذة من حصيلة لغوية أو متن لغوي.\",\"name_ar\":\"المعجم الموحد لمصطلحات اللسانيات (2002)\"},\n{\"entry_id\":626181,\"headword\":\"وَذَرِيّ (قَضيبِيٌّ أَو بَظْرِيّ؛و الوَذَرةُ:القطعة من اللحم وتطلق على القضيب والبظر. متن اللغة)\",\"headword_norm\":\"وذري (قضيبي او بظري؛و الوذرة:القطعة من اللحم وتطلق علي القضيب والبظر. متن اللغة)\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الطبي الموحد (2009)\"},\n{\"entry_id\":727734,\"headword\":\"(1) المُعْجَم\\n(2) «أ», المعجميّة: «ب» مجموع مفردات اللُّغة. «ج» مجموع المفردات التي يستخدمها شخص أو طبقة ما\\n(3) لائحة أو مجموعة من المصطلحات [كالمعجم أو المَسْرد].\\n\",\"headword_norm\":\"(1) المعجم\\n(2) «ا», المعجمية: «ب» مجموع مفردات اللغة. «ج» مجموع المفردات التي يستخدمها شخص او طبقة ما\\n(3) لائحة او مجموعة من المصطلحات [كالمعجم او المسرد].\",\"definitions_text\":\"(1) المُعْجَم\\n(2) «أ», المعجميّة: «ب» مجموع مفردات اللُّغة. «ج» مجموع المفردات التي يستخدمها شخص أو طبقة ما\\n(3) لائحة أو مجموعة من المصطلحات [كالمعجم أو المَسْرد].\",\"name_ar\":\"المورد الحديث (2008)\"},\n{\"entry_id\":820506,\"headword\":\"اللّغة\",\"headword_norm\":\"اللغة\",\"definitions_text\":\"اللّغة:[في الانكليزية] Language [ في الفرنسية] langue بالضم من لغي بالكسر وأصلها لغي أو لغو والتاء عوض عن المحذوف وهو اللفظ الموضوع للمعنى وجمعه اللغات. ولغات الأضداد هي اللغات الدالة على معنيين متضادين كالبيع فإنّه يطلق على الشراء أيضا وهي داخلة في المشترك. وظنّ البعض أنّ الأضداد والمشترك نوعان وهذا ليس بصحيح. ومن أنواع اللغة الأصلية والمولّدة والمعرّبة والمعجمة والمختلفة والمعروفة وشرح كلّ في موضعه.وقد تطلق اللغة على جميع أقسام العلوم العربية وعلم متن اللغة هو معرفة أوضاع المفردات هكذا في الدقائق المحكمة والمطول والاطول، وقد سبق في المقدمة أيضا في بيان العلوم العربية. قال الچلپي الصرف قد يطلق عليه اللغة أيضا.\",\"name_ar\":\"كشّاف اصطلاحات الفنون والعلوم للتهانوي\"},\n{\"entry_id\":848572,\"headword\":\"متن\",\"headword_norm\":\"متن\",\"definitions_text\":\"متن: متن: اشتد (النبيذ) معجم الادريسي.\\nمتن (بالتشديد): في (م. المحيط) ( .. متن الطعام قواه بالافاويه) وفي معجم الادريسي): أضاف إليه الطيوب.\\nمتن: المتن مصدر وما صلب من الأرض وارتفع والجمع متون (ديوان عمرو بن كلثوم طبعة ارنولد 124: 2).\\nمتن: ظهر البعير والحصان (بوشر).\\nمتن: صفحة البحر أو الغدير (ابن جيبر 30:5 و35:5 دي ساسي كرست 2: 39).\\nعلى متن الطريق: في الطريق نفسه (معجم الجغرافيا).\\nمتن: حد السيف (شرب).\\nالمتن: في م. المحيط (متن الحديث ألفاظه المقوية للمعاني وقيل هو غاية ما ينتهي إليه الإسناد من الكلام) (دي سلان، المقدمة 2: 481 وانظر هاماكر 172 ودي ساسي كرست 1: 170).\\nمتن اللغة: في م. المحيط (أصولها وألفاظها ومفرداتها).\\nمتون: فضلاء الناس (رولاند).\\nمتين وجمعها متان (ابن جبير، 132:17 معجم المنصوري): خز هو صنف من الحرير يتخذ منه ثياب متان.\\nمتانة: صلابة الخلق (المقري 1: 174) قوة الشعر وصلابته (عباد 1: 202) معرفة راسخة مكينة (المقري 1: 504).\\nمتانة: قوة الاسكار في الشراب (معجم الادريسي).\\nماتن: في م. المحيط (اسم فاعل وفي اصطلاح المؤلفين خلاف الشارح أي صاحب المتن).\\nتمتون= تمتان: خيوط الخام وجمعها تماتين (رايت 3: 1).\",\"name_ar\":\"تكملة المعاجم العربية لرينهارت دوزي\"},\n{\"entry_id\":859664,\"headword\":\"عجم\",\"headword_norm\":\"عجم\",\"definitions_text\":\"عجمعجَمَ يَعجُم، عَجْمًا، فهو عاجِم، والمفعول مَعْجوم• عجمَ الحرفَ أو الكتابَ: أزال إبهامَه بالنَّقط أو بالشَّكْل.• عجَم الشَّيءَ: اختبره ° عجَم عُود فلان. \\nعجُمَ يَعجُم، عُجْمةً، فهو أعجمُ• عجُم الشَّخصُ: كانت في لسانه لُكنة وعدم إفصاح في الكلام \\\"لم يستطعْ التعبيرَ عن نفسه بسبب عُجْمته- عجُم لسانُه بعد أن أقَام مدَّة طويلة في بلاد أجنبيّة\\\". \\nأعجمَ يُعجم، إعجامًا، فهو مُعجِم، والمفعول مُعجَم• أعجم الحرفَ أو الكتابَ: عجَمه؛ أزال إبهامه بالنَّقط أو بالشَّكل.• أعجم الكلامَ: أبهمه وذهَب به إلى العُجْمة. \\nاستعجمَ على يستعجِم، استعجامًا، فهو مُسْتَعْجِم، والمفعول مُسْتَعْجَم عليه• استعجم الكلامُ علينا: خفِي علينا واستبهم \\\"استعجم على الجاهل حديث العلماء\\\". \\nأعْجَمُ [مفرد]: ج أعجمون وعُجْم، مؤ عجماءُ، ج مؤ عَجْماوات وعُجْم:1 - صفة مشبَّهة تدلّ على الثبوت من عجُمَ.2 - مَنْ لا يُفصح في كلامه ولا يُبين وإن كان عربيًّا.3 - مَنْ ليس بعربيّ وإن أفصح بالعجميَّة \\\" {وَلَوْ نَزَّلْنَاهُ عَلَى بَعْضِ الأَعْجَمِينَ} \\\".4 - أخرسُ \\\"الحيوان مخلوقٌ أعجم\\\" ° العجماءُ: البهيمة. \\nأعجميّ [مفرد]: ج أعجميُّون وأعاجِمُ، مؤ أعجميّة، ج مؤ أعجميّات وأعاجِمُ:1 - اسم منسوب إلى أعْجَمُ: ليس بعربيّ ولا بفصيح \\\"لِسانٌ أعجميّ- كتابٌ أعجميّ: غير مبين- {وَلَوْ جَعَلْنَاهُ قُرْءَانًا أَعْجَمِيًّا لَقَالُوا لَوْلاَ فُصِّلَتْ ءَايَاتُهُ ءَأَعْجَمِيٌّ وَعَرَبِيٌّ} \\\" ° لفظ أعجميّ: لفظ دخيل أو غير فصيح في لغة ما، مثل كلمة تليفون.2 - مَنْ لا ينطق بالكلام الفصيح ولو كان عربيًّا \\\"ما أكثر الأعاجم من العرب\\\". \\nعَجْم [مفرد]: مصدر عجَمَ. \\nعَجَم [جمع]: مف عَجَميّ• العَجَم: من لم يكونوا من العرب، نطقوا بالعربيّة أو لم ينطقوا، وتُطلق مجازًا على الفرس \\\"أُرسل النَّبيُّ محمّد صلَّى الله عليه وسلَّم إلى العرب والعَجَم\\\" ° بلادُ العَجَمِ: بلاد الفُرْسِ، إيران حاليًّا. \\nعُجْمة [مفرد]: ج عُجُمات (لغير المصدر) وعُجْمات (لغير المصدر):1 - مصدر عجُمَ.2 - إبهام وخفاء في الكتابة وعدم فصاحة في الكلام. \\nعَجَميّ [مفرد]: ج عَجَم: اسم منسوب إلى عَجَم: وهم غيرُ العرب \\\"سِجَّاد عَجَمِيّ: من بلاد العَجَم- بلح/ فنّ عَجَميّ- ينطق بالعربيّة بشكل جيِّد بالرَّغم من أنّه عَجَميّ\\\". \\nمُعْجَم [مفرد]: ج مُعْجمات ومَعاجِمُ:1 - اسم مفعول من أعجمَ.2 - (لغ) قاموس، كتاب يضمُّ مفرداتٍ لغويَّةً مرتَّبة ترتيبًا معيَّنًا وشرحًا لهذهِ المفردات أو ذكر ما يقابلها بلغة أخرى \\\"ازدهرت صناعة المعاجم في العصر الحديث- بحث عن معنى الكلمة في المعجم\\\" ° حروف المُعْجَم: الحروف الهجائيَّة. \\nمُعجماتيّ [مفرد]: اسم منسوب إلى مُعْجمات: على غير قياس \\\"ازداد اهتمام المعجماتيّين بلغة الصحافة- لديه فكر معجماتيّ\\\". \\nمُعجميّات [جمع]: (لغ) علم يقوم على جمع مفردات اللغة وتصنيفها من حيث دلالتها وبنيتها وأصولها.\",\"name_ar\":\"معجم اللغة العربية المعاصرة لأحمد مختار عمر\"},\n{\"entry_id\":913231,\"headword\":\"علم البلاغة\",\"headword_norm\":\"علم البلاغة\",\"definitions_text\":\"علم البلاغة\\nعبارة عن علم البيان والبديع والمعاني والغرض من تلك العلوم: أن البلاغة سواء كانت في الكلام أو في المتكلم رجوعها إلى أمرين:\\nأحدهما: الاحتراز عن الخطأ في تأدية المعنى المراد أي: ما هو مراد البليغ من الغرض المصوغ له الكلام كما هو المتبادر من إطلاق المعنى المراد في كتب علم البلاغة فلا يندرج فيه الاحتراز عن التعقيد المعنوي كما توهمه البعض ولا الاحتراز عن التعقيد مطلقاً.\\nوالثاني: تمييز الفصيح عن غيره ومعرفة أن هذا الكلام فصيح وهذا غير فصيح فمنه: ما يبين في علم متن اللغة والتصريف أو: النحو أو يدرك بالحس وهو: أي ما يبين في هذه العلوم ما عدا التعقيد المعنوي فمست الحاجة للاحتراز عن الخطأ في تأدية المعنى المراد إلى علم واللاحتراز عن التعقيد المعنوي إلى علم آخر فوضعوا لهما علمي: المعاني والبيان وسموهما: علم البلاغة لمزيد اختصاص لهما بها ثم احتاجوا لمعرفة ما يتبع البلاغة من وجوه التحسين إلى علم آخر فوضعوا له علم البديع فما يحترز به عن الأول أي الخط في التأدية: علم المعاني وما يحترز به عن الثاني أي التعقيد المعنوي: علم البيان وما يعرف به وجوه التحسين: علم البديع.\",\"name_ar\":\"أبجد العلوم لصديق حسن خان\"},\n{\"entry_id\":77739,\"headword\":\"الحافظةُ\",\"headword_norm\":\"الحافظة\",\"definitions_text\":\"قُوَّة الذاكرة (عن متن اللغة)\",\"name_ar\":\"المعجم الكبير\"}]"}
{"type":"tool_use","timestamp":"2026-03-17T17:01:42.004Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773766901994_0","parameters":{"command":"sqlite3 -json /data/arabic_dict.db \"\nSELECT e.headword_norm, e.definitions_text\nFROM entries e\nWHERE e.dictionary_id = 151 AND e.headword_norm IN ('فرد', 'ذخر', 'لغو', 'ثرو', 'حصل', 'متن');\n\""}}
{"type":"tool_result","timestamp":"2026-03-17T17:01:42.698Z","tool_id":"run_shell_command_1773766901994_0","status":"success","output":"[{\"headword_norm\":\"حصل\",\"definitions_text\":\"(حَصَلَ) الْحَاءُ وَالصَّادُ وَاللَّامُ أَصْلٌ وَاحِدٌ مُنْقَاسٌ، وَهُوَ جَمْعُ الشَّيْءِ، وَلِذَلِكَ سُمِّيَتْ حَوْصَلَةُ الطَّائِرِ ; لِأَنَّهُ يَجْمَعُ فِيهَا. وَيُقَالُ حَصَّلْتُ الشَّيْءَ تَحْصِيلًا.\\nوَزَعَمَ نَاسٌ مِنْ أَهْلِ اللُّغَةِ أَنَّ أَصْلَ التَّحْصِيلِ اسْتِخْرَاجُ الذَّهَبِ أَوِ الْفِضَّةِ مِنَ الْحَجَرِ أَوْ مِنْ تُرَابِ الْمَعْدِنِ; وَيُقَالُ لِفَاعِلِهِ الْمُحَصِّلُ. قَالَ:\\nأَلَا رَجُلٌ جَزَاهُ اللَّهُ خَيْرًا ... يَدُلُّ عَلَى مُحَصِّلَةٍ تُبِيتُ\\nفَإِنْ كَانَ كَذَا فَهُوَ الْقِيَاسُ، وَالْبَابُ كُلُّهُ مَحْمُولٌ عَلَيْهِ.\\nوَالْحَصَلُ: الْبَلَحُ قَبْلَ أَنْ يَشْتَدَّ وَيَظْهَرَ ثَفَارِيقُهُ، الْوَاحِدَةُ حَصَلَةٌ. قَالَ:\\nيَنْحَتُّ مِنْهُنَّ السَّدَى وَالْحَصْلُ\\nالسَّدَى: الْبَلَحُ الذَّاوِي، الْوَاحِدَةُ سَدَاةٌ. وَهَذَا أَيْضًا مِنَ الْبَابِ، أَعْنِي الْحَصَلَ، لِأَنَّهُ حُصِّلَ مِنَ النَّخْلَةِ.\\nوَمِمَّا شَذَّ عَنِ الْبَابِ وَمَا أَدْرِي مِمَّ اشْتِقَاقُهُ، قَوْلُهُمْ: حَصِلَ الْفَرَسُ، إِذَا اشْتَكَى بَطْنَهُ عَنْ أَكْلِ التُّرَابِ.\"},\n{\"headword_norm\":\"ذخر\",\"definitions_text\":\"(ذَخَرَ) الذَّالُ وَالْخَاءُ وَالرَّاءُ يَدُلُّ عَلَى إِحْرَازِ شَيْءٍ يَحْفَظُهُ. يُقَالُ ذَخَرْتُ الشَّيْءَ أَذْخَرُهُ ذَخْرًا. فَإِذَا قُلْتَ: افْتَعَلْتُ مِنْ ذَلِكَ قُلْتَ: ادَّخَرْتُ. وَمِنَ الْبَابِ الْمَذَاخِرُ، وَهُوَ اسْمٌ يَجْمَعُ جَوْفَ الْإِنْسَانِ وَعُرُوقَهُ. قَالَ مَنْظُورٌ:\\nفَلَمَّا سَقَيْنَاهَا الْعَكِيسَ تَمَلَّأَتْ ... مَذَاخِرُهَا وَازْدَادَ رَشْحًا وَرِيدُهَا\\nوَيَقُولُونَ: مَلَأَ الْبَعِيرُ مَذَاخِرَهُ، أَيْ جَوْفَهُ. وَالْإِذْخِرُ، لَيْسَ مِنَ الْبَابِ: نَبْتٌ. \\nٌ فَأَمَّا مَا زَادَ عَلَى ثَلَاثَةِ أَحْرُفٍ فَكَلِمَاتٌ يَسِيرَةٌ تَدُلُّ عَلَى انْطِلَاقٍ وَذَهَابٍ، وَأَمْرُهَا فِي الِاشْتِقَاقِ خَفِيٌّ جِدًّا، فَلِذَلِكَ لَمْ نَعْرِضْ لِذِكْرِهِ. فَالذَِّعْلِبَةُ: النَّاقَةُ السَّرِيعَةُ. يُقَالُ تَذَعْلَبَتْ تَذَعْلُبًا، وَاذْلَوْلَتِ اذْلِيلَاءً، وَهُوَ انْطِلَاقٌ فِي اسْتِخْفَاءٍ. وَيُقَالُ إِنَّ الذِّعْلِبَةَ النَّعَامَةُ، وَبِهَا شُبِّهَتِ النَّاقَةُ. وَالذَّعَالِبُ: قِطَعُ الْخِرَقِ، وَهِيَ قَوْلُهُ:\\nمُنْسَرِحًا إِلَّا ذَعَالِيبَ الْخِرَقْ\\nوَاذْلَعَبَّ الْجَمَلُ فِي سَيْرِهِ اذْلِعْبَابًا، وَهُوَ قَرِيبٌ مِنَ الَّذِي قَبْلَهُ.\\nوَاللَّهُ أَعْلَمُ بِالصَّوَابِ.\"},\n{\"headword_norm\":\"فرد\",\"definitions_text\":\"(فَرَدَ) الْفَاءُ وَالرَّاء�"}
