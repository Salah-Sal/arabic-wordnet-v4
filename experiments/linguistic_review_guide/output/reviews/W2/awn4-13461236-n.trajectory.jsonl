HERE e.id IN (\n    SELECT rowid FROM entries_fts \n    WHERE entries_fts MATCH '\\\"عملية\\\" AND \\\"جسم\\\"' OR entries_fts MATCH '\\\"وظيفة\\\" AND \\\"أعضاء\\\"'\n)\nAND e.domain IN ('Biology', 'The Unified Medical Dictionary', 'Veterinary Medicine', 'Hygienics and Human Body')\nLIMIT 50;\n\"","description":"Keyword search for process/function within bodily context."}}
{"type":"tool_result","timestamp":"2026-03-17T16:06:22.271Z","tool_id":"run_shell_command_1773763582056_0","status":"success","output":"[{\"entry_id\":452931,\"headword\":\"جسم أصفر\",\"definitions_text\":\"الجسم الذي يتكون في المبيض بعد حدوث عملية الحمل\",\"translation_en\":\"corpus luteum\",\"domain\":\"Biology\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\"},\n{\"entry_id\":550121,\"headword\":\"أَجْسامُ إِيلْشِنيغ (بَعد عملية الساد العيني)\",\"definitions_text\":\"\",\"translation_en\":\"Elsching bodies\",\"domain\":\"The Unified Medical Dictionary\",\"name_ar\":\"المعجم الطبي الموحد (2009)\"}]"}
{"type":"tool_use","timestamp":"2026-03-17T16:06:33.232Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773763593230_0","parameters":{"command":"sqlite3 -json \"/data/arabic_dict.db\" \"\nSELECT e.headword, e.definitions_text \nFROM entries e \nWHERE e.dictionary_id = 151 AND e.headword_norm IN ('عمل','وظف','نشط','جسم','حيي','بدن','عضو')\nORDER BY e.headword_norm;\n\"","description":"Gather roots and quotes from Maqayis al-Lugha."}}
{"type":"tool_result","timestamp":"2026-03-17T16:06:33.348Z","tool_id":"run_shell_command_1773763593230_0","status":"success","output":"[{\"headword\":\"بَدَنَ \",\"definitions_text\":\"(بَدَنَ) الْبَاءُ وَالدَّالُ وَالنُّونُ أَصْلٌ وَاحِدٌ، وَهُوَ شَخْصُ الشَّيْءِ دُونَ شَوَاهُ، وَشَوَاهُ أَطْرَافُهُ. يُقَالُ: هَذَا بَدَنُ الْإِنْسَانِ، وَالْجَمْعُ الْأَبْدَانُ. وَسُمِّيَ الْوَعْلُ الْمُسِنُّ بَدَنًا مِنْ هَذَا. قَالَ الشَّاعِرُ:\\nقَدْ ضَمَّهَا وَالْبَدَنَ الْحِقَابُ ... جِدِّي لِكُلِّ عَامِلٍ ثَوَابُ\\nالرَّأْسُ وَالْأَكْرُعُ وَالْإِهَابُ\\nوَإِنَّمَا سُمِّيَ بِذَلِكَ لِأَنَّهُمْ إِذَا بَالَغُوا فِي نَعْتِ الشَّيْءِ سَمَّوْهُ بِاسْمِ الْجِنْسِ، كَمَا يَقُولُونَ لِلرَّجُلِ الْمُبَالَغِ فِي نَعْتِهِ: هُوَ رَجُلٌ، فَكَذَلِكَ الْوَعِلُ الشَّخِيصُ، سُمِّيَ بَدَنًا. وَكَذَلِكَ الْبَدَنَةُ الَّتِي تُهْدَى لِلْبَيْتِ، قَالُوا: سُمِّيَتْ بِذَلِكَ لِأَنَّهُمْ كَانُوا يَسْتَسْمِنُونَهَا. وَرَجُلٌ بَدَنٌ، أَيْ: مُسِنٌّ. قَالَ الشَّاعِرُ:\\nهَلْ لِشَبَابٍ فَاتَ مِنْ مَطْلَبِ ... أَمْ مَا بُكَاءُ الْبَدَنِ الْأَشْيَبِ\\nوَرَجُلٌ بَادِنٌ وَبَدِينٌ، أَيْ: عَظِيمُ الشَّخْصِ وَالْجِسْمِ، يُقَالُ مِنْهُ بَدُنَ. وَفِي الْحَدِيثِ: «إِنِّي قَدْ بَدُنْتُ» . وَالنَّاسُ قَدْ يَرْوُونَهُ: \\\" بَدَّنْتُ \\\". وَيَقُولُونَ: بَدَّنَ: إِذَا أَسَنَّ. قَالَ الشَّاعِرُ: وَكُنْتُ خِلْتُ الشَّيْبَ وَالتَّبْدِينَا ... وَالْهَمَّ مِمَّا يُذْهِلُ الْقَرِينَا\\nوَتُسَمَّى الدِّرْعُ الْبَدَنَ لِأَنَّهَا تَضُمُّ الْبَدَنَ.\"},\n{\"headword\":\"جَسَمَ \",\"definitions_text\":\"(جَسَمَ) الْجِيمُ وَالسِّينُ وَالْمِيمُ يَدُلُّ عَلَى تَجَمُّعِ الشَّيْءِ. فَالْجِسْمُ كُلُّ شَخْصٍ مُدْرِكٍ. كَذَا قَالَ ابْنُ دُرَيْدٍ. وَالْجَسِيمُ: الْعَظِيمُ الْجِسْمِ، وَكَذَلِكَ الْجُسَامُ. وَالْجُسْمَانُ: الشَّخْصُ.\"},\n{\"headword\":\"عَضَوَ \",\"definitions_text\":\"(عَضَوَ) الْعَيْنُ وَالضَّادُ وَالْحَرْفُ الْمُعْتَلُّ أَصْلٌ وَاحِدٌ يَدُلُّ عَلَى تَجْزِئَةِ الشَّيْءِ. مِنْ ذَلِكَ الْعِضْوُ وَالْعُضْوُ. وَالتَّعْضِيَةُ: أَنْ يُعَضِيَ الذَّبِيحَةَ أَعْضَاءً. وَالْعِضَةُ: الْقِطْعَةُ مِنَ الشَّيْءِ، تَقُولُ: عَضَّيْتُ الشَّيْءَ أَيْ وَزَّعْتُهُ. قَالَ رُؤْبَةُ:\\nوَلَيْسَ دِينُ اللَّهِ بِالْمُعَضَّى\\nأَيْ بِالْمُفَرَّقِ. قَالَ الْخَلِيلُ: وَقَوْلُهُ - تَعَالَى: {الَّذِينَ جَعَلُوا الْقُرْآنَ عِضِينَ} [الحجر: 91] ، أَيْ عِضَةً عِضَةً، فَفَرَّقُوهُ، آمَنُوا بِبَعْضِهِ وَكَفَرُوا بِبَعْضِهِ. وَالِاسْمُ مِنْهُ التَّعْضِيَةُ. وَمِنْهُ الْحَدِيثُ: «لَا تَعْضِيَةَ فِي مِيرَاثٍ» أَيْ لَا تَقْسِمُوا مَا [لَا] يَحْتَمِلُ الْقَسْمَ كَالسَّيْفِ وَالدُّرَّةِ وَمَا أَشْبَهَ ذَلِكَ.\"},\n{\"headword\":\"عَمِلَ \",\"definitions_text\":\"(عَمِلَ) الْعَيْنُ وَالْمِيمُ وَاللَّامُ أَصْلٌ وَاحِدٌ صَحِيحٌ، وَهُوَ عَامٌّ فِي كُلِّ فِعْلٍ يُفْعَلُ.\\nقَالَ الْخَلِيلُ: عَمِلَ يَعْمَلُ عَمَلًا، فَهُوَ عَامِلٌ; وَاعْتَمَلَ الرَّجُلُ، إِذَا عَمِلَ بِنَفْسِهِ. قَالَ:\\nإِنَّ الْكَرِيمَ وَأَبِيكَ يَعْتَمِلْ ... إِنْ لَمْ يَجِدْ يَوْمًا عَلَى مَنْ يَتَّكِلْ\\nوَالْعِمَالَةُ: أَجْرُ مَا عُمِلَ. وَالْمُعَامَلَةُ: مَصْدَرٌ مِنْ قَوْلِكَ عَامَلْتُهُ، وَأَنَا أُعَامِلُهُ مُعَامَلَةً. وَالْعَمَلَةُ: الْقَوْمُ يَعْمَلُونَ بِأَيْدِيهِمْ ضُرُوبًا مِنَ الْعَمَلِ، حَفْرًا، أَوْ طَيًّا أَوْ نَحْوَهُ. وَمِنَ الْبَابِ: عَامِلُ الرُّمْحِ وَعَامِلَتُهُ، وَهُوَ مَا دُونَ الثَّعْلَبِ قَلِيلًا مِمَّا يَلِي السِّنَانَ، وَهُوَ صَدْرُهُ. قَالَ:\\nأَطْعَنُ النَّجْلَاءَ يَعْوِي كَلْمُهَا ... عَامِلُ الثَّعْلَبِ فِيهَا مَرْجَحِنْ\\nقَالَ: وَالرَّجُلُ يَعْتَمِلُ لِنَفْسِهِ، وَيَعْمَلُ لِقَوْمٍ، وَيَسْتَعْمِلُ غَيْرَهُ، وَيُعْمِلُ رَأْيَهُ أَوْ كَلَامَهُ أَوْ رُمْحَهُ. وَالْبَنَّاءُ يُسْتَعْمَلُ اللَّبِنَ، إِذَا بَنَى بِهِ. قَالَ: وَالْيَعْمَلَةُ مِنَ الْإِبِلِ: اسْمٌ لَهَا اشْتُقَّ مِنَ الْعَمَلِ، وَالْجَمْعُ يَعْمَلَاتٌ. وَلَا يُقَالُ ذَلِكَ إِلَّا لِلْأُنْثَى، وَقَدْ يَجُوزُ الْيَعَامِلُ. قَالَ ذُو الرُّمَّةِ أَوْ غَيْرُهُ: وَالْيَعْمَلَاتُ عَلَى الْوَجَى ... يَقْطيْدًا بَعْدَ بِيَدِ\\nوَاللَّهُ أَعْلَمُ.\"},\n{\"headword\":\"نَشِطَ \",\"definitions_text\":\"(نَشِطَ) النُّونُ وَالشِّينُ وَالطَّاءُ: أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى اهْتِزَازٍ وَحَرَكَةٍ. مِنْهُ النَّشَاطُ مَعْرُوفٌ وَهُوَ لِمَا فِيهِ مِنَ الْحَرَكَةِ وَالِاهْتِزَازِ وَالتَّفَتُّحِ. يُقَالُ نَشِطَ يَنْشَطُ. وَأَنْشَطَ الْقَوْمُ: كَانَتْ دَوَابُّهُمْ نَشِيطَةً. وَالثَّوْرُ نَاشِطٌ، لِأَنَّهُ يَنْشِطُ مِنْ بَلَدٍ إِلَى بَلَدٍ. قَالَ ذُو الرُّمَّةِ:\\nأَذَاكَ أَمْ نَمِشٌ بِالْوَشْيِ أَكْرُعُهُ ... مُسَفَّعُ الْخَدِّ هَادٍ نَاشِطٌ شَبَبُ\\nوَنَشَطْتُ الشَّيْءَ: قَشَرْتُهُ، كَأَنَّهُ لَمَّا قُشِرَ أُخْرِجَ مِنْ جِلْدِهِ. وَطَرِيقٌ نَاشِطٌ: يَنْشِطُ فِي الطَّرِيقِ الْأَعْظَمِ يَمْنَةً [وَيَسْرَةً] . وَنَشَطَتِ النَّاقَةُ فِي سَيْرِهَا، إِذَا شَدَّتْ. وَالْأُنْشُوطَةُ: الْعُقْدَةُ مِثْلُ عُقْدَةِ السَّرَاوِيلِ وَنَشَطْتُهُ بِأُنْشُوطَةٍ. وَأَنْشَطْتُ الْعِقَالَ: مَدَدْتُ أُنْشُوطَتَهُ فَانْحَلَّتْ. وَقَالَ قَوْمٌ: الْإِنْشَاطُ: الْحَلُّ، وَالتَّنْشِيطُ: الْعَقْدُ. وَبِئْرٌ أَنْشَاطٌ: قَرِيبَةُ الْقَعْرِ يَخْرُجُ دَلْوُهَا بِجَذْبَةٍ. وَنَشَطْتُ الدَّلْوَ مِنَ الْبِئْرِ بِغَيْرِ قَامَةٍ. وَالنَّشِيطَةُ مِنَ الْإِبِلِ: أَنْ تُوجَدَ فَتُسَاقَ مِنْ غَيْرِ أَنْ يُعْمَدَ لَهَا. وَقَالَ قَوْمٌ: هُوَ الَّذِي يُصِيبُهُ الْقَوْمُ قَبْلَ أَنْ يَصِلُوا إِلَى الْحَيِّ الَّذِي يُرِيدُونَ الْإِغَارَةَ عَلَيْهِ، فَيَنْشِطُهُ الرَّئِيسُ مِنْ بَيْنِ أَيْدِيهِمْ. قَالَ: لَكَ الْمِرْبَاعُ مِنْهَا وَالصَّفَايَا ... وَحُكْمُكَ وَالنَّشِيطَةُ وَالْفُضُولُ.\"},\n{\"headword\":\"وَظَفَ \",\"definitions_text\":\"(وَظَفَ) الْوَاوُ وَالظَّاءُ وَالْفَاءُ: كَلِمَةٌ تَدُلُّ عَلَى تَقْدِيرِ شَيْءٍ. يُقَالُ: وَظَّفْتَ لَهُ، إِذَا قَدَّرْتَ لَهُ كُلَّ حِينٍ شَيْئًا مِنْ رِزْقٍ أَوْ طَعَامٍ. ثُمَّ اسْتُعِيرَ ذَلِكَ فِي عَظْمِ السَّاقِ، كَأَنَّهُ شَيْءٌ مُقَدَّرٌ، وَهُوَ مَا فَوْقَ الرُّسْغِ مِنْ قَائِمَةِ الدَّابَّةِ إِلَى السَّاقِ. وَيُقَالُ وَظَفْتُ الْبَعِيرَ، إِذَا قَصَرْتَ لَهُ الْقَيْدَ. وَيُقَالُ: مَرَّ يَظِفُهُمْ، أَيْ يُتْبِعُهُمْ كَأَنَّهُ يَجْعَلُ وَظِيفَهُ بِإِزَاءِ أَوْظِفَتِهِمْ.\"}]"}
