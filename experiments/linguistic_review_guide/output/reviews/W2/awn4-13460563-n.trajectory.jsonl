ions_text\":\"\",\"translation_en\":\"Bloom's syndrome\",\"name_ar\":\"المعجم الطبي الموحد (2009)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":391063,\"dictionary_id\":53,\"headword\":\"انتشار الطحلب\",\"headword_bare\":\"انتشار الطحلب\",\"headword_norm\":\"انتشار الطحلب\",\"root\":\"نشر\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"انتشار الطحالب تعرف بالزيادة السريعة أو تراكم في كميات الطحالب (المجهرية عادة) في النظام المائي. قد تحدث انتشار الطحالب في المياه العذبة وكذلك في البيئة البحرية.فالغالب يوجد أنواع قليله من الطحالب (عوالق نباتية) مسببه في الأنتشار.\",\"translation_en\":\"algal bloom\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":394084,\"dictionary_id\":53,\"headword\":\"نمو الطحالب\",\"headword_bare\":\"نمو الطحالب\",\"headword_norm\":\"نمو الطحالب\",\"root\":\"نم\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"انتشار واسع للطحالب يحدث نتيجة الإفراط في استخدام مُغذياتها.\",\"translation_en\":\"algal bloom\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\",\"source_type\":\"arabterm\"},\n{\"entry_id\":737221,\"dictionary_id\":99,\"headword\":\"حلفح\",\"headword_bare\":\"حلفح\",\"headword_norm\":\"حلفح\",\"root\":null,\"root_source\":null,\"pos\":null,\"form\":null,\"definitions_text\":\"آفة جلدية منتشرة وظاهرة.\",\"translation_en\":\"efflorescence\",\"name_ar\":\"معجم المصطلحات الطبية (ج.2، 2003)\",\"source_type\":\"arabterm\"}]"}
