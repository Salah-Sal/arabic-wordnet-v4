entry_id\":927374,\"headword\":\"زَهْرِيَّا\",\"headword_norm\":\"زهريا\",\"root\":\"زهر\",\"definitions_text\":\"زَهْرِيَّا\\nصورة كتابية صوتية من زَهْرِيَّة.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":429869,\"headword\":\"زهريات\",\"headword_norm\":\"زهريات\",\"root\":\"زهر\",\"definitions_text\":\"مجموعة من الجومعويات أو معويات الجوف يتخذ الفرد فيها الشكل البوليبي الذي يبني هيكلا خارجيا كلسيا يعيش منفردا أو في المستعمرات\",\"name_ar\":\"المعجم الموحد لمصطلحات الجيولوجيا (2000)\"},\n{\"entry_id\":434277,\"headword\":\"زهريات\",\"headword_norm\":\"زهريات\",\"root\":\"زهر\",\"definitions_text\":\"رتبة من المرجانيات في شعبة معويات الجوف\",\"name_ar\":\"المعجم الموحد لمصطلحات الجيولوجيا (2000)\"},\n{\"entry_id\":434494,\"headword\":\"زهريات\",\"headword_norm\":\"زهريات\",\"root\":\"زهر\",\"definitions_text\":\"مجموعة من الجو فمعونات أو معويات الجوف يتخذ الفرد فيها الشكل البوليبي الذي يبني هيكلا خارجيا كلسيا ميعيش منفردا أو في المستعمرات\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":438999,\"headword\":\"زهريات\",\"headword_norm\":\"زهريات\",\"root\":\"زهر\",\"definitions_text\":\"رتبة من المرجانيات في شعبة معويات الجوف\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":396065,\"headword\":\"زهرية\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"زخرفة زجاجية دائرية على شكل وردة أو نجمة\",\"name_ar\":\"المعجم الموحد لمصطلحات التقنيات التربوية (1999)\"},\n{\"entry_id\":479172,\"headword\":\"زهرية\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"قمة مزخرفة في برج أو سقف\",\"name_ar\":\"المعجم الموحد للمصطلحات المهنية والتقنية ج. 2: بناء - تجارة (1999)\"},\n{\"entry_id\":504608,\"headword\":\"زهرية\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"مسرد الجغرافيا والتاريخ، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\"},\n{\"entry_id\":505349,\"headword\":\"زهرية\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"زخرف طباعي في أول فصل أو آخره\",\"name_ar\":\"المعجم الموحد للمصطلحات المهنية والتقنية ج. 1: طباعة - كهرباء (1996)\"},\n{\"entry_id\":853302,\"headword\":\"زُهْرِيَّة\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"زُهْرِيَّةالجذر: ز هـ ر\\nمثال: زُهْرِيَّة الوردالرأي: مرفوضة عند بعضهمالسبب: لأن الكلمة لم ترد بهذا الضبط في المعاجم.\\nالصواب والرتبة: -زَهْرِيَّة الورد [فصيحة] التعليق: كلمة «زَهْرِيَّة» منسوبة إلى «الزَّهْر» بفتح الزاي، وأثبتها المعجم الوسيط بهذا الضبط، وذكر أن معناها: وعاء من خزف ونحوه يُوضع فيه الزهر للزينة.\",\"name_ar\":\"معجم الصواب اللغوي لأحمد مختار عمر\"},\n{\"entry_id\":927375,\"headword\":\"زَهْرِيّة\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"زَهْرِيّة\\nمن (ز ه ر) مؤنث زَهْري، ووعاء من خزف يوضع فيه الزهر للزينة.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":927376,\"headword\":\"زُهْرِيَّة\",\"headword_norm\":\"زهرية\",\"root\":\"زهر\",\"definitions_text\":\"زُهْرِيَّة\\nمن (ز ه ر) مؤنث زُهْرِي.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":395108,\"headword\":\"زُهرية سقف\",\"headword_norm\":\"زهرية سقف\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات التقنيات التربوية (1999)\"},\n{\"entry_id\":853305,\"headword\":\"زُهُور\",\"headword_norm\":\"زهور\",\"root\":\"زهر\",\"definitions_text\":\"زُهُورالجذر: ز هـ ر\\nمثال: زهور الربيعالرأي: مرفوضةالسبب: لأن هذا الجمع لم يرد في المعاجم القديمة. المعنى: جمع زَهْر\\nالصواب والرتبة: -أزهار الربيع [فصيحة]-زهور الربيع [فصيحة] التعليق: لم يرد في المعاجم القديمة جمع «زهر» على «زهور»، وإنما ورد جمعه على «أزهار»، ومع ذلك فقد وردت كلمة «زهور» في غير مدخلها في عدد من المعاجم كالمصباح المنير (روض)، وتاج العروس (عنبر). ويبدو أن إهمالها في مدخلها باعتبار أنها من الجموع القياسية. ولم يكن مجمع اللغة المصري موفقًا حين اعتبر هذا الجمع من كلام المولدين.\",\"name_ar\":\"معجم الصواب اللغوي لأحمد مختار عمر\"},\n{\"entry_id\":927387,\"headword\":\"زَهُور\",\"headword_norm\":\"زهور\",\"root\":\"زهر\",\"definitions_text\":\"زَهُور\\nمن (ز ه ر) الصافي اللون والمشرق الوجه.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":927388,\"headword\":\"زُهُور\",\"headword_norm\":\"زهور\",\"root\":\"زهر\",\"definitions_text\":\"زُهُور\\nمن (ز ه ر) جمع زهرة، والزهور: تلألؤ الوجه وإشراقه.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":455247,\"headword\":\"زهور الشيخ\",\"headword_norm\":\"زهور الشيخ\",\"root\":\"زهر\",\"definitions_text\":\"جنس نباتات من الفصيلة المركبة\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\"},\n{\"entry_id\":927389,\"headword\":\"زهور الله\",\"headword_norm\":\"زهور الله\",\"root\":\"زهر\",\"definitions_text\":\"زهور الله\\nصفاء الله ونعمه.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":43104,\"headword\":\"زُهَيْر\",\"headword_norm\":\"زهير\",\"root\":\"زهر\",\"definitions_text\":\"علم على غير واحد\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":927397,\"headword\":\"زُهَيْر\",\"headword_norm\":\"زهير\",\"root\":\"زهر\",\"definitions_text\":\"زُهَيْر\\nمن (ز ه ر) تصغير زَهْر، وتصغير ترخيم أزهر.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":927398,\"headword\":\"زَهِير\",\"headword_norm\":\"زهير\",\"root\":\"زهر\",\"definitions_text\":\"زَهِير\\nمن (ز ه ر) المشرق الناصع والصافي اللون والحسن.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":43108,\"headword\":\"زُهَيْرٌ الْبَلَوِىُّ\",\"headword_norm\":\"زهير البلوي\",\"root\":\"زهر\",\"definitions_text\":\"ـ نسبة إلى بَلِىّ, قبيلـة مـن قضاعة ـ (٧٦هـ = ٦٩٥م): أميرٌ من القادة الشُّجْعان الفاتحين, شَهِدَ فتحَ مصرَ, وَوَلَّاه أميرُها عبدُ العزيز بنُ مَرْوانَ بَرْقَةَ سنة (٦٩هـ = ٦٨٨م), فكانتْ لـه مـع البربر والرومِ وقائعُ. وأقام فى القَيْرَوان مُدَّةً, فَوَجَّه الروم من القسطنطينية مراكب إلى برقة, فعاد إليهم وقاتَلهم, فكثرت عليه جموعُهم, فثبتَ إلى أن قُتِلَ على أبوابها\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43110,\"headword\":\"زُهَيْرٌ العامرِىُّ\",\"headword_norm\":\"زهير العامري\",\"root\":\"زهر\",\"definitions_text\":\"(٤٢٩هـ = ١٠٣٨م) ـ فَتَى المنصورِ بنِ أبى عامر: أميرٌ, عِصامِىّ, صَقْلَبِىُّ الأصل, من الدُّهاةِ فى عهدِ ملوك الطوائف بالأندلس, كان مـن رجـالِ خَيران الصَّقْلبِىَّ صاحبِ المرِيَّة, وَوَلِيَها بعـد وفاة خيران سنة (٤١٩هـ = ١٠٢٨م), وَتَلَقَّبَ بـ (عميـد الدولة) واستمرَّ فى ولايتها نحو عشَرَةِ أعوامٍ, امتدَّ بهـا سلطانُه إلى أول أعمال طُلَيْطِلة, وكانتْ تربطُه بصاحِبِ غرناطة ”حيوس بن ماكسن” مُحالفَةٌ, فَتُوفِّى حيوس, وخلفه ابنُه باديس فاختلف مع زُهَيْر, واقتتلا وقُتِلَ زُهَيْر\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43107,\"headword\":\"زُهَيْرُ بْنُ أبِى سُلْمَى بن ربيعةَ بن رِيَاح الْمُزَنِىُّ\",\"headword_norm\":\"زهير بن ابي سلمي بن ربيعة بن رياح المزني\",\"root\":\"زهر\",\"definitions_text\":\"(١٣ق.هـ = ٦٠٩م): شاعر مُضَر, وحكيمُ الشُّعراءِ فى الجاهليَّةِ, وفى أئمة الأدب من يُفَضِّلُه على شعراءِ العرب كافَّةً. قيل: كان يَنْظُمُ القصيدةَ في شَهْرٍ ويُنَقِّحُها ويُهذِّبها فى سَنَةٍ, فكانت قصائدُه تُسَمَّى ”الْحَوْلِيَّاتِ”, ولد في مُزَيْنَةَ بنواحى المدينة, وأقام فى الحاجر من ديار نجـد, كان أبوه شاعرًا, وخاله شاعرًا, وأخته سُلْمى شاعرة, وابناه كعب وبُجَيْر شاعرين. له ”ديوان” وأشهرُ شعره مُعَلَّقَتُه\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43106,\"headword\":\"زُهَيْرُ بنُ جَذِيمة بن رواحة العَبْسى\",\"headword_norm\":\"زهير بن جذيمة بن رواحة العبسي\",\"root\":\"زهر\",\"definitions_text\":\"(نحـو ٥٠ ق. هـ = ٥٧٤م): أميرُ عَبْسٍ, وأحدُ ساداتِ العربِ المعدودين فى الجاهِلِيَّةِ, كانتْ هوازنُ تَهابُه, وتحمل إليه الإِتاوةَ فى كلِّ عامٍ تأتيه بها فى عكاظ, قتله خالدُ بنُ جعفرٍ العامرىُّ\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43105,\"headword\":\"زُهَيْرُ بنُ جَنَاب بن هُبَلَ الْكلْبِىُّ\",\"headword_norm\":\"زهير بن جناب بن هبل الكلبي\",\"root\":\"زهر\",\"definitions_text\":\"(نحو ٦٠ ق. هـ = ٥٦٤م): شاعِرٌ من بنى كنانة بن بكر من أهلِ اليمن, كان خَطِيبَ قُضاعةَ وسيِّدَها وشاعرَها وبَطَلَها ووافِدَها إلى الملوك, قيل: إنّ وقائِعَه تُناهِزُ المئتين, أشهرُها أيامُه مع بكر وتَغْلب. عاش طويلاً, وكان يُدْعَى ”الكاهنَّ”, لِصِحَّةِ رأيِه. وله ديوانُ شعرٍ مطبوعٌ\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43109,\"headword\":\"زُهَيْرُ بْـنُ حَرْب بن شَدَّادِ النَّسائِى البغدادى, أبـو خَيْثَمَةَ\",\"headword_norm\":\"زهير بن حرب بن شداد النسائي البغدادي, ابو خيثمة\",\"root\":\"زهر\",\"definitions_text\":\"(٢٣٤هـ = ٨٤٩م): (انظره فى: خ ث م)\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43111,\"headword\":\"زُهَيْرُ بنُ محمد بن على المهلبي العتكى, الملقَّب بهاء الدِّين\",\"headword_norm\":\"زهير بن محمد بن علي المهلبي العتكي, الملقب بهاء الدين\",\"root\":\"زهر\",\"definitions_text\":\"(٦٥٦ هـ = ١٢٥٨م): (انظره فى: ب هـ ى)\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43087,\"headword\":\"عبد الله بن علىِّ بن زُهْرة\",\"headword_norm\":\"عبد الله بن علي بن زهرة\",\"root\":\"زهر\",\"definitions_text\":\"ابن الحسن بن زُهْرَة الحُسَيْنِي الحلبي الشِّيعي, أبو القاسم (٥٨٠هـ = ١١٨٤م): فقيه أصولى, من مؤلفاته: ”التجريد فى فقه الإمامية”, و”الغُنية عن الحجج والأدلة”, و”تبيين المحجة فى كون إجماع الإمامية حجة”, و”رسالة الحج”\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43089,\"headword\":\"عبدِ الوهابِ بـن محمـدِ بـن يحيـى بـن أحمـد الطرابلسى\",\"headword_norm\":\"عبد الوهاب بن محمد بن يحيي بن احمد الطرابلسي\",\"root\":\"زهر\",\"definitions_text\":\"الشافعىُّ, تاج الدين أبو الفضل (٨٩٥هـ = ١٤٩٠م): فقيه أُصولِىٌّ, من آثاره”: بهجة الوصول” فى شرح منهاج الأصول للبيضاوى, و”تذكرة النبيه” فى شرح التنبيه لأبى إسحاق الشيرازى, و”تذكرة المحتاج” فى شرح المنهاج للنووى, و”شرح مختصر التبريزى”, و”المختار فى فقه الأبرار”\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":681314,\"headword\":\"لازَهْريّ (نب).\",\"headword_norm\":\"لازهري (نب).\",\"root\":\"زهر\",\"definitions_text\":\"لازَهْريّ (نب).\",\"name_ar\":\"المورد الحديث (2008)\"},\n{\"entry_id\":635120,\"headword\":\"لازَهْرِيٌّ وِعائِيّ\",\"headword_norm\":\"لازهري وعائي\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الطبي الموحد (2009)\"},\n{\"entry_id\":752759,\"headword\":\"لازهريات\",\"headword_norm\":\"لازهريات\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\"},\n{\"entry_id\":747878,\"headword\":\"لازهريات وعائية\",\"headword_norm\":\"لازهريات وعائية\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المَكنَز الزراعي متعدد اللغات\"},\n{\"entry_id\":451285,\"headword\":\"لازهرية\",\"headword_norm\":\"لازهرية\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\"},\n{\"entry_id\":941969,\"headword\":\"لَزْهَر\",\"headword_norm\":\"لزهر\",\"root\":\"زهر\",\"definitions_text\":\"لَزْهَر\\nصورة كتابية صوتية من الأزهر.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":43083,\"headword\":\"مَاءُ الزَّهْر\",\"headword_norm\":\"ماء الزهر\",\"root\":\"زهر\",\"definitions_text\":\"ما قَطَرَ من زَهْر النَّارنج\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43099,\"headword\":\"محمد بن سعد بن منيع الزُّهْرِيُّ\",\"headword_norm\":\"محمد بن سعد بن منيع الزهري\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":43088,\"headword\":\"محمـدُ بنُ يحيـى بـنِ أحمـدَ بـنِ زُهْرة\",\"headword_norm\":\"محمد بن يحيي بن احمد بن زهرة\",\"root\":\"زهر\",\"definitions_text\":\"شَمْسُ الدِّينِ (٨٤٨ هـ = ١٤٤٤م): مُفَسِّرٌ, من أعيان الشَّافِعِيَّة, وُلِدَ فى حبراص, وانتقل إلى دمشق, ثم استقَرَّ فى طرابلس الشام وتُوُفِّىَ بها, من مؤلفاته: ”فَتْحُ الْمَنَّان” في تفسير القرآن, و”شروحٌ كبيرةٌ” فى الفقه, و”تعليقةٌ” كالتَّذْكرة فى مجلدٍ كبيرٍ يشتملُ على تفسيرٍ وحديثٍ وفِقْهٍ وعربِيَّةٍ ووعْظٍ\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":453825,\"headword\":\"مزدهر\",\"headword_norm\":\"مزدهر\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\"},\n{\"entry_id\":944186,\"headword\":\"مُزْدَهر\",\"headword_norm\":\"مزدهر\",\"root\":\"زهر\",\"definitions_text\":\"مُزْدَهر\\nمن (ز ه ر) المشرق المتلألئ الوجه.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":453404,\"headword\":\"مزهر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\"},\n{\"entry_id\":453817,\"headword\":\"مزهر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\"},\n{\"entry_id\":479209,\"headword\":\"مزهَّر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"مزيّن بزخرف على شكل الزّهر\",\"name_ar\":\"المعجم الموحد للمصطلحات المهنية والتقنية ج. 2: بناء - تجارة (1999)\"},\n{\"entry_id\":503011,\"headword\":\"مزهّر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"\",\"name_ar\":\"مسرد الجغرافيا والتاريخ، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\"},\n{\"entry_id\":782146,\"headword\":\"مِزْهَرٌ\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"(مِزْهَرٌ)- فِي حَدِيثِ أُمِّ زرع «إذ سَمِعْنَ صوتَ المِزْهَرِ أيْقَنَّ أنَّهُنَّ هَوَالِكُ» المِزْهَرُ:العُودُ الَّذِي يُضْرَبُ بِهِ فِي الغِناء. أَرَادَتْ أَنَّ زَوْجَهَا عَوّدَ إبِلَه إِذَا نَزَلَ بِهِ الضَّيفانُ أن يأتيَهُم بالمَلاَهي ويَسْقِيَهُم الشَّراب ويَنْحَرَ لَهُمُ الإِبل، فَإِذَا سَمِعْنَ ذَلِكَ الصوتَ أيقنتْ أَنَّهَا منحورةٌ.ومِيمُ المِزْهَرِ زائدةٌ. وَجَمْعُهُ: مَزَاهِرُ.وَمِنْهُ حَدِيثُ ابْنِ عَمْرٍو «إِنَّ اللَّهَ أَنْزَلَ الحقَّ ليُذْهب بِهِ الباطِل، ويُبطِلَ بِهِ الزَّمَّارَاتِ والمَزَاهِرَ» .وَفِيهِ «فَمَا كَانَ لَهُمْ فِيهَا مِنْ مِلْكٍ وعُرْمانٍ ومَزَاهِرَ» المَزَاهِرُ: الرِّياضُ، سُمِّيَتْ بِذَلِكَ لِأَنَّهَا تَجْمعُ أصنافَ الزَّهر وَالنَّبَاتِ. وذاتُ المَزَاهِرِ: موضعٌ. والمَزَاهِرُ: هَضَباتٌ حُمْرٌ.\",\"name_ar\":\"النهاية في غريب الحديث والأثر لأبي السعادات ابن الأثير الجزري\"},\n{\"entry_id\":811813,\"headword\":\"مزهر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"[مزهر] نه: فيه: إذا سمعن صوت \\\"المزهر\\\" أيقن أنهن هوالك، هو عود يضرب به في الغناء، أي إن زوجها عود إبله إذا نزل به الضيفان أن يأتيهم بالملاهي ويسقيهم الشراب وينحر لهم الإبل، فإذا سمعن ذلك الصوت أيقنت أنها منحورة، وميمه زائدة، وجمعه مزاهر- ومر في ز. ومنه ح: وإن الله أنزل الحق ليذهب به الباطل ويبطل به الزمارات و\\\"المزاهر\\\". وفيه: فما كان لهم من \\\"مزاهر\\\"، هي الرياض لأنها تجمع أصناف الزهر والنبات، وذات المزاهر موضع، والمزاهر: هضبات حمر.\",\"name_ar\":\"مجمع بحار الأنوار للفَتِّنيّ\"},\n{\"entry_id\":848695,\"headword\":\"مزهر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"مزهر: مزهر (بالتشديد): غاضب، ساخط (باين سميث 1670).\",\"name_ar\":\"تكملة المعاجم العربية لرينهارت دوزي\"},\n{\"entry_id\":944208,\"headword\":\"مُزْهِر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"مُزْهِر\\nمن (ز ه ر) النبات إذا نور وطلع زهره، وموقد النار.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":944209,\"headword\":\"مُزْهَر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"مُزْهَر\\nمن (ز ه ر) الذي يضيء النار ويوقدها للضيف والعود الذي يضرب به طربا.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":944210,\"headword\":\"مِزْهِر\",\"headword_norm\":\"مزهر\",\"root\":\"زهر\",\"definitions_text\":\"مِزْهِر\\nمن (ز ه ر) المكان امتلأ بالزهر.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":707424,\"headword\":\"مُزْهر (نب).\",\"headword_norm\":\"مزهر (نب).\",\"root\":\"زهر\",\"definitions_text\":\"مُزْهر (نب).\",\"name_ar\":\"المورد الحديث (2008)\"},\n{\"entry_id\":944211,\"headword\":\"مُزْهِرَة\",\"headword_norm\":\"مزهرة\",\"root\":\"زهر\",\"definitions_text\":\"مُزْهِرَة\\nمن (ز ه ر) مؤنث مُزْهِر.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":944212,\"headword\":\"مِزْهَرَة\",\"headword_norm\":\"مزهرة\",\"root\":\"زهر\",\"definitions_text\":\"مِزْهَرَة\\nمن (ز ه ر) مؤنث مِزْهَر.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":855227,\"headword\":\"مَزْهَريَّة\",\"headword_norm\":\"مزهرية\",\"root\":\"زهر\",\"definitions_text\":\"مَزْهَريَّةالجذر: ز هـ ر\\nمثال: مَزْهَرِيَّة الوردالرأي: مرفوضةالسبب: لعدم ورودها في المعاجم. المعنى: وعاء من خزف ونحوه يوضع فيه الزهر للزينة\\nالصواب والرتبة: -زَهْرِيَّة الورد [فصيحة]-مَزْهَرِيَّة الورد [صحيحة] التعليق: كلمة «زَهْريَّة» أدلّ على المعنى المراد؛ لأنها اسم منسوب إلى الزَّهْر أو الزَّهرة، وقد سجلتها المعاجم الحديثة كالوسيط، والأساسي، أما تصحيح اللفظ المرفوض «مَزْهريَّة»، فلوروده في المنجد، والأساسي على اعتبار أنه نسبة إلى «مَزْهَر»، اسم المكان من زَهَر يَزْهَر.\",\"name_ar\":\"معجم الصواب اللغوي لأحمد مختار عمر\"},\n{\"entry_id\":43100,\"headword\":\"هارون بن عبد الله بن محمد, أبو يحيى الزُّهْرِيُّ\",\"headword_norm\":\"هارون بن عبد الله بن محمد, ابو يحيي الزهري\",\"root\":\"زهر\",\"definitions_text\":\"فقيه مالكي من القضاة, من أهل مكة, نزل بغداد, وولاه المأمون قضاء مصر سنة (٢١٧ هـ = ٨٣٢م)\",\"name_ar\":\"المعجم الكبير\"}]"}
