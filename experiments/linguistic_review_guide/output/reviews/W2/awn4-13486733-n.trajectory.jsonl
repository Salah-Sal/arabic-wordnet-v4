{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_015cxeBm6bNxmc464Gcs6AXK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SJtZVrTsgpMFthSoZQoq1b","name":"Bash","input":{"command":"cat > /output/awn4-13486733-n.review.yaml << 'ENDOFFILE'\n# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية — AWN4 Review Pipeline v2\n# synset_id : awn4-13486733-n\n# ili       : i107498\n# concept   : diffusion (physics)\n# reviewer  : AWN4 Review Pipeline v2 (5-Stage)\n# date      : 2026-03-17\n# ═══════════════════════════════════════════════════════════════\n\n\n# ── المرحلة ١: المراجعة والتوليد ─────────────────────────────\nstage1_review:\n  assessment:\n    concerns:\n      - \"لمّة «تداخل» هي المصطلح العربي الراسخ لـ«interference» (التداخل الموجي) في الفيزياء، لا لـ«diffusion»؛ ووجودها في هذه المجموعة خلطٌ اصطلاحي خطير يُربك الباحث العلمي.\"\n      - \"التعريف العربي الحالي يستعمل عبارة «تحدث فيها حركة لمادة» الركيكة؛ والأدق «تنتقل فيها جُسَيمات مادة ما تلقائياً».\"\n      - \"التعريف يُغفل الطابع التلقائي (spontaneous/passive) للانتشار الذي هو جوهر الظاهرة وما يميزها عن النقل الفعّال (active transport).\"\n    observations: \"المجموعة تمثّل ظاهرة الانتشار الفيزيائي (diffusion)، وهو من أكثر المفاهيم الفيزيائية توثيقاً في المعاجم العلمية العربية. «انتشار» مصطلح مقنَّن صادر عن لجان ALECSO في معاجم الفيزياء والكيمياء والجيولوجيا وهندسة المياه والطاقة المتجددة والطب البيطري، فلا حاجة إلى اشتقاق جديد. المشكلة الوحيدة هي وجود «تداخل» بجانبه وهو ينتمي إلى synset مغاير تماماً.\"\n\n  blind_candidates:\n    - lemma: \"تَسَرُّبٌ\"\n      generation_method: ishtiqaq\n      justification: \"من جذر س-ر-ب، باب تَفَعُّل، والسرب دالٌّ على السيلان والذهاب في الأرض (ابن فارس: «يدل على الاتساع والذهاب في الأرض»). يُعبّر تسرّب عن انتقال مادة من موضع إلى آخر عبر وسط، وهو ملائم للحركة من منطقة تركيز مرتفع إلى أخفض.\"\n    - lemma: \"نَفَاذٌ\"\n      generation_method: ishtiqaq\n      justification: \"من جذر ن-ف-ذ، مصدر نَفَذَ يَنْفُذُ. ابن فارس: «أصل صحيح يدل على مضاء في أمر وغيره». يُعبّر النفاذ عن اختراق المادة للوسط وعبورها من منطقة إلى أخرى، وهو ملامس لفكرة انتقال الجزيئات عبر الوسط تدريجياً.\"\n    - lemma: \"تَخَلُّلٌ\"\n      generation_method: ishtiqaq\n      justification: \"من جذر خ-ل-ل، باب تَفَعُّل. يدل على تغلغل شيء في ثنايا شيء آخر واختراقه. يُعبّر عن تشرّب مادة في الوسط وتوزّعها داخله من مناطق الكثافة العالية إلى المنخفضة.\"\n    - lemma: \"تَغَلْغُلٌ\"\n      generation_method: ishtiqaq\n      justification: \"من جذر رباعي مضاعف غ-ل-غ-ل، باب تَفَعْلَل. يدل على الاختراق العميق التدريجي. يُناسب الانتشار التدريجي للجزيئات من منطقة إلى أخرى عبر وسط.\"\n\n\n# ── المرحلة ٢: جمع الأدلة ────────────────────────────────────\n# الاستعلامات المُنفَّذة:\n#   Q1 — batch headword lookup: انتشار/الانتشار + تداخل/التداخل + تسرب/التسرب +\n#         نفاذ/النفاذ + تخلل/التخلل + تغلغل/التغلغل\n#   Q2 — English bridge: translation_en:\"diffusion\"\n#   Q3 — enrichment by entry_id (86703,806622,813223,816156,801771,387318,420407,632769)\n#   Q4 — Maqayis (dictionary_id=151): headword_norm IN ('نشر','دخل','سرب','نفذ')\nstage2_evidence:\n  per_lemma:\n\n    - lemma: \"انتشار\"\n      confirm:\n        - text: \"«انتشار — diffusion — Physics»\"\n          source: \"المعجم الموحد لمصطلحات الفيزياء العامة والنووية (1989) — ARABTERM/ALECSO\"\n        - text: \"«انتشار — diffusion — Chemistry»\"\n          source: \"المعجم الموحد لمصطلحات الكيمياء (1992) — ARABTERM/ALECSO\"\n        - text: \"«انتشار — diffusion — Geology»\"\n          source: \"المعجم الموحد لمصطلحات الجيولوجيا (2000) — ARABTERM/ALECSO\"\n        - text: \"«انتشار — diffusion — Water Engineering»\"\n          source: \"المعجم الموحد لمصطلحات المياه (2000) — ARABTERM/ALECSO\"\n        - text: \"«انتشار — diffusion — Remote Sensing»\"\n          source: \"المعجم الموحد لمصطلحات الاستشعار عن بعد (2000) — ARABTERM/ALECSO\"\n        - text: \"«انتشار — diffusion — Renewable Energy»\"\n          source: \"المعجم الموحد لمصطلحات الطاقة المتجددة (1996) — ARABTERM/ALECSO\"\n        - text: \"«انتشار ميسَّر — facilitated diffusion — Veterinary Medicine»\"\n          source: \"المعجم الموحد لمصطلحات الطب البيطري (2010) — ARABTERM/ALECSO\"\n        - text: \"«انتشار دوّامي — eddy diffusion; turbulent diffusion — Meteorology»\"\n          source: \"المعجم الموحد لمصطلحات الأرصاد الجوية (1999) — ARABTERM/ALECSO\"\n      expands:\n        - text: \"«النُّونُ وَالشِّينُ وَالرَّاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى فَتْحِ شَيْءٍ وَتَشَعُّبِهِ. وَنَشَرْتُ الْخَشَبَةَ بِالْمِنْشَارِ نَشْرًا. وَالنَّشْرُ: الرِّيحُ الطَّيِّبَةُ. [...] وَالِانْتِشَارُ: انْتِفَاخُ عَصَبِ الدَّابَّةِ مِنْ تَعَبٍ. وَالنَّشَرُ: أَنْ تَنْتَشِرَ الْغَنَمُ بِاللَّيْلِ فَتَرْعَى، وَلِذَلِكَ يُقَالُ لِمَنْ جَمَعَ أَمْرَهُ: قَدْ ضَمَّ نَشَرَهُ.»\"\n          source: \"مقاييس اللغة لابن فارس (ت. 395هـ)\"\n          addition: \"الجذر نشر يدل على الفتح والتشعب والانتشار في الاتجاهات، وهو يُجسّد الحركة الإشعاعية للجزيئات من مركز التركيز نحو المحيط تجسيداً دلالياً دقيقاً.\"\n        - text: \"«الانتشار — prevalence — The Unified Medical Dictionary»\"\n          source: \"المعجم الطبي الموحد (2009) — ARABTERM/ALECSO\"\n          addition: \"استعمال ثانوي للفظ بمعنى الانتشار الوبائي (prevalence)؛ يُؤكد قدرة اللمّة على التوسّع الدلالي دون أن يتعارض مع استعمالها الفيزيائي.\"\n\n    - lemma: \"تداخل\"\n      contradicts:\n        - text: \"«(فى الفيزياء) interference: ظاهِرَةٌ مَوْجِيَّةٌ تَحدُثُ عن تراكُبِ مَوْجَتَيْن مُتَساوِيَتَى الطُّولِ, صادِرَتَيْنِ عن مَصدَرَيْن مُترابِطَيْن»\"\n          source: \"المعجم الكبير — مجمع اللغة العربية (OCR)\"\n          conflict: \"المعجم الكبير يُحدد تداخل صراحةً بوصفه المصطلح الفيزيائي لـ«interference» لا لـ«diffusion»؛ المفهومان مختلفان جوهرياً: التداخل الموجي تراكبٌ لموجتين، والانتشار انتقالٌ جزيئي بفعل تدرّج التركيز.\"\n        - text: \"«التداخل: دخول شيء في شيء بلا زيادة حجم وقدر. تداخل العددين أن يفني أقلهما الأكثر كثلاثة وتسعة.»\"\n          source: \"التوقيف على مهمات التعاريف للمناوي (ت. 1031هـ)\"\n          conflict: \"الدلالة الكلاسيكية تصف الاندراج الكامل بحيث يشغل الشيئان حيزاً واحداً، وهو مغاير للانتشار الذي يصف الحركة من مركز إلى محيط.\"\n        - text: \"«التدَاخُلُ: تلاقي الشَّيْء الآخر بكليته حَتَّى يكفيهما مَكَان وَاحِد.»\"\n          source: \"معجم مقاليد العلوم للسيوطي (ت. 911هـ)\"\n          conflict: \"اندماج الشيئين في حجم واحد بلا زيادة ليس وصفاً للانتشار الفيزيائي الذي يُعبّر عن حركة جزيئية من تركيز أعلى إلى تركيز أدنى.\"\n        - text: \"«التَّدَاخُل: وَفِي عرف الْحُكَمَاء نُفُوذ بعض الْأَشْيَاء فِي بعض بِحَيْثُ يتحدان فِي الْوَضع والحجم. وَبِعِبَارَة أُخْرَى دُخُول شَيْء فِي شَيْء آخر بِلَا زِيَادَة حجم وَمِقْدَار.»\"\n          source: \"دستور العلماء للأحمدنكري\"\n          conflict: \"المفهوم الفلسفي الكلاسيكي للتداخل (interpenetration بلا حجم إضافي) يختلف عن الانتشار الفيزيائي ولا يُعبّر عنه.\"\n\n    - lemma: \"تَسَرُّبٌ\"\n      expands:\n        - text: \"«التسرب — seepages — AGROVOC»\"\n          source: \"المكنز الزراعي متعدد اللغات — ARABTERM/ALECSO\"\n          addition: \"يُستخدم بمعنى الرشح في الزراعة والمياه، أقرب إلى seepage/leakage منه إلى diffusion.\"\n        - text: \"«السِّينُ وَالرَّاءُ وَالْبَاءُ أَصْلٌ مُطَّرِدٌ، وَهُوَ يَدُلُّ عَلَى الِاتِّسَاعِ وَالذَّهَابِ فِي الْأَرْضِ. [...] وَمِنْ هَذَا الْبَابِ: السَّرَبُ وَالسَّرِبُ، وَهُوَ الْمَاءُ السَّائِلُ مِنَ الْمَزَادَةِ.»\"\n          source: \"مقاييس اللغة لابن فارس (ت. 395هـ)\"\n          addition: \"الجذر يدل على السيلان من شق أو فتحة (seepage)، لا على الانتشار الجزيئي العشوائي متعدد الاتجاهات.\"\n\n    - lemma: \"نَفَاذٌ\"\n      confirm:\n        - text: \"«نَفَاذ — diffusion; penetration — Water Engineering»\"\n          source: \"المعجم الموحد لمصطلحات المياه (2000) — ARABTERM/ALECSO\"\n      expands:\n        - text: \"«النَّفاذُ: جوازُ الشيءِ عن الشيءِ، والخُلوصُ منه، كالنُّفوذِ، ومخالَطَةُ السَّهْمِ جَوْفَ الرَّمِيَّةِ، وخُروجُ طَرَفِه من الشِّقِّ الآخَرِ وسائِرُه فيه.»\"\n          source: \"القاموس المحيط للفيروزآبادي (ت. 817هـ)\"\n          addition: \"الدلالة الأصلية هي الجواز والاختراق (penetration)؛ استعمالها في المياه قُرن بـdiffusion لكنه ثانوي وغير كافٍ للتقنين.\"\n        - text: \"«النُّونُ وَالْفَاءُ وَالذَّالُ: أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى مَضَاءٍ فِي أَمْرٍ وَغَيْرِهِ. وَنَفَذَ السَّهْمُ الرَّمْيَةَ نَفَاذًا.»\"\n          source: \"مقاييس اللغة لابن فارس (ت. 395هـ)\"\n          addition: \"الجذر يدل على المضاء والاختراق الخطي في اتجاه واحد (كالسهم)، وهو يختلف عن التشعب متعدد الاتجاهات الذي يميز الانتشار.\"\n\n    - lemma: \"تَخَلُّلٌ\"\n      evidence_status: \"no_material_found\"\n\n    - lemma: \"تَغَلْغُلٌ\"\n      evidence_status: \"no_material_found\"\n\n\n# ── المرحلة ٣: التحليل اللغوي للّمات ────────────────────────\nstage3_analysis:\n  per_lemma:\n\n    - lemma: \"انتشار\"\n      decision: confirmed\n      decision_reason: \"المصطلح العلمي المقنَّن والراسخ في 8+ معاجم ALECSO عبر ميادين الفيزياء والكيمياء والجيولوجيا وهندسة المياه والطاقة المتجددة والطب البيطري والأرصاد. الجذر نشر (الفتح والتشعب) يُجسّد الظاهرة الفيزيائية تجسيداً دلالياً دقيقاً: انتشار الجزيئات في جميع الاتجاهات من مركز التركيز نحو المحيط. اللمة غير مُشكَّلة، تحتاج تحديثاً.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: \"اللمة الأساسية والمقنَّنة للظاهرة؛ تُعبّر عن الحركة الإشعاعية متعددة الاتجاهات للجزيئات من مركز التركيز إلى المحيط، مستمدّةً من الجذر نشر الدالّ على الفتح والتشعب.\"\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"اِنْتِشَارٌ\"\n\n    - lemma: \"تداخل\"\n      decision: removed\n      decision_reason: \"تداخل هو المصطلح العربي الفيزيائي الراسخ لـ«interference» (التداخل الموجي) لا لـ«diffusion»؛ يُثبت ذلك المعجم الكبير صراحةً بتعريفه الفيزيائي: «ظاهرة موجية تحدث عن تراكب موجتين». الدلالة الكلاسيكية (اندراج شيئين في حجم واحد) أيضاً لا تُطابق مفهوم الانتشار. إبقاؤه يُحدث خلطاً مع synset التداخل الموجي ويُضلل الباحث.\"\n      evidence_assessment:\n        case: contradicts_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: remove_sense\n          params:\n            sense_id: \"{auto}\"\n\n    - lemma: \"تَسَرُّبٌ\"\n      source: stage1\n      decision: removed\n      decision_reason: \"تسرّب يدل على الرشح والسيلان (seepage/leakage) لا على الانتشار الجزيئي. الجذر سرب في مقاييس اللغة دالٌّ على السيلان من فتحة أو شق. ARABTERM يُرجمه بـseepages لا بـdiffusion.\"\n      evidence_assessment:\n        case: contradicts_only\n      mwe_check:\n        is_mwe: false\n\n    - lemma: \"نَفَاذٌ\"\n      source: stage1\n      decision: removed\n      decision_reason: \"نفاذ يدل أصالةً على الاختراق الخطي في اتجاه واحد (كنفاذ السهم) لا على التشعب متعدد الاتجاهات المميِّز للانتشار. الدليل من هندسة المياه (diffusion; penetration) ثانوي يخلط بين diffusion وpenetration. كما أن نفاذية = permeability مجاور يُحدث لبساً إضافياً.\"\n      evidence_assessment:\n        case: mixed\n      mwe_check:\n        is_mwe: false\n\n    - lemma: \"تَخَلُّلٌ\"\n      source: stage1\n      decision: removed\n      decision_reason: \"لا أدلة معجمية تدعم استخدام تخلّل مصطلحاً فيزيائياً للانتشار.\"\n      evidence_assessment:\n        case: no_material\n\n    - lemma: \"تَغَلْغُلٌ\"\n      source: stage1\n      decision: removed\n      decision_reason: \"لا أدلة معجمية تدعم استخدام تغلغل مصطلحاً فيزيائياً للانتشار.\"\n      evidence_assessment:\n        case: no_material\n\n\n# ── المرحلة ٤: التعريف والأمثلة ──────────────────────────────\nstage4_content:\n  definition:\n    current: \"(في الفيزياء) العملية التي تحدث فيها حركة لمادة من منطقة ذات تركيز عالٍ لتلك المادة إلى منطقة ذات تركيز أقل\"\n    assessment:\n      decision: revise\n      reason: \"التعريف مقبول وظيفياً إلا أنه يعاني من: (أ) «تحدث فيها حركة لمادة» صياغة ركيكة؛ (ب) إغفال الطابع التلقائي (spontaneous) الجوهري الذي يميز الانتشار عن النقل الفعّال؛ (ج) «تركيز أقل» دون ذكر الوصول إلى الاتزان كغاية الظاهرة.\"\n    authored:\n      - type: terminological\n        text: \"عمليةٌ فيزيائيةٌ تنتقل فيها جُسَيماتُ مادةٍ ما تلقائياً من منطقةٍ ذاتِ تركيزٍ مرتفعٍ إلى منطقةٍ ذاتِ تركيزٍ أدنى، دون الحاجة إلى طاقة خارجية، حتى يتحقق الاتزان في التوزيع\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: \"ظاهرةٌ فيزيائيةٌ تتحرك فيها جزيئاتُ مادةٍ —غازاً كانت أو سائلاً أو ذائباً— من مناطق التركيز المرتفع إلى مناطق التركيز المنخفض بفعل الحركة الحرارية العشوائية للجزيئات، وتستمر حتى يتوزع التركيز توزيعاً متجانساً؛ ومن أبرز تطبيقاتها انتقال الأكسجين من الحُوَيصلات الهوائية إلى الدم، وتوزّع الأملاح في المحاليل المائية.\"\n    actions:\n      - command: update_definition\n        params:\n          synset_id: \"awn4-13486733-n\"\n          definition_index: 0\n          text: \"عمليةٌ فيزيائيةٌ تنتقل فيها جُسَيماتُ مادةٍ ما تلقائياً من منطقةٍ ذاتِ تركيزٍ مرتفعٍ إلى منطقةٍ ذاتِ تركيزٍ أدنى، دون الحاجة إلى طاقة خارجية، حتى يتحقق الاتزان في التوزيع\"\n      - command: add_definition\n        params:\n          synset_id: \"awn4-13486733-n\"\n          text: \"ظاهرةٌ فيزيائيةٌ تتحرك فيها جزيئاتُ مادةٍ —غازاً كانت أو سائلاً أو ذائباً— من مناطق التركيز المرتفع إلى مناطق التركيز المنخفض بفعل الحركة الحرارية العشوائية للجزيئات، وتستمر حتى يتوزع التركيز توزيعاً متجانساً؛ ومن أبرز تطبيقاتها انتقال الأكسجين من الحُوَيصلات الهوائية إلى الدم، وتوزّع الأملاح في المحاليل المائية.\"\n\n  examples:\n    per_lemma:\n      - lemma: \"اِنْتِشَارٌ\"\n        examples:\n          - text: \"يُفسِّر الانتشارُ انتقالَ جزيئات الأكسجين من الحُوَيصلات الهوائية في الرئتين إلى الدم عبر الأغشية الخلوية الرقيقة، إذ تتحرك تلقائياً من منطقة تركيزها المرتفع إلى منطقة تركيزها المنخفض دون استهلاك أي طاقة.\"\n            type: usage\n    actions:\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"يُفسِّر الانتشارُ انتقالَ جزيئات الأكسجين من الحُوَيصلات الهوائية في الرئتين إلى الدم عبر الأغشية الخلوية الر