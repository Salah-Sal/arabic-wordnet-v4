4,\"headword\":\"ركاز ضعيف المحتوى الفلزي\",\"headword_norm\":\"ركاز ضعيف المحتوي الفلزي\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":437589,\"headword\":\"ركاز ضعيف المحتوى المعدني\",\"headword_norm\":\"ركاز ضعيف المحتوي المعدني\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":438213,\"headword\":\"ركاز منضد\",\"headword_norm\":\"ركاز منضد\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":438808,\"headword\":\"ركاز عرقي\",\"headword_norm\":\"ركاز عرقي\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":438950,\"headword\":\"ركاز مجوي\",\"headword_norm\":\"ركاز مجوي\",\"definitions_text\":\"مغير بالعوامل الجوية\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":446827,\"headword\":\"ركَازٌ مَسْحُوق\",\"headword_norm\":\"ركاز مسحوق\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\"},\n{\"entry_id\":451041,\"headword\":\"رِكَاز كبريت الزنك\",\"headword_norm\":\"ركاز كبريت الزنك\",\"definitions_text\":\"ركاز كبريتيد الزنك\",\"name_ar\":\"المعجم الموحد لمصطلحات النفط (1999)\"},\n{\"entry_id\":502982,\"headword\":\"لقية شاردة\",\"headword_norm\":\"لقية شاردة\",\"definitions_text\":\"\",\"name_ar\":\"مسرد الجغرافيا والتاريخ، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\"},\n{\"entry_id\":643807,\"headword\":\"عُتْمَةُ بِييروم (درجة متفاقمة من العُتْمَة الحَلقية)\",\"headword_norm\":\"عتمة بييروم (درجة متفاقمة من العتمة الحلقية)\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الطبي الموحد (2009)\"}]"}
{"type":"tool_use","timestamp":"2026-03-19T07:03:17.636Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773903797636_0","parameters":{"command":"sqlite3 -json \"/data/arabic_dict.db\" \"SELECT e.id AS entry_id, e.headword, e.definitions_text, d.name_ar FROM entries e JOIN dictionaries d ON e.dictionary_id = d.id WHERE e.headword_norm IN ('لقية','اللقية','لقطة','اللقطة') ORDER BY d.source_type, d.death_year ASC;\"","description":"Gathering evidence for 'لقية' and 'لقطة'."}}
{"type":"tool_result","timestamp":"2026-03-19T07:03:17.689Z","tool_id":"run_shell_command_1773903797636_0","status":"success","output":"[{\"entry_id\":432262,\"headword\":\"لقطة\",\"definitions_text\":\"شذر من الذهب تكون من فعل المياه على خامات الذهب\",\"name_ar\":\"المعجم الموحد لمصطلحات الجيولوجيا (2000)\"},\n{\"entry_id\":437117,\"headword\":\"لقطة\",\"definitions_text\":\"شذر من الذهب تكون من فعل المياه على خامات الذهب\",\"name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\"},\n{\"entry_id\":486286,\"headword\":\"لقطة\",\"definitions_text\":\"\",\"name_ar\":\"مسرد الإعلام والتواصل، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\"},\n{\"entry_id\":646503,\"headword\":\"لَقْطَةٌ\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الطبي الموحد (2009)\"},\n{\"entry_id\":817507,\"headword\":\"اللّقطَة\",\"definitions_text\":\"اللّقطَة: بِضَم الأول وَسُكُون الثَّانِي فِي اللُّغَة الرّفْع من الأَرْض - وَفِي الشَّرْع هِيَ مَال يُوجد فِي الطَّرِيق أَو غَيره وَلَا يعرف لَهُ مَالك بِعَيْنِه. سمي بهَا لِأَنَّهُ يلقط غَالِبا.\",\"name_ar\":\"دستور العلماء للأحمدنكري\"},\n{\"entry_id\":942106,\"headword\":\"لَقْطَة\",\"definitions_text\":\"لَقْطَة\\nمن (ل ق ط) المنظر في تؤخذ صورته على حدة.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":942107,\"headword\":\"لُقَطَة\",\"definitions_text\":\"لُقَطَة\\nمن (ل ق ط) بقلة تتبعها الدواب فتأكلها لطيبها، وقطعة منالذهب توجد في المعدن.\",\"name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\"},\n{\"entry_id\":795478,\"headword\":\"لُّقَطة\",\"definitions_text\":\"اللُّقَطة: هو مالٌ يوجد على الأرض ولا يعرف له مالك، وهي على وزن الضحكة، مبالغة في الفاعل؛ وهي لكونها مالًا مرغوبًا فيه جعلت آخذًا مجازًا، لكونها سببًا لأخذ من رآها.\",\"name_ar\":\"كتاب التعريفات للشريف الجرجاني\"},\n{\"entry_id\":814869,\"headword\":\"اللقطة\",\"definitions_text\":\"اللقطة: مال يؤخذ من الأرض ولا يعرف له مالك. وهو على وزن ضحكة مبالغة في الفاعل، وهي لكونها مالا مرغوبا فيه جعلت أخذا مجازا لكونها سببا لأخذ من رآها. كذا عبر بعضهم. وقال آخرون: اللقطة لغة: تناول ما ليس محفوظا. وشرعا: ما ضاع بسقوط أو غفلة.\",\"name_ar\":\"التوقيف على مهمات التعاريف للمناوي\"},\n{\"entry_id\":820515,\"headword\":\"اللّقطة\",\"definitions_text\":\"اللّقطة:[في الانكليزية] Finding ،waif ،find [ في الفرنسية] TrouvaiLLe ،objet trouve par terre بالضم وفتح القاف سماعا مبالغة الفاعل وبسكون القاف قياسا مبالغة المفعول كما في الطلبة. وقال الأزهري لم أسمعها بالسكون لغير اللّبث كما في المغرب. وإنّما قيل له بالفتح لجعله كالداعي إلى التقاط. وقيل إنّه اسم للملتقط وبالسكون للملقوط والأول هو الأصح كما في الاختيار. وفي القاموس إنّها بالضم والفتح والسكون أو بفتحتين اسم مفعول من الالتقاط وكان التاء للنقل فهي لغة الأخذ أو المأخوذ وشرعا مال بلا حافظ لا يعرف مالكه سواء كان من الحجرين أو العروض أو الحيوان كذا في جامع الرموز.\",\"name_ar\":\"كشّاف اصطلاحات الفنون والعلوم للتهانوي\"},\n{\"entry_id\":835652,\"headword\":\"اللُّقَطة\",\"definitions_text\":\"اللُّقَطة: كهُمزَةَ الشيء الذي تجده مُلقىً فتأخذه، أي المالُ الواقع على الأرض، قال السيد: \\\"هو مل يوجد على الأرض ولا يُعرَف له مالك، وهي على وزن الضُحَكة مبالغة في الفاعل، وهي لكونها مالاً مرغوباً به جعلت آخذاً مجازاً لكونها سبباً لأخذ من رآها\\\". وقال الفقيه أبو الليث: اللّقْطة بسكون القاف ولم تسمع بغيره كأنه جعل بمعنى الملقوط.\",\"name_ar\":\"التعريفات الفقهيّة للبركتي\"},\n{\"entry_id\":881375,\"headword\":\"اللّقطَة\",\"definitions_text\":\"(اللّقطَة) المنظر فِي الفلم تُؤْخَذ صورته على حِدة (محدثة)\\n(اللّقطَة) وَاحِدَة اللقط\\n(اللّقطَة) الشَّيْء الَّذِي تَجدهُ ملقى فتأخذه و (فِي الجيولوجيا) قِطْعَة من الذَّهَب ملْء الْكَفّ أَو أكبر تُوجد فِي الْمَعْدن (مج)\",\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\"},\n{\"entry_id\":26373,\"headword\":\"اللُّقَطَةُ\",\"definitions_text\":\"واحدة اللُّقَط الشيءُ الذى تجده مُلْقًى فتأخُذُه قطعة من الذهب ملء الكف أو أكبر توجد في المعدن. (مج)\",\"name_ar\":\"المعجم الوسيط\"},\n{\"entry_id\":26372,\"headword\":\"اللُّقْطَةُ\",\"definitions_text\":\"المنظر فى الفيلم تؤُخذ صورته على حِدَة. (محدثة)\",\"name_ar\":\"المعجم الوسيط\"},\n{\"entry_id\":26388,\"headword\":\"اللِّقِيَّةُ\",\"definitions_text\":\"فهو مَلْقُوٌّ (تكملة من صفحة سابقة أو معنى مرتبط بمادة سابقة)\",\"name_ar\":\"المعجم الوسيط\"}]"}
{"type":"tool_use","timestamp":"2026-03-19T07:03:26.549Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773903806549_0","parameters":{"command":"sqlite3 -json \"/data/arabic_dict.db\" \"SELECT headword, definitions_text FROM entries WHERE dictionary_id = 151 AND headword_norm IN ('كنز','ركز','لقي','دفن');\"","description":"Gathering Maqayis quotes for roots 'كنز', 'ركز', 'لقي', 'دفن'."}}
{"type":"tool_result","timestamp":"2026-03-19T07:03:26.597Z","tool_id":"run_shell_command_1773903806549_0","status":"success","output":"[{\"headword\":\"دَفَنَ \",\"definitions_text\":\"(دَفَنَ) الدَّالُ وَالْفَاءُ وَالنُّونُ أَصْلٌ وَاحِدٌ يَدُلُّ عَلَى اسْتِخْفَاءٍ وَغُمُوضٍ. يُقَالُ دُفِنَ الْمَيِّتُ، وَهَذِهِ بِئْرٌ دَفْنٌ: ادَّفَنَتْ. فَأَمَّا الِادِّفَانُ فَاسْتِخْفَاءُ الْعَبْدِ لَا يُرِيدُ الْإِبَاقَ الْبَاتَّ. وَقَالَ قَوْمٌ: الِادِّفَانُ: إِبَاقُ الْعَبْدِ وَذَهَابُهُ عَلَى وَجْهِهِ. وَالْأَوَّلُ أَجْوَدُ; لِمَا ذَكَرْنَاهُ مِنَ الْحَدِيثِ. وَالدَّاءُ الدَّفِينُ: الْغَامِضُ الَّذِي لَا يُهْتَدَى لِوَجْهِهِ. وَالدَّفُونُ: النَّاقَةُ تَبْرُكُ مَعَ الْإِبِلِ فَتَكُونُ وَسْطَهُنَّ. وَالدَّفَنِيُّ: ضَرْبٌ مِنَ الثِّيَابِ. وَسَمِعْتُ بَعْضَ أَهْلِ الْعِلْمِ يَقُولُونَ: إِنَّهُ صِبْغٌ يُدْفَنُ فِي صِبْغٍ يَكُونُ أَشْبَعَ مِنْهُ.\"},\n{\"headword\":\"رَكَزَ \",\"definitions_text\":\"(رَكَزَ) الرَّاءُ وَالْكَافُ وَالزَّاءُ أَصْلَانِ: أَحَدُهُمَا إِثْبَاتُ شَيْءٍ فِي شَيْءٍ يَذْهَبُ سُفْلًا، وَالْآخَرُ صَوْتٌ.\\nفَالْأَوَّلُ: رَكَزْتُ الرُّمْحَ رَكْزًا. وَمَرْكَزُ الْجُنْدِ: الْمَوْضِعُ الَّذِي أُلْزِمُوهُ. وَيُقَالُ ارْتَكَزَ الرَّجُلُ عَلَى قَوْسِهِ، إِذَا وَضَعَ سِيَتَهَا بِالْأَرْضِ ثُمَّ اعْتَمَدَ عَلَيْهَا. وَمِنَ الْبَابِ: الرِّكَازُ، وَهُوَ الْمَالُ الْمَدْفُونُ فِي الْجَاهِلِيَّةِ، وَهُوَ مِنْ قِيَاسِهِ; لِأَنَّ صَاحِبَهُرَكَزَهُ. وَقَالَ قَوْمٌ: الرِّكَازُ الْمَعْدِنُ. وَأَرْكَزَ الرَّجُلُ: وَجَدَ الرِّكَازَ. فَإِنْ كَانَ هَذَا صَحِيحًا فَهُوَ مُسْتَعَارٌ. وَالْمُرْتَكِزُ: يَابِسُ الْحَشِيشِ الَّذِي تَكَسَّرَ وَرَقُهُ وَتَطَايَرَ. وَمَعْنَاهُ أَنَّهُ ذَهَبَ مِنْهُ مَا ذَهَبَ وَارْتَكَزَ هَذَا، أَيْ ثَبَتَ.\"},\n{\"headword\":\"كَنَزَ \",\"definitions_text\":\"(كَنَزَ) الْكَافُ وَالنُّونُ وَالزَّاءُ أُصَيْلٌ صَحِيحٌ يَدُلُّ عَلَى تَجَمُّعٍ فِي شَيْءٍ. مِنْ ذَلِكَ نَاقَةٌ كِنَازُ اللَّحْمِ، أَيْ مُجْتَمِعَةٌ. وَكَنَزْتُ التَّمْرَ فِي وِعَائِهِ أَكْنِزُهُ. وَكَنَزْتُ الْكَنْزَ أَكْنِزُهُ. وَيَقُولُونَ فِي كَنْزِ التَّمْرِ: هُوَ زَمَنُ الْكَنَازِ. قَالَ ابْنُ السِّكِّيتِ: لَمْ يُسْمَعْ هَذَا إِلَّا بِالْفَتْحِ، أَيْ إِنَّهُ لَيْسَ هَذَا مِمَّا جَاءَ عَلَى فِعَالٍ وَفَعَالٍ كَجِدَادٍ وَجَدَادٍ.\"},\n{\"headword\":\"لَقِيَ \",\"definitions_text\":\"(لَقِيَ) اللَّامُ وَالْقَافُ وَالْحَرْفُ الْمُعْتَلُّ أُصُولٌ ثَلَاثَةٌ: أَحَدُهَا يَدُلُّ عَلَى عِوَجٍ، وَالْآخَرُ عَلَى تَوَافِي شَيْئَيْنِ، وَالْآخَرُ عَلَى طَرْحِ شَيْءٍ.\\nفَالْأَوَّلُ اللَّقْوَةُ: دَاءٌ يَأْخُذُ فِي الْوَجْهِ يَعْوَجُّ مِنْهُ. وَرَجُلٌ مَلْقُوٌّ، وَلُقِيَ الْإِنْسَانُ. وَاللَّقْوَةُ: الدَّلْوُ الَّتِي إِذَا أَرْسَلْتَهَا فِي الْبِئْرِ وَارْتَفَعَتْ أُخْرَى شَالَتْ مَعَهَا. قَالَ:\\nشَرُّ الدِّلَاءِ اللَّقْوَةُ الْمُلَازِمَهْ وَالِلَّقْوَةُ: الْعُقَابُ، سُمِّيَتْ بِهَا لِاعْوِجَاجِهَا فِي مِنْقَارِهَا. وَاللَِّقْوَةُ: النَّاقَةُ السَّرِيعَةُ اللِّقَاحِ.\\nوَالْأَصْلُ الْآخَرُ اللِّقَاءُ: الْمُلَاقَاةُ وَتَوَافِي الِاثْنَيْنِ مُتَقَابِلَيْنِ، وَلَقِيتُهُ لَقْوَةً، أَيْ مَرَّةً وَاحِدَةً وَلِقَاءَةً. وَلَقِيتُهُ لُِقْيًا وَلُقْيَانًا. وَاللُّقْيَةُ فُعْلَةٌ مِنَ اللِّقَاءِ، وَالْجَمْعُ لُقًى قَالَ:\\nوَإِنِّي لِأَهْوَى النَّوْمَ مِنْ غَيْرِ نَعْسَةٍ ... لَعَلَّ لُقَاكُمْ فِي الْمَنَامِ تَكُونُ\\nوَالْأَصْلُ الْآخَرُ: أَلْقَيْتُهُ: نَبَذْتُهُ إِلْقَاءً. وَالشَّيْءُ الطَّرِيحُ لَقًى. وَالْأَصْلُ أَنَّ قَوْمًا مِنَ الْعَرَبِ كَانُوا إِذَا أَتَوُا الْبَيْتَ لِلطَّوَافِ قَالُوا: لَا نَطُوفُ فِي ثِيَابٍ عَصَيْنَا اللَّهَ فِيهَا، فَيُلْقُونَهَا، فَيُسَمَّى ذَلِكَ الْمُلْقَى لَقًى. قَالَ ابْنُ أَحْمَرَ يَصِفُ فَرْخَ الْقَطَاةِ:\\nتُؤْوِي لَقًى أُلْقِيَ فِي صَفْصَفٍ ... تَصْهَرُهُ الشَّمْسُ فَلَا يَنْصَهِرْ.\"}]"}
