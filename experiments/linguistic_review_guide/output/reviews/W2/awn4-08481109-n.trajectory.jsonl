{"type":"tool_result","timestamp":"2026-03-19T07:03:37.123Z","tool_id":"run_shell_command_1773903817034_0","status":"success","output":"[{\"entry_id\":871880,\"headword\":\"الخبيئة\",\"headword_bare\":\"الخبيئة\",\"headword_norm\":\"الخبيئة\",\"root\":\"خب\",\"pos\":null,\"definitions_text\":\"(الخبيئة) الخبأة (ج) خبايا وَفِي الحَدِيث (اطْلُبُوا الرزق فِي خبايا الأَرْض) وخبايا الأَرْض بذورها فَيكون حثا على الزِّرَاعَة أَو خبايا الأَرْض معادنها فَيكون حثا على اسْتِخْرَاج الْمَعَادِن\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\"},\n{\"entry_id\":6814,\"headword\":\"الخبيئةُ\",\"headword_bare\":\"الخبيئة\",\"headword_norm\":\"الخبيئة\",\"root\":\"خبأ\",\"pos\":\"noun\",\"definitions_text\":\"الخبأة خبايا الأرض: بُذُورها. فيكون حثاً على الزراعة خبايا الأرض: معادنها. فيكون حثاً على استخراج المعادن\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\"},\n{\"entry_id\":80391,\"headword\":\"الخبيئَةُ\",\"headword_bare\":\"الخبيئة\",\"headword_norm\":\"الخبيئة\",\"root\":\"خبأ\",\"pos\":\"noun\",\"definitions_text\":\"الشيءُ المخبوءُ. يقال: له خَبِيئةٌ خَبَأَها ليوم حاجَتِهِ\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"},\n{\"entry_id\":873011,\"headword\":\"الدفينة\",\"headword_bare\":\"الدفينة\",\"headword_norm\":\"الدفينة\",\"root\":\"دفن\",\"pos\":null,\"definitions_text\":\"(الدفينة) مَا يدْفن والكنز (ج) دفائن\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\"},\n{\"entry_id\":968296,\"headword\":\"الدَّفينَةُ\",\"headword_bare\":\"الدفينة\",\"headword_norm\":\"الدفينة\",\"root\":\"دفن\",\"pos\":null,\"definitions_text\":\"الدَّفينَةُ:\\nبفتح أوله، وكسر ثانيه، وياء مثناة من تحت، ونون: مكان لبني سليم، ويروى بالقاف، قال السكري في قول جرير:\\nورّعت ركبي بالدفينة بعد ما ... ناقلن، من وسط الكراع، نقيلا\\nمن كل يعملة النّجاء تكلّفت ... جوز الفلاة تأوّها وذميلا\\nقال: الدفينة، بالفاء، ماء لبني سليم على خمس مراحل من مكة إلى البصرة، نقلته من خط ابن أخي الشافعي، وكان فيه يوم من أيامهم، وقال أنس ابن عباس الرّعلي في يوم الدفينة وكان لبني مازن بن عمرو بن تميم على بني سليم:\\nأغرّك مني أن رأيت فوارسي ... ثوى منهم، أعلى الدفينة، حاضر\\nأتاني برجل فوق أخرى يعدّنا ... عديد الحصى ما إن يزال يكاثر\\nوأمّكم تزجي التّؤام لبعلها، ... وأمّ أبيكم كزّة الرحم عاقر\",\"translation_en\":null,\"name_ar\":\"معجم البلدان لياقوت الحموي\",\"source_type\":\"hawramani\"},\n{\"entry_id\":9232,\"headword\":\"الدفينةُ\",\"headword_bare\":\"الدفينة\",\"headword_norm\":\"الدفينة\",\"root\":\"دفأ\",\"pos\":\"noun\",\"definitions_text\":\"غرفة زجاجية تُرَبَّى فيها النباتات, وتُدَفَّأ صناعِيًّا. (مج)\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\"},\n{\"entry_id\":9288,\"headword\":\"الدَّفِينَةُ\",\"headword_bare\":\"الدفينة\",\"headword_norm\":\"الدفينة\",\"root\":\"دفن\",\"pos\":\"noun\",\"definitions_text\":\"ما يُدْفَن الكنز\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\"},\n{\"entry_id\":813976,\"headword\":\"الركاز\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":null,\"definitions_text\":\"الركاز: المال المركوز في الأرض أي المدفون فيها إما بفعل آدمي كالكنز وإما بفعل إلهي كالمعدن. ويتناول الركاز الأمرين. وعند الفقهاء: المال المدفون في الجاهلية فعال بمعنى مفعول.\",\"translation_en\":null,\"name_ar\":\"التوقيف على مهمات التعاريف للمناوي\",\"source_type\":\"hawramani\"},\n{\"entry_id\":816711,\"headword\":\"الرِّكَاز\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":null,\"definitions_text\":\"الرِّكَاز: المَال المركوز فِي الأَرْض مخلوقا كَانَ أَو مَوْضُوعا فِيهَا فَهُوَ أَعم من الْمَعْدن والكنز و (الْمَعْدن) مَا خلقه الله تَعَالَى فِي الأَرْض يَوْم خلقهَا و (الْكَنْز) اسْم لما دَفنه بَنو آدم و (الرِّكَاز) اسْم لَهما.\",\"translation_en\":null,\"name_ar\":\"دستور العلماء للأحمدنكري\",\"source_type\":\"hawramani\"},\n{\"entry_id\":819776,\"headword\":\"الرّكاز\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":null,\"definitions_text\":\"الرّكاز:[في الانكليزية] Ore ،hidden treasure [ في الفرنسية] Minerai ،tresor enfoui لغة مأخوذ من الركز أي الإثبات بمعنى المركوز. وشرعا مال مركوز تحت أرض أعمّ من كون راكزه خالقا أو مخلوقا، أي معدن خلقي أو كنز مدفون هكذا في الدر المختار. الرّكة:[في الانكليزية] Accentuation [ في الفرنسية] Accentuation عند البلغاء هو أن يضطرّ الشّاعر لتسكين المتحرّك أو أن يحرّك السّاكن أو أن يسكّن المتحرّك المشدّد أو يشدّد المخفّف. كذا في جامع الصنائع.\",\"translation_en\":null,\"name_ar\":\"كشّاف اصطلاحات الفنون والعلوم للتهانوي\",\"source_type\":\"hawramani\"},\n{\"entry_id\":834763,\"headword\":\"الرِّكاز\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":null,\"definitions_text\":\"الرِّكاز: هو المال المركوز في الأرض مخلوقاً كان أو موضوعاً فيعمُّ المعدن الخِلقي والكنز المدفون.\",\"translation_en\":null,\"name_ar\":\"التعريفات الفقهيّة للبركتي\",\"source_type\":\"hawramani\"},\n{\"entry_id\":874220,\"headword\":\"الرِّكَاز\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":null,\"definitions_text\":\"(الرِّكَاز) مَا ركزه الله تَعَالَى فِي الأَرْض من الْمَعَادِن فِي حالتها الطبيعية والكنز وَالْمَال المدفون قبل الْإِسْلَام\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\"},\n{\"entry_id\":11395,\"headword\":\"الرِّكازُ\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":\"noun\",\"definitions_text\":\"ما ركزه الله تعالى فى الأرض من المعادن فى حالتها الطبيعية الكنز المال المدفون قبل الإسلام\",\"translation_en\":null,\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\"},\n{\"entry_id\":39040,\"headword\":\"الرِّكَازُ\",\"headword_bare\":\"الركاز\",\"headword_norm\":\"الركاز\",\"root\":\"ركز\",\"pos\":\"noun\",\"definitions_text\":\"ما ركَزَه الله تعالى فى الأرض أو فى المعادن؛ أى: أَحْدَثه وأَوْجَدَه فيها, وهو التِّبْرُ المخْلُوق فى الأرض القِطَعُ من الفِضَّة والذَّهَبِ تَخْرُجُ من الأرض أو من المَعْدِن المعادِنُ كُلُّها\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"},\n{\"entry_id\":80392,\"headword\":\"خَبِيئَة\",\"headword_bare\":\"خبيئة\",\"headword_norm\":\"خبيئة\",\"root\":\"خبأ\",\"pos\":\"noun\",\"definitions_text\":\"الزرع؛ لأنَّه إذا ألقى البَذْرَ في الأَرْض فقد خَبَّأَهُ فيها ما خَبَّأَهُ اللهُ في معادن الأَرْض\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"},\n{\"entry_id\":80390,\"headword\":\"خَبِيئَةُ\",\"headword_bare\":\"خبيئة\",\"headword_norm\":\"خبيئة\",\"root\":\"خبأ\",\"pos\":\"proper_noun\",\"definitions_text\":\"علَمٌ لغير واحدٍ, منهم: خَبِيئَةُ بنُ كُنّاز اسمُ امرأةٍ, وهى خَبِيئةُ بنتُ رياح بن يَرْبوع بن ثَعْلبة\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"},\n{\"entry_id\":80393,\"headword\":\"خُبيئَةُ\",\"headword_bare\":\"خبيئة\",\"headword_norm\":\"خبيئة\",\"root\":\"خبأ\",\"pos\":\"proper_noun\",\"definitions_text\":\"أبو خُبيئَةَ: كُنْيَةُ بعض المحدثين, منهم: أبوخُبيئَةَ, محمّد بن خالد , رَوَى عن أَنَسِ بن مالكٍ\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"},\n{\"entry_id\":852927,\"headword\":\"دَفِينة\",\"headword_bare\":\"دفينة\",\"headword_norm\":\"دفينة\",\"root\":\"دفن\",\"pos\":null,\"definitions_text\":\"دَفِينةالجذر: د ف ن\\nمثال: علّة دفينةالرأي: مرفوضةالسبب: لأن صيغة «فعيل» بمعنى «مفعول» مما يستوي فيه المذكر والمؤنث فلا تلحقها التاء. المعنى: مستورة مواراة\\nالصواب والرتبة: -علّة دفينٌ [فصيحة]-علّة دفينة [صحيحة] التعليق: «فعيل» بمعنى «مفعول» إذا جاء بعد موصوف لا تلحقه التاء مع المؤنث؛ لأنه مما يستوي في الوصف به المذكر والمؤنث، وأجاز بعض اللغويين إلحاق التاء حتى مع ذكر الموصوف. وقد اتخذ مجمع اللغة المصري قرارًا يجيز إلحاق التاء سواء ذكر الموصوف أو لم يذكر.\",\"translation_en\":null,\"name_ar\":\"معجم الصواب اللغوي لأحمد مختار عمر\",\"source_type\":\"hawramani\"},\n{\"entry_id\":88078,\"headword\":\"دَفِينَةٌ\",\"headword_bare\":\"دفينة\",\"headword_norm\":\"دفينة\",\"root\":\"دفن\",\"pos\":\"noun\",\"definitions_text\":\"ما يُدْفَنُ الكنْزُ, لِكونِهِ مَدْفُونًا في الأَرْضِ امْرأَةٌ دَفِينَةٌ: دَفِينٌ منزلٌ - وقيل: ماءٌ - لِبَنِى سُلَيْم على خَمْسِ مَراحِلَ (نحو ١٥٠كم) من مكَّةَ إلى البَصرة, كان فيه يَوْمٌ لِبَنِى مازِنِ بنِ عَمْرِو بنِ تَميمٍ على بَنِى سُلَيْم\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"},\n{\"entry_id\":795045,\"headword\":\"ركاز\",\"headword_bare\":\"ركاز\",\"headword_norm\":\"ركاز\",\"root\":\"ركز\",\"pos\":null,\"definitions_text\":\"الركاز: هو المال المركوز في الأرض، مخلوقًا كان أو موضوعًا.\",\"translation_en\":null,\"name_ar\":\"كتاب التعريفات للشريف الجرجاني\",\"source_type\":\"hawramani\"},\n{\"entry_id\":39041,\"headword\":\"رِكاز\",\"headword_bare\":\"ركاز\",\"headword_norm\":\"ركاز\",\"root\":\"ركز\",\"pos\":\"noun\",\"definitions_text\":\"شىءٌ دَسَرَه البَحْرُ المالُ المَدْفُونُ خاصَّةً مما كَنَزَه بنو آدم قبل الإسلام دَفِينُ أَهْل الجاهِلِيَّةِ (فى علوم الأرض) ore: المَعْدِنُ فى حالَتِه الطبيعيَّة, وهو فى الغالب ذو قيمة اقتصاديَّة؛ لاحتوائه على موادَّ نافِعةٍ\",\"translation_en\":null,\"name_ar\":\"المعجم الكبير\",\"source_type\":\"ocr\"}]"}
