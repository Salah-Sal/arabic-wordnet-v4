{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01HDtPqWvPNyq4AMwwN7q3Hh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HzCQ6SA9M4RWAjorE3UT3b","name":"Bash","input":{"command":"cat > /output/awn4-13450179-n.review.yaml << 'YAML_EOF'\n# ═══════════════════════════════════════════════════════════════\n# مراجعة المجموعة الترادفية — AWN4 Review Pipeline v2 (5-Stage)\n# synset_id : awn4-13450179-n\n# ili       : i107313\n# pos       : n\n# lemmas_en : aging / ageing / senescence\n# ═══════════════════════════════════════════════════════════════\n\n# ── المرحلة ١: المراجعة والتوليد ──────────────────────────────\nstage1_review:\n  assessment:\n    concerns:\n      - \"لمّة «تقدم في السن» عبارةٌ وصفيةٌ حرةٌ لا مصطلحٌ مسكوكٌ؛ يجوز إحلال «العمر» محلَّ «السن» دون إخلالٍ بالمعنى، مما يُخفق في اختبار التثبيت المعجمي\"\n      - \"لمّة «هرم» خاليةٌ من التشكيل وتحتاج إلى ضبطٍ كـ«هَرَمٌ» لتمييزِها عن «الهَرْمُ» (نبات) والهَرَمُ (بناء فرعوني) والهَرِمُ (الشخص البالغ أقصى الكبر)\"\n      - \"لمّة «شيخوخة» خاليةٌ من التشكيل وتستحقُّ التشكيلَ الكاملَ «شَيْخُوخَةٌ»\"\n      - \"«هرم» يعاني من اشتراكٍ لفظيٍّ شديدٍ مع المعنى المعمارييِّ والهندسيِّ والنباتيِّ\"\n      - \"غيابُ مصطلحٍ طبيٍّ دقيقٍ يُعادل «Senescence» بمعناه الفسيولوجيِّ عن المجموعةِ الراهنةِ\"\n    observations: \"المجموعةُ الترادفيةُ تُعبِّرُ عن مفهومٍ حيويٍّ أصيلٍ للتقدُّمِ في السنِّ عرَفَه العربُ منذُ القِدَمِ بمصطلحاتٍ متعددةِ المناحي. «شيخوخة» مصدرٌ صناعيٌّ راسخٌ هو الأعمُّ استعمالاً والأشملُ دلالةً. «هرم» مصدرٌ كلاسيكيٌّ يُفيد المبالغةَ في الكِبَرِ وبلوغَ أقصاه. غاب عن المجموعةِ مصطلحانِ وجديران بالإضافةِ: «التَّشَيُّخُ» المصطلحُ الطبيُّ الذي يُقابل Senescence في الأدبياتِ العلميةِ العربيةِ، و«الكِبَرُ» الذي يُركِّزُ على الجانبِ الزمنيِّ للعمليةِ. يُلاحَظُ أيضاً خطأٌ في بعضِ إدخالاتِ قاعدةِ البياناتِ التي تُسجِّلُ «شخ» جذراً لـ«شيخوخة» بدلاً من الجذرِ الصحيحِ «شيخ».\"\n\n  blind_candidates:\n    - lemma: \"تَهَرُّمٌ\"\n      generation_method: ishtiqaq\n      justification: \"مشتقٌّ من الجذر «هرم» على وزن «تَفَعُّل» الدالِّ على حصولِ الفعلِ تدريجياً؛ يُعبِّر عن المسارِ الحيويِّ لبلوغِ أقصى الكِبَرِ. الوزنُ ملائمٌ للدلالةِ على العمليةِ لا على الحالةِ.\"\n    - lemma: \"تَشَيُّخٌ\"\n      generation_method: ishtiqaq\n      justification: \"مشتقٌّ من الجذر «شيخ» على وزن «تَفَعُّل» الدالِّ على الحدوثِ التدريجيِّ؛ يُعبِّر عن مسارِ الكائنِ الحيِّ نحو الشيخوخةِ بصورةٍ عضويةٍ، وهو مستعمَلٌ في المعاجمِ الطبيةِ الحديثةِ مقابلاً لـSenescence.\"\n    - lemma: \"الذُّبُولُ\"\n      generation_method: majaz\n      justification: \"استعارةٌ من مجالِ النباتِ (ذَبَلَ النباتُ: ذوى وجفَّ)، تُطبَّق على العمليةِ الحيويةِ للهرمِ باعتبارها انتقاصاً تدريجياً للحجمِ والوظيفةِ بمشابهةٍ وظيفيةٍ. إحياءٌ لفظيٌّ كلاسيكيٍّ استعمله الحكماءُ في وصفِ انتقاصِ الجسمِ.\"\n    - lemma: \"الكِبَرُ\"\n      generation_method: ishtiqaq\n      justification: \"مصدرٌ من الجذر «كبر» على وزن «فِعَل»، ورد في معاجم اللغةِ بمعنى «التقدُّمِ في السنِّ». فرَّق المعجميون بين «الكِبَر» (علوُّ السنِّ) و«الكِبْر» (العظمةُ والغرور) و«الكُبْر» (الأقعديةُ في النسب)، مما يُتيحُ استعمالَه اصطلاحياً محدَّداً.\"\n\n\n# ── المرحلة ٢: جمع الأدلة ────────────────────────────────────\nstage2_evidence:\n  per_lemma:\n    - lemma: \"تقدم في السن\"\n      confirm:\n        - text: \"«شيخوخة، تقدم في السن» [مدخل مقابل ageing]\"\n          source: \"المعجم الموحد لمصطلحات علم الصحة وجسم الانسان (1992) — ARABTERM\"\n        - text: \"pres. part. of age: (1) تعمير؛ اكتهال؛ تقدّم في السنّ\"\n          source: \"المورد الحديث (2008) — ARABTERM\"\n\n    - lemma: \"شَيْخُوخَةٌ\"\n      confirm:\n        - text: \"[مدخل مستقل = senescence]\"\n          source: \"المعجم الموحد لمصطلحات علم الصحة وجسم الانسان (1992) — ARABTERM\"\n        - text: \"[مدخلان = senility / senium]\"\n          source: \"المعجم الطبي الموحد (2009) — ARABTERM\"\n        - text: \"[= old-age]\"\n          source: \"مسرد علم الاجتماع والأنثروبولوجيا — ARABTERM\"\n        - text: \"[= caducity]\"\n          source: \"المعجم الموحد لمصطلحات القانون (2017) — ARABTERM\"\n        - text: \"(1) شيخوخة؛ خَرَف (2) سرعة الزوال\"\n          source: \"المورد الحديث (2008) — ARABTERM\"\n\n    - lemma: \"هَرَمٌ\"\n      confirm:\n        - text: \"«الهَرَم: محركةً كِبَرُ السن وبلوغ أقصى الكبر»\"\n          source: \"التعريفات الفقهية للبركتي (1975 م)\"\n        - text: \"«الهرم: علو السن. وأصله من الهرم، وهو نبت ضعيف، والكبر يضعف البدن»\"\n          source: \"التوقيف على مهمات التعاريف للمناوي (1622 م)\"\n        - text: \"«مرحلة من مراحل ما بعد القطاف في الثمار يحصل فيها تحلل الفاكهة أو الخضار نتيجة لتخزينها فترة طويلة» [= senescence]\"\n          source: \"المعجم الموحد لمصطلحات تقانات الأغذية (2004) — ARABTERM\"\n        - text: \"[= senescence]\"\n          source: \"المَكنَز الزراعي متعدد اللغات AGROVOC — ARABTERM\"\n        - text: \"[= senility]\"\n          source: \"مسرد علم الاجتماع والأنثروبولوجيا — ARABTERM\"\n      expands:\n        - text: \"«الهَرَمُ، محركةً، والمَهْرَمُ والمَهْرَمَةُ: أقْصَى الكِبَرِ، هَرِمَ، كفرحَ، فهو هَرِمٌ من هَرِمينَ وهَرْمَى»\"\n          source: \"القاموس المحيط للفيروزآبادي (1414 م)\"\n          addition: \"يُضيف مصدرَيْن جديدَيْن: المَهرَم والمَهرَمة، ويؤكَّد أن الهرمَ أقصى الكِبَرِ لا مجرد التقدُّمِ فيه\"\n        - text: \"«(الهَرم) الشَّيخ يبلغ أقصى الكبر»\"\n          source: \"المعجم الوسيط لمجموعة من المؤلفين (1998)\"\n          addition: \"يُشير إلى أن «الهرم» يُطلق أيضاً على الشخصِ البالغِ أقصى الكبرِ (بمعنى اسم الفاعل)\"\n        - text: \"«كبر السن أو العجز» [translation_en: insenescence]\"\n          source: \"معجم المصطلحات الطبية ج.3 (1997) — ARABTERM\"\n          addition: \"الترجمةُ الإنجليزيةُ مشكوكٌ فيها (insenescence ≠ senescence)؛ المعنى العربي صحيحٌ لكن الترجمةَ معكوسةٌ ظاهراً\"\n\n    - lemma: \"تَشَيُّخٌ\"\n      confirm:\n        - text: \"«التَّشَيُّخُ (فى الطب) (Senescence (E: بُطْءُ الوظائفِ الحيويَّةِ وضَعْفُها الناتجانِ عن الشيخوخة»\"\n          source: \"المعجم الكبير — مجمع اللغة العربية\"\n        - text: \"«تشيُّخ، وَهَن، هَرَم» [= senescence]\"\n          source: \"المعجم الموحد لمصطلحات الطب البيطري (2010) — ARABTERM\"\n        - text: \"«نظرية التَّشَيُّخِ في التَّصَلُّبِ العَصيدِيّ» [= aging theory of atherosclerosis]\"\n          source: \"المعجم الطبي الموحد (2009) — ARABTERM\"\n      contradicts:\n        - text: \"«(تشيخ) تكلّف الشيخوخة»\"\n          source: \"المعجم الوسيط لمجموعة من المؤلفين (1998)\"\n          conflict: \"يُثبت الوسيطُ أن الفعلَ «تشيَّخَ» يعني التظاهرَ بالشيخوخةِ لا حدوثَها الفعليَّ؛ غير أن السياقَ الطبيَّ يُميِّز الاستخدامَ الاصطلاحيَّ عن المعنى العامِّ\"\n        - text: \"«تشيَّخَ فلانٌ: شاخ | تكلَّف الشيخوخة»\"\n          source: \"المعجم الكبير — مجمع اللغة العربية\"\n          conflict: \"المعجمُ الكبيرُ نفسُه يُورد المعنيَيْن معاً؛ مما يستوجبُ تقييدَ الاستعمالِ الاصطلاحيِّ بالسياقِ الطبيِّ\"\n\n    - lemma: \"الذُّبُولُ\"\n      contradicts:\n        - text: \"«ذبول» [= wilting / wilts]\"\n          source: \"المَكنَز الزراعي متعدد اللغات AGROVOC — ARABTERM\"\n          conflict: \"المصطلحُ الحديثُ يُحيل إلى ذبولِ النباتاتِ لا إلى هرمِ الكائناتِ الحيَّةِ\"\n        - text: \"«ذبول» [= wilt disease]\"\n          source: \"المعجم الموحد لمصطلحات علم الأحياء (1993) — ARABTERM\"\n          conflict: \"يُحيلُ إلى مرضٍ نباتيٍّ لا إلى عمليةِ التقدُّمِ في السنِّ\"\n        - text: \"«ذبول» [= deflorescence]\"\n          source: \"معجم المصطلحات الطبية ج.2 (2003) — ARABTERM\"\n          conflict: \"في الطبِّ يعني زوالَ الطفحِ الجلديِّ لا الشيخوخةَ\"\n        - text: \"«الذبول: هو انتقاص حجم الجسم بسبب ما ينفصل عنه في جميع الأقطار على نسبة طبيعية»\"\n          source: \"كتاب التعريفات للشريف الجرجاني (1413 م)\"\n          conflict: \"يُشير إلى انتقاصِ الحجمِ عموماً وليس إلى عمليةِ الهرمِ البيولوجيِّ تحديداً\"\n      expands:\n        - text: \"«الذّبول: ضد النمو وهما من أنواع الحركة الكمية... ويطلق الذبول أيضا على بعض أقسام البحران»\"\n          source: \"كشّاف اصطلاحات الفنون والعلوم للتهانوي (1777 م)\"\n          addition: \"يُوضِّح أن الذبولَ مفهومٌ فلسفيٌّ وطبيٌّ يعني انتقاصَ الحجمِ لا التقدُّمَ في السنِّ\"\n\n    - lemma: \"الكِبَرُ\"\n      confirm:\n        - text: \"«كِبَر: تقدُّم في السن» [= aging]\"\n          source: \"المعجم الموحد لمصطلحات الطب البيطري (2010) — ARABTERM\"\n        - text: \"«كبر» [= ageing]\"\n          source: \"المَكنَز الزراعي متعدد اللغات AGROVOC — ARABTERM\"\n        - text: \"«التغيرات التدريجية التي تطرأ على أجهزة الكائن الحي بمرور الوقت دون أن تنشأ عن مرض معين أو إصابة» [= aging]\"\n          source: \"معجم المصطلحات الطبية ج.1 (1985) — ARABTERM\"\n        - text: \"«وَمِنَ الْبَابِ الْكِبَرُ، وَهُوَ الْهَرَمُ»\"\n          source: \"مقاييس اللغة لابن فارس (1004 م)\"\n        - text: \"«[كبر] الكِبَرُ في السنّ وقد كَبِرَ الرجل يَكْبَرُ كِبَراً، أي أسن»\"\n          source: \"تاج اللغة وصحاح العربية للجوهري (1003 م)\"\n      expands:\n        - text: \"«كَبِرَ الرجل والدابة كِبَراً، فهو كبير: طعن في السن. وقد علته كَبْرَة ومَكْبِرَة ومَكْبُرَة»\"\n          source: \"المحكم والمحيط الأعظم لابن سيده (1066 م)\"\n          addition: \"يُضيف مصادرَ مشتقةً من الجذرِ دالةً على علوِّ السنِّ: كَبْرَة، مَكْبِر، مَكْبُرَة\"\n\n    - lemma: \"تَهَرُّمٌ\"\n      evidence_status: \"no_material_found\"\n\n\n# ── المرحلة ٣: التحليل اللغوي للّمات ────────────────────────\nstage3_analysis:\n  per_lemma:\n    - lemma: \"تقدم في السن\"\n      decision: removed\n      decision_reason: \"تفشلُ هذه العبارةُ في اختبار التثبيت المعجمي؛ يجوز إحلالُ «تقدُّم في العمر» أو «تقدُّم في الأعمار» محلَّها في أيِّ سياقٍ دون إخلالٍ، مما يُثبتُ أنها عبارةٌ وصفيةٌ حرةٌ لا وحدةٌ معجميةٌ ثابتةٌ. لا يُسجِّلُها المعجمُ مدخلاً مستقلاً بل يُورِدُها مقترنةً بـ«شيخوخة». بنيتُها: اسمٌ + جارٌّ ومجرور، وليست تركيباً إضافياً أو وصفياً مسكوكاً.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: true\n        mwe_type: wasfi\n      actions:\n        - command: remove_sense\n          params:\n            sense_id: \"{auto}\"\n\n    - lemma: \"شيخوخة\"\n      decision: confirmed\n      decision_reason: \"المصطلحُ الأعمُّ والأشيعُ استعمالاً في العربيةِ الحديثةِ والمعاصرةِ للدلالةِ على الشيخوخةِ بأبعادِها البيولوجيةِ والاجتماعيةِ. يُثبتُه عددٌ كبيرٌ من المعاجمِ المتخصصةِ ترجمةً لـsenescence وsenility وold-age. مصدرٌ صناعيٌّ من الجذرِ «شيخ» راسخٌ في الاستعمالِ الفصيحِ. يستوجبُ تصحيحَ التشكيلِ.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: \"أعمُّ الألفاظِ وأشيعُها، تشملُ الحالةَ والعمليةَ معاً، وتُستخدَم في السياقَيْن البيولوجيِّ والاجتماعيِّ دونَ تخصيصٍ لدرجةِ التقدُّمِ\"\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"شَيْخُوخَةٌ\"\n\n    - lemma: \"هرم\"\n      decision: confirmed\n      decision_reason: \"موثَّقٌ في المعاجمِ الكلاسيكيةِ بمعنى «كبرِ السنِّ وبلوغِ أقصاه»، وتُترجمُه AGROVOC وتقانات الأغذية بـ«senescence» مباشرةً. الاشتراكُ اللفظيُّ المعماريُّ لا يُبطلُ الاستعمالَ البيولوجيَّ المتواترَ في المعاجمِ المتخصصةِ. يستوجبُ تصحيحَ التشكيلِ إلى «هَرَمٌ» (بفتحتَيْن) للتمييزِ من «الهَرْمُ» (البناء الفرعوني: بفتح فسكون).\"\n      evidence_assessment:\n        case: mixed\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: \"يُفيد المبالغةَ في التقدُّمِ في السنِّ وبلوغَ أقصى درجاتِه مع انحلالِ الجسمِ وضعفِ وظائفِه؛ أخصُّ من «شيخوخة» وأشدُّ منها وطأةً\"\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"هَرَمٌ\"\n\n    - lemma: \"تَشَيُّخٌ\"\n      source: stage1\n      decision: confirmed\n      decision_reason: \"المعجمُ الكبيرُ يُثبتُه مصطلحاً طبياً صريحاً مقابلاً لـ«Senescence» بتعريفٍ دقيقٍ (بطءُ الوظائفِ الحيويةِ وضعفُها). معجمُ الطبِّ البيطريِّ يُورِدُه ضمنَ مجموعةِ مرادفاتٍ للـsenescence. التناقضُ مع «التظاهرِ بالشيخوخة» خاصٌّ بالفعلِ «تشيَّخَ» في سياقٍ اجتماعيٍّ، ولا يُلغي المعنى الاصطلاحيَّ الطبيَّ للمصدرِ. الوزنُ «تفعُّل» دالٌّ على العمليةِ التدريجيةِ مما يُناسبُ التعبيرَ البيولوجيَّ.\"\n      evidence_assessment:\n        case: mixed\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: \"مصطلحٌ طبيٌّ تقنيٌّ يُبرزُ الطابعَ الفسيولوجيَّ الدقيقَ للعمليةِ (بطءُ الوظائفِ الحيويةِ وضعفُها)، ويُقابلُ «Senescence» في الأدبياتِ الطبيةِ والبيطريةِ العربيةِ الحديثةِ\"\n      actions:\n        - command: create_entry\n          params:\n            lemma: \"تَشَيُّخٌ\"\n            pos: n\n        - command: add_sense\n          params:\n            entry_id: \"{auto}\"\n            synset_id: \"{synset_id}\"\n\n    - lemma: \"الذُّبُولُ\"\n      source: stage1\n      decision: removed\n      decision_reason: \"تُثبتُ الأدلةُ المعجميةُ الحديثةُ أن «الذبول» مصطلحٌ نباتيٌّ (wilting / wilt disease) في المعاجمِ المتخصصةِ، ولا صلةَ له بعمليةِ الشيخوخةِ البشريةِ. الاستخدامُ الكلاسيكيُّ عند الحكماءِ يُفيد انتقاصَ حجمِ الجسمِ عموماً لا الهرمَ البيولوجيَّ تحديداً. الإزاحةُ المجازيةُ المقترَحةُ غيرُ قابلةٍ للتثبيتِ مع وجودِ ألفاظٍ راسخةٍ.\"\n\n    - lemma: \"الكِبَرُ\"\n      source: stage1\n      decision: confirmed\n      decision_reason: \"يُوثِّقُه معجمُ الطبِّ البيطريِّ (كِبَر = aging) ومقاييسُ اللغةِ لابن فارس (الكِبَرُ = الهَرَمُ)، ويُشير إليه AGROVOC بـageing، ومعجمُ الطبِّ (1985) يُعرِّفُه بـ«التغيراتِ التدريجيةِ التي تطرأ على أجهزةِ الكائنِ الحيِّ بمرورِ الوقتِ». مصدرٌ كلاسيكيٌّ راسخٌ من الجذرِ «كبر» يُركِّزُ على الجانبِ الزمنيِّ. فارقُ التشكيلِ «كِبَر» يُميِّزُه من «كِبْر» (عظمة) و«كُبْر» (أقعدية).\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      nuance_differentiation: \"يُركِّزُ على الجانبِ الزمنيِّ للتقدُّمِ في السنِّ (مرورُ الوقتِ وتراكُمُ التغيُّراتِ التدريجيةِ) دونَ إيحاءٍ بالانحلالِ الشديدِ أو أقصى الكبرِ كما يُوحي «الهرم»\"\n      actions:\n        - command: create_entry\n          params:\n            lemma: \"الكِبَرُ\"\n            pos: n\n        - command: add_sense\n          params:\n            entry_id: \"{auto}\"\n            synset_id: \"{synset_id}\"\n\n    - lemma: \"تَهَرُّمٌ\"\n      source: stage1\n      decision: removed\n      decision_reason: \"لم تُسفر استعلاماتُ قاعدةِ البياناتِ عن أيِّ دليلٍ معجميٍّ مُثبِتٍ لهذا المصدرِ. يُغني عنه «هَرَمٌ» الموجودُ في المجموعةِ ويُشاركُه الجذرَ والمعنى، كما يُغني عنه «تَشَيُّخٌ» المؤكَّدُ في أدائِه وظيفةَ التعبيرِ عن العمليةِ الحيويةِ.\"\n\n\n# ── المرحلة ٤: التعريف والأمثلة ──────────────────────────────\nstage4_content:\n  definition:\n    current: \"العملية العضوية للتقدم في العمر وظهور آثار زيادة السن\"\n    assessment:\n      decision: revise\n      reason: \"التعريفُ الحالي ترجمةٌ حرفيةٌ من الإنجليزيةِ تفتقرُ إلى أسلوبِ المعجمِ العربيِّ القائمِ على الجنسِ والفصلِ. «العضوية» أقلُّ دقةً من «الحيوية» في السياقِ البيولوجيِّ. عبارةُ «التقدُّمِ في العمر» يُحيطُ بها خطرُ الدورانِ. التعريفُ مُهملٌ لِوَصفِ التدريجيةِ والطابعِ الحتميِّ للعمليةِ.\"\n    authored:\n      - type: terminological\n        text: \"عمليةٌ حيويةٌ طبيعيةٌ تعتري الكائناتِ الحيَّةَ بالتدريجِ، يصاحبُها تراجُعُ الوظائفِ الجسديَّةِ وظهورُ آثارِ تقدُّمِ السنِّ على مختلفِ أجهزتِها\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n      - type: encyclopedic\n        text: \"سيرورةٌ بيولوجيةٌ تدريجيةٌ حتميةٌ تصيبُ الكائناتِ الحيَّةَ، تتجلَّى في ضعفِ الخلايا والأنسجةِ وانخفاضِ كفاءتِها وتراجُعِ قدرتِها التجديديةِ، مما يُفضي إلى التغيُّراتِ الملازِمةِ لمرحلةِ الكِبَرِ كشيبِ الشَّعرِ وضعفِ البصرِ وهشاشةِ العظامِ\"\n    actions:\n      - command: update_definition\n        params:\n          synset_id: \"{synset_id}\"\n          definition_index: 0\n          text: \"عمليةٌ حيويةٌ طبيعيةٌ تعتري الكائناتِ الحيَّةَ بالتدريجِ، يصاحبُها تراجُعُ الوظائفِ الجسديَّةِ وظهورُ آثارِ تقدُّمِ السنِّ على مختلفِ أجهزتِها\"\n      - command: add_definition\n        params:\n          synset_id: \"{synset_id}\"\n          text: \"سيرورةٌ بيولوجيةٌ تدريجيةٌ حتميةٌ تصيبُ الكائناتِ الحيَّةَ، تتجلَّى في ضعفِ الخلايا والأنسجةِ وانخفاضِ كفاءتِها وتراجُعِ قدرتِها التجديديةِ، مما يُفضي إلى التغيُّراتِ الملازِمةِ لمرحلةِ الكِبَرِ كشيبِ الشَّعرِ وضعفِ البصرِ وهشاشةِ العظامِ\"\n\n  examples:\n    per_lemma:\n      - lemma: \"شَيْخُوخَةٌ\"\n        examples:\n          - text: \"تدرسُ علومُ الطبِّ الحديثِ الشيخوخةَ دراسةً معمَّقةً بهدفِ فهمِ التغيُّراتِ الجسديةِ والنفسيةِ المصاحبةِ لها والحدِّ من تأثيراتِها على جودةِ الحياةِ\"\n            type: usage\n      - lemma: \"هَرَمٌ\"\n        examples:\n          - text: \"أقعدَه الهَرَمُ عن الحركةِ بعدَ أن تجاوزَ التسعينَ، فكانَ يستعينُ بعصاهُ على النهوضِ والمشيِ\"\n            type: usage\n      - lemma: \"الكِبَرُ\"\n        examples:\n          - text: \"اعتراهُ الكِبَرُ فضَعُفَ بصرُه وتساقطَت أسنانُه، غيرَ أن ذهنَه ظلَّ وقَّاداً يُحدِّث عن أيامِه الغابرةِ\"\n            type: usage\n      - lemma: \"تَشَيُّخٌ\"\n        examples:\n          - text: \"تُبيِّنُ الدراساتُ الجينيةُ الحديثةُ أن معدَّلَ التَّشَيُّخِ يتفاوتُ بينَ الأفرادِ تبعاً للعواملِ الوراثيةِ وأنماطِ التغذيةِ وأسلوبِ الحياةِ\"\n            type: usage\n    actions:\n      - command: add_synset_example\n        params:\n          synset_id: \"{synset_id}\"\n          text: \"تُعدُّ الشيخوخةُ عمليةً حيويةً حتميةً تصيبُ جميعَ الكائناتِ الحيَّةِ بالتدريجِ وتتجلَّى في تراجُعِ الوظائفِ الجسميةِ\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"تدرسُ علومُ الطبِّ الحديثِ الشيخوخةَ دراسةً معمَّقةً بهدفِ فهمِ التغيُّراتِ الجسديةِ والنفسيةِ المصاحبةِ لها والحدِّ من تأثيراتِها على جودةِ الحياةِ\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"أقعدَه الهَرَمُ عن الحركةِ بعدَ أن تجاوزَ التسعينَ، فكانَ يستعينُ بعصاهُ على النهوضِ والمشيِ\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"اعتراهُ الكِبَرُ فضَعُفَ بصرُه وتساقطَت أسنانُه، غيرَ أن ذهنَه ظلَّ وقَّاداً يُحدِّث عن أيامِه الغابرةِ\"\n      - command: add_sense_example\n        params:\n          sense_id: \"{auto}\"\n          text: \"تُبيِّنُ الدراساتُ الجينيةُ الحديثةُ أن معدَّلَ التَّشَيُّخِ يتفاوتُ بينَ الأفرادِ تبعاً للعواملِ الوراثيةِ وأنماطِ التغذيةِ وأسلوبِ الحياةِ\"\n\n\n# ── المرحلة ٥: الإثراء (البيانات الوصفية) ─────────────────────\nstage5_enrichment:\n  per_entry:\n    - lemma: \"شَيْخُوخَةٌ\"\n      entry_id: \"{auto}\"\n      root: \"شيخ\"\n      maqayis_quote: \"«الشِّينُ وَالْيَاءُ وَالْخَاءُ كَلِمَةٌ وَاحِدَةٌ، وَهِيَ الشَّيْخُ. تَقُولُ: هُوَ شَيْخٌ، وَهُوَ مَعْرُوفٌ، بَيِّنُ الشَّيْخُوخَةِ وَالشَّيَخِ وَالتَّشْيِيخِ. وَقَدْ قَالُوا أَيْضًا كَلِمَةً، قَالُوا: شَيَّخْتُ عَلَيْهِ»\"\n\n    - lemma: \"هَرَمٌ\"\n      entry_id: \"{auto}\"\n      root: \"هرم\"\n      maqayis_quote: \"«الْهَاءُ وَالرَّاءُ وَالْمِيمُ كَلِمَتَانِ: إِحْدَاهُمَا الْهَرَمُ: كِبَرُ السِّنِّ. وَيُقَالُ: الْهَرِمَةُ: اللَّبُؤَةُ. وَابْنُ هِرْمَةَ: آخِرُ وَلَدِ الرَّجُلِ. وَالْأُخْرَى الْهُرْمَانُ: الْعَقْلُ»\"\n\n    - lemma: \"تَشَيُّخٌ\"\n      entry_id: \"{auto}\"\n      root: \"شيخ\"\n      maqayis_quote: \"«الشِّينُ وَالْيَاءُ وَالْخَاءُ كَلِمَةٌ وَاحِدَةٌ، وَهِيَ الشَّيْخُ. تَقُولُ: هُوَ شَيْخٌ، وَهُوَ مَعْرُوفٌ، بَيِّنُ الشَّيْخُوخَةِ وَالشَّيَخِ وَالتَّشْيِيخِ»\"\n\n    - lemma: \"الكِبَرُ\"\n      entry_id: \"{auto}\"\n      root: \"كبر\"\n      maqayis_quote: \"«الْكَافُ وَالْبَاءُ وَالرَّاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى خِلَافِ الصِّغَرِ. يُقَالُ: هُوَ كَبِيرٌ، وَكُبَارٌ، وَكُبَّارٌ... وَمِنَ الْبَابِ الْكِبَرُ، وَهُوَ الْهَرَمُ. وَعَلَتْ فُلَانًا كَبْرَةٌ، إِذَا كَبِرَ. وَيَقُولُونَ: كِبْرُ سِيَاسَةِ الْقَوْمِ فِي الْمَالِ»\"\n\n  per_sense:\n    - lemma: \"شَيْخُوخَةٌ\"\n      sense_id: \"{auto}\"\n      nuance: \"أعمُّ الألفاظِ وأشيعُها استعمالاً، تشملُ الحالةَ والعمليةَ معاً، وتُستخدَم في السياقَيْن البيولوجيِّ والاجتماعيِّ دونَ تخصيصٍ لدرجةِ التقدُّمِ\"\n      mwe: false\n\n    - lemma: \"هَرَمٌ\"\n      sense_id: \"{auto}\"\n      nuance: \"يُفيد المبالغةَ في التقدُّمِ في السنِّ وبلوغَ أقصاهُ مع انحلالِ الجسمِ وضعفِ وظائفِه؛ أخصُّ من «شيخوخة» وأشدُّ منها دلالةً على الانحلالِ الجسديِ