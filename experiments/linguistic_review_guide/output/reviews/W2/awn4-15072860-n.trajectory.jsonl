{"type":"tool_use","timestamp":"2026-03-16T13:29:53.806Z","tool_name":"run_shell_command","tool_id":"run_shell_command_1773667793805_0","parameters":{"description":"Batch headword lookup for existing and candidate lemmas.","command":"sqlite3 -json \"/data/arabic_dict.db\" \"SELECT e.id AS entry_id, e.headword, e.headword_norm, e.root, e.root_source, e.definitions_text, e.translation_en, e.domain, d.name_ar, d.source_type, d.period FROM entries e JOIN dictionaries d ON e.dictionary_id=d.id WHERE e.headword_norm IN ('مبيد للفيروسات', 'المبيد للفيروسات', 'مبيد الفيروسات', 'المبيد الفيروسات', 'مضاد الفيروسات', 'المضاد الفيروسات', 'فيروسيد', 'الفيروسيد', 'مبيد', 'المبيد', 'فيروس', 'الفيروس') ORDER BY e.headword_norm, d.source_type, d.death_year ASC NULLS LAST;\""}}
{"type":"tool_result","timestamp":"2026-03-16T13:29:53.947Z","tool_id":"run_shell_command_1773667793805_0","status":"success","output":"[{\"entry_id\":879496,\"headword\":\"الفيروس\",\"headword_norm\":\"الفيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"(الفيروس) كائنات دقيقة لَا ترى بالمجهر العادي تنفذ من الراشحات البكتيرية وتحدث بعض الْأَمْرَاض (د)\",\"translation_en\":null,\"domain\":null,\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\",\"period\":\"modern\"},\n{\"entry_id\":22375,\"headword\":\"الفَيْرُوسُ\",\"headword_norm\":\"الفيروس\",\"root\":\"فيرس\",\"root_source\":\"ocr\",\"definitions_text\":\"كائنات دقيقة لا ترى بالمجهر العادى تنفذ من الراشحات البكتيرية, وتُحدِثُ بعضَ الأمراض. (د)\",\"translation_en\":null,\"domain\":null,\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\",\"period\":\"modern\"},\n{\"entry_id\":881782,\"headword\":\"المبيد\",\"headword_norm\":\"المبيد\",\"root\":\"بد\",\"root_source\":\"camel\",\"definitions_text\":\"(المبيد) مبيد الحشرات مَادَّة تقتل الجراثيم (البكترية) فتحول دون الْعَدْوى\",\"translation_en\":null,\"domain\":null,\"name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"source_type\":\"hawramani\",\"period\":\"modern\"},\n{\"entry_id\":2575,\"headword\":\"المُبيد\",\"headword_norm\":\"المبيد\",\"root\":\"بيد\",\"root_source\":\"ocr\",\"definitions_text\":\"مبيد الحشرات: مادّة تقتل الجراثيم (البكتيرية), فتحول دون العدوى\",\"translation_en\":null,\"domain\":null,\"name_ar\":\"المعجم الوسيط\",\"source_type\":\"ocr\",\"period\":\"modern\"},\n{\"entry_id\":385182,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"كائنات دقيقة ممرضة.\",\"translation_en\":\"virus\",\"domain\":\"Renewable Energy\",\"name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":355869,\"headword\":\"فَيْرُوس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"برنامج ذو حجم صغير جدا (بعض البايتات)، له خاصية الدخول في برنامج مضيف والتكاثر ذاتيا سواء بالمثل أو بالتغيير، عند كل مرة ينطلق فيها البرنامج. وهدفه إصابة أكثر ما يمكن من البرامج في أكثر ما يمكن من الأنظمة\",\"translation_en\":\"virus\",\"domain\":\"Information and Communication\",\"name_ar\":\"المعجم الموحد لمصطلحات تقانة (تكنولوجيا) المعلومات (2011)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":360059,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"أصغر شكل من أشكال الكائنات الدقيقة القادرة على التسبب في المرض. والفيروسات جسيمات معدية تعتمد على الآلية الخلوية للخلية المضيفة للنمو والتكاثر.\",\"translation_en\":\"virus\",\"domain\":\"Climate, Environment and Solid Waste management\",\"name_ar\":\"مسرد المناخ والبيئة وإدارة النفايات الصلبة، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":399336,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"برنامج حاسوبي مدمر قادر على تكرار نفسه، مثل الكثير من الفيروسات البيولوجية. وقد يعطل عمل الحاسوب الخاص بك عن طريق إعادة كتابة أو حذف المعلومات بطريقة عشوائية.\",\"translation_en\":\"virus\",\"domain\":\"Education\",\"name_ar\":\"مسرد التربية، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":457475,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"جسيم من الرواشح  ومن العوامل المرضية يتألف من مادة بروتينية ويتخذ الشكل البلوري ويكون خاملا في الأحوال الاعتيادية ولكنه يميل إلى الانقسام عند تماسه بأجسام حية خاصة\",\"translation_en\":\"virus\",\"domain\":\"Biology\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":459686,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"\",\"translation_en\":\"virus\",\"domain\":\"Hygienics and Human Body\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الصحة وجسم الانسان (1992)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":462245,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"كائن جرثوميّ قادر على الإصابة يتكون من حمض نوويّ وبروتين يستطيع التكاثر داخل الخلية.\",\"translation_en\":\"virus\",\"domain\":\"Genetics\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":465888,\"headword\":\"فَيْرُوس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"عامل مسبب للمرض، يتراوح قطره بين (10و250) نانمترا، يتألف من غلاف بروتينيّ يحيط بالحمض النوويّ الدنا (DNA) أو الرنا (RNA)، يسخر الخلية التي يدخلها لتركيب مادته الوراثية وتكاثرها، ولكنه لايستطيع الاستقلال في الاستقلاب والتكاثر.\",\"translation_en\":\"virus\",\"domain\":\"Pharmacy\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الصيدلة (2009)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":470854,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"\",\"translation_en\":\"virus\",\"domain\":\"Veterinary Medicine\",\"name_ar\":\"المعجم الموحد لمصطلحات الطب البيطري (2010)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":483032,\"headword\":\"فَيْروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"عامل ممرض يحتاج إلى الخلايا الحية لتكاثره وهو أصغر حجماً من الأحياء الدقيقة كالبكتيريا والأوليات.\",\"translation_en\":\"virus\",\"domain\":\"Nutrition Technologies\",\"name_ar\":\"المعجم الموحد لمصطلحات تقانات الأغذية (2004)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":533351,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"برنامجٌ دخيلٌ يُصيبُ الملفاتِ الحاسوبيةَ بإدراجِ نُسَخٍ من نفسِه فيها. وتُنفَّذ النسخُ عادةً لدى تحميل الملف في الذاكرة، الأمر الذي يؤدِّي إلى عدوى ملفات أخرى، وهكذا دواليك. وغالباً ما يكون للفيروسات أعراضٌ جانبية مؤذية، مقصودة أحياناً، وغير مقصودة أحياناً أخرى. فمثلاً، قد تخرِّبُ الفيروساتُ القرصَ الصُّلبَ في الحاسوب، أو قد تحتلُّ حيّزاً من الذاكرة كان من الممكِن للبرامج أن تستفيد منه.\",\"translation_en\":\"virus\",\"domain\":\"Dictionary of Information Technology Terms\",\"name_ar\":\"معجم مصطلحات المعلوماتية (2000)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":860255,\"headword\":\"فيروس\",\"headword_norm\":\"فيروس\",\"root\":\"فرس\",\"root_source\":\"camel\",\"definitions_text\":\"فيروسفَيْروس [مفرد]: ج فَيْروسات:1 - (حس) ميكروب برمجي موجّه يصيب أجهزة الحاسب الآليّ، يؤدِّي إلى خلل أو تدمير أو إتلاف بيانات أو أجزاء الجهاز كُليًّا أو جزئيًّا.2 - (حي، طب) كائن دقيق سريع الانتشار، لا يُرى بالمجهر العاديّ، وقد يكون وسطًا بين الحيّ وغير الحيّ، منه أنواع عديدة، تُحدث الكثير من الأمراض المعْدِية، كالجدريّ والحصبة، وشلل الأطفال ونحوها \\\"فيروس الإيدز/ الأنفلونزا\\\".• علم الفيروسات: (حي) العلم الذي يتناول دراسة الفيروسات والأمراض الفيروسيّة. \\nفَيْروسيّ [مفرد]: اسم منسوب إلى فَيْروس: له قدرة أو خاصيّة التوالد والتزايد بسرعة \\\"مرض فيروسيّ- عدوى فيروسيّة\\\".\",\"translation_en\":null,\"domain\":null,\"name_ar\":\"معجم اللغة العربية المعاصرة لأحمد مختار عمر\",\"source_type\":\"hawramani\",\"period\":\"modern\"},\n{\"entry_id\":352354,\"headword\":\"مبيد\",\"headword_norm\":\"مبيد\",\"root\":\"بد\",\"root_source\":\"camel\",\"definitions_text\":\"مادة كيميائية تستخدم لقتل الحشرات غير المرغوب فيها والحيوانات\",\"translation_en\":\"pesticides\",\"domain\":\"Civil Engineering\",\"name_ar\":\"المعجم الموحد لمصطلحات الهندسة المدنية (2012)\",\"source_type\":\"arabterm\",\"period\":\"modern\"},\n{\"entry_id\":361450,\"headword\":\"مبيد\",\"headword_norm\":\"مبيد\",\"root\":\"بد\",\"root_source\":\"camel\",\"definitions_text\":\"مواد كيميائية تقتل كائنات (نباتات أو حشرات أو فطريات، مزعجة أو ضارة)، أو تمنع إنباتها أو نموها أو تكاثرها. تستعمل في الحقول والمزارع والحدائق والأماكن المفتوحة لكن أيضا في البيت والأماكن المغلقة مع أخد الاحتياطات اللازمة في كلتا الحالتين.\",\"translation_en\":\"pesticide\",\"domain\":\"Climate, Environment and Solid Waste management\",\"name_ar\":\"مسرد المناخ والبيئة وإدارة النفايات الصلبة، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"source_type\":\"arabterm\",\"period\":\"modern\"}]"}
