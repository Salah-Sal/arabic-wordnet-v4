{"type":"tool_result","timestamp":"2026-03-16T13:50:49.523Z","tool_id":"run_shell_command_1773669049454_0","status":"success","output":"[{\"type\":\"poetry\",\"text\":\"فما أجْشَمْت من إثْيانِ قَوْمٍ / هُمُ الْأَعْدَاءُ والأكبادُ سُودُ\"},\n{\"type\":\"poetry\",\"text\":\"تَبَصَّرْ خَليلى هَلْ تَرَى من ظعائنٍ / خَرَجْنَ بِنِصْفِ اللَّيْلِ مِنْ أَسْوَدِ الدَّمِ\"},\n{\"type\":\"poetry\",\"text\":\"إذا زالَ عَنْكُمْ أَسْوَدُ العَيْنِ كُنْتُمُ / كرامًا وأَنْتُمْ ما أقامَ الألائِمُ\"},\n{\"type\":\"poetry\",\"text\":\"ألا ما لعينٍ لا ترى أَسْوَدَ الحِمَى / ولا جَبَلَ الأوشالِ إلا استَهَلَّتِ\"},\n{\"type\":\"poetry\",\"text\":\"ولقَدْ غَدَوْتُ وصاحبى وَحْشِيَّةٌ / تحتَ الرِّداءِ بَصيرةٌ بالْمُشْرِفِ / حتى انْتَهيْتُ إلى فِراش عزيزةً / سوداءَ رَوْثَةُ أَنْفِها كَالْمِخْصَفِ\"},\n{\"type\":\"quran\",\"text\":\"يَوْمَ تَبْيَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌ فَأَمَّا الَّذِينَ اسْوَدَّتْ وُجُوهُهُمْ أَكَفَرْتُم بَعْدَ إِيمَانِكُمْ\"},\n{\"type\":\"quran\",\"text\":\"وَيَوْمَ الْقِيَامَةِ تَرَى الَّذِينَ كَذَبُوا عَلَى اللَّهِ وُجُوهُهُم مُّسْوَدَّةٌ\"},\n{\"type\":\"poetry\",\"text\":\"وقال ابن هَرْمَة – يمدح أبا جعفر المنصور – :\"},\n{\"type\":\"poetry\",\"text\":\"لَهُ تُرْبَةٌ بَيْضَاءُ مِنْ آلِ هَاشِمٍ\\nإِذا اسْوَدَّ مِنْ لُؤْمِ التُّرَابِ القبائِلُ\"},\n{\"type\":\"poetry\",\"text\":\"تَرَى قَسَماتِنا تَسْوَدُّ فيها\\nوما أخْلاقُنا فِيها بِسُودِ\"},\n{\"type\":\"poetry\",\"text\":\"فَقَدْنَاكَ فاسْوَدَّتْ عَلَيْكَ قُلُوبُنَا\\nوحُقَّتْ بِأَنْ تَسْوَدَّ وابْيَضَّتِ اللِّمَمْ\"},\n{\"type\":\"poetry\",\"text\":\"وبأىِّ نَوْلٍ أنْتَ ناسِجُ بُرْدَةٍ\\nلِلضَّفَّتَيْن جَدِيدُها لا يَخْلُقُ\\nتَسْوَدُّ ديباجًا إِذا فارقْتَها\\nفإِذا حَضَرْتَ اخْضَوْضَرَ الإسْتَبْرَقُ\"},\n{\"type\":\"poetry\",\"text\":\"قامت تُرِيك أثيثَ النبتِ منسدلاً / مِثْلَ الأساود قد مُسِّحْنَ بالفاقِ\"},\n{\"type\":\"poetry\",\"text\":\"أسودُ شَرًى لاقَتْ أسودَ خَفِيَّةٍ / تساقوا على حَرْدٍ سِمامَ الأساودِ\"},\n{\"type\":\"poetry\",\"text\":\"كلا يمينِ اللهِ حتَّى تُنْزِلُوا / مِن رأْسِ شاهقَةٍ إلينا الأَسْوَدَا\"},\n{\"type\":\"quran\",\"text\":\"وَكُلُوا وَاشْرَبُوا حَتَّى يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ مِنَ الْخَيْطِ الْأَسْوَدِ مِنَ الْفَجْرِ\"},\n{\"type\":\"proverb\",\"text\":\"رَمَى بسَهْمِه الأسودِ\"},\n{\"type\":\"poetry\",\"text\":\"قالَتْ أُمَيْمَةُ لَمَّا جِئْتُ زائرَها / هلا رَمَيْت ببعض الْأَسْهُمِ السُّودُ\"},\n{\"type\":\"hadith\",\"text\":\"اللَّهُمَّ إنى أعوذُ بك من الأسدِ والأسودِ\"},\n{\"type\":\"poetry\",\"text\":\"كنتم كَمَنْ أدْخَل فى جُحْرِ يدا / فأخطأ الأفعى ولاقى الأسودا\"},\n{\"type\":\"poetry\",\"text\":\"يرى الناسُ مِنَّا جِلْدَ أَسْوَدَ سالِخٍ / وفَرْوَةَ ضِرْغَامٍ مِنَ الْأُسْدِ ضَيْغَمِ\"},\n{\"type\":\"hadith\",\"text\":\"بُعِثْتُ إلى الأحمر والأسود\"},\n{\"type\":\"poetry\",\"text\":\"تُرَاجِعُ منها أَسْوَدَ القلبِ خَطْرَةً / بلاءً ويَجْرِى فى العِظامِ امْذِلالُها\"},\n{\"type\":\"poetry\",\"text\":\"فرَدَّ شُعورَهن السُّودَ بيضًا / وردَّ وجوههن البيض سُودا\"},\n{\"type\":\"poetry\",\"text\":\"صَدٍ غائِرُ العَيْنَيْن شَقَّقَ لحمَهُ\\nسَمَائِمُ قَيْظٍ فَهُوَ أَسْوَدُ شاسِفُ\"},\n{\"type\":\"poetry\",\"text\":\"على أَنَّها قالَتْ رَأَيْتُ خُوَيْلِدًا\\nتَنَكَّر حَتَّى عادَ أَسْوَدَ كالْجِذْل\"},\n{\"type\":\"poetry\",\"text\":\"قُلْ للمليحة فى الخِمار الأَسْوَد\\nماذا فعلتِ بناسِكٍ مُتَعَبِّدِ\"},\n{\"type\":\"poetry\",\"text\":\"أَلا إِنَّني شَرِبْتُ أَسْوَد حالِكًا\\nأَلا بَجَلى من الشَّراب أَلَا بَجَلْ\"},\n{\"type\":\"quran\",\"text\":\"{وَمِنَ الْجِبَالِ جُدَدٌ بِيضٌ وَحُمْرٌ مُّخْتَلِفٌ أَلْوَانُهَا وَغَرَابِيبُ سُودٌ}\"}]"}
