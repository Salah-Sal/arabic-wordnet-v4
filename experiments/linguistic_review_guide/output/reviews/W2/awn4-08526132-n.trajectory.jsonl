{"type":"tool_result","timestamp":"2026-03-16T12:31:56.787Z","tool_id":"run_shell_command_1773664316705_0","status":"success","output":"[{\"entry_id\":385969,\"headword\":\"صراع استخدام وطني\",\"headword_norm\":\"صراع استخدام وطني\",\"definitions_text\":\"-\",\"name_ar\":\"المعجم الموحد لمصطلحات الطاقة المتجددة (1996)\"},\n{\"entry_id\":389379,\"headword\":\"مِصراع 'فوراكرز'\",\"headword_norm\":\"مصراع 'فوراكرز'\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":391341,\"headword\":\"مِصراع البنغال\",\"headword_norm\":\"مصراع البنغال\",\"definitions_text\":\"بوّابة السد في مُنشئات الري الرئيسية، وتتكوّن البوابة من ضلفتين، واحدة على مُستوى مُنخفض في اتجاه التيار (الضلفة الأمامية) والثانية تقع تحت مُستوى المياه وتكون بارتفاعها الكامل. وتثبت كلتا الضلفتين عند نفس الموضع. وتُعد الضلفة الأمامية تجهيزة مُساعدة لإنتصاب الضلفة الخلفية. (انظر: [مِصراع البنغال](http://www.arabterm.org/index.php?id=3&L=1&tx_3m5techdict_pi1[id]=107035))\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":391342,\"headword\":\"بوابة بنغال\",\"headword_norm\":\"بوابة بنغال\",\"definitions_text\":\"(انظر: [مِصراع البنغال](http://www.arabterm.org/index.php?id=3&L=1&tx_3m5techdict_pi1[id]=107035))\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":391485,\"headword\":\"مِصراع الثقل الموازن\",\"headword_norm\":\"مصراع الثقل الموازن\",\"definitions_text\":\"\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":391633,\"headword\":\"بوابة هدّار مزدوجة خطافية\",\"headword_norm\":\"بوابة هدار مزدوجة خطافية\",\"definitions_text\":\"في مُنشآت تخزين المياه، مِصراع يتكوَّن من بوابتين، البوابة العليا منه تكون على شكل بوابة هدّار خطافية. (DIN 4048-1:1987)\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":391774,\"headword\":\"مصراع\",\"headword_norm\":\"مصراع\",\"definitions_text\":\"مِصراع يتم تركيبه على بوابات الهدَّارات أو عَتَبِها أو على العوارض الحاجزة، حيث تقترب حافته السُفلى من بوّابة الهدَّار الدوَّارة. (DIN 4048-1:1987)\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":392142,\"headword\":\"مِصراع ذو ثقل موازن علوي\",\"headword_norm\":\"مصراع ذو ثقل موازن علوي\",\"definitions_text\":\"مصراع أوتوماتي موجود في مُنشئات الريّ، وهو يحتفظ بمنسوب مياه ثابت بواسطة مجموعة من الأثقال الموازنة يمكن وضعها فوق المصراع. (الاتحاد الألماني لإدارة المياه والهندسة الزراعية: DVWK) 1983))\",\"name_ar\":\"المعجم الموحد لمصطلحات المياه (2000)\"},\n{\"entry_id\":15937,\"headword\":\"المِصراعُ\",\"headword_norm\":\"المصراع\",\"definitions_text\":\"مصراع الباب: أحَدُ جزيأيه؛ وهما مصراعان أحدهما إلى اليمين والآخر إلى اليسار من بيت الشعر: نصفه. وهما مصراعان يسمى الأول الصَّدْر والآخر العَجُز\",\"name_ar\":\"المعجم الوسيط\"},\n{\"entry_id\":17253,\"headword\":\"أطْرَدَهُ\",\"headword_norm\":\"اطرده\",\"definitions_text\":\"جعلَه طريداً فلانًا عن البلد ونحوه أو منه: أمر بطرده وإبعاده صاحبَه: راهنه في سبَق أو قمار أو صراع\",\"name_ar\":\"المعجم الوسيط\"},\n{\"entry_id\":35368,\"headword\":\"الأراميون\",\"headword_norm\":\"الاراميون\",\"definitions_text\":\"شعب ساميّ سكن الأرض الواقعة بين بلاد الرافدين (بابل وأشور) وكَنْعان (فلسطين وفينيقيا) فى منطقة تُحَدُّ جنوبًا بصحراء العرب, وشمالاً بجبال الأناضول . ويصعد تاريخُهم السياسيُّ إلى الألف الثاني قبل الميلاد , وبلَغَ ذِرْوَته فى القرنين الحادي عشر والعاشر قبل الميلاد . ولم يكوِّنوا وحدةً سياسية , وإنما انقسموا إلى دول صغيرة كانت فى صراع دائم مع أشور وبابل من جانب , ومع العبريين من جانب آخر\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":37757,\"headword\":\"أهُورًا مَزْدَا\",\"headword_norm\":\"اهورا مزدا\",\"definitions_text\":\"إله الخير والنور والصلاح عند المجوس , وهو يقابل أهْرِمن إله الشر والظلمة والفساد عندهم أيضا , ومنهما تتكون ثنائية زَرادُشت التي صدر عنها الكون , وهما في صراع دائم ينتهى بغلبة الخير .\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":53511,\"headword\":\"الشِّنْكِل\",\"headword_norm\":\"الشنكل\",\"definitions_text\":\"حديدةٌ يُقَيَّدُ بها مِصراعُ النَّافِذَة من الخارج أو الداخل أوتادٌ صغيرةٌ تُدَقُّ فى الحائط تُعَلَّقُ بها الثِّيابُ ونَحْوُها حديدةٌ مَعْقوفَةٌ مُفْرَدَةٌ أو مُزْدَوَجةٌ تُعَلَّقُ بها اللحومُ والذبائحُ\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":55466,\"headword\":\"الصِّراعُ\",\"headword_norm\":\"الصراع\",\"definitions_text\":\"مُعالجةُ القِرْنَيْن أيهما يطرحُ صاحبَه. (فـي الأدب): التَّصادمُ بـين الشَّخصيَّات, أو النِّزاع الذى يؤدّى إلى تعقيد الحدثِ في المسرحيةِ أو القصة. وهو ينقسمُ قسمين: صراعٌ داخليٌّ, وصراعٌ خارجيٌّ. الشَّديدُ الطَّرْحِ, وإن لم يكن معروفًا بذلك.\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":56145,\"headword\":\"الصَّفْقُ\",\"headword_norm\":\"الصفق\",\"definitions_text\":\"مِصراع الباب, وهُو ما يُسمَّى الآن بالدَّرْفَة. وهما صِفْقان. يقال: باب دارهِ صِفْقٌ واحدٌ: إذا لم يكنْ مِصْرَاعَيْنِ\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":58291,\"headword\":\"الضَّرْبُ\",\"headword_norm\":\"الضرب\",\"definitions_text\":\"المِثْلُ والشَّبِيه. يقال: هو ضَرْبُ فلانٍ. المِثَالُ. يقال: عندى من هذا الضَّرْبِ شيءٌ كثيرٌ. ويقال: هذه الأشياءُ على ضَرْبٍ واحدٍ. التَّشابُهُ في القَدِّ والخَلْقِ. ويقال: رأيتُ ضَرْبَ نساءٍ. الصِّنْفُ والنَّوعُ. يقال: هذا من ضَرْبِ ذلك. ويقال: الدَّهْرُ ضربانِ: ضَرْبُ بلاءٍ, وضَرْبُ رَخاءٍ. الصِّفَةُ. الصِّيغَةُ. يقال: هذا من ضَرْبِ فُلانٍ. (في الجبر) Multiplication (E): تَكرارُ عددٍ ما مرَّاتٍ بقدر ما في عددٍ آخرَ مِن الوحداتِ, ومنه: جدول الضَّرْب. (في علوم الأحياء) Variety (E): وَحْدَةٌ من وَحداتِ التَّصنيف الصُّغرى تَلِي تحت النَّوع (نُوَيْع) كالسُّلالةِ. (في العروض): آخرُ تفعيلةٍ من المِصراع الثانى من البيت.\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":64170,\"headword\":\"الأراميون\",\"headword_norm\":\"الاراميون\",\"definitions_text\":\"شعب سامى سكن الأرض الواقعة بين بلاد الرافدين ( بابل وأشور) وكنعان ( فلسطين وفينيقيا) فى منطقة تُحدُّ جنوباً بصحراء العرب, وشمالاً بجبال الأناضول . ويصعد تاريخُهم السياسى إلى الألف الثانى قبل الميلاد , وبلغ ذِروَتَه فى القرنين الحادى عشر والعاشر قبل الميلاد . ولم يكوِّنوا وحدةً سياسية , وإنما انقسموا إلى دول صغيرة كانت فى صراع دائم مع أشور وبابل من جانب , ومع العبريين من جانب آخر .\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":73788,\"headword\":\"جَهْجَهَ\",\"headword_norm\":\"جهجه\",\"definitions_text\":\"البَطَلُ: صاحَ عند قتال أو صراع الرَّاعِي بالذِّئْبِ وغيره: صاحَ به ليكفَّه بالإبل : زَجَرَها الإبل : رَدَّ وجوهَها فلانًا : رَدَّه عن كُلِّ شَيءٍ\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":75825,\"headword\":\"الحَرْبُ\",\"headword_norm\":\"الحرب\",\"definitions_text\":\"المقاتلةُ , نقيضُ السَّلْمِ. مؤنَّثٌ , وأصلُها الصفةُ كأنَّها مُقاتِلَةٌ القَتْلُ في الاصطلاح الحديث: صراعٌ بالقُوَّةِ المُسَلَّحةِ بين دولتين أو أكثر, تَسْتَهدِفُ فيه كلُّ دولةٍ فَرْضَ إراداتِها بالقوّة على الدَّوْلة الخصم\",\"name_ar\":\"المعجم الكبير\"},\n{\"entry_id\":75828,\"headword\":\"الحَرْبُ الأهْليَّةُ\",\"headword_norm\":\"الحرب الاهلية\",\"definitions_text\":\"صراعٌ بالقُوَّةِ المُسَلَّحةِ فى إطار دَوْلَةٍ واحِدةٍ , يدورُ بينَ طائفتَيْن تَتصارعان من أجْل السَّيْطرةِ على الدَّوْلة أو جُزْءٍ مِنْها\",\"name_ar\":\"المعجم الكبير\"}]"}
