{"type":"tool_result","timestamp":"2026-03-16T12:32:54.907Z","tool_id":"run_shell_command_1773664374837_0","status":"success","output":"[{\"entry_id\":836833,\"dictionary_id\":124,\"headword\":\"الشمأَلُ\",\"headword_bare\":\"الشمأل\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"الشمأَلُ: بفتح الشين وإسكان الميم وهمز الألف مؤنثة، وجمعها أشمل وشمائل.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_29\",\"dict_name_ar\":\"المذكر والمؤنث لابن التستري الكاتب\",\"dict_name_en\":\"Ibn al-Tustarī al-Kātib, al-Mudhakkar wa-l-Muʾannath (d. 896 CE)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":896},\n{\"entry_id\":836834,\"dictionary_id\":124,\"headword\":\"الشِّمَالُ\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"الشِّمَالُ: بكسر الشين خلاف اليمين مؤنثة. وجمعها أشمل.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_29\",\"dict_name_ar\":\"المذكر والمؤنث لابن التستري الكاتب\",\"dict_name_en\":\"Ibn al-Tustarī al-Kātib, al-Mudhakkar wa-l-Muʾannath (d. 896 CE)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":896},\n{\"entry_id\":799119,\"dictionary_id\":113,\"headword\":\"الشِمالُ\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"الشِمالُ: ضِدُّ اليمينِ،كالشِيمالِ والشِمْلال، بكسرهنَّ، ج: أشْمُلٌ وشَمائِلُ وشُمُلٌ وشِمالٌ، بلفظِ الواحِدِ.وشَمَلَ به: أخَذَ ذات الشِمالِ.والشِمالُ: الطَّبْعُ، ج: شَمائِلُ، والشُّؤْمُ، وبالفتح ويُكْسَرُ: الريحُ التي تَهُبُّ من قِبَلِ الحِجْرِ، أو ما اسْتَقْبَلَكَ عن يَمِينِكَ وأنتَ مُسْتَقْبِلٌ، والصحيحُ أنه ما مَهَبُّه بين مَطْلَعِ الشمسِ وبناتِ نَعْشٍ، أو من مَطْلَعِ النَّعْشِ إلى مَسْقَطِ النَّسْرِ الطائِرِ، ويكونُ اسماً وصِفَةً، ولا تَكادُ تَهُبُّ ليلاً،كالشَّيْمَلِ والشَّأمَلِ، بالهمْزِ،والشَّمَلِ، محرَّكةً وتُسَكَّنُ ميمُهُ،والشَّمْأَلِ، بالهَمْزِ، وقد تُشَدُّ لامُهُ،والشَّوْمَلِ، كجَوْهَرٍ وكَصَبورٍ وكأَميرٍ، ج: شَمالاتٌ.وأشْمَلُوا: دَخَلوا فيها. وكفَرِحوا: أصابَتْهُم.وشَمَلَ الخَمْرَ: عَرَّضَها للشِّمَالِ فَبَرَدَتْ. وككِتابٍ: سِمَةٌ في ضَرْعِ الشاةِ، وكُلُّ قَبْضَةٍ من الزَّرْعِ يَقْبِضُ عليها الحاصِدُ، وشيءٌ كمِخْلاةٍ يُغَطَّى به ضَرْعُ الشاةِ إذا ثَقُلَتْ، أو خاصٌّ بالعَنْزِ.وشَمَلَها يَشْمُلُها ويَشْمِلُها: عَلَّقَ عَليها الشِّمالَ وشَدَّهُ.وشَمَلَ الشاةَ أيضاً،وأشْمَلَها: جَعَلَ لها شِمالاً.وشَمِلَهُمُ الأمْرُ، كفَرِحَ ونَصَرَ، شَمَلاً وشُمْلاً وشُمولاً: عَمَّهُم،أو شَمِلَهُمْ خَيْراً أو شَرّاً، كَفَرِحَ: أصابَهُم ذلك.وأشْمَلَهُم شَرّاً: عَمَّهُم به.واشْتَمَلَ بالثَّوْبِ: أدارَهُ على جَسَدِهِ كُلِّهِ حتى لا تَخْرُجَ منه يَدُهُ،وـ عليهِ الأمْرُ: أحاطَ به.والشِّمْلَةُ، بالكسر: هَيْئَةُ الاشْتِمالِ. والشِّمْلَةُ الصَّمَّاءُ: في الميم، وبالفتحِ: كِساءٌ دونَ القَطيفَةِ يُشْتَمَلُ به،كالمِشْمَلِ والمِشْمَلَةِ، بكسر أوَّلِهِما.وأشْمَلَهُ: أعْطاهُ إيَّاها.وشَمِلَهُ، كعَلِمَهُ، شَمْلاً وشُمولاً: غَطَّاهُ بها، وقد تَشَمَّلَ بها تَشَمُّلاً وتَشْمِيلاً.وأشْمَلَ: صارَ ذا مِشْمَلٍ. وكمِنْبَرٍ: سَيْفٌ قَصيرٌ يَتَغَطَّى بالثَّوْبِ. وكمِحْرابٍ: مِلْحَفَةٌ. وكصَبورٍ: الخَمْرُ، أو البارِدَةُ منها،كالمَشْمولَةِ، لأنَّها تَشْمُل بِريحِها الناسَ، أو لأِنَّ لها عَصْفَةً كعَصْفَةِ الشِّمالِ، ومُغَنِّيَةٌ.والمَشْمولُ: المَرْضِيُّ الأخْلاقِ.والشَّمْلُ، بالكسر والفتحِ، وكطِمِرٍّ: العِذْقُ، أو القَليلُ الحَمْلِ منه، وبالتَّحْريكِ: القَليلُ من الرُّطَبِ ومن المَطَرِ ومن الناسِ وغيرِه، ج: أشْمالٌ، وكذا الشُّمْلولُ، بالضم،ج: شَماليلُ، والكَتِفُ. وشَمْلَةُ بنُ مُنيبٍ، وابنُ هَزَّالٍ: محدِّثانِ ضعيفانِ. وكجُهَيْنَةَ: شُمَيْلَةُ ابنُ محمدِ بنِ جعفرٍ: من أولادِ أُمَراءِ مكةَ، محدِّثٌ ضَعيفٌ.وشَمِلَ النَّخْلَةَ،وأشْمَلَها وشَمْلَلَها: لَقَطَ ما عليها من الرُّطَبِ.وذهبُوا شَماليلَ: فِرَقاً.وأَشْمَلَ الفَحْلُ شُوَّلَهُ لِقَاحاً: ألْقَحَ النِّصْفَ، إلى الثُلُثَيْنِ.وشَمِلَتِ الناقةُ لِقَاحاً، كفرِحَ: قَبِلَتْه،وـ إبِلُكُمْ بَعيراً لنا: أخْفَتْهُ.ودَخَلَ في شَمْلِها، ويُحَرَّكُ: في غِمارِها.وانْشَمَلَ: شَمَّرَ، وأسْرَعَ،كشَمَّلَ وشَمْلَلَ.وناقَةٌ شِمِلَّةٌ، بكَسْرَتَيْنِ مُشَدَّدَةَ اللامِ،وشِمالٌ وشِمْلالٌ وشِمْلِيلٌ، بكسْرِهِنَّ: سَريعَةٌ.وأُمُّ شَمْلَةَ: الدُّنْيا، والخَمْرُ. وأبو الشِّمالِ، ككِتابٍ: تابِعِيٌّ. ومحمدُ بنُ أبي الشِّمالِ: عُطارِدِيٌّ. وذو الشِّمالَيْنِ: عُمَيْرُ بنُ عبدِ عَمْرٍو، صحابِيٌّ، وكان يَعْمَلُ بِيَدَيْهِ. وكشَدَّادٍ: ابنُ موسى المُحَدِّثُ فَرْدٌ.والشَّماليلُ: حِبالُ رَمْلٍ مُتَفَرِّقَةٌ بِناحِيَةِ مُقَلْقَلَةَ. وكزُبَيْرٍ وكِتابٍ وحَمْزَةَ وصاحبٍ: أسماءٌ.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_19\",\"dict_name_ar\":\"القاموس المحيط للفيروزآبادي\",\"dict_name_en\":\"Firuzabadi, al-Qāmūs al-Muḥīṭ (d. 1414 CE)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":1414},\n{\"entry_id\":814188,\"dictionary_id\":117,\"headword\":\"الشمال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"الشمال: المقابل لليمين، والريح الهابة من شمال الكعبة. وهي تقابل الجنوب.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_22\",\"dict_name_ar\":\"التوقيف على مهمات التعاريف للمناوي\",\"dict_name_en\":\"Al-Munāwī, al-Tawqīf ʿalā Muhimmāt al-Taʿārīf (d. 1622 CE)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":1622},\n{\"entry_id\":876253,\"dictionary_id\":131,\"headword\":\"الشمَال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"(الشمَال) الْجِهَة الَّتِي تقَابل الْجنُوب وَتَكون على شمالك وَأَنت مُتَّجه إِلَى الشرق وَالرِّيح الَّتِي تهب من تِلْكَ الْجِهَة وَيُقَال شمأل وشأمل(الشمَال) مُقَابل الْيَمين يُقَال الْيَد الشمَال والجانب الشمَال وَنَحْوهمَا وَفِي التَّنْزِيل الْعَزِيز {لقد كَانَ لسبإ فِي مسكنهم آيَة جنتان عَن يَمِين وشمال} (ج) أشمل وَشَمل وشمائل وَفِي التَّنْزِيل الْعَزِيز {ثمَّ لآتينهم من بَين أَيْديهم وَمن خَلفهم وَعَن أَيْمَانهم وَعَن شمائلهم} والشؤم وطير الشمَال مَا يتشاءم بِهِ (انْظُر طير) والخلق (ج) شمائل وكيس يغطى بِهِ الضَّرع إِذا ثقل أَو التَّمْر لِئَلَّا ينتشر\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_35\",\"dict_name_ar\":\"المعجم الوسيط لمجموعة من المؤلفين\",\"dict_name_en\":\"Academy of the Arabic Language in Cairo, al-Muʿjam al-Wasīṭ (1998)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":1998},\n{\"entry_id\":53213,\"dictionary_id\":2,\"headword\":\"الشَّمال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"ريح تهب من ناحية القطب\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":53212,\"dictionary_id\":2,\"headword\":\"الشَّمَالُ\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"فِي الجغرافيا: الجهةُ التى تُقابِلُ الجنوبَ, وتكونُ على شمال المُتَّجِه إلى الشَّرْق بُلْدانُ الشَّمال: البُلْدانُ الواقعةُ فى الْقِسْمِ الأَعْلَى من الكرة الأرضيَّة, وهى البلدان الأمريكية والأوربيَّة ريحُ الشَّمال: الرِّيحُ التى تهبُّ من تلك الجهةِ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":53216,\"dictionary_id\":2,\"headword\":\"الشِّمال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"الشَّمائل: الطباع والخصال الشُّؤْمُ جعل الأمرَ فى الشِّمال: أهمله\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":53214,\"dictionary_id\":2,\"headword\":\"الشِّمَال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"نَقيضُ اليَمِين. يقال: اليَدُ الشِّمَالُ, والجهةُ الشِّمَالُ.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":15417,\"dictionary_id\":1,\"headword\":\"الشَّمَال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"الجهة التي تقابل الجنوب, وتكون على شمالك وأنت متجه إلى الشرق الريح التي تهب من تلك الجهة. ويقال: شَمَال, وشَأْمَل\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"dict_name_en\":\"Al-Mu'jam Al-Wasit\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":15418,\"dictionary_id\":1,\"headword\":\"الشَّمَال\",\"headword_bare\":\"الشمال\",\"headword_norm\":\"الشمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"مقابل اليمين. يقال: اليد الشَّمال والجانب الشَّمال ونحوهما الشؤم طير الشمال: ما يتشاءم به. (انظر: طير) الخُلُق كيس يغطى به الضَّرع إذا ثقل, أو التمر لئلا ينتثر\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Waseet\",\"dict_name_ar\":\"المعجم الوسيط\",\"dict_name_en\":\"Al-Mu'jam Al-Wasit\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":353293,\"dictionary_id\":58,\"headword\":\"شَمَال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"lane\",\"pos\":null,\"form\":null,\"definitions_text\":\"\",\"translation_en\":\"north\",\"translation_fr\":\"nord\",\"domain\":\"Civil Engineering\",\"dict_key\":\"arabterm_arabterm_civil_engineering\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات الهندسة المدنية (2012)\",\"dict_name_en\":\"Civil Engineering\",\"dict_source_type\":\"arabterm\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":432254,\"dictionary_id\":70,\"headword\":\"شَمال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"lane\",\"pos\":null,\"form\":null,\"definitions_text\":\"\",\"translation_en\":\"north\",\"translation_fr\":\"nord\",\"domain\":\"Geology\",\"dict_key\":\"arabterm_arabterm_geology\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات الجيولوجيا (2000)\",\"dict_name_en\":\"Geology\",\"dict_source_type\":\"arabterm\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":437109,\"dictionary_id\":71,\"headword\":\"شمال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"lane\",\"pos\":null,\"form\":null,\"definitions_text\":\"\",\"translation_en\":\"north\",\"translation_fr\":\"nord\",\"domain\":\"Seismology\",\"dict_key\":\"arabterm_arabterm_seismology\",\"dict_name_ar\":\"المعجم الموحد لمصطلحات علوم الزلازل (1999)\",\"dict_name_en\":\"Seismology\",\"dict_source_type\":\"arabterm\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":853665,\"dictionary_id\":129,\"headword\":\"شَمَال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"شَمَالالجذر: ش م ل\\nمثال: تَلَفَّت عن يمينه وعن شَمَالهالرأي: مرفوضة عند بعضهمالسبب: لضبط الكلمة بفتح الشين.\\nالصواب والرتبة: -تلفَّت عن يمينه وعن شِماله [فصيحة] التعليق: تُطْلَق الشِّمال في مقابل اليمين، ومنه قوله تعالى: {وَنُقَلِّبُهُمْ ذَاتَ الْيَمِينِ وَذَاتَ الشِّمَالِ} الكهف/18، وأما الشَّمال بفتح الشين فهي ضد الجنوب.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_33\",\"dict_name_ar\":\"معجم الصواب اللغوي لأحمد مختار عمر\",\"dict_name_en\":\"Ahmad Mukhtar Umar, Muʿjam al-Ṣawāb al-Lughawī (d. 2003 CE)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"modern\",\"dict_author\":null,\"dict_death_year\":2003},\n{\"entry_id\":931059,\"dictionary_id\":144,\"headword\":\"شَمَال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"شَمَال\\nمن (ش م ل) الجهة التي تقابل الجنوب والريحالتي تهب من تلك الجهة.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_48\",\"dict_name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"dict_name_en\":\"Sultan Qaboos Encyclopedia of Arab Names (Sultan Qaboos University, 1985)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":931061,\"dictionary_id\":144,\"headword\":\"شَمَّال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"شَمَّال\\nمن (ش م ل) الأمر الذي يغطي الناس، والمغطي غيره بالشملة، والكثير الأخذ بغيره ذات الشمال.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_48\",\"dict_name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"dict_name_en\":\"Sultan Qaboos Encyclopedia of Arab Names (Sultan Qaboos University, 1985)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":931060,\"dictionary_id\":144,\"headword\":\"شِمَال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"camel\",\"pos\":null,\"form\":null,\"definitions_text\":\"شِمَال\\nمن (ش م ل) ضد اليمين، والخلق، وكيس يغطي به الضرع أو التمر يستخدم للذكور والإناث.\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"hawramani_48\",\"dict_name_ar\":\"موسوعة السلطان قابوس لأسماء العرب\",\"dict_name_en\":\"Sultan Qaboos Encyclopedia of Arab Names (Sultan Qaboos University, 1985)\",\"dict_source_type\":\"hawramani\",\"dict_period\":\"classical\",\"dict_author\":null,\"dict_death_year\":null},\n{\"entry_id\":53219,\"dictionary_id\":2,\"headword\":\"شَمَالٌ\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"adj\",\"form\":null,\"definitions_text\":\"نَاقةٌ شِمَالٌ: خفيفةٌ سريعةٌ مُشَمِّرةٌ\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null},\n{\"entry_id\":53215,\"dictionary_id\":2,\"headword\":\"شِمال\",\"headword_bare\":\"شمال\",\"headword_norm\":\"شمال\",\"root\":\"شمل\",\"root_source\":\"ocr\",\"pos\":\"noun\",\"form\":null,\"definitions_text\":\"ريحُ الشَّمالِ النَّخْلَةُ إذا شُدَّتْ أَعْذَاقُها بقِطَعِ الأَكْسِيَةِ لِئَلَّا تُنْفَضَ كِيسٌ, أو شِبْهُ مِخْلَاةٍ يُغَطَّى بها الضَّرْعُ إِذا ثَقُلَ, أو التَّمْرُ لئلا يَتَفَرَّقَ سِمَةٌ فى ضَرْع الشَّاةِ كُلُّ قَبْضَةٍ (حُزْمَة) مِن الزَّرْعِ يَقْبِضُ عليها الحاصدُ المَنْزِلَةُ الخَسِيسَة. يقال: فُلانٌ عِندِى بالشَّمالِ الخُلُقُ والطَّبع\",\"translation_en\":null,\"translation_fr\":null,\"domain\":null,\"dict_key\":\"Al_Mujam_Al_Kabeer\",\"dict_name_ar\":\"المعجم الكبير\",\"dict_name_en\":\"Al-Mu'jam Al-Kabir\",\"dict_source_type\":\"ocr\",\"dict_period\":\"modern\",\"dict_author\":\"مجمع اللغة العربية\",\"dict_death_year\":null}]"}
