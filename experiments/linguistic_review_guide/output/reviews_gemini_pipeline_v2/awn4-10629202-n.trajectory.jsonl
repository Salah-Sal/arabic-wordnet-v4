oot\":\"تبع\",\"name_ar\":\"مسرد الهندسة الكهربائية، المنظمة العربية للتربية والثقافة والعلوم (موقع ArabTerm)\",\"def_preview\":\"هو مُشترك سلبي في عملية الاتصال، مُطالب باستقبال البيانات وإرسالها، فضلاً عن التوقيع على استلام الملفات المُستقبَلة إذا لزم الأمر. يُسمح للتابعين - كم\",\"translation_en\":\"Slave\"},\n{\"entry_id\":456817,\"headword\":\"نملة استعبادية\",\"headword_norm\":\"نملة استعبادية\",\"root\":\"نمل\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الأحياء (1993)\",\"def_preview\":\"\",\"translation_en\":\"slave-making ant\"},\n{\"entry_id\":461141,\"headword\":\"مفهوم السيد والعبد\",\"headword_norm\":\"مفهوم السيد والعبد\",\"root\":\"فهم\",\"name_ar\":\"المعجم الموحد لمصطلحات علم الوراثة (2009)\",\"def_preview\":\"ينص على أن كل مقرون يمثل بعدة نسخ متصلة عند نهاياتها، بعضها ببعض، وتوجد في كل سلسلة نسخة واحدة من 'مورث سيد'، ومن المحتمل أن يكون في طرف السلسلة. أما \",\"translation_en\":\"master-slave concept\"},\n{\"entry_id\":510708,\"headword\":\"إستقرار حلقة مفتوحة\",\"headword_norm\":\"استقرار حلقة مفتوحة\",\"root\":\"قرر\",\"name_ar\":\"موسوعة الكهرباء (IEC 60050)\",\"def_preview\":\"\",\"translation_en\":\"slave operation\"},\n{\"entry_id\":510709,\"headword\":\"تشغيل بتابع\",\"headword_norm\":\"تشغيل بتابع\",\"root\":\"شغل\",\"name_ar\":\"موسوعة الكهرباء (IEC 60050)\",\"def_preview\":\"\",\"translation_en\":\"slave tracking operation\"}]"}
