"المصطلح العام للأبعاض التي يتشكل منها الكل (part).\"\n\n# ── المرحلة ٢: جمع الأدلة ────────────────────────────────\nstage2_evidence:\n  per_lemma:\n    - lemma: \"جزء\"\n      confirm:\n        - text: \"«الجزء: ما يتركب الشيء منه ومن غيره.»\"\n        - source: \"كتاب التعريفات للشريف الجرجاني\"\n        - text: \"«الجزء: ما يتركب الشيء عنه وعن غيره... كأجزاء السفينة والبيت.»\"\n        - source: \"التوقيف على مهمات التعاريف للمناوي\"\n    - lemma: \"عنصر\"\n      confirm:\n        - text: \"«العنصر: ابتداء تركيب الشيء.»\"\n        - source: \"معجم مقاليد العلوم للسيوطي\"\n        - text: \"«الجدران والأعمدة والجوائز عناصر إنشائية. فأي منشإ يتألف من مجموعة العناصر المرتبطة بعضها ببعض.»\"\n        - source: \"المعجم الموحد لمصطلحات الهندسة المدنية\"\n    - lemma: \"مكون\"\n      confirm:\n        - text: \"«مُكَوِّن: قطعة أو جزء من جهاز معلوماتي مثل اللوحة الأم أو الذاكرة أو بطاقة الصوت أو القرص الصلب وغير ذلك.»\"\n        - source: \"المعجم الموحد لمصطلحات تقانة المعلومات\"\n        - text: \"«عنصر مسؤول عن بعض الوظائف الداخلية في الحاسوب... يترابط مع عناصر أخرى للقيام ككل بجميع الوظائف.»\"\n        - source: \"المعجم الموحد لمصطلحات تقانة المعلومات\"\n    - lemma: \"قطعة\"\n      confirm:\n        - text: \"«القطعةُ من الشىء: الطائفة منه.»\"\n        - source: \"المعجم الوسيط\"\n      expands:\n        - text: \"«قطعة أو جزء من جهاز معلوماتي.»\"\n        - source: \"المعجم الموحد لتقانة المعلومات (استخدام قطعة كمرادف لمكون مادي)\"\n    - lemma: \"وحدة\"\n      confirm:\n        - text: \"«وَحْدَة بِناء: assembly (object) / unit / component.»\"\n        - source: \"المعجم الموحد لمصطلحات المياه\"\n\n# ── المرحلة ٣: التحليل اللغوي للّمات ────────────────────\nstage3_analysis:\n  per_lemma:\n    - lemma: \"جزء\"\n      decision: confirmed\n      decision_reason: \"مصطلح عام وأساسي للتعبير عن القسم من الكل، وهو مدعوم في المعاجم القديمة والحديثة.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"جُزْء\"\n    - lemma: \"عنصر\"\n      decision: confirmed\n      decision_reason: \"شائع جداً في السياقات العلمية والتقنية للتعبير عن المكونات الأساسية.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"عُنْصُر\"\n    - lemma: \"مكوّن\"\n      decision: confirmed\n      decision_reason: \"أدق المصطلحات للتعبير عن المكونات التقنية والوظيفية داخل الأنظمة.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: update_lemma\n          params:\n            entry_id: \"{auto}\"\n            new_lemma: \"مُكَوِّن\"\n    - lemma: \"قِطْعَة\"\n      source: stage1\n      decision: confirmed\n      decision_reason: \"تُستخدم بشكل متخصص للأجزاء المادية القابلة للتبديل (spare parts) وهو ما يغطي جانب 'separable or attachable' في التعريف.\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: create_entry\n          params: {lemma: \"قِطْعَة\", pos: n}\n        - command: add_sense\n          params: {entry_id: \"{auto}\", synset_id: \"{synset_id}\"}\n    - lemma: \"وَحْدَة\"\n      source: stage1\n      decision: confirmed\n      decision_reason: \"تعبر عن المكونات المستقلة وظيفياً داخل نظام مركب (module/unit).\"\n      evidence_assessment:\n        case: confirm_only\n      mwe_check:\n        is_mwe: false\n      actions:\n        - command: create_entry\n          params: {lemma: \"وَحْدَة\", pos: n}\n        - command: add_sense\n          params: {entry_id: \"{auto}\", synset_id: \"{synset_id}\"}\n\n# ── المرحلة ٤: التعريف والأمثلة ──────────────────────────\nstage4_content:\n  definition:\n    current: \"مصنوع يشكل جزءاً فردياً من كيان مركب؛ خاصة الجزء الذي يمكن فصله أو توصيله بنظام\"\n    assessment:\n      decision: revise\n      reason: \"التعريف الحالي ركيك لغوياً ومترجم حرفياً. يفضل صياغته بأسلوب المعجم الوسيط مع التركيز على الجانب الوظيفي والمادي.\"\n    authored:\n      - type: terminological\n        text: \"أحدُ الأجْزاءِ المادِّيَّةِ الَّتي يَتَأَلَّفُ مِنْها جِهازٌ أوْ نِظامٌ مُرَكَّبٌ، ويُمْكِنُ فَصْلُهُ عَنْهُ أوْ تَرْكيبُهُ فيهِ لِيُؤَدِّيَ وَظيفَةً مُعَيَّنَةً.\"\n        quality_check:\n          genus_present: true\n          differentia_present: true\n          circular: false\n  examples:\n    per_lemma:\n      - lemma: \"مُكَوِّن\"\n        examples:\n          - text: \"يَتَطَلَّبُ إصْلاحُ الحاشوبِ اسْتِبْدالَ بَعْضِ المُكَوِّناتِ التالِفَةِ.\"\n            type: usage\n      - lemma: \"عُنْصُر\"\n        examples:\n          - text: \"تُعَدُّ المِعمارِيَّةُ النَّمَطِيَّةُ سَهْلَةَ الصِّيانَةِ لِإمْكانِيَّةِ تَغْيِيرِ العُنْصُرِ المُعَطَّلِ بِسُهولَةٍ.\"\n            type: usage\n      - lemma: \"جُزْء\"\n        examples:\n          - text: \"يَتَكَوَّنُ المُحَرِّكُ مِنْ أجزاءٍ كَثيرَةٍ تَعْمَلُ مَعاً في تَنَاغُمٍ.\"\n            type: usage\n      - lemma: \"قِطْعَة\"\n        examples:\n          - text: \"اشْتَرى المُهَنْدِسُ قِطَعاً جَدِيدَةً لِتَرْكيبِ الآلَةِ.\"\n            type: usage\n      - lemma: \"وَحْدَة\"\n        examples:\n          - text: \"تَتَمَيَّزُ السَّفِينَةُ الفَضائِيَّةُ بِوِحْداتٍ يُمْكِنُ انْفِصالُها عِنْدَ الحاجَةِ.\"\n            type: usage\n    actions:\n      - command: update_definition\n        params: {synset_id: \"{synset_id}\", definition_index: 0, text: \"أحدُ الأجْزاءِ المادِّيَّةِ الَّتي يَتَأَلَّفُ مِنْها جِهازٌ أوْ نِظامٌ مُرَكَّبٌ، ويُمْكِنُ فَصْلُهُ عَنْهُ أوْ تَرْكيبُهُ فيهِ لِيُؤَدِّيَ وَظيفَةً مُعَيَّنَةً.\"}\n\n# ── المرحلة ٥: الإثراء (البيانات الوصفية) ─────────────────\nstage5_enrichment:\n  per_entry:\n    - lemma: \"جُزْء\"\n      entry_id: \"{auto}\"\n      root: \"جزأ\"\n      maqayis_quote: \"«الْجِيمُ وَالزَّاءُ وَالْهَمْ