{"type":"tool_result","timestamp":"2026-03-16T14:38:05.143Z","tool_id":"run_shell_command_1773671885028_0","status":"success","output":"[{\"entry_id\":11720,\"headword\":\"رَهَنَ\",\"headword_norm\":\"رهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الوسيط\",\"definitions_text\":\"الشيءَ: ثبت ودام بالمكان: أقام الرجلُ والدابةُ رُهُوناً: هُزِلَ وأعيا الشيءَ رَهْناً: أثبته وأدامه فلاناً وعند فلان الشيءَ: حبسَهُ عنده بدَيْن رَهَنْتُه لسانِي: كففته وحبستُه\"},\n{\"entry_id\":11721,\"headword\":\"أَرْهَنَ\",\"headword_norm\":\"ارهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الوسيط\",\"definitions_text\":\"فى السِّلعة وبها: غالى بها وبذَل فيها ماله حتى أدركها الشيءَ: أثبته وأدامه. يقال: أرهن لهم الطعامَ والشرابَ أرهنَ الميتَ القَبْرَ: ضَمَّنَهُ إيَّاه فلاناً وغيره: أضعفه وأعجفه فلاناً الشيءَ: رهنَه إيَّاه, أو دفعه إليه ليرهنَه عند أحد\"},\n{\"entry_id\":11723,\"headword\":\"ارْتَهَنَه\",\"headword_norm\":\"ارتهنه\",\"root\":\"رهن\",\"name_ar\":\"المعجم الوسيط\",\"definitions_text\":\"منه: أَخَذه رَهْناً\"},\n{\"entry_id\":11725,\"headword\":\"اسْتَرْهَنَهُ\",\"headword_norm\":\"استرهنه\",\"root\":\"رهن\",\"name_ar\":\"المعجم الوسيط\",\"definitions_text\":\"طَلَب منه رَهْناً\"},\n{\"entry_id\":11729,\"headword\":\"الرَّهْنُ\",\"headword_norm\":\"الرهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الوسيط\",\"definitions_text\":\"(شرعاً): حَبْسُ الشيء بحق ليستوفى منه عند تعذّر وفائه ما وضع عندك ليتوب مَنَاب ما أُخِذ منك (فَعْلٌ بمعنى مفعول)\"},\n{\"entry_id\":11731,\"headword\":\"الرَّهْنُ\",\"headword_norm\":\"الرهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الوسيط\",\"definitions_text\":\"هو رهنُ مالٍ: قَيّمٌ به وسائسٌ له\"},\n{\"entry_id\":39976,\"headword\":\"رَهَنَ\",\"headword_norm\":\"رهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"الشىءُ ـــ يَرْهَنُ, ورُهُونًا: ثَبت ودامَ الشىءُ لِفُلان: (فهو راهنٌ, وهى بتاء). يقال: طعامٌ راهنٌ, وصَبوحٌ راهِنٌ: دائم لا ينقطع. ويقال: خمرٌ راهِنَةٌ بالمكان, وفيه: ثَبَت وأقام (مجاز)\"},\n{\"entry_id\":39977,\"headword\":\"رَهَنَ\",\"headword_norm\":\"رهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"الرجلُ أو الدابَّةُ رُهونًا: هَزُل وأعيَا من رُكوبٍ أو مرضٍ أو حَدثٍ الطَّعامُ والشَّراب لضيْفِه رَهْنًا: أدامه له الشىءَ عِنْد فُلان: جَعَلَه رَهْنًا عنده الشَّىءَ عَنْ فُلان: جَعَلَه رَهْنًا بَدَلًا مِنْهُ فلانًا الشَّىءَ: جعله عِنْده رَهْنًا رَهْنه الثَّوبَ وَنَحوه: دفعه إليه لِيرْهَنَه رهنتُه لِسَانِى: كَفَفْتُهُ عنه وحبَسْتُه رَهَنَهُ عِرْضَه: عَرَّضه للهجاء رَهَن يده المَنِيَّة: اقتحمها واستًمَاتَ\"},\n{\"entry_id\":39978,\"headword\":\"أَرْهَنَ\",\"headword_norm\":\"ارهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"فلانٌ فى السِّلْعَة ونحوها : غالَى بها وبذَل فيها ماله حتَّى أدركها الشىءَ, وفيه : أسْلَف. أى دفع مُقَدَّمَةً لثمنه فجعلها رهينة لإتمام الثمن الشَّىءَ: أضعَفه وأعْجَفَه وَلَدَه: أخْطَرَهُمْ خَطَرًا أرهنوا بينهم خَطَرًا: إذا بَذَلُوا منه ما يَرْضَى به القَوْمُ بالغًا ما بَلَغَ, فيكونُ لَهم سَبَقًا الشىءَ لفلان : أدامه له فلانًا للمَوتِ : أَسْلَمَه فلانًا الشىءَ: رَهَنَه إيَّاه الميَّت القَبْرَ: ضَمَّنَه إيَّاه (دفنه)\"},\n{\"entry_id\":39980,\"headword\":\"ارْتَهَنَ\",\"headword_norm\":\"ارتهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"الشَّىءَ : أَخَذَه رَهْنًا من فلان رَهْنًا : أخذه هو مُرْتَهِنٌ بكذا: مأخوذٌ به\"},\n{\"entry_id\":39982,\"headword\":\"استرهن\",\"headword_norm\":\"استرهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"فلانًا شيئًا: طلبه منه رَهْنًا\"},\n{\"entry_id\":39983,\"headword\":\"استرهنَه\",\"headword_norm\":\"استرهنه\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"فَرَهَنَهُ: طلب منه رَهْنًا فأعطاه إيَّاه\"},\n{\"entry_id\":39989,\"headword\":\"الرَّهْنُ\",\"headword_norm\":\"الرهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"ما وُضِع عند الإنسان لينوبَ مَنَابَ ما أُخِذ منه, أو هو التوثقة بالشىءِ بما يعادله بوَجْه ما. (عن الحرالىّ) (فى الشرع): جَعْلُ عَيْن ماليَّة وثيقة بدين لازمٍ أو آيلٍ إلى اللزوم\"},\n{\"entry_id\":39990,\"headword\":\"رَهْن\",\"headword_norm\":\"رهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"ما يُوضع وثيقةً للدَّيْنِ (تتمة الشرح والأمثلة)\"},\n{\"entry_id\":39991,\"headword\":\"الرَّهْن\",\"headword_norm\":\"الرهن\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"يُقال: هو رهنُ مال, أي : قَيِّم عليه مُحسن لسياسته\"},\n{\"entry_id\":39992,\"headword\":\"رَهْنَةُ\",\"headword_norm\":\"رهنة\",\"root\":\"رهن\",\"name_ar\":\"المعجم الكبير\",\"definitions_text\":\"قريةٌ من قُرَى كِرْمَان, يُنسب إليها مُحمدُ بن بَحْرٍ, أبو الحَسَن الرَّهْنى, أَحدُ الأدباءِ العلماءِ\"},\n{\"entry_id\":101221,\"headword\":\"رَهَن\",\"headword_norm\":\"رهن\",\"root\":\"رهن\",\"name_ar\":\"مقاييس اللغة\",\"definitions_text\":\"ثبات شيء يمسك بحق الدوام\"},\n{\"entry_id\":105897,\"headword\":\"رهنت\",\"headword_norm\":\"رهنت\",\"root\":\"رهن\",\"name_ar\":\"مجمل اللغة\",\"definitions_text\":\"وضع الشيء رهنا\"}]"}
